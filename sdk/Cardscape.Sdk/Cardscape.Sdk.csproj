<Project Sdk="Microsoft.NET.Sdk">

  <!-- This project overrides the repository-wide <TargetFramework>
       (net11.0) imposed by Directory.Build.props because the SDK
       is published to NuGet as a multi-target package that
       consumers can pull into netstandard2.0 and net8.0 hosts.
       The override is a one-line opt-out from
       Directory.Build.props; everything else (analyzers, nullable,
       etc.) is inherited. -->
  <PropertyGroup>
    <!-- Override the repository-wide <TargetFramework>net11.0</TargetFramework>
         imposed by Directory.Build.props. The SDK is a multi-target
         package (netstandard2.0 + net8.0). Unsetting TargetFramework
         here is what makes TargetFrameworks (plural) win. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Cardscape.Sdk</RootNamespace>
    <AssemblyName>Cardscape.Sdk</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Cardscape.Sdk</PackageId>
    <Version>1.1.0</Version>
    <PackageDescription>Typed C# client for the Cardscape REST API. Hand-written for the 30 most-used endpoints; the rest of the surface stays reachable through the lower-level HttpClient extension methods.</PackageDescription>
    <PackageTags>cardscape;kanban;trello;mcp;api-client;netstandard2.0</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

  <ItemGroup>
    <!-- netstandard2.0 needs the explicit packages; net8.0 already
         has them in the BCL through the FrameworkReference above,
         so the PackageReferences are conditioned to that target. -->
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Net.Http.Json" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
