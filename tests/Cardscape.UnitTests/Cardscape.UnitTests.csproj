<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Cardscape.UnitTests</AssemblyName>
    <RootNamespace>Cardscape.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Fast in-process unit tests for Domain, Application, and Infrastructure.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestCommon\TestCommon.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Domain\Cardscape.Domain.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Application\Cardscape.Application.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Infrastructure\Cardscape.Infrastructure.csproj" />
    <!--
      Cardscape.Api: needed for the in-process unit tests of
      AdminOnlyAuthorizationHandler + AdminAuthorizationOptions
      (the type lives in src/Cardscape.Api/Authentication/).
      The transitive dependency on the Blazor WASM project is
      tolerated because the unit test process only references
      the auth handler; it never instantiates or loads any of
      the Web types.
    -->
    <ProjectReference Include="..\..\src\Cardscape.Api\Cardscape.Api.csproj" />
    <!--
      Cardscape.Web: needed for the in-process unit tests of
      src/Cardscape.Web/Theming/ThemeCatalog.cs (added by
      docs/roadmap/06-plan-radzen-themes.md, commit 1). The
      Blazor WASM runtime types are never instantiated by
      these tests — they only touch the static catalog and
      the Radzen.Theme POCO.
    -->
    <ProjectReference Include="..\..\src\Cardscape.Web\Cardscape.Web.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Mcp\Cardscape.Mcp.csproj" />
  </ItemGroup>

</Project>
