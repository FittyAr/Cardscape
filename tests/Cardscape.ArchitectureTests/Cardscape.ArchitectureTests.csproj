<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Cardscape.ArchitectureTests</AssemblyName>
    <RootNamespace>Cardscape.ArchitectureTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>NetArchTest rules: enforces layer boundaries, naming, dependency direction.</Description>
    <!-- Test naming convention: Method_Scenario_Expected. CA1707 is a global suppression
         for the test projects only; production code follows PascalCase. -->
    <!-- CA1865: NetArchTest's HaveNameStartingWith API requires a string parameter. -->
    <NoWarn>$(NoWarn);CA1707;CA1865</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestCommon\TestCommon.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Domain\Cardscape.Domain.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Application\Cardscape.Application.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Infrastructure\Cardscape.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Api\Cardscape.Api.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Web\Cardscape.Web.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Mcp\Cardscape.Mcp.csproj" />
  </ItemGroup>

</Project>
