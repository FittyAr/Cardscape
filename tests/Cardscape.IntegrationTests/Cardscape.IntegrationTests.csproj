<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Cardscape.IntegrationTests</AssemblyName>
    <RootNamespace>Cardscape.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Integration tests that boot the API/Persistence in-process. CURRENTLY: SQLite only. Designed to be portable to PostgreSQL/MariaDB once their EF Core providers stabilize on the LTS line — see docs/adr/0001-multi-provider-strategy.md.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!--
    Tests currently run against SQLite only (Microsoft.EntityFrameworkCore.Sqlite,
    referenced transitively via Cardscape.Infrastructure). The other two providers
    (Npgsql for PostgreSQL, MySql.EntityFrameworkCore for MariaDB) are NOT
    referenced here on purpose: pulling in the Postgres / MariaDB EF Core provider
    stacks would add a third database engine to the CI matrix without changing
    the assertions, and slow the test loop proportionally.

    The runtime side (Cardscape.Api) DOES reference all three providers, so the
    application itself can be configured to run on any of them at deployment
    time. See docs/adr/0001-multi-provider-strategy.md for the full rationale
    and the migration plan to bring PostgreSQL / MariaDB back into the test
    matrix once the EF Core providers stabilize on the LTS line.
  -->

  <ItemGroup>
    <ProjectReference Include="..\TestCommon\TestCommon.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Infrastructure\Cardscape.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Api\Cardscape.Api.csproj" />
  </ItemGroup>

</Project>
