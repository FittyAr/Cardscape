<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Cardscape.IntegrationTests</AssemblyName>
    <RootNamespace>Cardscape.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Integration tests that boot the API/Persistence in-process. CURRENTLY: SQLite only. Designed to be portable to PostgreSQL/MariaDB once their EF Core 11+ providers ship — see docs/adr/0001-multi-provider-strategy.md.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <!--
    Tests currently run against SQLite only (Microsoft.EntityFrameworkCore.Sqlite,
    referenced transitively via Cardscape.Infrastructure). The other two providers
    (Npgsql for PostgreSQL, MySql.EntityFrameworkCore for MariaDB) are NOT
    referenced here on purpose: their .NET 11 / EF Core 11 binaries are not yet
    stable, and shipping them as test dependencies would lock the test matrix
    to a broken state.

    The runtime side (Cardscape.Api) DOES reference all three providers, so the
    application itself can be configured to run on any of them at deployment
    time. See docs/adr/0001-multi-provider-strategy.md for the full rationale
    and the migration plan to bring PostgreSQL / MariaDB back into the test
    matrix once the providers stabilize.
  -->

  <ItemGroup>
    <ProjectReference Include="..\TestCommon\TestCommon.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Infrastructure\Cardscape.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Cardscape.Api\Cardscape.Api.csproj" />
  </ItemGroup>

</Project>
