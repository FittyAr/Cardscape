<Project>

  <PropertyGroup>
    <!-- Central Package Management. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NOTE: We target net11.0, but EF Core 11 preview providers for MariaDB
      have not shipped yet. We use EF Core 10.0.10 (current LTS) for all
      three database engines: SQLite, PostgreSQL, and MariaDB (via Oracle's
      MySql.EntityFrameworkCore, which is wire-compatible with MariaDB).
      This decision will be revisited once Pomelo / Oracle ship EF Core 11
      providers for MariaDB.
    -->

    <!-- Application layer. -->
    <PackageVersion Include="WolverineFx" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.23.1" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-preview.6.26359.118" />

    <!-- Override transitive SQLitePCLRaw (vulnerability GHSA-2m69-gcr7-jv3q, fixed in 2.1.12+). -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0-preview.6.26359.118" />

    <!-- Override transitive Newtonsoft.Json (transitive from SignalR.Client 1.2.0; 11.0.2 has a known high-severity advisory GHSA-5crp-9r3c-p9vr). -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- EF Core 10 LTS + Identity. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />

    <!-- Database providers (one per engine, all EF Core 10-compatible). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.7" />

    <!-- API surface. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <!-- Blazor WASM + Radzen. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Radzen.Blazor" Version="11.1.8" />

    <!-- Model Context Protocol (AI integration server). -->
    <PackageVersion Include="ModelContextProtocol" Version="1.4.1" />

    <!-- Tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

</Project>
