<Project>
  <PropertyGroup>
    <!-- Central Package Management. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET 10 LTS application stack with EF Core 10 and SQLite. -->
    <!-- Application layer. -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.CorrelationId" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Span" Version="3.1.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact.Reader" Version="4.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.BrowserHttp" Version="1.0.0-dev-00032" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageVersion Include="WolverineFx" Version="6.24.5" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.24.5" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!-- Override transitive SQLitePCLRaw (vulnerability GHSA-2m69-gcr7-jv3q, fixed in 2.1.12+). -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <!-- Override transitive Newtonsoft.Json (transitive from SignalR.Client 1.2.0). -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Redis client (opt-in distributed backends for the rate limiter
         and the pending-2FA token store). See docs/operations/06-configurable-subsystems.md. -->
    <PackageVersion Include="StackExchange.Redis" Version="2.8.16" />
    <!-- EF Core 10 LTS + Identity. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <!-- API surface. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!--
      System.IdentityModel.Tokens.Jwt: previously pinned to 8.2.1 to dodge the
      GHSA-5crp-9r3c-p9vr advisory that hit 11.0.2. The advisory is fixed in
      7.1.2 / 8.2.1+, and the JwtBearer 10.0.10 transitive tree now requires
      >= 8.19.2 via Microsoft.IdentityModel.Protocols.OpenIdConnect 8.19.2.
      Bumping to the latest 8.x release (still on the 8.x line to keep the
      LTS-friendly surface area).
    -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!--
      OpenAPI / API reference (replaces Swashbuckle.AspNetCore).
      Microsoft.AspNetCore.OpenApi is the native .NET 10+ OpenAPI
      document generator (Microsoft.AspNetCore.OpenApi package on
      NuGet, ships as part of the ASP.NET Core shared framework in
      10.0.x). Scalar.AspNetCore mounts the Scalar reference UI on
      top of the document emitted by MapOpenApi().
    -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.12.50" />
    <!--
      Override transitive Microsoft.OpenApi (pulled in by both
      Microsoft.AspNetCore.OpenApi 10.0.10 and Scalar.AspNetCore).
      The 2.0.0 default is flagged by GHSA-v5pm-xwqc-g5wc (CVE-2026-49451,
      uncontrolled recursion on circular schema references, fixed in
      2.7.5). Central Package Management is what lets us pin the
      transitive once instead of overriding per project.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Localization (Blazor WASM). -->
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.10" />
    <!-- OAuth 2.0 / OIDC external login providers. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <!-- Blazor WASM + Radzen. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Radzen.Blazor" Version="11.2.1" />
    <!-- Model Context Protocol (AI integration server). -->
    <PackageVersion Include="ModelContextProtocol" Version="2.0.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />
    <!-- OpenTelemetry (tracing for the MCP server). -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
    <!-- 2FA / TOTP (OtpNet RFC 6238 + ASP.NET Core Data Protection for at-rest secret encryption). -->
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.10" />
    <!-- SAML 2.0 SSO (Sustainsys.Saml2 — formerly Kentor.AuthServices). -->
    <PackageVersion Include="Sustainsys.Saml2.AspNetCore2" Version="2.11.0" />
    <!-- Tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- SDK (Cardscape.Sdk) — published as a NuGet package targeting
         netstandard2.0 + net8.0. System.Text.Json is in the BCL for
         net8.0 but must be an explicit reference on netstandard2.0,
         so it's listed here for central management. -->
    <PackageVersion Include="System.Text.Json" Version="10.0.10" />
    <PackageVersion Include="System.Net.Http.Json" Version="10.0.10" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
