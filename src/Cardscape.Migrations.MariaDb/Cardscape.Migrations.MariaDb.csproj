    <AssemblyName>Cardscape.Migrations.MariaDb</AssemblyName>
    <RootNamespace>Cardscape.Migrations.MariaDb</RootNamespace>
    <Description>Native EF Core migration history for Cardscape on MariaDB.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
