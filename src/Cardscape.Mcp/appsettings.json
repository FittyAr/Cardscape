{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "_comment": "Defaults wired by UseCardscapeSerilog(). The MCP server is a stdio host; the OTel sink only attaches when Otel:EndpointUrl is set so the process can stay quiet when no collector is around.",
    "File": {
      "RootPath": "logs",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 30,
      "FileSizeLimitBytes": 104857600
    },
    "Database": {
      "Enabled": false,
      "ConnectionString": null,
      "TableName": "logs"
    }
  },
  "AllowedHosts": "*",
  "Otel": {
    "ServiceName": "Cardscape.Mcp",
    "EndpointUrl": ""
  }
}
