<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Cardscape.Application</AssemblyName>
    <RootNamespace>Cardscape.Application</RootNamespace>
    <Description>Application layer: use cases (CQRS via Wolverine), validations, DTOs, abstractions, mapping.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Riok.Mapperly" />
    <!--
      Microsoft.Extensions.{DependencyInjection,Logging}.Abstractions are
      pinned centrally in Directory.Packages.props at the matching 10.0.10
      patch. The Application layer only needs the abstractions (no concrete
      DI / logging implementation), so it doesn't reference the AspNetCore
      shared framework that would otherwise auto-include them.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cardscape.Domain\Cardscape.Domain.csproj" />
  </ItemGroup>

</Project>
