<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Cardscape.Api</AssemblyName>
    <RootNamespace>Cardscape.Api</RootNamespace>
    <UserSecretsId>cardscape-api-secrets</UserSecretsId>
    <Description>Cardscape REST API. ASP.NET Core minimal APIs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cardscape.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.CorrelationId" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Process" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Exceptions" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Formatting.Compact.Reader" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <!--
      Native .NET 10+ OpenAPI document generation. The OpenAPI
      document is served at /openapi/v1.json (Development) via
      MapOpenApi() and the Scalar reference UI is mounted at
      /scalar via Scalar.AspNetCore. No third-party Swagger UI
      or document generators — the whole pipeline is built on
      the Microsoft.AspNetCore.OpenApi + Scalar.AspNetCore pair.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Sustainsys.Saml2.AspNetCore2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cardscape.Application\Cardscape.Application.csproj" />
    <ProjectReference Include="..\Cardscape.Infrastructure\Cardscape.Infrastructure.csproj" />
    <ProjectReference Include="..\Cardscape.Web\Cardscape.Web.csproj" />
    <!--
      Optional, feature-gated seeder. Scaffolds a demo dataset
      on demand. The whole pipeline returns 404 when the
      Cardscape:Seeder:Enabled toggle is false, so this
      reference has no effect outside the admin surface.
    -->
    <ProjectReference Include="..\Cardscape.Seeder\Cardscape.Seeder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Migrations: a single set of migrations under
      src/Cardscape.Infrastructure/Persistence\Migrations is the canonical
      SQLite schema and is generated exclusively from the EF Core model.
    -->
    <EmbeddedResource Include="..\Cardscape.Infrastructure\Persistence\Migrations\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      BETA-8-UI-#3 + BETA-8-UI-#9 — see test-results/r8/r8-report.md.
      The per-culture SharedResource.{culture}.resx files live in the
      Web project. The translation endpoint in the API reads them
      from the file system at runtime (AppContext.BaseDirectory),
      so we copy the Spanish resx into the API's output directory
      under Resources/. CopyToOutputDirectory=PreserveNewest ensures
      a fresh build ships the file.
      BUG-A1-003 — also copy the invariant SharedResource.resx so
      the /api/internal/translate/en endpoint can fall back to it.
      Without this, the `en` request returned 0 keys and the
      Blazor client's CultureSwitcher rendered raw resource keys
      for every label.
    -->
    <Content Include="..\Cardscape.Web\Resources\SharedResource.es.resx"
             Link="Resources\SharedResource.es.resx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Cardscape.Web\Resources\SharedResource.resx"
             Link="Resources\SharedResource.resx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
