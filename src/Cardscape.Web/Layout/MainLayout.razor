@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.Extensions.Localization
@inject AuthService Auth
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="page-body">
        <AuthorizeView>
            <Authorized>
                <div class="top-row px-4">
                    <span class="user-info">
                        <span class="user-name">@context.User.Identity?.Name</span>
                        <span class="user-email">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                    </span>
                    <RadzenButton Text="@L["AuthLogOut"]"
                                  ButtonStyle="@ButtonStyle.Light"
                                  Size="@ButtonSize.Small"
                                  Click="@HandleLogout" />
                </div>
            </Authorized>
            <NotAuthorized>
                <header class="guest-bar">
                    <a class="guest-brand" href="/">
                        <span class="brand-lanes brand-lanes--sm" aria-hidden="true">
                            <span></span><span></span><span></span>
                        </span>
                        <span class="brand-wordmark">@L["AppName"]</span>
                    </a>
                    <nav class="guest-actions">
                        <a href="login" class="guest-link">@L["AuthSignIn"]</a>
                        <a href="register" class="guest-link guest-link--solid">@L["AuthCreateAccount"]</a>
                    </nav>
                </header>
            </NotAuthorized>
        </AuthorizeView>

        <article class="content px-4">
            @Body
        </article>
    </div>
</div>

@code {
    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login", forceLoad: true);
    }
}
