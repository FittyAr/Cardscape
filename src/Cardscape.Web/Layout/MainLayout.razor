@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.Extensions.Localization
@inject AuthService Auth
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@inject CultureSwitcher Culture

<RadzenComponents />

@*
  BETA-3-UI-#14 — see test-results/BETA-TEST-REPORT.md.
  Skip-link is the single highest-impact a11y fix on a
  SPA: keyboard / screen-reader users hit Tab once and
  jump straight past the sidebar / header chrome to the
  page body. The CSS in wwwroot/css/app.css styles
  `.skip-link` so it stays invisible until focused.
*@
<a href="#main-content" class="skip-link">Skip to main content</a>

<AuthorizeView>
    <Authorized>
        <RadzenLayout>
            <RadzenHeader>
                <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0">
                    <RadzenColumn Size="3">
                        <RadzenSidebarToggle Click="@ToggleSidebar" aria-label="@L["NavToggleSidebar"]" />
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            <InboxBell />
                            <AppearanceToggle />
                            <LanguageSwitcher />
                            <RadzenProfileMenu Click="@ProfileMenuClick">
                                <ChildContent>
                                    <RadzenProfileMenuItem Path="account/api-tokens" Icon="key" Text="@L["NavApiTokens"]" />
                                    <RadzenProfileMenuItem Path="settings/two-factor" Icon="security" Text="@L["SettingsTwoFactor"]" />
                                    <RadzenProfileMenuItem Path="settings/appearance" Icon="palette" Text="@L["SettingsAppearance"]" />
                                    <RadzenProfileMenuItem Text="@L["AuthLogOut"]" Value="logout" Icon="power_settings_new" />
                                </ChildContent>
                                <Template>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" JustifyContent="JustifyContent.End" Class="rz-overflow-hidden">
                                        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.End" Gap="0">
                                            <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-default">
                                                @context.User.Identity?.Name
                                            </RadzenText>
                                            <RadzenText Text="@context.User.FindFirst(ClaimTypes.Email)?.Value" TextStyle="TextStyle.Caption" Class="rz-color-text-default" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </Template>
                            </RadzenProfileMenu>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenHeader>

            <RadzenSidebar Expanded="@sidebarExpanded">
                <RadzenStack AlignItems="AlignItems.Center" Class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding); border-bottom: var(--rz-panel-menu-item-border);">
                    <RadzenLink Path="" Text="@L["AppName"]" TextStyle="TextStyle.Subtitle1" />
                </RadzenStack>
                <RadzenPanelMenu>
                    <RadzenPanelMenuItem Text="@L["NavHome"]" Path="" Icon="home" />
                    <RadzenPanelMenuItem Text="@L["NavWorkspaces"]" Path="workspaces" Icon="workspaces" />
                    <RadzenPanelMenuItem Text="@L["NavInbox"]" Path="inbox" Icon="inbox" />
                    <RadzenPanelMenuItem Text="@L["NavCalendar"]" Path="calendar" Icon="event" />
                    <RadzenPanelMenuItem Text="@L["NavPlanner"]" Path="planner" Icon="view_timeline" />
                    <RadzenPanelMenuItem Text="@L["NavInvitations"]" Path="invitations" Icon="mail" />
                </RadzenPanelMenu>
                <RadzenStack AlignItems="AlignItems.Center" Gap="0" Class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding);">
                    <RadzenText Text="Cardscape v1.0.0" TextStyle="TextStyle.Caption" Class="rz-color-text-disabled" TagName="TagName.P" TextAlign="TextAlign.Center" />
                    <RadzenText Text="Copyright ? 2026" TextStyle="TextStyle.Caption" Class="rz-mb-0 rz-color-text-disabled" TagName="TagName.P" TextAlign="TextAlign.Center" />
                </RadzenStack>
            </RadzenSidebar>

            <RadzenBody Expanded="@sidebarExpanded">
                <RadzenRow Class="rz-mx-auto rz-px-4 rz-pt-2 rz-pt-md-4 rz-pt-lg-6 rz-pt-xl-12 rz-pb-2 rz-pb-lg-12" Style="max-width: 1440px;">
                    <RadzenColumn Size="12">
                        @* BETA-3-UI-#14 — see test-results/BETA-TEST-REPORT.md.
                           id="main-content" is the target of the
                           skip-link above. Keyboard / screen-reader
                           users land here on the first Tab press. *@
                        <main id="main-content" role="main">
                            @Body
                        </main>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenBody>
        </RadzenLayout>
    </Authorized>
    <NotAuthorized>
        <RadzenLayout>
            <RadzenHeader>
                <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0">
                    <RadzenColumn Size="6">
                        <RadzenLink Path="" Text="@L["AppName"]" TextStyle="TextStyle.Subtitle1" />
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            <LanguageSwitcher />
                            <RadzenButton Text="@L["AuthSignIn"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => Nav.NavigateTo("login"))" />
                            <RadzenButton Text="@L["AuthCreateAccount"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => Nav.NavigateTo("register"))" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenHeader>
            <RadzenBody Expanded="true">
                <RadzenRow Class="rz-mx-auto rz-px-4 rz-pt-2 rz-pt-md-4 rz-pt-lg-6 rz-pt-xl-12 rz-pb-2 rz-pb-lg-12" Style="max-width: 1440px;">
                    <RadzenColumn Size="12">
                        @Body
                    </RadzenColumn>
                </RadzenRow>
            </RadzenBody>
        </RadzenLayout>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool sidebarExpanded = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Read the saved culture from localStorage and
            // load the matching translations. Subsequent
            // changes are driven by LanguageSwitcher via
            // Culture.Changed.
            await Culture.InitializeAsync();
        }
    }

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
    }

    private void OnCultureChanged()
    {
        // Re-render the layout (and its children) so the
        // HttpBackedStringLocalizer picks up the new
        // translations. The Blazor diff renderer is
        // efficient — only the @L["…"] expressions re-evaluate.
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
    }

    void ToggleSidebar() => sidebarExpanded = !sidebarExpanded;

    async Task ProfileMenuClick(RadzenProfileMenuItem args)
    {
        if (args.Value == "logout")
        {
            await LogoutAsync();
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login", forceLoad: true);
    }
}

