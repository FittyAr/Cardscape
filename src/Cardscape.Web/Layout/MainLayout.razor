@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.Extensions.Localization
@inject AuthService Auth
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@inject CultureSwitcher Culture

@*
  BETA-3-UI-#14 — see test-results/BETA-TEST-REPORT.md.
  Skip-link is the single highest-impact a11y fix on a
  SPA: keyboard / screen-reader users hit Tab once and
  jump straight past the sidebar / header chrome to the
  page body. The CSS in wwwroot/css/app.css styles
  `.skip-link` so it stays invisible until focused.
*@
<a href="#main-content" class="skip-link">Skip to main content</a>

<AuthorizeView>
    <Authorized>
        <RadzenLayout>
            <RadzenHeader>
                <div class="cs-topbar">
                    <RadzenSidebarToggle Click="@ToggleSidebar" aria-label="@L["NavToggleSidebar"]" />
                    <a href="" class="cs-topbar-brand" aria-label="@L["AppName"]">
                        <BrandMark Size="22" />
                    </a>
                    <div class="cs-topbar-search">
                        <TopbarSearch />
                    </div>
                    <div class="cs-topbar-actions">
                        <InboxBell />
                        <AppearanceToggle />
                        <LanguageSwitcher />
                        <RadzenProfileMenu Click="@ProfileMenuClickAsync" class="cs-profile-menu">
                            <ChildContent>
                                <RadzenProfileMenuItem Path="settings/appearance" Icon="palette" Text="@L["SettingsAppearance"]" />
                                <RadzenProfileMenuItem Path="settings/two-factor" Icon="security" Text="@L["SettingsTwoFactor"]" />
                                <RadzenProfileMenuItem Path="account/api-tokens" Icon="key" Text="@L["NavApiTokens"]" />
                                <RadzenProfileMenuItem Text="@L["AuthLogOut"]" Value="logout" Icon="logout" />
                            </ChildContent>
                            <Template>
                                <span class="cs-profile">
                                    <span class="cs-avatar" aria-hidden="true">@UserInitials.From(context.User.Identity?.Name)</span>
                                    <span class="cs-profile-text">
                                        <span class="cs-profile-name">@context.User.Identity?.Name</span>
                                        <span class="cs-profile-email">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                                    </span>
                                </span>
                            </Template>
                        </RadzenProfileMenu>
                    </div>
                </div>
            </RadzenHeader>

            <RadzenSidebar Expanded="@sidebarExpanded" class="cs-sidebar">
                <RadzenPanelMenu>
                    <RadzenPanelMenuItem Text="@L["NavHome"]" Path="" Icon="home" />
                    <RadzenPanelMenuItem Text="@L["NavWorkspaces"]" Path="workspaces" Icon="space_dashboard" />
                    <RadzenPanelMenuItem Text="@L["NavInbox"]" Path="inbox" Icon="inbox" />
                    <RadzenPanelMenuItem Text="@L["NavCalendar"]" Path="calendar" Icon="calendar_month" />
                    <RadzenPanelMenuItem Text="@L["NavPlanner"]" Path="planner" Icon="view_timeline" />
                    <RadzenPanelMenuItem Text="@L["NavInvitations"]" Path="invitations" Icon="mail" />
                </RadzenPanelMenu>
                @if (context.User.FindFirst("is_admin")?.Value == "true")
                {
                    <div class="cs-sidebar-section">@L["NavAdministration"]</div>
                    <RadzenPanelMenu>
                        <RadzenPanelMenuItem Text="@L["NavUsers"]" Path="admin/users" Icon="manage_accounts" />
                        <RadzenPanelMenuItem Text="@L["NavSystemSettings"]" Path="admin/settings" Icon="tune" />
                        <RadzenPanelMenuItem Text="@L["NavSeeder"]" Path="admin/seeder" Icon="database" />
                    </RadzenPanelMenu>
                }
                <div class="cs-sidebar-footer">Cardscape @AppInfo.Version</div>
            </RadzenSidebar>

            <RadzenBody Expanded="@sidebarExpanded">
                <div class="cs-main">
                    @* BETA-3-UI-#14 — see test-results/BETA-TEST-REPORT.md.
                       id="main-content" is the target of the
                       skip-link above. Keyboard / screen-reader
                       users land here on the first Tab press. *@
                    <main id="main-content" role="main">
                        <InstanceNoticeBanner />
                        @* BETA-8-I18N-#3 — see test-results/r8/A8-settings.md.
                           The router-provided @Body is a RenderFragment
                           that is NOT re-invoked when the layout
                           re-renders. We mount the wrapper with a
                           key that we bump on every culture change;
                           the new wrapper receives a fresh @Body
                           and renders the page with the now-Spanish
                           dictionary. *@
                        @if (_bodyKey is not null)
                        {
                            <CultureReactiveBody @key="@_bodyKey">
                                @Body
                            </CultureReactiveBody>
                        }
                    </main>
                </div>
            </RadzenBody>
        </RadzenLayout>
    </Authorized>
    <NotAuthorized>
        <RadzenLayout>
            <RadzenHeader>
                <div class="cs-topbar">
                    <a href="" class="cs-topbar-brand" aria-label="@L["AppName"]">
                        <BrandMark Size="22" />
                    </a>
                    <div class="cs-topbar-search">
                        <TopbarSearch />
                    </div>
                    <div class="cs-topbar-actions">
                        <AppearanceToggle />
                        <LanguageSwitcher />
                        <RadzenButton Text="@L["AuthSignIn"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => Nav.NavigateTo("login"))" />
                        <RadzenButton Text="@L["AuthCreateAccount"]" ButtonStyle="ButtonStyle.Primary" Click="@(() => Nav.NavigateTo("register"))" />
                    </div>
                </div>
            </RadzenHeader>
            <RadzenBody Expanded="true">
                <div class="cs-main">
                    @Body
                </div>
            </RadzenBody>
        </RadzenLayout>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool sidebarExpanded = true;

    // BETA-8-I18N-#3 — see test-results/r8/A8-settings.md.
    // The @Body RenderFragment isn't re-invoked when the layout
    // re-renders. We toggle a key field whenever the culture
    // changes; the @if/_bodyKey below mounts a new wrapper, which
    // receives a fresh @Body and renders the page with the
    // current dictionary.
    private string? _bodyKey;
    private string? _mountedCulture;

    protected override void OnInitialized()
    {
        // BETA-SW-004 — see test-results/beta/round-2/sw-caching.md.
        // Seed _bodyKey in OnInitialized so the @Body
        // wrapper mounts on the first render. The
        // InitializeAsync step in OnAfterRenderAsync may
        // replace it with the saved culture once JS
        // interop is available.
        _mountedCulture = Culture.CurrentCulture;
        _bodyKey = $"body-{_mountedCulture}-{Guid.NewGuid():N}";
        Culture.Changed += OnCultureChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Read the saved culture from localStorage and
            // load the matching translations. Subsequent
            // changes are driven by LanguageSwitcher via
            // Culture.Changed.
            await Culture.InitializeAsync();
            // App.razor's router gate usually loaded the culture before
            // the first render; remount the page only if it changed,
            // otherwise the freshly shown screen would flicker.
            if (Culture.CurrentCulture != _mountedCulture)
            {
                _mountedCulture = Culture.CurrentCulture;
                _bodyKey = $"body-{_mountedCulture}-{Guid.NewGuid():N}";
                StateHasChanged();
            }
        }
    }

    private Task OnCultureChangedAsync()
    {
        // Re-create the body wrapper on every culture change. We
        // bump the key with a fresh GUID so Blazor's diff renderer
        // destroys the old CultureReactiveBody and mounts a new
        // one, which in turn re-invokes the @Body RenderFragment
        // with the now-Spanish dictionary.
        _mountedCulture = Culture.CurrentCulture;
        _bodyKey = $"body-{_mountedCulture}-{Guid.NewGuid():N}";
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Culture.Changed -= OnCultureChangedAsync;
    }

    void ToggleSidebar() => sidebarExpanded = !sidebarExpanded;

    private async Task ProfileMenuClickAsync(RadzenProfileMenuItem args)
    {
        if (args.Value == "logout")
        {
            await LogoutAsync();
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login", forceLoad: true);
    }
}
