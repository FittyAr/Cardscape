@using Microsoft.AspNetCore.Components.Authorization
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<SharedResource> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@L["AppName"]</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @L["NavHome"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="workspaces">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @L["NavWorkspaces"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="invitations">
                        <span class="bi bi-envelope-nav-menu" aria-hidden="true"></span> @L["NavInvitations"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="inbox">
                        <span class="bi bi-bell-nav-menu" aria-hidden="true"></span> @L["NavInbox"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="calendar">
                        <span class="bi bi-calendar-nav-menu" aria-hidden="true"></span> @L["NavCalendar"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="planner">
                        <span class="bi bi-roadmap-nav-menu" aria-hidden="true"></span> @L["NavPlanner"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/api-tokens">
                        <span class="bi bi-key-nav-menu" aria-hidden="true"></span> @L["NavApiTokens"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <InboxBell />
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @L["NavSignIn"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @L["NavCreateAccount"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}
