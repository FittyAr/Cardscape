@inherits LayoutComponentBase
@implements IDisposable
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject CultureSwitcher Culture

@*
    Auth / marketing chrome — brand panel + form stage.
    Used by login, register, and OAuth callback. Styled as a
    Radzen split layout: brand side on the left (primary
    background), form side on the right (paper background).

    The brand-column gradient, the form-column background, and
    the no-padding card override all live in
    `EmptyLayout.razor.css` (Blazor scoped CSS) so this file
    stays markup-only.

    BETA-8-I18N-#4 — see test-results/r8/A8-settings.md.
    MainLayout calls Culture.InitializeAsync() in
    OnAfterRenderAsync so the saved locale is loaded on every
    authed page. EmptyLayout must do the same, otherwise the
    auth screens (login, register, OAuth callback) always
    render in English even after the user has chosen Spanish
    in a previous session.
*@

<RadzenComponents />

<RadzenLayout Class="cs-empty-layout">
    <RadzenBody Expanded="true">
        <div class="cs-auth">
            <div class="cs-auth-card">
                <aside class="cs-auth-brand">
                    <a href="" class="cs-auth-brand-mark" aria-label="@L["AppName"]">
                        <BrandMark Size="28" ShowWordmark="false" />
                        <span>@L["AppName"]</span>
                    </a>
                    <p class="cs-auth-tagline">@L["AppTagline"]</p>
                    <ul class="cs-auth-points">
                        <li><RadzenIcon Icon="view_kanban" />@L["HomePointBoardsTitle"]</li>
                        <li><RadzenIcon Icon="dns" />@L["HomePointSelfHostTitle"]</li>
                        <li><RadzenIcon Icon="smart_toy" />@L["HomePointMcpTitle"]</li>
                    </ul>
                </aside>
                <main class="cs-auth-form" id="main-content">
                    @* BETA-8-I18N-#4 — see test-results/r8/A8-settings.md.
                       The @Body RenderFragment below is not re-invoked
                       when the layout re-renders. We wrap it in a
                       wrapper component and re-create the wrapper via
                       an @if that flips whenever the culture changes. *@
                    @if (_bodyKey is not null)
                    {
                        <CultureReactiveBody @key="@_bodyKey">
                            @Body
                        </CultureReactiveBody>
                    }
                </main>
            </div>
            <p class="cs-auth-footer">Cardscape @AppInfo.Version</p>
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    // BETA-8-I18N-#4 — see test-results/r8/A8-settings.md.
    // The @Body RenderFragment isn't re-invoked when the layout
    // re-renders. We toggle a key field whenever the culture
    // changes; the @if/_bodyKey below mounts a new wrapper, which
    // receives a fresh @Body and renders the page with the
    // current dictionary.
    private string? _bodyKey;

    protected override void OnInitialized()
    {
        // BETA-SW-004 — see test-results/beta/round-2/sw-caching.md.
        // The first render needs _bodyKey non-null so the
        // @Body wrapper mounts immediately. The default
        // culture is "en" (CultureSwitcher.DefaultCulture),
        // so we seed with a "default" key; InitializeAsync
        // may replace it with the saved culture once JS
        // interop is available.
        _bodyKey = $"body-default-{Guid.NewGuid():N}";
        Culture.Changed += OnCultureChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load the saved culture from localStorage. Without this
            // call the auth screens (login, register, OAuth callback)
            // always render in English even after the user has chosen
            // a different language in a previous session — see
            // BETA-8-I18N-#4 in test-results/r8/A8-settings.md.
            await Culture.InitializeAsync();
            _bodyKey = $"body-{Culture.CurrentCulture}-{Guid.NewGuid():N}";
        }
    }

    public void Dispose()
    {
        Culture.Changed -= OnCultureChangedAsync;
        GC.SuppressFinalize(this);
    }

    private Task OnCultureChangedAsync()
    {
        // Re-create the body wrapper on every culture change. We
        // bump the key with a fresh GUID so Blazor's diff renderer
        // destroys the old CultureReactiveBody and mounts a new
        // one, which in turn re-invokes the @Body RenderFragment
        // with the now-Spanish dictionary.
        _bodyKey = $"body-{Culture.CurrentCulture}-{Guid.NewGuid():N}";
        return InvokeAsync(StateHasChanged);
    }
}
