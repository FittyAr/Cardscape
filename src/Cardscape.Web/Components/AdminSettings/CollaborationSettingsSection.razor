@namespace Cardscape.Web.Components.AdminSettings

<RadzenTabs RenderMode="TabRenderMode.Client">
    <Tabs>
        @* 4.1 Comentarios y Menciones *@
        <RadzenTabsItem Text="Comentarios y Menciones" Icon="forum">
            <RadzenCard Class="rz-p-4">
                <RadzenStack Gap="1.25rem">
                    <RadzenText Text="Políticas de Discusión, Menciones y Moderación" TextStyle="@TextStyle.H6" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenText Text="Permitir Edición de Comentarios Propios" TextStyle="@TextStyle.Subtitle2" />
                        <RadzenSwitch @bind-Value="Model.AllowCommentEditing" />
                    </RadzenStack>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenText Text="Permitir Eliminación de Comentarios Propios" TextStyle="@TextStyle.Subtitle2" />
                        <RadzenSwitch @bind-Value="Model.AllowCommentDeletion" />
                    </RadzenStack>

                    <RadzenFormField Text="Longitud Máxima por Comentario (Caracteres)" Component="maxComment">
                        <RadzenNumeric @bind-Value="Model.MaxCommentLength" Name="maxComment" Min="50" Max="20000" Style="width:100%" />
                    </RadzenFormField>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Permitir Menciones de Usuarios (@@usuario)" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Despacha notificaciones directas al etiquetar miembros en comentarios y descripciones."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.AllowUserMentions" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenTabsItem>

        @* 4.2 Campos y Automatizaciones *@
        <RadzenTabsItem Text="Campos y Automatizaciones" Icon="auto_fix_high">
            <RadzenCard Class="rz-p-4">
                <RadzenStack Gap="1.25rem">
                    <RadzenText Text="Metadatos Personalizados y Reglas de Automatización" TextStyle="@TextStyle.H6" />

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Etiquetas Máximas por Tablero" Component="maxLabelsBoard" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxLabelsPerBoard" Name="maxLabelsBoard" Min="1" Max="100" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Etiquetas Máximas por Tarjeta" Component="maxLabelsCard" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxLabelsPerCard" Name="maxLabelsCard" Min="1" Max="50" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Campos Personalizados en Tableros" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Permite definir campos adicionales estructurados (número, texto, fecha, desplegable) por tablero."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.CustomFieldsEnabled" />
                    </RadzenStack>

                    @if (Model.CustomFieldsEnabled)
                    {
                        <RadzenFormField Text="Campos Personalizados Máximos por Tablero" Component="maxCustom">
                            <RadzenNumeric @bind-Value="Model.MaxCustomFieldsPerBoard" Name="maxCustom" Min="1" Max="50" Style="width:100%" />
                        </RadzenFormField>
                    }

                    <RadzenText Text="Motor de Reglas de Automatización de Tableros" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Motor de Automatización (Triggers y Acciones)" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Ejecuta acciones automáticas (asignar, mover tarjeta, archivar) al cumplirse condiciones en el tablero."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.BoardAutomationEnabled" />
                    </RadzenStack>

                    @if (Model.BoardAutomationEnabled)
                    {
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Reglas Máximas por Tablero" Component="maxRules" Style="width:100%">
                                    <RadzenNumeric @bind-Value="Model.MaxAutomationRulesPerBoard" Name="maxRules" Min="1" Max="50" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Acciones Máximas por Regla" Component="maxActions" Style="width:100%">
                                    <RadzenNumeric @bind-Value="Model.MaxAutomationActionsPerRule" Name="maxActions" Min="1" Max="20" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Cuota Mensual de Ejecuciones por Usuario" Component="autoQuota" Style="width:100%">
                                    <RadzenNumeric @bind-Value="Model.AutomationMonthlyRunQuotaPerUser" Name="autoQuota" Min="10" Max="50000" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Timeout de Ejecución por Regla (Segundos)" Component="autoTimeout" Style="width:100%">
                                    <RadzenNumeric @bind-Value="Model.AutomationTimeoutSeconds" Name="autoTimeout" Min="1" Max="120" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenStack>
            </RadzenCard>
        </RadzenTabsItem>

        @* 4.3 Notificaciones y Enlaces *@
        <RadzenTabsItem Text="Notificaciones y Webhooks" Icon="notifications_active">
            <RadzenCard Class="rz-p-4">
                <RadzenStack Gap="1.25rem">
                    <RadzenText Text="Centro de Notificaciones y Alertas" TextStyle="@TextStyle.H6" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenText Text="Habilitar Notificaciones Internas en la App (In-App)" TextStyle="@TextStyle.Subtitle2" />
                        <RadzenSwitch @bind-Value="Model.InAppNotificationsEnabled" />
                    </RadzenStack>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Umbral para Alerta de Vencimiento Próximo (Horas)" Component="dueSoon" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.DueSoonThresholdHours" Name="dueSoon" Min="1" Max="168" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Retención de Notificaciones Leídas (Días)" Component="notifRet" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.NotificationRetentionDays" Name="notifRet" Min="1" Max="365" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenText Text="Notificar al Asignar Tarjeta" TextStyle="@TextStyle.Subtitle2" />
                                <RadzenSwitch @bind-Value="Model.NotifyOnCardAssignment" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenText Text="Notificar al Recibir Mención" TextStyle="@TextStyle.Subtitle2" />
                                <RadzenSwitch @bind-Value="Model.NotifyOnCardMention" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenText Text="Notificar Tarjetas Próximas a Vencer" TextStyle="@TextStyle.Subtitle2" />
                                <RadzenSwitch @bind-Value="Model.NotifyOnDueSoon" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenText Text="Notificar Tarjetas Vencidas" TextStyle="@TextStyle.Subtitle2" />
                                <RadzenSwitch @bind-Value="Model.NotifyOnOverdue" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenText Text="Notificaciones Web Push (VAPID)" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Web Push Notifications en Navegadores" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Permite entregar notificaciones push nativas incluso con la pestaña del navegador cerrada."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.EnableWebPushNotifications" />
                    </RadzenStack>

                    @if (Model.EnableWebPushNotifications)
                    {
                        <RadzenFormField Text="Sujeto VAPID (mailto: o https:)" Component="vapidSub">
                            <RadzenTextBox @bind-Value="Model.VapidSubject" Name="vapidSub" Style="width:100%" />
                        </RadzenFormField>
                        <RadzenFormField Text="Clave Pública VAPID" Component="vapidPub">
                            <RadzenTextBox @bind-Value="Model.VapidPublicKey" Name="vapidPub" Style="width:100%" />
                        </RadzenFormField>
                        <RadzenFormField Text="Clave Privada VAPID (dejar en blanco o '******' para mantener)" Component="vapidPriv">
                            <RadzenPassword @bind-Value="Model.VapidPrivateKey" Name="vapidPriv" Placeholder="******" Style="width:100%" />
                        </RadzenFormField>
                    }

                    <RadzenText Text="Webhooks Salientes y Disparo de Eventos" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenText Text="Habilitar Suscripciones a Webhooks Salientes" TextStyle="@TextStyle.Subtitle2" />
                        <RadzenSwitch @bind-Value="Model.WebhooksEnabled" />
                    </RadzenStack>

                    @if (Model.WebhooksEnabled)
                    {
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Reintentos Máximos de Entrega" Component="whRetries" Style="width:100%">
                                    <RadzenNumeric @bind-Value="Model.MaxWebhookRetries" Name="whRetries" Min="0" Max="10" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Timeout de Petición HTTP (Segundos)" Component="whTimeout" Style="width:100%">
                                    <RadzenNumeric @bind-Value="Model.WebhookTimeoutSeconds" Name="whTimeout" Min="1" Max="60" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                            <RadzenText Text="Firmar Carga Útil con HMAC SHA-256 (X-Cardscape-Signature)" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenSwitch @bind-Value="Model.WebhookPayloadSignatureEnabled" />
                        </RadzenStack>
                    }
                </RadzenStack>
            </RadzenCard>
        </RadzenTabsItem>

        @* 4.4 Tiempo Real y Búsqueda *@
        <RadzenTabsItem Text="Tiempo Real y Búsqueda" Icon="sync">
            <RadzenCard Class="rz-p-4">
                <RadzenStack Gap="1.25rem">
                    <RadzenText Text="Sincronización Bidireccional y Presencia en Vivo" TextStyle="@TextStyle.H6" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Difusión de Eventos en Tiempo Real (SignalR Hubs)" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Transmite cambios de tarjetas, listas y comentarios a los clientes conectados de manera inmediata sin recargar."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.RealtimeBroadcastingEnabled" />
                    </RadzenStack>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Indicadores de Presencia de Usuarios Concurrentes" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Muestra qué compañeros de equipo están visualizando o editando el mismo tablero simultáneamente."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.RealtimePresenceEnabled" />
                    </RadzenStack>

                    <RadzenText Text="Motor de Búsqueda e Indexación Global" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Longitud Mínima de Término de Búsqueda" Component="minSearch" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.SearchMinQueryLength" Name="minSearch" Min="1" Max="10" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Resultados Máximos por Página de Búsqueda" Component="maxSearch" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.SearchMaxPageSize" Name="maxSearch" Min="10" Max="100" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Coincidencia Difusa (Fuzzy Search / Trigram)" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Permite localizar tarjetas incluso con faltas ortográficas o caracteres omitidos."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.SearchFuzzyMatching" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    [Parameter, EditorRequired]
    public SettingsFormModel Model { get; set; } = default!;
}
