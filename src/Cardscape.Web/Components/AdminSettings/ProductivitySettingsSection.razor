@namespace Cardscape.Web.Components.AdminSettings

<RadzenTabs RenderMode="TabRenderMode.Client">
    <Tabs>
        @* 3.1 Espacios y Tableros *@
        <RadzenTabsItem Text="Espacios y Tableros" Icon="workspaces">
            <RadzenCard Class="rz-p-4">
                <RadzenStack Gap="1.25rem">
                    <RadzenText Text="Límites, Permisos y Plantillas de Espacios y Tableros" TextStyle="@TextStyle.H6" />

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Espacios Máximos por Usuario (0 = Ilimitado)" Component="maxWs" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxWorkspacesPerUser" Name="maxWs" Min="0" Max="1000" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Tableros Máximos por Espacio (0 = Ilimitado)" Component="maxBoards" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxBoardsPerWorkspace" Name="maxBoards" Min="0" Max="1000" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Miembros Máximos por Espacio (0 = Ilimitado)" Component="maxMembers" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxMembersPerWorkspace" Name="maxMembers" Min="0" Max="10000" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Rol Predeterminado en Espacios" Component="defRole" Style="width:100%">
                                <RadzenDropDown @bind-Value="Model.DefaultWorkspaceRole" Data="@AdminSettingsOptions.WorkspaceRoles" Name="defRole" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Caducidad de Invitaciones (Días)" Component="invDays" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.InvitationExpirationDays" Name="invDays" Min="1" Max="90" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Permitir Tableros Públicos (Accesibles sin autenticación)" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Si está desactivado, todos los tableros requieren ser miembro del espacio para ser visualizados."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.AllowPublicBoards" />
                    </RadzenStack>

                    <RadzenText Text="Plantillas de Tableros" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Catálogo de Plantillas Públicas" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Permite a los usuarios seleccionar plantillas estándar preconfiguradas al crear tableros."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.EnablePublicBoardTemplates" />
                    </RadzenStack>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Permitir Creación de Plantillas Personalizadas" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Permite a los usuarios guardar sus propios tableros como plantillas reutilizables del espacio."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.AllowCustomUserTemplates" />
                    </RadzenStack>

                    <RadzenText Text="Límites de Longitud de Nombres y Descripciones" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Longitud Máx. Nombre de Espacio" Component="maxWsName" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxWorkspaceNameLength" Name="maxWsName" Min="10" Max="255" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Longitud Máx. Nombre de Tablero" Component="maxBoardName" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxBoardNameLength" Name="maxBoardName" Min="10" Max="255" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Longitud Máx. Nombre de Lista" Component="maxListName" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxListNameLength" Name="maxListName" Min="10" Max="255" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Longitud Máx. Nombre Visible Usuario" Component="maxDispName" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxDisplayNameLength" Name="maxDispName" Min="10" Max="150" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Longitud Máx. Descripción Tablero" Component="maxBoardDesc" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxBoardDescriptionLength" Name="maxBoardDesc" Min="100" Max="10000" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenCard>
        </RadzenTabsItem>

        @* 3.2 Tarjetas y Listas *@
        <RadzenTabsItem Text="Tarjetas y Listas" Icon="view_kanban">
            <RadzenCard Class="rz-p-4">
                <RadzenStack Gap="1.25rem">
                    <RadzenText Text="Productividad, Límites de Flujo (WIP) y Recurrencia" TextStyle="@TextStyle.H6" />

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Límite WIP Predeterminado por Lista (0 = Desactivado)" Component="defaultWip" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.DefaultWipLimit" Name="defaultWip" Min="0" Max="100" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween" Class="rz-pt-3">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Forzar Bloqueo Estricto de Límites WIP" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Impide mover o crear tarjetas en columnas que hayan alcanzado su capacidad máxima."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="Model.EnforceWipLimits" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Resaltar Visualmente Listas con Límite WIP Excedido" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Aplica un borde de alerta a las columnas que superan el límite WIP configurado."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.HighlightOverLimitLists" />
                    </RadzenStack>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Permitir Tarjetas Espejo (Card Mirroring)" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Permite sincronizar una tarjeta en múltiples tableros simultáneamente."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.AllowCardMirroring" />
                    </RadzenStack>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Posposición de Tarjetas (Card Snoozing)" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Oculta temporalmente una tarjeta del tablero hasta una fecha y hora programada."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.AllowCardSnoozing" />
                    </RadzenStack>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Permitir Sistema de Votación en Tarjetas" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Habilita que los miembros emitan votos de prioridad en las tarjetas."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.AllowCardVoting" />
                    </RadzenStack>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Votos Máximos por Usuario por Tarjeta" Component="maxVotes" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxVotesPerUserPerCard" Name="maxVotes" Min="1" Max="100" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Listas de Verificación Máx. por Tarjeta" Component="maxChecklists" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxChecklistsPerCard" Name="maxChecklists" Min="1" Max="50" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenText Text="Motor de Tarjetas Recurrentes" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Creación Periódica de Tarjetas Recurrentes" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Genera tarjetas automáticamente con frecuencias programadas (diarias, semanales, mensuales)."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.CardRecurrenceEnabled" />
                    </RadzenStack>

                    @if (Model.CardRecurrenceEnabled)
                    {
                        <RadzenFormField Text="Intervalo Máximo de Recurrencia Permitido (Días)" Component="maxRecDays">
                            <RadzenNumeric @bind-Value="Model.MaxRecurrenceIntervalDays" Name="maxRecDays" Min="1" Max="730" Style="width:100%" />
                        </RadzenFormField>
                    }

                    <RadzenText Text="Límites y Tamaños de Contenido de Tarjetas" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Longitud Máx. Título de Tarjeta" Component="maxCardTitle" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxCardTitleLength" Name="maxCardTitle" Min="20" Max="1000" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Longitud Máx. Elemento Checklist" Component="maxCheckItem" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxChecklistItemLength" Name="maxCheckItem" Min="20" Max="2000" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Longitud Máx. Descripción de Tarjeta" Component="maxCardDesc" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxCardDescriptionLength" Name="maxCardDesc" Min="500" Max="65536" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Adjuntos Máximos por Tarjeta" Component="maxCardAttach" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.MaxAttachmentsPerCard" Name="maxCardAttach" Min="1" Max="200" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenCard>
        </RadzenTabsItem>

        @* 3.3 Control de Tiempo y Envejecimiento *@
        <RadzenTabsItem Text="Tiempo y Envejecimiento" Icon="hourglass_bottom">
            <RadzenCard Class="rz-p-4">
                <RadzenStack Gap="1.25rem">
                    <RadzenText Text="Control de Tiempo y Estimaciones (Time Tracking)" TextStyle="@TextStyle.H6" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Registro de Tiempo en Tarjetas" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Permite registrar horas trabajadas y comparar con el tiempo estimado en cada tarea."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.EnableTimeTracking" />
                    </RadzenStack>

                    @if (Model.EnableTimeTracking)
                    {
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Unidad de Medida de Tiempo" Component="timeUnit" Style="width:100%">
                                    <RadzenDropDown @bind-Value="Model.TimeTrackingUnit" Data="@AdminSettingsOptions.TimeUnits" Name="timeUnit" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween" Class="rz-pt-3">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenText Text="Exigir Estimación de Tiempo" TextStyle="@TextStyle.Subtitle2" />
                                        <RadzenText Text="Obliga a indicar un tiempo estimado antes de registrar horas dedicadas."
                                                    TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                    </RadzenStack>
                                    <RadzenSwitch @bind-Value="Model.EnforceTimeTrackingEstimates" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    }

                    <RadzenText Text="Degradación Visual de Tarjetas Inactivas (Card Aging)" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Envejecimiento Visual de Tarjetas" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Atenúa o degrada visualmente las tarjetas que llevan tiempo sin actividad reciente."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.CardAgingEnabled" />
                    </RadzenStack>

                    @if (Model.CardAgingEnabled)
                    {
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Días de Inactividad para Activar Envejecimiento" Component="agingDays" Style="width:100%">
                                    <RadzenNumeric @bind-Value="Model.CardAgingInactiveDays" Name="agingDays" Min="1" Max="365" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Modo de Degradación Visual" Component="agingMode" Style="width:100%">
                                    <RadzenDropDown @bind-Value="Model.CardAgingMode" Data="@AdminSettingsOptions.AgingModes" Name="agingMode" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenStack>
            </RadzenCard>
        </RadzenTabsItem>

        @* 3.4 Vistas y Dashboards *@
        <RadzenTabsItem Text="Vistas y Dashboards" Icon="dashboard">
            <RadzenCard Class="rz-p-4">
                <RadzenStack Gap="1.25rem">
                    <RadzenText Text="Vistas Alternativas de Tablero" TextStyle="@TextStyle.H6" />

                    <RadzenFormField Text="Vista Predeterminada del Tablero" Component="defaultView" Style="width:100%">
                        <RadzenDropDown @bind-Value="Model.DefaultBoardView" Data="@AdminSettingsOptions.BoardViews" Name="defaultView" Style="width:100%" />
                    </RadzenFormField>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Vista Cronograma / Línea de Tiempo (Timeline)" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Permite visualizar las tarjetas en formato Gantt y dependencias temporales."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.EnableTimelineView" />
                    </RadzenStack>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Vista Calendario" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Muestra tarjetas en cuadrícula mensual/semanal según sus fechas de vencimiento."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.EnableCalendarView" />
                    </RadzenStack>

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Vista Tabla / Hoja de Cálculo" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Presenta las tarjetas como filas ordenables y filtrables para edición rápida."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.EnableTableView" />
                    </RadzenStack>

                    <RadzenText Text="Dashboards de Rendimiento y Dashcards de Métricas" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                    <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="Habilitar Widgets y Dashboards de Métricas por Tablero" TextStyle="@TextStyle.Subtitle2" />
                            <RadzenText Text="Permite añadir dashcards visuales de tarjetas vencidas, distribución por miembro, listas y etiquetas."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                        </RadzenStack>
                        <RadzenSwitch @bind-Value="Model.EnableDashboards" />
                    </RadzenStack>

                    @if (Model.EnableDashboards)
                    {
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Dashcards Máximas por Tablero" Component="maxCards" Style="width:100%">
                                    <RadzenNumeric @bind-Value="Model.MaxDashcardsPerBoard" Name="maxCards" Min="1" Max="50" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Intervalo de Refresco de Métricas (Segundos)" Component="refSecs" Style="width:100%">
                                    <RadzenNumeric @bind-Value="Model.DashboardRefreshIntervalSeconds" Name="refSecs" Min="5" Max="600" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenStack>
            </RadzenCard>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    [Parameter, EditorRequired]
    public SettingsFormModel Model { get; set; } = default!;
}
