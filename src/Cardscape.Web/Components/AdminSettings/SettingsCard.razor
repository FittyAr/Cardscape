@* SettingsCard — one titled group of settings: heading, optional
   explanation and the fields. Every settings panel is built from these. *@

<RadzenCard Variant="Variant.Outlined" class="rz-p-4">
    <RadzenStack Gap="1rem">
        <RadzenStack Gap="0.25rem">
            <RadzenText Text="@Title" TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0" />
            @if (!string.IsNullOrEmpty(Description))
            {
                <RadzenText Text="@Description" TextStyle="TextStyle.Body2" class="rz-color-text-secondary rz-m-0" />
            }
        </RadzenStack>
        @ChildContent
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Description { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
