@using System.Globalization
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject ISeederApiClient Seeder
@inject DialogService DialogService
@inject AuthService Auth
@inject NavigationManager Nav
@implements IAsyncDisposable

@*
  SeederConsole — runs the demo-data seeder and streams its log and
  table counts. Lives in the "Seeder" tab of System settings, which is
  only shown while the seeder is enabled (the on/off switch sits in the
  System tab), so this component assumes the endpoints are reachable.
*@

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center"
                     JustifyContent="@JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="@FlexWrap.Wrap">
            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" Gap="0.5rem">
                <RadzenBadge BadgeStyle="@((_options?.Enabled == true || _status?.Enabled == true) ? BadgeStyle.Info : BadgeStyle.Danger)" Text="@StatusBadge" />
                @if (_options?.WipeBeforeSeed == true)
                {
                    <RadzenBadge BadgeStyle="@BadgeStyle.Warning" Text="@L["SeederWipeOnSeed"]" />
                }
            </RadzenStack>
            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" Gap="0.5rem" Wrap="@FlexWrap.Wrap">
                <RadzenButton Text="@L["SeederRun"]" Icon="play_arrow" ButtonStyle="@ButtonStyle.Primary"
                              Disabled="@ActionsDisabled" Click="@(() => RunAsync(wipe:false))" />
                <RadzenButton Text="@L["SeederForceReseed"]" Icon="refresh" ButtonStyle="@ButtonStyle.Danger"
                              Disabled="@ActionsDisabled" Click="@(() => RunAsync(wipe:true))" />
                <RadzenButton Text="@L["SeederWipe"]" Icon="delete_sweep" ButtonStyle="@ButtonStyle.Warning"
                              Disabled="@ActionsDisabled" Click="@WipeAsync" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @if (_completed is DestructiveRun.WipeOnly)
    {
        <RadzenAlert AlertStyle="@AlertStyle.Warning" Variant="@Variant.Flat" Shade="@Shade.Lighter" AllowClose="false"
                     Icon="restart_alt" Title="@L["SeederWipedTitle"]" class="rz-m-0">
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="@L["SeederWipedMessage"]" TextStyle="@TextStyle.Body2" class="rz-m-0" />
                <RadzenButton Text="@L["SeederGoToSetup"]" Icon="rocket_launch" ButtonStyle="@ButtonStyle.Warning"
                              Click="@(() => SignOutToAsync("/setup"))" class="rz-align-self-start" />
            </RadzenStack>
        </RadzenAlert>
    }
    else if (_options?.DemoAccount is { } demo)
    {
        @if (_completed is DestructiveRun.WipeAndSeed)
        {
            <DemoAccountNotice Account="@demo" AlertStyle="@AlertStyle.Success" Icon="check_circle"
                               Title="@L["SeederReseededTitle"]" Message="@L["SeederReseededMessage"]">
                <Actions>
                    <RadzenButton Text="@L["SeederSignInAsDemo"]" Icon="login" ButtonStyle="@ButtonStyle.Success"
                                  Click="@(() => SignOutToAsync("/login"))" />
                </Actions>
            </DemoAccountNotice>
        }
        else
        {
            <DemoAccountNotice Account="@demo" Title="@L["SeederDemoAccountTitle"]" Message="@L["SeederDemoAccountMessage"]" />
        }
    }

    @if (_error is not null)
    {
        <RadzenAlert AlertStyle="@AlertStyle.Danger" ShowIcon="true" Close="@(() => _error = null)">
            <RadzenText TextStyle="@TextStyle.Body2">@_error</RadzenText>
        </RadzenAlert>
    }

    @if (_initialLoading)
    {
        <LoadingState Size="LoadingSize.Page" />
    }
    else
    {
        <RadzenTabs RenderMode="@TabRenderMode.Client" Class="rz-w-100">
            <Tabs>
                <RadzenTabsItem Text="@L["SeederLog"]" Icon="terminal">
                    <RadzenCard Class="rz-p-4 rz-mt-2">
                        <RadzenStack Gap="0.75rem">
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween" Wrap="@FlexWrap.Wrap" Gap="0.5rem">
                                <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" Gap="0.5rem">
                                    <RadzenText TextStyle="@TextStyle.H5" TagName="@TagName.H3" Class="rz-m-0">@L["SeederLog"]</RadzenText>
                                    <RadzenBadge BadgeStyle="@BadgeStyle.Light" Text="@L["SeederLogLines", _entries.Count]" />
                                </RadzenStack>
                                <RadzenText TextStyle="@TextStyle.Caption" class="rz-color-text-secondary">
                                    @StepLine
                                </RadzenText>
                            </RadzenStack>
                            <RadzenProgressBar Value="@ProgressValue" Max="100" Class="seeder-progress" />
                            <div class="seeder-log" role="log" aria-live="polite" aria-label="@L["SeederLog"]">
                                @if (_entries.Count == 0)
                                {
                                    <span class="rz-color-text-secondary">@L["SeederLogEmpty"]</span>
                                }
                                else
                                {
                                    @foreach (var entry in _entries)
                                    {
                                        <div class="seeder-log-entry">
                                            <span class="seeder-log-time">@entry.At.ToLocalTime().ToString("HH:mm:ss")</span>
                                            <span class="@LevelClass(entry.Level)">@entry.Level.ToUpperInvariant()</span>
                                            <span class="seeder-log-step">@entry.Step</span>
                                            <span class="seeder-log-message">@entry.Message</span>
                                        </div>
                                    }
                                }
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenTabsItem>

                <RadzenTabsItem Text="@L["SeederTableStatus"]" Icon="table_chart">
                    <RadzenCard Class="rz-p-4 rz-mt-2">
                        <RadzenStack Gap="0.75rem">
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween" Wrap="@FlexWrap.Wrap" Gap="0.5rem">
                                <RadzenText TextStyle="@TextStyle.H5" TagName="@TagName.H3" Class="rz-m-0">@L["SeederTableStatus"]</RadzenText>
                                <RadzenText TextStyle="@TextStyle.Caption" class="rz-color-text-secondary">
                                    @TableSummary
                                </RadzenText>
                            </RadzenStack>
                            @if (_tables.Count == 0)
                            {
                                <RadzenText TextStyle="@TextStyle.Body2" class="rz-color-text-secondary">@L["SeederNoTables"]</RadzenText>
                            }
                            else
                            {
                                <div class="seeder-table-scroll">
                                    <RadzenDataGrid Data="@_tables" TItem="SeederTableStatusDto"
                                                    AllowSorting="false" AllowPaging="false"
                                                    Density="@Density.Compact">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="SeederTableStatusDto" Property="Aggregate" Title="@L["SeederTableAggregate"]" />
                                            <RadzenDataGridColumn TItem="SeederTableStatusDto" Property="Key" Title="@L["SeederTableTable"]">
                                                <Template Context="row">
                                                    <code>@row.Key</code>
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="SeederTableStatusDto" Property="Rows" Title="@L["SeederTableRows"]" Width="6rem">
                                                <Template Context="row">
                                                    <span class="seeder-row-count">@row.Rows</span>
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                </div>
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
</RadzenStack>

@code {
    private SeederStatusDto? _status;
    private SeederOptionsDto? _options;
    private List<SeederLogEntryDto> _entries = new();
    private List<SeederTableStatusDto> _tables = new();
    private bool _initialLoading = true;
    private bool _busy;
    private string? _error;
    private CancellationTokenSource? _pollCts;

    // A wipe deletes every account, the operator's included; once such a
    // run finishes the page tells them how to get back in.
    private DestructiveRun? _pending;
    private DestructiveRun? _completed;

    private enum DestructiveRun
    {
        WipeAndSeed,
        WipeOnly,
    }
    private Task? _pollTask;

    private bool ActionsDisabled => _busy || _options is null || !_options.Enabled;

    private string StatusBadge => _status is null
        ? "—"
        : (!_options?.Enabled ?? true) && !_status.Enabled
            ? L["SeederStatusDisabled"]
            : _status.Running
                ? L["SeederStatusRunning"]
                : _status.Report.Status switch
                {
                    "Succeeded" or "Wiped" => L["SeederStatusSucceeded"],
                    var s when s.StartsWith("Failed", StringComparison.Ordinal) => L["SeederStatusFailed"],
                    _ => L["SeederStatusIdle"]
                };

    private string StepLine
    {
        get
        {
            if (_status is null) { return string.Empty; }
            var r = _status.Report;
            if (r.TotalSteps <= 0) { return L["SeederNoRun"]; }
            var name = r.CurrentStepName ?? string.Empty;
            return $"{r.CurrentStep} / {r.TotalSteps} — {name}";
        }
    }

    private int ProgressValue => _status is null || _status.Report.TotalSteps <= 0
        ? 0
        : Math.Clamp((int)Math.Round(100.0 * _status.Report.CurrentStep / _status.Report.TotalSteps), 0, 100);

    private string TableSummary => L["SeederTableSummaryText", _tables.Count, _tables.Sum(t => t.Rows)];

    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // Leaving the tab while the first load is in flight disposes the
        // component; starting the poll loop then would leak it.
        if (_disposed)
        {
            return;
        }

        _pollCts = new CancellationTokenSource();
        _pollTask = PollAsync(_pollCts.Token);
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            ApiResult<SeederOptionsDto> options = await Seeder.GetOptionsAsync();
            if (options.IsSuccess)
            {
                _options = options.Value;
            }
            else if (options.Error is not null && ContainsDisabled(options.Error))
            {
                // Server returned 404; the toggle is off. The
                // page should still render but every action
                // button must end up disabled. We render with
                // a flag the operator can read on the
                // status badge.
                _options = null;
            }

            ApiResult<SeederStatusDto> status = await Seeder.GetStatusAsync();
            if (status.IsSuccess)
            {
                await ApplyStatusAsync(status.Value!);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _initialLoading = false;
        }
    }

    private async Task PollAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                ApiResult<SeederStatusDto> status = await Seeder.GetStatusAsync(ct);
                if (status.IsSuccess)
                {
                    await ApplyStatusAsync(status.Value!);
                }
            }
            catch (OperationCanceledException) { return; }
            catch
            {
                // Network blip; keep the last good snapshot
                // on screen and try again next tick.
            }

            try
            {
                // Poll faster while a run is in flight so the
                // progress bar and log feel live; back off
                // once the runner is idle.
                int delayMs = (_status?.Running ?? false) ? 700 : 3_000;
                await Task.Delay(delayMs, ct);
            }
            catch (OperationCanceledException) { return; }
        }
    }

    private async Task ApplyStatusAsync(SeederStatusDto status)
    {
        _status = status;
        if (_pending is { } pending && !status.Running && status.Report.Status is "Succeeded" or "Wiped")
        {
            (_completed, _pending) = (pending, null);
        }
        // The endpoints return every log entry the
        // server has ever emitted. A full seed run is
        // ~80 entries; the full live grid is the
        // operator's view, so we render verbatim.
        _entries = status.Report.Entries.OrderBy(e => e.At).ToList();
        _tables = status.Report.Tables.OrderBy(t => t.Key, StringComparer.OrdinalIgnoreCase).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunAsync(bool wipe)
    {
        if (_busy) { return; }
        if (wipe && !await ConfirmAsync(L["SeederReseedConfirm", DemoEmail, DemoPassword], L["SeederForceReseed"]))
        {
            return;
        }

        _busy = true;
        _completed = null;
        _error = null;
        try
        {
            ApiResult<SeederRunAcceptedDto> r = await Seeder.RunAsync(wipe, ct: default);
            if (!r.IsSuccess)
            {
                _error = TranslateError(r.Error);
            }
            else if (r.Value?.Wipe == true)
            {
                _pending = DestructiveRun.WipeAndSeed;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task WipeAsync()
    {
        if (_busy) { return; }

        if (!await ConfirmAsync(L["SeederWipeConfirm"], L["SeederWipe"]))
        {
            return;
        }

        _busy = true;
        _completed = null;
        _error = null;
        try
        {
            ApiResult<SeederWipeAcceptedDto> r = await Seeder.WipeAsync(ct: default);
            if (!r.IsSuccess)
            {
                _error = TranslateError(r.Error);
            }
            else
            {
                _pending = DestructiveRun.WipeOnly;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string DemoEmail => _options?.DemoAccount?.Email ?? string.Empty;

    private string DemoPassword => _options?.DemoAccount?.Password ?? string.Empty;

    private async Task<bool> ConfirmAsync(string message, string okText) =>
        await DialogService.Confirm(
            message,
            L["SeederWipeConfirmTitle"],
            new ConfirmOptions { OkButtonText = okText, CancelButtonText = L["CommonCancel"] }) == true;

    /// <summary>The operator's account no longer exists after a wipe: drop the stale session and go on.</summary>
    private async Task SignOutToAsync(string path)
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo(path, forceLoad: true);
    }

    private string TranslateError(string? raw)
    {
        if (string.IsNullOrEmpty(raw)) { return L["CommonError"]; }
        if (raw.Contains("seeder.already_running", StringComparison.OrdinalIgnoreCase))
        {
            return L["SeederAlreadyRunning"];
        }
        if (raw.Contains("404", StringComparison.OrdinalIgnoreCase) || raw.Contains("seeder.disabled", StringComparison.OrdinalIgnoreCase))
        {
            return L["SeederDisabled"];
        }
        return raw;
    }

    private static bool ContainsDisabled(string error) =>
        error.Contains("404", StringComparison.OrdinalIgnoreCase) || error.Contains("seeder.disabled", StringComparison.OrdinalIgnoreCase);

    private static string LevelClass(string level) => level switch
    {
        "Success" => "seeder-log-level seeder-log-level-success",
        "Warning" => "seeder-log-level seeder-log-level-warning",
        "Error" => "seeder-log-level seeder-log-level-error",
        _ => "seeder-log-level"
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_pollCts is not null)
        {
            _pollCts.Cancel();
            _pollCts.Dispose();
        }
        if (_pollTask is not null)
        {
            try { await _pollTask; } catch { /* swallow on teardown */ }
        }
    }
}
