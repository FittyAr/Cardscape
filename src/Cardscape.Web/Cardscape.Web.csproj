<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <AssemblyName>Cardscape.Web</AssemblyName>
    <RootNamespace>Cardscape.Web</RootNamespace>
    <Description>Cardscape SPA client. Blazor WebAssembly + Radzen components. Talks to the API via HTTP.</Description>
    <!--
        The .NET 11 preview SDK (11.0.100-preview.6.26359.118) does not
        run the token-replacement pass over wwwroot/index.html. The
        default template's <link id="webassembly" /> and
        <script src="_framework/blazor.webassembly#[.{fingerprint}].js">
        ship to the output with the literal placeholders, and the
        Blazor WASM dev server (`dotnet run`) silently leaves the
        build pipeline half-done (no per-assembly .wasm files in
        bin/Debug). Disable static-web-asset fingerprinting so the
        generated paths are stable: dotnet.js, blazor.webassembly.js,
        Cardscape.Web.wasm, and the dependency .wasm files are all
        served at their non-fingerprinted names. Re-enable when the
        SDK ships the replacement pass.
    -->
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
    <!--
        G12 (SetDefaultCulture / AddSupportedCultures on
        AddLocalization) caused a Blazor WASM runtime error:
        "Blazor detected a change in the application's culture
        that is not supported with the current project
        configuration." The default culture list (en, es) is
        loaded at startup and Blazor refuses to switch to a
        culture that wasn't part of the initial load. Setting
        this to true ships the ICU / globalization data for
        every supported culture (≈300 KB compressed); the
        alternative is hard-coding the default culture to
        "en" and only shipping English data, which we don't
        want because the Spanish .resx is the second-largest
        string set in the project.
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net.Http" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

</Project>
