<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <AssemblyName>Cardscape.Web</AssemblyName>
    <RootNamespace>Cardscape.Web</RootNamespace>
    <Description>Cardscape SPA client. Blazor WebAssembly + Radzen components. Talks to the API via HTTP.</Description>
    <!--
        Load all globalization data at startup (ICU + culture tables) so the
        .NET runtime can change the current culture during initialization
        without throwing "Blazor detected a change in the application's
        culture that is not supported with the current project configuration".
        On .NET 10 LTS this is the official fix; on the .NET 11 preview SDK
        the same flag caused a different startup race and was disabled, but
        on net10.0 it is required for any non-default culture (e.g. when the
        browser sends "es" in Accept-Language) to boot without crashing.
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!--
        Historical workaround for the .NET 11 preview SDK
        (11.0.100-preview.6.26359.118): it did not run the
        token-replacement pass over wwwroot/index.html, so the
        default template's <link id="webassembly" /> and
        <script src="_framework/blazor.webassembly#[.{fingerprint}].js">
        shipped with the literal placeholders and the Blazor WASM
        dev server left the build pipeline half-done (no per-assembly
        .wasm files in bin/Debug). Disabling static-web-asset
        fingerprinting was the mitigation.

        Now that the project targets net10.0 (10.0.10 SDK), this
        workaround is no longer required. The property is kept
        `false` as a safety net; flip it back to `true` (or remove
        the line) once a `dotnet run` + browser smoke test confirms
        fingerprinted assets still serve correctly on the stable
        SDK. Tracked as a follow-up; see project history.
    -->
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net.Http" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <!--
    The Spanish .resx is shipped as a static web asset so a future
    client-side CulturePicker can fetch it via HttpClient and
    switch cultures without going through the (broken on this
    preview SDK) `CultureInfo.DefaultThreadCurrentCulture`
    path. Until that picker is wired, the localizer still uses
    the embedded `SharedResource.resx` (English).
  -->
  <ItemGroup>
    <None Include="Resources\SharedResource.es.resx"
          Pack="true"
          PackagePath="wwwroot\Resources\SharedResource.es.resx" />
  </ItemGroup>

</Project>
