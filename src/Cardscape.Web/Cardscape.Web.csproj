<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <AssemblyName>Cardscape.Web</AssemblyName>
    <RootNamespace>Cardscape.Web</RootNamespace>
    <Description>Cardscape SPA client. Blazor WebAssembly + Radzen components. Talks to the API via HTTP.</Description>
    <!--
        Load all globalization data at startup (ICU + culture tables) so the
        .NET runtime can change the current culture during initialization
        without throwing "Blazor detected a change in the application's
        culture that is not supported with the current project configuration".
        Required for any non-default culture (e.g. when the browser sends
        "es" in Accept-Language) to boot without crashing.
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!--
        Generate the service-worker-assets.js manifest so the SW can
        pre-cache every published asset with integrity hashes. The SW
        in wwwroot/service-worker.js reads the manifest and uses
        `assetsManifest.version` (the build content hash) as part of
        the cache name, so every deploy automatically invalidates
        client-side caches without a hard reload. The `<ServiceWorker>`
        item below is what tells the SDK which file to process — the
        `ServiceWorkerAssetsManifest` property alone doesn't generate
        anything.
    -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot/service-worker.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Exceptions" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.BrowserHttp" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net.Http" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <!--
    The Spanish .resx is shipped as a static web asset so a future
    client-side CulturePicker can fetch it via HttpClient and
    switch cultures without going through the
    `CultureInfo.DefaultThreadCurrentCulture` path. Until that
    picker is wired, the localizer uses the embedded
    `SharedResource.resx` (English) at runtime.
  -->
  <ItemGroup>
    <None Include="Resources\SharedResource.es.resx" Pack="true" PackagePath="wwwroot\Resources\SharedResource.es.resx" />
  </ItemGroup>

</Project>
