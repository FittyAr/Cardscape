@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Cardscape.Web.Layout
@using Cardscape.Web.Services
@using Radzen
@implements IDisposable
@inject NavigationManager Nav
@inject UserPreferencesService UserPreferences

<!--
  v1.2.0 theming — the RadzenTheme tag replaces the two static
  <link rel="stylesheet" href="_content/Radzen.Blazor/css/..." />
  tags that used to live in wwwroot/index.html. The
  UserPreferencesService decides what to bind:

  - For a Radzen free theme (default, humanistic, material,
    software, standard and their -dark siblings), the
    bound Theme is the theme name (string, cookie value) and
    CssPath is null. The Radzen cookie service + RadzenTheme
    component read the cookie value and emit the matching
    <link> automatically (from the default Radzen CSS path).

  - For one of the two custom Cardscape Classic variants,
    the bound Theme is the custom theme name
    ("cardscape-classic" / "cardscape-classic-dark") and
    CssPath is the matching wwwroot/css/cardscape-classic*.css
    file. The RadzenTheme component reads CssPath and emits
    the matching <link>; the file declares the brand
    colour overrides on top of Radzen's Software base.

  The service is a singleton and is initialised in
  OnInitializedAsync; the Changed event re-renders this
  tag whenever the user picks a different theme.
-->
<RadzenTheme Theme="@UserPreferences.CurrentThemeName"
             CssPath="@UserPreferences.CurrentCssPath" />

@*
  SystemAppearanceWatcher — listens to the OS
  prefers-color-scheme media query. When the user picks
  the "System" mode, the service re-applies the
  matching sibling of their chosen theme. Documented
  Radzen component (no custom JS interop needed).
*@
<RadzenMediaQuery Query="(prefers-color-scheme: dark)"
                   Change="@OnSystemDarkChanged" />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @* If the user is not signed in, bounce to /login and keep the original URL. *@
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

<!-- Radzen dialog / notification providers so any page can show them. -->
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

@code {
    // BETA-2-UI-#11 — see test-results/ui/beta-test-r2-ui.md.
    //
    // The default Blazor `blazor-error-ui` banner is shown when
    // a page throws during render. The framework only clears it
    // on the SAME component's next successful render, so once
    // a page throws in OnInitializedAsync (e.g. a JsonException
    // from a mis-shaped DTO) the user navigates away to a
    // working page but the red banner stays visible until a
    // hard reload. We hide the banner on every navigation so
    // it only ever reflects a CURRENT-page error.
    [Inject] private IJSRuntime Js { get; set; } = default!;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UserPreferences.Changed += OnUserPreferencesChanged;

        // BETA-SW-008 — see test-results/beta/round-2/sw-caching.md.
        // The original code awaited UserPreferences.InitializeAsync()
        // here, which fires an HTTP call to /api/users/me/preferences.
        // Blazor awaits OnInitializedAsync before the first render,
        // so the page sat on a white loading screen for 10-20s
        // in dev mode while the .NET runtime JIT'd the C# code
        // and the round-trip to the API returned 401. Hot reload
        // 'fixed' the symptom because the re-render fired AFTER
        // the WASM was warm and the await had long since
        // completed — it skipped the slow path entirely.
        //
        // Move the hydration off the render path. The RadzenTheme
        // tag above binds to UserPreferences.CurrentThemeName /
        // CurrentCssPath, both of which default to 'default' +
        // light (Radzen's default). The first render uses those
        // defaults; once InitializeAsync completes the
        // Changed event fires StateHasChanged, the theme flips
        // to the user's saved choice if any. An anonymous user
        // (no saved preference) gets 'default' either way, so
        // there is no visible flash. A logged-in user with a
        // dark theme saved may see a one-frame light→dark flip
        // — vastly preferable to a 10-20s blank page.
        _ = HydratePreferencesInBackgroundAsync();
    }

    private async Task HydratePreferencesInBackgroundAsync()
    {
        try
        {
            await UserPreferences.InitializeAsync();
        }
        catch (Exception ex)
        {
            // Defensive: InitializeAsync already swallows
            // network failures, but a synchronous throw
            // (e.g. from ThemeService.SetTheme) should not
            // crash the app. The catch lives off the render
            // path now, so a throw here just leaves the
            // Radzen default in place — same outcome as the
            // original OnInitializedAsync catch block.
            Console.Error.WriteLine($"[App] UserPreferences.InitializeAsync threw: {ex.Message}");
        }
    }

    /// <summary>Called by <c>&lt;RadzenMediaQuery&gt;</c>
    /// when the OS <c>prefers-color-scheme: dark</c>
    /// media query flips. The service re-applies the
    /// matching sibling of the user's chosen theme
    /// (only when the mode is "System"; explicit Light /
    /// Dark ignores the OS preference).</summary>
    private void OnSystemDarkChanged(bool prefersDark)
    {
        UserPreferences.NotifySystemDarkChanged(prefersDark);
    }

    private void OnUserPreferencesChanged() => InvokeAsync(StateHasChanged);

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Defer one tick so we don't fight the framework
        // when the navigation itself triggered the error
        // it just rendered.
        try
        {
            await Task.Delay(50);
            await Js.InvokeVoidAsync("eval",
                "var el=document.getElementById('blazor-error-ui');if(el){el.classList.add('d-none');el.style.display='none';}");
        }
        catch
        {
            // IJSRuntime is not yet available on the very
            // first render — silently ignore. Subsequent
            // navigations (which is when the banner can
            // actually be stuck) will succeed.
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        UserPreferences.Changed -= OnUserPreferencesChanged;
    }
}
