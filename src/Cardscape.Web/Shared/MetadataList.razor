@* MetadataList — key/value list (card details, custom fields).
   Rendered as a semantic <dl>; the label column sizes to its
   content so the list reads well both full-width and inside the
   narrow card side panel. Styles: MetadataList.razor.css. *@

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MetadataListItem> Items { get; set; } = Array.Empty<MetadataListItem>();
}

<dl class="cs-meta">
    @foreach (MetadataListItem item in Items)
    {
        <dt class="cs-meta-label">@item.Label</dt>
        <dd class="cs-meta-value">@item.Value</dd>
    }
</dl>
