@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

@* Previous / current / next month toolbar shared by the month-paged views. *@
<RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center">
    <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Disabled="@Disabled"
                  Click="@(() => MonthChanged.InvokeAsync(Month.Previous))"
                  aria-label="@L["CalendarPreviousMonth", Month.Previous.Label]"
                  title="@L["CalendarPreviousMonth", Month.Previous.Label]" />
    <RadzenButton Text="@L["CalendarToday"]" ButtonStyle="ButtonStyle.Light" Disabled="@(Disabled || Month.IsCurrent)"
                  Click="@(() => MonthChanged.InvokeAsync(CalendarMonth.Current))"
                  aria-label="@L["CalendarCurrentMonth"]" title="@L["CalendarCurrentMonth"]" />
    <RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Disabled="@Disabled"
                  Click="@(() => MonthChanged.InvokeAsync(Month.Next))"
                  aria-label="@L["CalendarNextMonth", Month.Next.Label]"
                  title="@L["CalendarNextMonth", Month.Next.Label]" />
</RadzenStack>

@code {
    [Parameter, EditorRequired] public CalendarMonth Month { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<CalendarMonth> MonthChanged { get; set; }
}
