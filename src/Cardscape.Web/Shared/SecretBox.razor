@* SecretBox — monospace block with the Radzen "base-200"
   background. Used to display one-time secrets (API tokens,
   workspace invitation tokens, OAuth client secrets, …). *@

@code {
    [Parameter, EditorRequired] public string Secret { get; set; } = string.Empty;
    [Parameter] public string? AriaLabel { get; set; }
}

<code class="cs-secret-box" aria-label="@(AriaLabel ?? Secret)">@Secret</code>
