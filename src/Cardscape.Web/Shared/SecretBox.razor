@* SecretBox — monospace block with the Radzen "base-200" background
   used to display one-time secrets (API tokens, workspace invitation
   tokens, OAuth client secrets, etc.). Replaces the
   `<code style="font-family: monospace; background: var(--rz-base-200); padding: 0.5rem; border-radius: 0.375rem; display: block;">`
   pattern that appeared in ApiTokens.razor and WorkspaceMembers.razor. *@

@code {
    [Parameter, EditorRequired] public string Secret { get; set; } = string.Empty;
    [Parameter] public string? AriaLabel { get; set; }
}

<code class="cs-secret-box" aria-label="@(AriaLabel ?? Secret)">@Secret</code>
