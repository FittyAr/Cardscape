@* LanguageSwitcher — D7 (v1.2.0 plan, G12 follow-up).
   Renders a Radzen dropdown that calls CultureSwitcher.SetCultureAsync
   on change. The picker fetches the matching SharedResource.{culture}.resx
   static web asset and the HttpBackedStringLocalizer reads the new
   translations on the next render. The dropdown is intentionally
   minimal — no flag icons, no auto-detect; the user picks and the
   choice persists in localStorage. *@

@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.Extensions.Localization
@inject CultureSwitcher Culture
@inject IStringLocalizer<SharedResource> L

<RadzenDropDown TValue="string"
                Value="@Culture.CurrentCulture"
                Change="@OnChange"
                Data="@(Culture.AvailableCultures)"
                Placeholder="@L["CommonLanguage"]"
                Style="width: 7rem;"
                aria-label="@L["CommonLanguage"]">
    <Template>
        @GetLabel(context)
    </Template>
    <ValueTemplate>
        @GetLabel(context)
    </ValueTemplate>
</RadzenDropDown>

@code {
    // BETA-8-I18N-#1 — see test-results/r8/A8-settings.md.
    //
    // The previous `Change="@OnChange"` handler was parameterless,
    // so the new selection the user picked was discarded — the
    // handler then re-read `Culture.CurrentCulture` (the singleton,
    // still on the OLD value) and called SetCultureAsync with it.
    // The result: picking "Spanish" kept the UI in English, the
    // localStorage key was never written, and a hard refresh
    // re-loaded English from the empty default. The signature
    // here accepts the new `value` RadzenDropDown passes to Change
    // and forwards it to the picker.
    private async void OnChange(object value)
    {
        string newCulture = value?.ToString() ?? "en";
        await Culture.SetCultureAsync(newCulture);
    }

    private string GetLabel(object value)
    {
        string culture = value?.ToString() ?? "en";
        return culture switch
        {
            "es" => L["CommonLanguageSpanish"],
            _ => L["CommonLanguageEnglish"]
        };
    }
}
