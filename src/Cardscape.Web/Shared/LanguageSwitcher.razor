@* LanguageSwitcher — D7 (v1.2.0 plan, G12 follow-up).
   Renders a Radzen dropdown that calls CultureSwitcher.SetCultureAsync
   on change. The picker fetches the matching SharedResource.{culture}.resx
   static web asset and the HttpBackedStringLocalizer reads the new
   translations on the next render. The dropdown is intentionally
   minimal — no flag icons, no auto-detect; the user picks and the
   choice persists in localStorage. *@

@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.Extensions.Localization
@inject CultureSwitcher Culture
@inject IStringLocalizer<SharedResource> L

<RadzenDropDown TValue="string"
                Value="@Culture.CurrentCulture"
                Change="@OnChangeAsync"
                Data="@(Culture.AvailableCultures)"
                Placeholder="@L["CommonLanguage"]"
                Style="width: 7rem;"
                aria-label="@L["CommonLanguage"]">
    <Template>
        @GetLabel(context)
    </Template>
    <ValueTemplate>
        @GetLabel(context)
    </ValueTemplate>
</RadzenDropDown>

@code {
    // Radzen supplies the selected value to Change. Forwarding that
    // value avoids re-reading stale singleton state during the same
    // render cycle.
    //
    // BETA-8-I18N-#2 — see test-results/r8/A8-settings.md.
    //
    // The previous one-way `Value="@Culture.CurrentCulture"`
    // binding meant that when Culture.InitializeAsync loaded
    // "es" from localStorage on first render, the layout
    // re-rendered the menu in Spanish (Inicio / Espacios / …) but
    // RadzenDropDown kept showing "English" because its internal
    // selection is set by the first render and the
    // parameter-driven setter only fires when the diff-renderer
    // sees a primitive change. We force a re-render whenever the
    // culture changes by hooking Culture.Changed in OnInitialized
    // and calling StateHasChanged; combined with @bind-Value
    // (below) the dropdown's internal state stays in lock-step
    // with the singleton.
    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChangedAsync;
    }

    public void Dispose()
    {
        Culture.Changed -= OnCultureChangedAsync;
    }

    private Task OnCultureChangedAsync() => InvokeAsync(StateHasChanged);

    private async Task OnChangeAsync(object value)
    {
        string newCulture = value?.ToString() ?? "en";
        await Culture.SetCultureAsync(newCulture);
    }

    private string GetLabel(object value)
    {
        string culture = value?.ToString() ?? "en";
        return culture switch
        {
            "es" => L["CommonLanguageSpanish"],
            _ => L["CommonLanguageEnglish"]
        };
    }
}
