@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject INotificationsApiClient Notifications
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<RadzenButton Variant="Variant.Text"
              ButtonStyle="ButtonStyle.Light"
              Click="@(() => Nav.NavigateTo("inbox"))"
              title="@InboxAccessibleName"
              aria-label="@InboxAccessibleName"
              class="rz-border-radius-50">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
        <RadzenIcon Icon="notifications" />
        @if (count > 0)
        {
            <RadzenBadge Text="@Display(count)" BadgeStyle="BadgeStyle.Danger" />
        }
    </RadzenStack>
</RadzenButton>

@code {
    private int count;
    private readonly CancellationTokenSource refreshCts = new();
    private Task? refreshTask;
    private string InboxAccessibleName => count > 0 ? L["InboxUnreadCount", count] : L["InboxTitle"];
    private Microsoft.AspNetCore.Components.Authorization.AuthenticationState? authState;

    protected override async Task OnInitializedAsync()
    {
        authState = await AuthState.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await RefreshCountAsync(refreshCts.Token);
            refreshTask = RefreshLoopAsync(refreshCts.Token);
        }
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(() => RefreshCountAsync(ct));
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Component disposal owns cancellation of the observed loop.
        }
    }

    private async Task RefreshCountAsync(CancellationToken ct)
    {
        if (authState?.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            ApiResult<UnreadCountResponse> result = await Notifications.GetUnreadCountAsync(ct);
            if (result.IsSuccess && result.Value is not null)
            {
                count = result.Value.Count;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Best effort. The bell just shows 0 if the API is down.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await refreshCts.CancelAsync();
        if (refreshTask is not null)
        {
            await refreshTask;
        }
        refreshCts.Dispose();
    }

    private static string Display(int n) => n > 99 ? "99+" : n.ToString();
}
