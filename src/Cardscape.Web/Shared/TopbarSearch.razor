@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject ISearchApiClient Search
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@implements IDisposable

<div class="topbar-search">
    <RadzenIcon Icon="search" class="topbar-search-icon" />
    <RadzenTextBox @bind-Value="query"
                   @oninput="@OnInputChangedAsync"
                   @onkeydown="@OnKeyDown"
                   @onfocus="@ShowResults"
                   @onblur="@HideResultsAsync"
                   Placeholder="@(Placeholder ?? L["SearchPlaceholder"])"
                   aria-label="@L["SearchAriaLabel"]"
                   class="topbar-search-input" />
    @* The panel floats over the page (scoped CSS: position absolute),
       so opening it never resizes the topbar. *@
    @if (resultsVisible && results is not null && results.Count > 0)
    {
        <div class="topbar-search-panel" role="listbox" aria-label="@L["SearchResultsLabel"]">
            @foreach (SearchHitDto hit in results)
            {
                <a class="topbar-search-result" href="@hit.Url" role="option"
                   @onclick="@(() => NavigateTo(hit))" @onclick:preventDefault="true">
                    <span class="topbar-search-result-icon" aria-hidden="true">
                        <RadzenIcon Icon="@KindIcon(hit.Kind)" />
                    </span>
                    <span class="topbar-search-result-body">
                        <span class="topbar-search-result-title">@TitleFor(hit)</span>
                        @if (SnippetFor(hit) is { } snippet)
                        {
                            <span class="topbar-search-result-snippet">@snippet</span>
                        }
                    </span>
                    <span class="topbar-search-result-kind">@KindLabel(hit.Kind)</span>
                </a>
            }
        </div>
    }
    else if (resultsVisible && results is not null && results.Count == 0 && !string.IsNullOrWhiteSpace(query) && searched)
    {
        <div class="topbar-search-panel topbar-search-empty" role="status">
            <RadzenIcon Icon="search_off" />
            <span>@L["SearchNoResults"]</span>
        </div>
    }
</div>

@code {
    // BUG-A6-001 — see test-results/beta/reports/A6-views.md.
    // The task expected a topbar search input that called
    // /api/search and let the user jump to cards / comments /
    // checklist items. The endpoint existed; the Web side had
    // no client. This component is the missing glue: it
    // debounces, calls the existing ISearchApiClient (now
    // added next to this file), and renders the results as a
    // dropdown that navigates to the hit's URL on click.

    [Parameter] public string? Placeholder { get; set; }

    private string query = string.Empty;
    private List<SearchHitDto>? results;
    private bool resultsVisible;
    private bool searched;
    private CancellationTokenSource? debounceCts;
    private CancellationTokenSource? hideCts;

    private async Task OnInputChangedAsync(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? string.Empty;

        debounceCts?.Cancel();
        debounceCts?.Dispose();
        debounceCts = new CancellationTokenSource();
        CancellationToken ct = debounceCts.Token;

        try
        {
            await Task.Delay(250, ct);
            await RunSearchAsync(ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // A newer keystroke or component disposal superseded this search.
        }
    }

    private async Task RunSearchAsync(CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            results = null;
            searched = false;
            resultsVisible = false;
            return;
        }

        ApiResult<SearchPageDto> result = await Search.SearchAsync(query, pageSize: 8, ct: ct);
        if (result.HasValue)
        {
            results = result.Value.Items.ToList();
        }
        else
        {
            results = [];
        }
        searched = true;
        resultsVisible = true;
        StateHasChanged();
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.IsEscape)
        {
            resultsVisible = false;
        }
    }

    private void ShowResults()
    {
        hideCts?.Cancel();
        if (!string.IsNullOrWhiteSpace(query) && results is not null)
        {
            resultsVisible = true;
        }
    }

    private async Task HideResultsAsync()
    {
        // Small delay so a click on a result still fires.
        hideCts?.Cancel();
        hideCts?.Dispose();
        hideCts = new CancellationTokenSource();
        CancellationToken ct = hideCts.Token;

        try
        {
            await Task.Delay(200, ct);
            resultsVisible = false;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Focus returned before the delayed close completed.
        }
    }

    private void NavigateTo(SearchHitDto hit)
    {
        resultsVisible = false;
        query = string.Empty;
        results = null;
        string url = hit.Url.StartsWith('/') ? hit.Url[1..] : hit.Url;
        Nav.NavigateTo(url);
    }

    private string KindLabel(string kind) => kind switch
    {
        "card" => L["SearchKindCard"],
        "comment" => L["SearchKindComment"],
        "checklistItem" => L["SearchKindChecklist"],
        "label" => L["SearchKindLabel"],
        "activity" => L["SearchKindActivity"],
        _ => kind
    };

    private static string KindIcon(string kind) => kind switch
    {
        "card" => "sticky_note_2",
        "comment" => "chat_bubble",
        "checklistItem" => "checklist",
        "label" => "sell",
        "activity" => "history",
        _ => "search"
    };

    // Activity hits carry the event kind ("CardCreated") as their title;
    // show the same localized label the activity feed uses.
    private string TitleFor(SearchHitDto hit) =>
        hit.Kind == "activity" && Enum.TryParse(hit.Title, out ActivityKind activity)
            ? L[ActivityPresentation.LabelKey(activity)]
            : hit.Title;

    // Labels and whole checklists come with a technical placeholder
    // snippet ("Label · #hex", "Checklist"); the kind chip already
    // says what they are.
    private static string? SnippetFor(SearchHitDto hit) =>
        string.IsNullOrWhiteSpace(hit.Snippet)
        || hit.Kind == "label"
        || (hit.Kind == "checklistItem" && hit.Snippet == "Checklist")
        || hit.Snippet == hit.Title
            ? null
            : hit.Snippet;

    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        hideCts?.Cancel();
        hideCts?.Dispose();
    }
}
