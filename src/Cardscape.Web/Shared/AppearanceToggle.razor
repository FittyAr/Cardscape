@*
  AppearanceToggle — one icon button in the header that
  flips between the light and dark sibling of the user's
  current theme (e.g. Cardscape ↔ Cardscape Dark). Picking
  a different theme family, or the "follow the system"
  mode, lives on /settings/appearance; the header only
  carries the fast path.

  Bound to UserPreferencesService — the same singleton
  App.razor reads for the <RadzenTheme> tag, so a click
  re-themes the entire app without a reload.
*@

@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject UserPreferencesService UserPreferences
@inject IStringLocalizer<SharedResource> L

<RadzenButton Icon="@(IsDark ? "light_mode" : "dark_mode")"
              ButtonStyle="ButtonStyle.Base"
              Variant="Variant.Text"
              Size="ButtonSize.Medium"
              Click="@ToggleAsync"
              title="@(IsDark ? L["AppearanceModeLight"] : L["AppearanceModeDark"])"
              aria-label="@(IsDark ? L["AppearanceModeLight"] : L["AppearanceModeDark"])" />

@code {
    private bool IsDark =>
        UserPreferencesService.ResolveSiblingForSystem(UserPreferences.AppliedThemeName, prefersDark: true)
            == UserPreferences.AppliedThemeName;

    protected override void OnInitialized() =>
        UserPreferences.Changed += OnPreferencesChangedAsync;

    public void Dispose() =>
        UserPreferences.Changed -= OnPreferencesChangedAsync;

    private Task OnPreferencesChangedAsync() => InvokeAsync(StateHasChanged);

    private Task ToggleAsync()
    {
        bool toDark = !IsDark;
        string target = UserPreferencesService.ResolveSiblingForSystem(
            UserPreferences.AppliedThemeName, prefersDark: toDark);

        // An explicit click pins the mode; "System" can be
        // restored from /settings/appearance.
        return UserPreferences.SetAsync(target, toDark ? "Dark" : "Light");
    }
}
