@* PageHeader — consistent header for non-auth pages.
   Replaces the `<div class="page-shell"><div class="page-header"><h1>...`
   pattern that was repeated on every page. Styles live in
   PageHeader.razor.css. *@

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Hint { get; set; }
}

<header class="cs-page-header">
    <div class="cs-page-header-text">
        <RadzenText Text="@Title" TextStyle="TextStyle.H4" TagName="TagName.H1" class="cs-page-header-title" />
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <RadzenText Text="@Subtitle" TextStyle="TextStyle.Body2" class="cs-page-header-subtitle" />
        }
        @if (!string.IsNullOrEmpty(Hint))
        {
            <RadzenText Text="@Hint" TextStyle="TextStyle.Caption" class="cs-page-header-subtitle" />
        }
    </div>
    @if (Actions is not null)
    {
        <div class="cs-page-header-actions">
            @Actions
        </div>
    }
</header>
