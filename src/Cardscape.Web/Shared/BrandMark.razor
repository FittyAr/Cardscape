@using Cardscape.Web.Services
@implements IDisposable
@inject InstanceSettingsState Instance

@*
  BrandMark — the instance brand. By default the Cardscape glyph from
  docs/brand/00-brand-kit.md §1 (three offset rectangles drawn with the
  primary token so it follows the theme) and the instance title; an
  administrator-provided logo URL replaces the glyph.
*@

<span class="cs-brand @Class" aria-hidden="@(ShowWordmark ? null : "true")">
    @if (Instance.Current.LogoUrl is { } logo)
    {
        <RadzenImage Path="@logo" AlternateText="" class="cs-brand-glyph" Style="@($"height: {Size}px; width: auto;")" />
    }
    else
    {
        <svg class="cs-brand-glyph" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true" focusable="false">
            <rect x="9" y="2" width="12" height="15" rx="2.5" fill="var(--rz-primary)" opacity="0.35" />
            <rect x="6" y="4.5" width="12" height="15" rx="2.5" fill="var(--rz-primary)" opacity="0.6" />
            <rect x="3" y="7" width="12" height="15" rx="2.5" fill="var(--rz-primary)" />
        </svg>
    }
    @if (ShowWordmark)
    {
        <span class="cs-brand-wordmark">@Instance.Current.InstanceTitle</span>
    }
</span>

@code {
    [Parameter] public bool ShowWordmark { get; set; } = true;
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string? Class { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Instance.Changed += OnInstanceChanged;
        await Instance.GetAsync();
    }

    public void Dispose() => Instance.Changed -= OnInstanceChanged;

    private void OnInstanceChanged() => InvokeAsync(StateHasChanged);
}
