@page "/login"
@layout EmptyLayout
@using System.Web
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject AuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AuthSignIn"] @L["PageTitleSuffix"]</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        @if (challenge is null)
        {
            <header class="auth-header">
                <h1 class="auth-title">@L["AuthSignInTitle"]</h1>
                <p class="auth-subtitle">@L["AuthSignInSubtitle"]</p>
            </header>

            <div class="auth-providers">
                <a class="provider-button provider-google"
                   href="/api/auth/external/google/start?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")">
                    <span class="provider-glyph" aria-hidden="true">G</span>
                    <span>@L["AuthSignInWithGoogle"]</span>
                </a>
                <a class="provider-button provider-microsoft"
                   href="/api/auth/external/microsoft/start?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")">
                    <span class="provider-glyph" aria-hidden="true">M</span>
                    <span>@L["AuthSignInWithMicrosoft"]</span>
                </a>
                <a class="provider-button provider-apple"
                   href="/api/auth/external/apple/start?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")">
                    <span class="provider-glyph" aria-hidden="true">A</span>
                    <span>@L["AuthSignInWithApple"]</span>
                </a>
            </div>

            <div class="auth-divider"><span>@L["AuthOr"]</span></div>

            <RadzenTemplateForm TItem="LoginModel" Data="@model" Submit="@HandleSubmit" class="auth-form">
                <div class="auth-field">
                    <RadzenLabel Text="@L["AuthEmail"]" Component="email" />
                    <RadzenTextBox @bind-Value="model.Email" Name="email" Style="width:100%"
                                   autocomplete="email" Placeholder="you@company.com" />
                </div>

                <div class="auth-field">
                    <RadzenLabel Text="@L["AuthPassword"]" Component="password" />
                    <RadzenPassword @bind-Value="model.Password" Name="password" Style="width:100%"
                                    autocomplete="current-password" />
                </div>

                @if (error is not null)
                {
                    <div class="auth-error" role="alert">@error</div>
                }

                <RadzenButton ButtonType="@ButtonType.Submit"
                              Text="@L["AuthSignIn"]"
                              ButtonStyle="@ButtonStyle.Primary"
                              IsBusy="@busy"
                              BusyText="@L["AuthSigningIn"]"
                              class="auth-submit" />
            </RadzenTemplateForm>
        }
        else
        {
            <header class="auth-header">
                <h1 class="auth-title">@L["Login_TotpCode_Label"]</h1>
                <p class="auth-subtitle">@L["Login_TotpCode_Required"]</p>
            </header>

            <RadzenTemplateForm TItem="TotpModel" Data="@totpModel" Submit="@HandleTotpSubmit" class="auth-form">
                <div class="auth-field">
                    <RadzenLabel Text="@L["Login_TotpCode_Label"]" Component="totp" />
                    <RadzenTextBox @bind-Value="totpModel.Code" Name="totp"
                                   Style="width:100%; letter-spacing: 0.35em; font-variant-numeric: tabular-nums;"
                                   autocomplete="one-time-code"
                                   inputmode="numeric" maxlength="6"
                                   Placeholder="••••••" />
                </div>

                @if (error is not null)
                {
                    <div class="auth-error" role="alert">@error</div>
                }

                <RadzenButton ButtonType="@ButtonType.Submit"
                              Text="@L["AuthSignIn"]"
                              ButtonStyle="@ButtonStyle.Primary"
                              IsBusy="@busy"
                              BusyText="@L["AuthSigningIn"]"
                              class="auth-submit" />

                <button type="button" class="auth-back-link" @onclick="ResetTotp">
                    @L["AuthBackToSignIn"]
                </button>
            </RadzenTemplateForm>
        }

        <p class="auth-footer">
            @L["AuthNoAccount"] <a href="register">@L["AuthCreateOne"]</a>
        </p>
    </div>
</div>

@code {
    private readonly LoginModel model = new();
    private readonly TotpModel totpModel = new();
    private bool busy;
    private string? error;
    private LoginChallenge? challenge;

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            NavigateHome();
        }
    }

    private async Task HandleSubmit()
    {
        busy = true;
        error = null;
        try
        {
            ApiResult<UserSummaryDto> result = await Auth.LoginAsync(model.Email, model.Password);
            if (result.Challenge is { } c)
            {
                challenge = c;
                return;
            }

            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            NavigateHome();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleTotpSubmit()
    {
        if (challenge is null)
        {
            return;
        }

        busy = true;
        error = null;
        try
        {
            ApiResult<UserSummaryDto> result = await Auth.LoginWithTotpAsync(
                challenge.Value.PendingTotpToken, totpModel.Code);

            if (result.Challenge is not null)
            {
                error = L["Login_TotpCode_Invalid"];
                challenge = null;
                totpModel.Code = string.Empty;
                return;
            }

            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            NavigateHome();
        }
        finally
        {
            busy = false;
        }
    }

    private void ResetTotp()
    {
        challenge = null;
        totpModel.Code = string.Empty;
        error = null;
    }

    private void NavigateHome()
    {
        Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : HttpUtility.UrlDecode(ReturnUrl), forceLoad: true);
    }

    private sealed class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private sealed class TotpModel
    {
        public string Code { get; set; } = string.Empty;
    }
}
