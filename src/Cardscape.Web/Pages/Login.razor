@page "/login"
@layout EmptyLayout
@using System.Web
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject AuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AuthSignIn"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1.5rem">
    @if (challenge is null)
    {
        <RadzenText Text="@L["AuthSignInTitle"]" TextStyle="TextStyle.H4" TagName="TagName.H1" />
        <RadzenText Text="@L["AuthSignInSubtitle"]" TextStyle="TextStyle.Body1" />

        <RadzenStack Gap="0.75rem">
            <RadzenButton Text="@L["AuthSignInWithGoogle"]"
                          Icon="account_circle"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Large"
                          Click="@(() => StartExternal("google"))" />
            <RadzenButton Text="@L["AuthSignInWithMicrosoft"]"
                          Icon="account_circle"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Large"
                          Click="@(() => StartExternal("microsoft"))" />
            <RadzenButton Text="@L["AuthSignInWithApple"]"
                          Icon="account_circle"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Large"
                          Click="@(() => StartExternal("apple"))" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-my-2">
            <hr style="flex: 1; border: 0; border-top: 1px solid var(--rz-border-color);" />
            <RadzenText Text="@L["AuthOr"]" TextStyle="TextStyle.Caption" />
            <hr style="flex: 1; border: 0; border-top: 1px solid var(--rz-border-color);" />
        </RadzenStack>

        <RadzenTemplateForm TItem="LoginModel" Data="@model" Submit="@HandleSubmit">
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@L["AuthEmail"]" Component="email">
                    <RadzenTextBox @bind-Value="model.Email" Name="email" Style="width:100%"
                                   autocomplete="email" Placeholder="you@company.com" />
                </RadzenFormField>
                <RadzenFormField Text="@L["AuthPassword"]" Component="password">
                    <RadzenPassword @bind-Value="model.Password" Name="password" Style="width:100%"
                                    autocomplete="current-password" />
                </RadzenFormField>
                @if (error is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Size="AlertSize.Small" AllowClose="false">
                        @error
                    </RadzenAlert>
                }
                <RadzenButton ButtonType="ButtonType.Submit"
                              Text="@L["AuthSignIn"]"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Large"
                              IsBusy="@busy"
                              BusyText="@L["AuthSigningIn"]" />
            </RadzenStack>
        </RadzenTemplateForm>
    }
    else
    {
        <RadzenText Text="@L["Login_TotpCode_Label"]" TextStyle="TextStyle.H4" TagName="TagName.H1" />
        <RadzenText Text="@L["Login_TotpCode_Required"]" TextStyle="TextStyle.Body1" />

        <RadzenTemplateForm TItem="TotpModel" Data="@totpModel" Submit="@HandleTotpSubmit">
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@L["Login_TotpCode_Label"]" Component="totp">
                    <RadzenTextBox @bind-Value="totpModel.Code" Name="totp"
                                   Style="width:100%; letter-spacing: 0.35em; font-variant-numeric: tabular-nums;"
                                   autocomplete="one-time-code"
                                   inputmode="numeric" maxlength="6"
                                   Placeholder="••••••" />
                </RadzenFormField>
                @if (error is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Size="AlertSize.Small" AllowClose="false">
                        @error
                    </RadzenAlert>
                }
                <RadzenButton ButtonType="ButtonType.Submit"
                              Text="@L["AuthSignIn"]"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Large"
                              IsBusy="@busy"
                              BusyText="@L["AuthSigningIn"]" />
                <RadzenButton Text="@L["AuthBackToSignIn"]"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@ResetTotp" />
            </RadzenStack>
        </RadzenTemplateForm>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" class="rz-mt-2">
        <RadzenText Text="@L["AuthNoAccount"]" />
        <RadzenLink Path="register" Text="@L["AuthCreateOne"]" />
    </RadzenStack>
</RadzenStack>

@code {
    private readonly LoginModel model = new();
    private readonly TotpModel totpModel = new();
    private bool busy;
    private string? error;
    private LoginChallenge? challenge;

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            NavigateHome();
        }
    }

    private void StartExternal(string provider)
    {
        var returnUrl = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : Uri.EscapeDataString(ReturnUrl);
        Nav.NavigateTo($"/api/auth/external/{provider}/start?returnUrl={returnUrl}", forceLoad: true);
    }

    private async Task HandleSubmit()
    {
        busy = true;
        error = null;
        try
        {
            ApiResult<UserSummaryDto> result = await Auth.LoginAsync(model.Email, model.Password);
            if (result.Challenge is { } c)
            {
                challenge = c;
                return;
            }

            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            NavigateHome();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleTotpSubmit()
    {
        if (challenge is null)
        {
            return;
        }

        busy = true;
        error = null;
        try
        {
            ApiResult<UserSummaryDto> result = await Auth.LoginWithTotpAsync(
                challenge.Value.PendingTotpToken, totpModel.Code);

            if (result.Challenge is not null)
            {
                error = L["Login_TotpCode_Invalid"];
                challenge = null;
                totpModel.Code = string.Empty;
                return;
            }

            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            NavigateHome();
        }
        finally
        {
            busy = false;
        }
    }

    private void ResetTotp()
    {
        challenge = null;
        totpModel.Code = string.Empty;
        error = null;
    }

    private void NavigateHome()
    {
        Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : HttpUtility.UrlDecode(ReturnUrl), forceLoad: true);
    }

    private sealed class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private sealed class TotpModel
    {
        public string Code { get; set; } = string.Empty;
    }
}
