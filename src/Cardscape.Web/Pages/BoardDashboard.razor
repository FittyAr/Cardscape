@page "/boards/{BoardId:guid}/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Cardscape.Web.Services.Api
@using Microsoft.Extensions.Localization
@inject IDashboardsApiClient DashboardsApi
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["DashboardTitle"] @L["PageTitleSuffix"]</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <h1>@L["DashboardTitle"]</h1>
        <RadzenButton Text="@L["DashboardAddCard"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    </div>

    @if (showCreate)
    {
        <RadzenCard class="create-form">
            <RadzenLabel Text="@L["DashboardKind"]" Component="d-kind" />
            <RadzenDropDown @bind-Value="createModel.KindIndex" Data="@availableKinds"
                            TextProperty="Label" ValueProperty="Index" Name="d-kind" Style="width:100%" />
            <RadzenLabel Text="@L["DashboardTitle_Label"]" Component="d-title" Style="margin-top:1rem; display:block" />
            <RadzenTextBox @bind-Value="createModel.Title" Name="d-title" Style="width:100%" />
            <RadzenLabel Text="@L["DashboardConfig"]" Component="d-cfg" Style="margin-top:1rem; display:block" />
            <RadzenTextArea @bind-Value="createModel.ConfigurationJson" Name="d-cfg" Style="width:100%; height:6rem" />
            <div class="create-actions">
                <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="ButtonStyle.Light"
                              Click="@(() => { showCreate = false; error = null; })" />
                <RadzenButton Text="@L["ActionCreate"]" ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary" IsBusy="@busy"
                              Click="@CreateDashcard" />
            </div>
        </RadzenCard>
    }

    @if (dashcards is null)
    {
        <p>@L["ActionLoading"]</p>
    }
    else if (dashcards.Count == 0)
    {
        <p>@L["DashboardEmpty"]</p>
    }
    else
    {
        <div class="dashboard-grid">
            @foreach (DashcardDto d in dashcards)
            {
                <RadzenCard class="dashcard">
                    <h4>@d.Title</h4>
                    <small class="muted">@KindLabel(d.Kind)</small>
                    <p class="muted">@d.ConfigurationJson</p>
                    <RadzenButton Text="@L["ActionDelete"]" ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small" Click="@(() => Delete(d.Id))" />
                </RadzenCard>
            }
        </div>
    }

    @if (error is not null)
    {
        <div class="auth-error" role="alert">@error</div>
    }
</div>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private IReadOnlyList<DashcardDto>? dashcards;
    private bool showCreate;
    private bool busy;
    private string? error;
    private readonly CreateModel createModel = new();

    private record KindOption(int Index, string Label);

    private readonly IReadOnlyList<KindOption> availableKinds = new[]
    {
        new KindOption(0, "OverdueCount"),
        new KindOption(1, "ByMember"),
        new KindOption(2, "ByLabel"),
        new KindOption(3, "ByList"),
        new KindOption(4, "DueThisWeek")
    };

    protected override async Task OnInitializedAsync()
    {
        var result = await DashboardsApi.ListAsync(BoardId);
        dashcards = result.IsSuccess ? result.Value : [];
    }

    private async Task CreateDashcard()
    {
        busy = true;
        error = null;
        try
        {
            var result = await DashboardsApi.CreateAsync(new CreateDashcardRequest(
                BoardId, availableKinds[createModel.KindIndex].Label,
                createModel.Title, createModel.ConfigurationJson, dashcards?.Count ?? 0));
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            dashcards = [.. (dashcards ?? []), result.Value!];
            createModel.Title = string.Empty;
            createModel.ConfigurationJson = string.Empty;
            showCreate = false;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Delete(Guid id)
    {
        var result = await DashboardsApi.DeleteAsync(BoardId, id);
        if (!result.IsSuccess)
        {
            error = result.Error;
            return;
        }
        dashcards = (dashcards ?? []).Where(d => d.Id != id).ToList();
    }

    private string KindLabel(int kind) => kind switch
    {
        0 => "OverdueCount",
        1 => "ByMember",
        2 => "ByLabel",
        3 => "ByList",
        4 => "DueThisWeek",
        _ => "Unknown"
    };

    private sealed class CreateModel
    {
        public int KindIndex { get; set; }
        public string Title { get; set; } = string.Empty;
        public string ConfigurationJson { get; set; } = "{}";
    }
}
