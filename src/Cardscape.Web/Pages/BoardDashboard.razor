@page "/boards/{BoardId:guid}/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Components.Dashboard
@using Microsoft.Extensions.Localization
@inject IDashboardsApiClient DashboardsApi
@inject IBoardsApiClient BoardsApi
@inject ICardsApiClient CardsApi
@inject IListsApiClient ListsApi
@inject ILabelsApiClient LabelsApi
@inject IWorkspacesApiClient WorkspacesApi
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["DashboardTitle"] — @(board?.Name ?? L["BoardBadgeKanban"]) @L["PageTitleSuffix"]</PageTitle>

<RadzenBreadCrumb Class="rz-mb-3">
    <RadzenBreadCrumbItem Path="/workspaces" Text="@L["NavWorkspaces"]" Icon="domain" />
    @if (board is not null)
    {
        <RadzenBreadCrumbItem Path="@($"/workspaces/{board.WorkspaceId}")" Text="@(workspace?.Name ?? L["WorkspaceBadge"])" />
        <RadzenBreadCrumbItem Path="@($"/boards/{BoardId}")" Text="@board.Name" Icon="view_kanban" />
    }
    <RadzenBreadCrumbItem Text="@L["DashboardTitle"]" Icon="insights" />
</RadzenBreadCrumb>

<PageHeader Title="@L["DashboardTitle"]"
            Subtitle="@(board is not null ? $"{board.Name} — {L["HierarchyDashboardDesc"]}" : L["HierarchyDashboardDesc"])">
    <Actions>
        <RadzenButton Text="@L["BoardOpenKanban"]" Icon="view_kanban" ButtonStyle="@ButtonStyle.Light"
                      Click="@(() => Nav.NavigateTo($"boards/{BoardId}"))" />
        <RadzenButton Text="@L["DashboardAddCard"]" Icon="add" ButtonStyle="@ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    </Actions>
</PageHeader>

@if (showCreate)
{
    <RadzenCard Class="rz-mb-4">
        <RadzenStack Gap="0.5rem">
            <LabeledField Text="@L["DashboardKind"]" Component="d-kind">
                <RadzenDropDown @bind-Value="createModel.Kind" Data="@KindOptions"
                                TextProperty="Label" ValueProperty="Kind" Name="d-kind" Style="width:100%" />
            </LabeledField>
            <LabeledField Text="@L["DashboardTitle_Label"]" Component="d-title">
                <RadzenTextBox @bind-Value="createModel.Title" Name="d-title" Style="width:100%"
                               Placeholder="@KindLabel(createModel.Kind)" />
            </LabeledField>
            <RadzenText Text="@L["DashboardFilterHint"]" TextStyle="@TextStyle.Caption" class="rz-color-text-secondary rz-m-0" />
            <DashcardFilterFields Model="@createFilter" Lists="@lists" Labels="@labels" Members="@members" IdPrefix="d-new" />
            <RadzenStack Orientation="@Orientation.Horizontal" JustifyContent="@JustifyContent.End"
                         Gap="0.5rem" Class="rz-mt-3">
                <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="@ButtonStyle.Light"
                              Click="@(() => { showCreate = false; error = null; })" />
                <RadzenButton Text="@L["ActionCreate"]" ButtonType="@ButtonType.Submit"
                              ButtonStyle="@ButtonStyle.Primary" IsBusy="@busy"
                              Click="@CreateDashcardAsync" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
}

@if (loading)
{
    <LoadingState Size="LoadingSize.Page" />
}
else if (loadError is not null)
{
    <RadzenAlert AlertStyle="@AlertStyle.Danger" Variant="@Variant.Flat" AllowClose="false">@loadError</RadzenAlert>
}
else if (dashcards is { Count: 0 })
{
    <RadzenText Text="@L["DashboardEmpty"]" TextStyle="@TextStyle.Body2" class="rz-color-text-secondary" />
}
else if (dashcards is not null)
{
    @* The API stores only each widget's kind and title; the numbers are
       computed here from the board's cards (Shared/DashcardMetrics.cs). *@
    <div class="cs-dash-grid">
        @foreach (DashcardDto d in dashcards)
        {
            DashcardFilter filter = DashcardFilter.Parse(d.ConfigurationJson);
            DashcardResult metric = DashcardMetrics.Compute(d.Kind, cards, lists, now, UnassignedLabel(d.Kind), filter);
            <RadzenCard Variant="@Variant.Outlined" class="cs-dash-card">
                <div class="cs-dash-card-header">
                    <span class="cs-dash-card-icon" aria-hidden="true"><RadzenIcon Icon="@KindIcon(d.Kind)" /></span>
                    <div class="cs-dash-card-heading">
                        <RadzenText Text="@d.Title" TextStyle="@TextStyle.Subtitle1" TagName="@TagName.H3" class="rz-m-0" />
                        @if (!string.Equals(d.Title, KindLabel(d.Kind), StringComparison.CurrentCultureIgnoreCase))
                        {
                            <span class="cs-muted">@KindLabel(d.Kind)</span>
                        }
                    </div>
                    <RadzenButton Icon="filter_list" ButtonStyle="@(filter.IsEmpty ? ButtonStyle.Base : ButtonStyle.Primary)"
                                  Variant="@Variant.Text" Size="@ButtonSize.Small"
                                  aria-label="@L["DashboardFilterEdit"]" title="@L["DashboardFilterEdit"]"
                                  Click="@(() => ToggleFilterEditor(d, filter))" />
                    <RadzenButton Icon="delete" ButtonStyle="@ButtonStyle.Base" Variant="@Variant.Text" Size="@ButtonSize.Small"
                                  aria-label="@L["ActionDelete"]" title="@L["ActionDelete"]" Click="@(() => DeleteAsync(d.Id))" />
                </div>

                @if (!filter.IsEmpty)
                {
                    <div class="cs-dash-chips">
                        @foreach (string chip in FilterChips(filter))
                        {
                            <span class="cs-dash-chip">@chip</span>
                        }
                    </div>
                }

                @if (editingId == d.Id)
                {
                    <div class="cs-dash-filter-editor">
                        <DashcardFilterFields Model="@editFilter" Lists="@lists" Labels="@labels" Members="@members"
                                              IdPrefix="@($"d-{d.Id:N}")" />
                        <RadzenStack Orientation="@Orientation.Horizontal" JustifyContent="@JustifyContent.End" Gap="0.5rem">
                            <RadzenButton Text="@L["DashboardFilterClear"]" ButtonStyle="@ButtonStyle.Light" Variant="@Variant.Text"
                                          Size="@ButtonSize.Small" Click="@editFilter.Clear" />
                            <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="@ButtonStyle.Light" Size="@ButtonSize.Small"
                                          Click="@(() => editingId = null)" />
                            <RadzenButton Text="@L["ActionSave"]" ButtonStyle="@ButtonStyle.Primary" Size="@ButtonSize.Small"
                                          IsBusy="@busy" Click="@(() => SaveFilterAsync(d))" />
                        </RadzenStack>
                    </div>
                }

                @if (d.Kind is DashcardKind.OverdueCount or DashcardKind.DueThisWeek)
                {
                    <div class="cs-dash-figure @(d.Kind == DashcardKind.OverdueCount && metric.Total > 0 ? "cs-dash-figure-alert" : null)">
                        @metric.Total
                    </div>
                    @if (metric.Cards.Count == 0)
                    {
                        <span class="cs-muted">@L["DashboardNothingDue"]</span>
                    }
                    else
                    {
                        <ul class="cs-dash-cards">
                            @foreach (CardSummaryDto card in metric.Cards)
                            {
                                <li>
                                    <a href="@($"cards/{card.Id}")">@card.Title</a>
                                    <span class="cs-muted">@card.DueDate?.LocalDateTime.ToString("d")</span>
                                </li>
                            }
                        </ul>
                        @if (metric.Total > metric.Cards.Count)
                        {
                            <span class="cs-muted">@L["DashboardMoreCards", metric.Total - metric.Cards.Count]</span>
                        }
                    }
                }
                else
                {
                    <span class="cs-muted">@L["DashboardOpenCards", metric.Total]</span>
                    @if (metric.Total == 0)
                    {
                        <span class="cs-muted">@L["DashboardNoOpenCards"]</span>
                    }
                    else
                    {
                        int max = Math.Max(1, metric.Buckets.Max(bucket => bucket.Count));
                        <ul class="cs-dash-bars">
                            @foreach (DashcardBucket bucket in metric.Buckets)
                            {
                                <li class="@(bucket.IsUnassigned ? "cs-dash-bar-muted" : null)">
                                    <span class="cs-dash-bar-label">
                                        @if (bucket.Color is { } color)
                                        {
                                            <span class="cs-dash-swatch" style="--cs-label-color: @color" aria-hidden="true"></span>
                                        }
                                        @bucket.Label
                                    </span>
                                    <span class="cs-dash-bar-count">@bucket.Count</span>
                                    <span class="cs-dash-bar-track" aria-hidden="true">
                                        <span class="cs-dash-bar-fill" style="--cs-dash-share: @Share(bucket.Count, max)"></span>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                }
            </RadzenCard>
        }
    </div>
}

@if (error is not null)
{
    <RadzenAlert AlertStyle="@AlertStyle.Danger" Variant="@Variant.Flat" AllowClose="false">@error</RadzenAlert>
}

@code {
    [Parameter] public Guid BoardId { get; set; }

    private BoardDto? board;
    private WorkspaceDto? workspace;
    private IReadOnlyList<DashcardDto>? dashcards;
    private bool showCreate;
    private bool busy;
    private bool loading;
    private string? error;
    private string? loadError;
    private readonly CreateModel createModel = new();

    private IReadOnlyList<CardSummaryDto> cards = [];
    private IReadOnlyList<BoardListDto> lists = [];
    private IReadOnlyList<LabelDto> labels = [];
    private IReadOnlyList<WorkspaceMemberDto> members = [];
    private readonly DashcardFilterModel createFilter = new();
    private DashcardFilterModel editFilter = new();
    private Guid? editingId;
    private DateTimeOffset now = DateTimeOffset.Now;

    private sealed record KindOption(DashcardKind Kind, string Label);

    private IReadOnlyList<KindOption> KindOptions =>
        Enum.GetValues<DashcardKind>().Select(kind => new KindOption(kind, KindLabel(kind))).ToList();

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            var boardTask = BoardsApi.GetAsync(BoardId);
            var dashTask = DashboardsApi.ListAsync(BoardId);
            var cardsTask = CardsApi.ListForBoardAsync(BoardId);
            var listsTask = ListsApi.ListForBoardAsync(BoardId);
            var labelsTask = LabelsApi.ListForBoardAsync(BoardId);

            await Task.WhenAll(boardTask, dashTask, cardsTask, listsTask, labelsTask);
            now = DateTimeOffset.Now;
            ApiResult<IReadOnlyList<CardSummaryDto>> cardsRes = await cardsTask;
            ApiResult<IReadOnlyList<BoardListDto>> listsRes = await listsTask;
            cards = cardsRes.HasValue ? cardsRes.Value : [];
            lists = listsRes.HasValue ? listsRes.Value.OrderBy(list => list.Position).ToList() : [];
            ApiResult<IReadOnlyList<LabelDto>> labelsRes = await labelsTask;
            labels = labelsRes.HasValue ? labelsRes.Value.OrderBy(label => label.Name, StringComparer.CurrentCultureIgnoreCase).ToList() : [];

            var boardRes = await boardTask;
            if (boardRes.HasValue)
            {
                board = boardRes.Value;
                var wsRes = await WorkspacesApi.GetAsync(board.WorkspaceId);
                if (wsRes.IsSuccess)
                {
                    workspace = wsRes.Value;
                }

                ApiResult<IReadOnlyList<WorkspaceMemberDto>> membersRes = await WorkspacesApi.ListMembersAsync(board.WorkspaceId);
                members = membersRes.HasValue
                    ? membersRes.Value.OrderBy(m => m.DisplayName, StringComparer.CurrentCultureIgnoreCase).ToList()
                    : [];
            }

            var result = await dashTask;
            if (result.HasValue)
            {
                dashcards = result.Value;
                return;
            }

            dashcards = null;
            loadError = result.Error ?? L["DashboardLoadFailed"];
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CreateDashcardAsync()
    {
        busy = true;
        error = null;
        try
        {
            var result = await DashboardsApi.CreateAsync(new CreateDashcardRequest(
                BoardId, createModel.Kind,
                string.IsNullOrWhiteSpace(createModel.Title) ? KindLabel(createModel.Kind) : createModel.Title.Trim(),
                createFilter.ToFilter().ToJson(), dashcards?.Count ?? 0));
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            dashcards = [.. (dashcards ?? []), result.Value!];
            createModel.Title = string.Empty;
            createFilter.Clear();
            showCreate = false;
        }
        finally
        {
            busy = false;
        }
    }

    private void ToggleFilterEditor(DashcardDto dashcard, DashcardFilter filter)
    {
        if (editingId == dashcard.Id)
        {
            editingId = null;
            return;
        }

        editFilter = DashcardFilterModel.From(filter);
        editingId = dashcard.Id;
    }

    private async Task SaveFilterAsync(DashcardDto dashcard)
    {
        busy = true;
        error = null;
        try
        {
            ApiResult<DashcardDto> result = await DashboardsApi.UpdateConfigAsync(
                BoardId, dashcard.Id, editFilter.ToFilter().ToJson());
            if (!result.HasValue)
            {
                error = result.Error;
                return;
            }

            dashcards = (dashcards ?? []).Select(d => d.Id == dashcard.Id ? result.Value : d).ToList();
            editingId = null;
        }
        finally
        {
            busy = false;
        }
    }

    // Human-readable scope of a widget; an id whose list, label or member
    // no longer exists still shows, as "deleted", so the filter is not silent.
    private IEnumerable<string> FilterChips(DashcardFilter filter)
    {
        if (filter.ListId is { } listId)
        {
            yield return L["DashboardChipList", lists.FirstOrDefault(l => l.Id == listId)?.Name ?? L["DashboardChipDeleted"]];
        }

        if (filter.LabelId is { } labelId)
        {
            yield return L["DashboardChipLabel", labels.FirstOrDefault(l => l.Id == labelId)?.Name ?? L["DashboardChipDeleted"]];
        }

        if (filter.MemberId is { } memberId)
        {
            yield return L["DashboardChipMember", members.FirstOrDefault(m => m.UserId == memberId)?.DisplayName ?? L["DashboardChipDeleted"]];
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        var result = await DashboardsApi.DeleteAsync(BoardId, id);
        if (!result.IsSuccess)
        {
            error = result.Error;
            return;
        }
        dashcards = (dashcards ?? []).Where(d => d.Id != id).ToList();
    }

    private string KindLabel(DashcardKind kind) => kind switch
    {
        DashcardKind.OverdueCount => L["DashboardKindOverdue"],
        DashcardKind.DueThisWeek => L["DashboardKindDueSoon"],
        DashcardKind.ByList => L["DashboardKindByList"],
        DashcardKind.ByMember => L["DashboardKindByMember"],
        DashcardKind.ByLabel => L["DashboardKindByLabel"],
        _ => L["CommonUnknown"]
    };

    private static string KindIcon(DashcardKind kind) => kind switch
    {
        DashcardKind.OverdueCount => "alarm",
        DashcardKind.DueThisWeek => "event_upcoming",
        DashcardKind.ByList => "view_column",
        DashcardKind.ByMember => "group",
        DashcardKind.ByLabel => "sell",
        _ => "insights"
    };

    private string UnassignedLabel(DashcardKind kind) =>
        kind == DashcardKind.ByLabel ? L["DashboardNoLabel"] : L["DashboardUnassigned"];

    private static string Share(int count, int max) =>
        (100.0 * count / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private sealed class CreateModel
    {
        public DashcardKind Kind { get; set; } = DashcardKind.OverdueCount;
        public string Title { get; set; } = string.Empty;
    }
}
