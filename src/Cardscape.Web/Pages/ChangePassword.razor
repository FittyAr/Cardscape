@page "/change-password"
@layout EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IAccountApiClient Account
@inject AuthService Auth
@inject PasswordChangeGate PasswordChange
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

@* Choose a new password. Everyone can come here; accounts with a temporary
   password set by an administrator are sent here and cannot use the rest
   of the app until they finish. *@

<PageTitle>@L["ChangePasswordTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Gap="0.25rem">
        <RadzenText Text="@L["ChangePasswordTitle"]" TextStyle="TextStyle.H4" TagName="TagName.H1" />
        <RadzenText Text="@(PasswordChange.Required ? L["ChangePasswordRequiredIntro"] : L["ChangePasswordIntro"])"
                    TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
    </RadzenStack>

    <RadzenTemplateForm TItem="ChangeModel" Data="@model" Submit="@SubmitAsync">
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="@(PasswordChange.Required ? L["ChangePasswordTemporary"] : L["ChangePasswordCurrent"])" Component="current">
                <RadzenPassword @bind-Value="model.Current" Name="current" Style="width:100%" autocomplete="current-password" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="current" Text="@L["ValidationRequired"]" />

            <RadzenFormField Text="@L["ChangePasswordNew"]" Component="next">
                <RadzenPassword @bind-Value="model.Next" Name="next" Style="width:100%" autocomplete="new-password" />
                <RadzenText Text="@L["AuthPasswordHint"]" TextStyle="TextStyle.Caption" class="rz-color-text-secondary" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="next" Text="@L["ValidationRequired"]" />

            <RadzenFormField Text="@L["AuthConfirmPassword"]" Component="confirm">
                <RadzenPassword @bind-Value="model.Confirm" Name="confirm" Style="width:100%" autocomplete="new-password" />
                @if (!string.IsNullOrEmpty(model.Confirm) && model.Next != model.Confirm)
                {
                    <RadzenText Text="@L["AuthPasswordsDoNotMatch"]" TextStyle="TextStyle.Caption" Style="color: var(--rz-danger);" />
                }
            </RadzenFormField>

            @if (error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@error</RadzenAlert>
            }

            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["ChangePasswordSubmit"]" ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Large" IsBusy="@busy" BusyText="@L["ChangePasswordSaving"]"
                          Disabled="@(string.IsNullOrEmpty(model.Next) || model.Next != model.Confirm)" Style="width:100%" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>

@code {
    private sealed class ChangeModel
    {
        public string Current { get; set; } = string.Empty;
        public string Next { get; set; } = string.Empty;
        public string Confirm { get; set; } = string.Empty;
    }

    private readonly ChangeModel model = new();
    private bool busy;
    private string? error;

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;
        try
        {
            ApiResult<AuthResponseDto> result = await Account.ChangePasswordAsync(model.Current, model.Next);
            if (!result.HasValue || result.Value.AccessToken is not { } token)
            {
                error = result.Error ?? L["ChangePasswordFailed"];
                return;
            }

            await Auth.SetSessionAsync(token, result.Value.User);
            PasswordChange.Clear();
            Nav.NavigateTo("", forceLoad: true);
        }
        finally
        {
            busy = false;
        }
    }
}
