@page "/workspaces/{id:guid}/import"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.Extensions.Localization
@inject HttpClient Http
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<PageTitle>@L["ImportTitle"] @L["PageTitleSuffix"]</PageTitle>

<div class="page-shell">
    <h1>@L["ImportTitle"]</h1>
    <p>@L["ImportBlurb"]</p>

    <RadzenCard>
        <RadzenLabel Text="@L["ImportTrelloFile"]" Component="file" />
        <InputFile OnChange="@OnFileSelected" accept="application/json,.json" />

        @if (previewing)
        {
            <p class="import-status">@L["ImportPreviewing"]</p>
        }
        @if (applying)
        {
            <p class="import-status">@L["ImportApplying"]</p>
        }

        @if (error is not null)
        {
            <div class="auth-error" role="alert">@error</div>
        }

        @* Dry-run preview panel — rendered as soon as the
            user picks a valid file. No DB writes happened. *@
        @if (preview is not null && preview.Preview is { WasApplied: false })
        {
            <RadzenPanel Text="@L["ImportPreviewTitle"]" class="import-preview-panel">
                <RadzenCard>
                    <p>@L["ImportPreviewBlurb"]</p>
                    <ul>
                        <li>@L["ImportPreviewBoards"]: @preview.Preview.BoardCount</li>
                        <li>@L["ImportPreviewLists"]: @preview.Preview.ListCount</li>
                        <li>@L["ImportPreviewCards"]: @preview.Preview.CardCount</li>
                        <li>@L["ImportPreviewLabels"]: @preview.Preview.LabelCount</li>
                        <li>@L["ImportPreviewMembers"]: @preview.Preview.MemberCount</li>
                    </ul>

                    @if (preview.Preview.SampleBoardNames.Count > 0)
                    {
                        <p><strong>@L["ImportPreviewSampleBoards"]</strong></p>
                        <ul>
                            @foreach (var name in preview.Preview.SampleBoardNames)
                            {
                                <li>@name</li>
                            }
                        </ul>
                    }
                    @if (preview.Preview.SampleListNames.Count > 0)
                    {
                        <p><strong>@L["ImportPreviewSampleLists"]</strong></p>
                        <ul>
                            @foreach (var name in preview.Preview.SampleListNames)
                            {
                                <li>@name</li>
                            }
                        </ul>
                    }
                    @if (preview.Preview.SampleCardNames.Count > 0)
                    {
                        <p><strong>@L["ImportPreviewSampleCards"]</strong></p>
                        <ul>
                            @foreach (var name in preview.Preview.SampleCardNames)
                            {
                                <li>@name</li>
                            }
                        </ul>
                    }

                    <div class="form-actions">
                        <RadzenButton Text="@L["ImportApply"]"
                                      ButtonStyle="ButtonStyle.Primary"
                                      IsBusy="@applying"
                                      Disabled="@applying"
                                      Click="@ApplyImport" />
                        <RadzenButton Text="@L["ImportCancel"]"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@CancelPreview" />
                    </div>
                </RadzenCard>
            </RadzenPanel>
        }

        @* Apply result — rendered after a real import. *@
        @if (applied is not null)
        {
            <RadzenPanel Text="@L["ImportResultTitle"]" class="import-result-panel">
                <RadzenCard>
                    <p>@L["ImportResultSummary"]</p>
                    <ul>
                        <li>Boards: @applied.ImportedBoardIds.Count</li>
                        <li>Lists: @applied.ImportedListIds.Count</li>
                        <li>Cards: @applied.ImportedCardIds.Count</li>
                        <li>Labels: @applied.ImportedLabelIds.Count</li>
                    </ul>
                </RadzenCard>
            </RadzenPanel>
        }
    </RadzenCard>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private readonly ImportForm form = new();
    private bool previewing;
    private bool applying;
    private string? error;
    private ImportResultDto? preview;
    private ImportResultDto? applied;
    // Incremented on every file pick so a slow in-flight
    // preview can detect that the user moved on and bail out
    // without overwriting the current preview / error.
    private int selectionVersion;

    private async void OnFileSelected(InputFileChangeEventArgs e)
    {
        form.File = e.File;
        preview = null;
        applied = null;
        error = null;
        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        if (form.File is null)
        {
            return;
        }

        int myVersion = ++selectionVersion;
        previewing = true;
        error = null;
        try
        {
            var result = await PostImportAsync(previewOnly: true);
            if (myVersion != selectionVersion)
            {
                // A newer file was picked while we were
                // waiting; let the newer preview win.
                return;
            }
            preview = result;
        }
        catch (Exception ex)
        {
            if (myVersion == selectionVersion)
            {
                error = $"{L["ImportPreviewFailed"]}: {ex.Message}";
            }
        }
        finally
        {
            if (myVersion == selectionVersion)
            {
                previewing = false;
            }
        }
    }

    private async Task ApplyImport()
    {
        if (form.File is null)
        {
            error = L["ImportNoFile"];
            return;
        }

        applying = true;
        error = null;
        try
        {
            applied = await PostImportAsync(previewOnly: false);
        }
        catch (Exception ex)
        {
            error = $"{L["ImportFailed"]}: {ex.Message}";
        }
        finally
        {
            applying = false;
        }
    }

    private void CancelPreview()
    {
        preview = null;
        applied = null;
        error = null;
        form.File = null;
    }

    private async Task<ImportResultDto> PostImportAsync(bool previewOnly)
    {
        using MultipartFormDataContent content = new();
        using StreamContent fileContent = new(form.File!.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024));
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");
        content.Add(fileContent, "file", form.File.Name);
        content.Add(new StringContent(Id.ToString()), "targetWorkspaceId");
        content.Add(new StringContent(previewOnly ? "true" : "false"), "previewOnly");

        HttpResponseMessage response = await Http.PostAsync("api/imports/trello", content);
        if (response.IsSuccessStatusCode)
        {
            return await response.Content.ReadFromJsonAsync<ImportResultDto>()
                   ?? new ImportResultDto();
        }

        string body = await response.Content.ReadAsStringAsync();
        throw new InvalidOperationException(
            $"{(int)response.StatusCode}: {body}");
    }

    private sealed class ImportForm
    {
        public Microsoft.AspNetCore.Components.Forms.IBrowserFile? File { get; set; }
    }

    private sealed class ImportResultDto
    {
        public IReadOnlyList<Guid> ImportedBoardIds { get; set; } = [];
        public IReadOnlyList<Guid> ImportedListIds { get; set; } = [];
        public IReadOnlyList<Guid> ImportedCardIds { get; set; } = [];
        public IReadOnlyList<Guid> ImportedLabelIds { get; set; } = [];
        public ImportPreviewDto? Preview { get; set; }
    }

    private sealed class ImportPreviewDto
    {
        public int BoardCount { get; set; }
        public int ListCount { get; set; }
        public int CardCount { get; set; }
        public int LabelCount { get; set; }
        public int MemberCount { get; set; }
        public IReadOnlyList<string> SampleBoardNames { get; set; } = [];
        public IReadOnlyList<string> SampleListNames { get; set; } = [];
        public IReadOnlyList<string> SampleCardNames { get; set; } = [];
        public bool WasApplied { get; set; }
    }
}
