@page "/workspaces/{WorkspaceId:guid}/scim"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Cardscape.Web.Services.Api
@using Microsoft.Extensions.Localization
@inject IScimApiClient ScimApi
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ScimTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["ScimTitle"]"
                Subtitle="@L["ScimBlurb"]"
                Hint="@EndpointUrl" />

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="@L["ScimIssueToken"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
            <RadzenTemplateForm TItem="IssueModel" Data="@issueModel" Submit="@IssueToken">
                <LabeledField Text="@L["ScimTokenName"]" Component="scim-name">
                    <RadzenTextBox @bind-Value="issueModel.Name" Name="scim-name" Style="width:100%" />
                </LabeledField>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="@L["ScimIssueToken"]" ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Primary" IsBusy="@issuing" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenStack>
    </RadzenCard>

    @if (newTokenPlaintext is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span">@L["ScimTokenShownOnce"]</RadzenText>
            <code>@newTokenPlaintext</code>
        </RadzenAlert>
    }

    <RadzenText Text="@L["ScimExistingTokens"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />

    @if (tokens is null)
    {
        <RadzenText Text="@L["ActionLoading"]" />
    }
    else if (tokens.Count == 0)
    {
        <RadzenText Text="@L["ScimNoTokens"]" />
    }
    else
    {
        <RadzenStack Gap="0.5rem">
            @foreach (var t in tokens)
            {
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Gap="0.5rem">
                        <RadzenText Text="@t.Name" TextStyle="TextStyle.H5" TagName="TagName.H4" />
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
                            @L["ScimPrefix"]: <code>@t.TokenPrefix</code>
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
                            @L["ScimLastUsed"]: @(t.LastUsedAt?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? L["ScimNever"])
                        </RadzenText>
                        @if (t.IsRevoked)
                        {
                            <RadzenBadge Text="@L["ScimRevoked"]" BadgeStyle="BadgeStyle.Danger" />
                        }
                        @if (!t.IsRevoked)
                        {
                            <RadzenButton Text="@L["ScimRevoke"]" ButtonStyle="ButtonStyle.Danger"
                                          Click="@(() => Revoke(t.Id))" />
                        }
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    }
</RadzenStack>

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private IReadOnlyList<ScimTokenDto>? tokens;
    private string? newTokenPlaintext;
    private bool issuing;
    private readonly IssueModel issueModel = new();

    private string EndpointUrl => $"{Nav.BaseUri}scim/v2/";

    protected override async Task OnInitializedAsync()
    {
        var result = await ScimApi.ListTokensAsync(WorkspaceId);
        tokens = result.IsSuccess ? result.Value : [];
    }

    private async Task IssueToken()
    {
        if (string.IsNullOrWhiteSpace(issueModel.Name))
        {
            return;
        }

        issuing = true;
        try
        {
            var result = await ScimApi.IssueTokenAsync(WorkspaceId, issueModel.Name);
            if (result.IsSuccess)
            {
                newTokenPlaintext = result.Value!.PlaintextToken;
                issueModel.Name = string.Empty;
                var listResult = await ScimApi.ListTokensAsync(WorkspaceId);
                tokens = listResult.IsSuccess ? listResult.Value : tokens;
            }
        }
        finally
        {
            issuing = false;
        }
    }

    private async Task Revoke(Guid tokenId)
    {
        var result = await ScimApi.RevokeTokenAsync(WorkspaceId, tokenId);
        if (result.IsSuccess)
        {
            var listResult = await ScimApi.ListTokensAsync(WorkspaceId);
            tokens = listResult.IsSuccess ? listResult.Value : tokens;
        }
    }

    private sealed class IssueModel
    {
        public string Name { get; set; } = string.Empty;
    }
}
