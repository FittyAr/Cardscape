@page "/account/api-tokens"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject ISecurityApiClient Security

<PageTitle>API tokens — Cardscape</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="API tokens"
                Actions="@(NewTokenButton())" />

    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
        Long-lived bearer secrets for the MCP server and any other AI client.
        The cleartext is shown <RadzenText Text="only once" TextStyle="TextStyle.Body1" TagName="TagName.Span" /> at creation; after that
        only the prefix is recoverable.
    </RadzenText>

    @if (showCreate)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="CreateModel" Data="@createModel" Submit="@CreateToken">
                <LabeledField Text="Name" Component="token-name">
                    <RadzenTextBox @bind-Value="createModel.Name" Name="token-name"
                                   Placeholder="e.g. Cursor on laptop" Style="width:100%" />
                </LabeledField>

                <LabeledField Text="Scopes" Component="token-scopes">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenCheckBox @bind-Value="createModel.Read" Name="scope-read" />
                        <RadzenLabel Text="read" Component="scope-read" />
                        <RadzenCheckBox @bind-Value="createModel.Write" Name="scope-write" />
                        <RadzenLabel Text="write" Component="scope-write" />
                    </RadzenStack>
                </LabeledField>

                <LabeledField Text="Rate limit per hour" Component="token-rate" Help="0 disables the limit (token is never throttled).">
                    <RadzenNumeric TValue="int" @bind-Value="createModel.RateLimitPerHour" Name="token-rate"
                                   Min="0" Max="100000" Style="width:100%" />
                </LabeledField>

                <LabeledField Text="Burst size" Component="token-burst" Help="Maximum back-to-back requests before the per-hour refill kicks in.">
                    <RadzenNumeric TValue="int" @bind-Value="createModel.BurstSize" Name="token-burst"
                                   Min="1" Max="10000" Style="width:100%" />
                </LabeledField>

                @if (error is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Class="rz-mt-2">
                        @error
                    </RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelCreate" />
                    <RadzenButton Text="Create" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@busy" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @if (issuedSecret is not null)
    {
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Gap="0.5rem">
                <RadzenText Text="Token created" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                <RadzenText>Copy this secret now. It will not be shown again.</RadzenText>
                <SecretBox Secret="@issuedSecret" />
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="I've copied it" ButtonStyle="ButtonStyle.Primary"
                                  Click="@DismissIssuedSecret" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }

    @if (tokens is null)
    {
        <RadzenText Text="Loading…" />
    }
    else if (tokens.Count == 0)
    {
        <RadzenText Text="You haven't minted any API tokens yet." />
    }
    else
    {
        <RadzenStack Gap="0.5rem">
            @foreach (ApiTokenSummaryDto token in tokens)
            {
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="@token.Name" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                                <code>@token.SecretPrefix…</code>
                                · @string.Join(", ", token.Scopes)
                                · created @token.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd")
                                @if (token.LastUsedAt is not null)
                                {
                                    <span> · last used @token.LastUsedAt.Value.LocalDateTime.ToString("yyyy-MM-dd")</span>
                                }
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                                @if (token.RateLimitPerHour == 0)
                                {
                                    <span>rate limit: <RadzenText Text="disabled" TextStyle="TextStyle.Body1" TagName="TagName.Span" /></span>
                                }
                                else
                                {
                                    <span>
                                        rate limit: <RadzenText Text="@($"{token.RateLimitPerHour}/hr")" TextStyle="TextStyle.Body1" TagName="TagName.Span" />,
                                        burst <RadzenText Text="@token.BurstSize.ToString()" TextStyle="TextStyle.Body1" TagName="TagName.Span" />
                                    </span>
                                }
                                @if (rateLimitById.TryGetValue(token.Id, out ApiTokenRateLimitStatusDto? status))
                                {
                                    <span> · remaining <RadzenText Text="@($"{Math.Floor(status.AvailableTokens)}/{status.BurstSize}")" TextStyle="TextStyle.Body1" TagName="TagName.Span" /></span>
                                }
                            </RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                            @if (token.RevokedAt is null)
                            {
                                <RadzenBadge Text="Active" BadgeStyle="BadgeStyle.Success" />
                                <RadzenButton Text="Revoke" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => Revoke(token))" />
                            }
                            else
                            {
                                <RadzenBadge Text="Revoked" BadgeStyle="BadgeStyle.Light" />
                            }
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    }
</RadzenStack>

@code {
    private IReadOnlyList<ApiTokenSummaryDto>? tokens;
    private Dictionary<Guid, ApiTokenRateLimitStatusDto> rateLimitById = new();
    private bool showCreate;
    private bool busy;
    private string? error;
    private string? issuedSecret;
    private readonly CreateModel createModel = new();

    private RenderFragment NewTokenButton() => __builder =>
    {
        <RadzenButton Text="New token" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" Disabled="@(issuedSecret is not null)" />
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        ApiResult<IReadOnlyList<ApiTokenSummaryDto>> result = await Security.ListTokensAsync();
        tokens = result.IsSuccess ? result.Value : [];

        rateLimitById.Clear();
        if (tokens is null)
        {
            return;
        }

        foreach (ApiTokenSummaryDto t in tokens)
        {
            if (t.RevokedAt is not null)
            {
                continue;
            }

            ApiResult<ApiTokenRateLimitStatusDto> s = await Security.GetRateLimitStatusAsync(t.Id);
            if (s.IsSuccess && s.Value is not null)
            {
                rateLimitById[t.Id] = s.Value;
            }
        }
    }

    private async Task CreateToken()
    {
        busy = true;
        error = null;
        try
        {
            List<string> scopes = new();
            if (createModel.Read)
            {
                scopes.Add("read");
            }

            if (createModel.Write)
            {
                scopes.Add("write");
            }

            if (scopes.Count == 0)
            {
                error = "Pick at least one scope.";
                return;
            }

            ApiResult<ApiTokenIssuanceDto> result = await Security.IssueTokenAsync(
                createModel.Name, scopes, expiresAt: null,
                rateLimitPerHour: createModel.RateLimitPerHour,
                burstSize: createModel.BurstSize);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            issuedSecret = result.Value!.CleartextSecret;
            createModel.Name = string.Empty;
            createModel.Read = true;
            createModel.Write = true;
            showCreate = false;

            await RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelCreate()
    {
        showCreate = false;
        error = null;
        createModel.Name = string.Empty;
        createModel.Read = true;
        createModel.Write = true;
    }

    private void DismissIssuedSecret()
    {
        issuedSecret = null;
    }

    private async Task Revoke(ApiTokenSummaryDto token)
    {
        ApiResult result = await Security.RevokeTokenAsync(token.Id, null);
        if (result.IsSuccess)
        {
            await RefreshAsync();
        }
    }

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public bool Read { get; set; } = true;
        public bool Write { get; set; } = true;
        public int RateLimitPerHour { get; set; } = 1000;
        public int BurstSize { get; set; } = 50;
    }
}
