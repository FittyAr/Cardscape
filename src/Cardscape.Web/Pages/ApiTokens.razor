@page "/account/api-tokens"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject ISecurityApiClient Security
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NavApiTokens"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["NavApiTokens"]"
                Actions="@(NewTokenButton())" />

    <RadzenText Text="@L["ApiTokensBlurb"]" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />

    @if (showCreate)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="CreateModel" Data="@createModel" Submit="@CreateTokenAsync">
                <LabeledField Text="@L["ApiTokensName"]" Component="token-name">
                    <RadzenTextBox @bind-Value="createModel.Name" Name="token-name"
                                   Placeholder="@L["ApiTokensNamePlaceholder"]" Style="width:100%" />
                </LabeledField>
                <RadzenRequiredValidator Component="token-name" Text="@L["ValidationRequired"]" />

                <LabeledField Text="@L["ApiTokensScopes"]" Component="token-scopes">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenCheckBox @bind-Value="createModel.Read" Name="scope-read" />
                        <RadzenLabel Text="read" Component="scope-read" />
                        <RadzenCheckBox @bind-Value="createModel.Write" Name="scope-write" />
                        <RadzenLabel Text="write" Component="scope-write" />
                    </RadzenStack>
                </LabeledField>

                <LabeledField Text="@L["ApiTokensRateLimit"]" Component="token-rate" Help="@L["ApiTokensRateLimitHelp"]">
                    <RadzenNumeric TValue="int" @bind-Value="createModel.RateLimitPerHour" Name="token-rate"
                                   Min="0" Max="100000" Style="width:100%" />
                </LabeledField>

                <LabeledField Text="@L["ApiTokensBurst"]" Component="token-burst" Help="@L["ApiTokensBurstHelp"]">
                    <RadzenNumeric TValue="int" @bind-Value="createModel.BurstSize" Name="token-burst"
                                   Min="1" Max="10000" Style="width:100%" />
                </LabeledField>

                @if (error is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Class="rz-mt-2">
                        @error
                    </RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="ButtonStyle.Light" Click="@CancelCreate" />
                    <RadzenButton Text="@L["ActionCreate"]" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@busy" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @if (issuedSecret is not null)
    {
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Gap="0.5rem">
                <RadzenText Text="@L["ApiTokensCreated"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                <RadzenText Text="@L["ApiTokensCopyNow"]" />
                <SecretBox Secret="@issuedSecret" />
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="@L["ApiTokensCopied"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@DismissIssuedSecret" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }

    @if (loading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@loadError</RadzenAlert>
    }
    else if (tokens is { Count: 0 })
    {
        <RadzenText Text="@L["ApiTokensEmpty"]" />
    }
    else if (tokens is not null)
    {
        <RadzenStack Gap="0.5rem">
            @foreach (ApiTokenSummaryDto token in tokens)
            {
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="@token.Name" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                                <code>@token.SecretPrefix…</code>
                                · @string.Join(", ", token.Scopes)
                                · @L["ApiTokensCreatedAt", token.CreatedAt.LocalDateTime.ToString("d")]
                                @if (token.LastUsedAt is not null)
                                {
                                    <span> · @L["ApiTokensLastUsed", token.LastUsedAt.Value.LocalDateTime.ToString("d")]</span>
                                }
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                                @if (token.RateLimitPerHour == 0)
                                {
                                    <span>@L["ApiTokensRateLimitDisabled"]</span>
                                }
                                else
                                {
                                    <span>
                                        @L["ApiTokensRateLimitSummary", token.RateLimitPerHour, token.BurstSize]
                                    </span>
                                }
                                @if (rateLimitById.TryGetValue(token.Id, out ApiTokenRateLimitStatusDto? status))
                                {
                                    <span> · @L["ApiTokensRemaining", Math.Floor(status.AvailableTokens), status.BurstSize]</span>
                                }
                            </RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                            @if (token.RevokedAt is null)
                            {
                                <RadzenBadge Text="@L["WebhooksActive"]" BadgeStyle="BadgeStyle.Success" />
                                <RadzenButton Text="@L["ScimRevoke"]" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => RevokeAsync(token))" />
                            }
                            else
                            {
                                <RadzenBadge Text="@L["ScimRevoked"]" BadgeStyle="BadgeStyle.Light" />
                            }
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    }
</RadzenStack>

@code {
    private IReadOnlyList<ApiTokenSummaryDto>? tokens;
    private Dictionary<Guid, ApiTokenRateLimitStatusDto> rateLimitById = new();
    private bool showCreate;
    private bool busy;
    private bool loading;
    private string? error;
    private string? loadError;
    private string? issuedSecret;
    private readonly CreateModel createModel = new();

    private RenderFragment NewTokenButton() => __builder =>
    {
        <RadzenButton Text="@L["ApiTokensNew"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" Disabled="@(issuedSecret is not null)" />
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        loading = true;
        loadError = null;
        try
        {
            ApiResult<IReadOnlyList<ApiTokenSummaryDto>> result = await Security.ListTokensAsync();
            if (!result.IsSuccess || result.Value is null)
            {
                tokens = null;
                rateLimitById.Clear();
                loadError = result.Error ?? L["ApiTokensLoadFailed"];
                return;
            }

            tokens = result.Value;
            ApiTokenSummaryDto[] activeTokens = tokens.Where(t => t.RevokedAt is null).ToArray();
            ApiResult<ApiTokenRateLimitStatusDto>[] statuses = await Task.WhenAll(
                activeTokens.Select(t => Security.GetRateLimitStatusAsync(t.Id)));

            rateLimitById = activeTokens
                .Zip(statuses)
                .Where(pair => pair.Second.IsSuccess && pair.Second.Value is not null)
                .ToDictionary(pair => pair.First.Id, pair => pair.Second.Value!);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CreateTokenAsync()
    {
        busy = true;
        error = null;
        try
        {
            List<string> scopes = new();
            if (createModel.Read)
            {
                scopes.Add("read");
            }

            if (createModel.Write)
            {
                scopes.Add("write");
            }

            if (scopes.Count == 0)
            {
                error = L["ApiTokensScopeRequired"];
                return;
            }

            ApiResult<ApiTokenIssuanceDto> result = await Security.IssueTokenAsync(
                createModel.Name, scopes, expiresAt: null,
                rateLimitPerHour: createModel.RateLimitPerHour,
                burstSize: createModel.BurstSize);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            issuedSecret = result.Value!.CleartextSecret;
            createModel.Name = string.Empty;
            createModel.Read = true;
            createModel.Write = true;
            showCreate = false;

            await RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelCreate()
    {
        showCreate = false;
        error = null;
        createModel.Name = string.Empty;
        createModel.Read = true;
        createModel.Write = true;
    }

    private void DismissIssuedSecret()
    {
        issuedSecret = null;
    }

    private async Task RevokeAsync(ApiTokenSummaryDto token)
    {
        ApiResult result = await Security.RevokeTokenAsync(token.Id, null);
        if (result.IsSuccess)
        {
            await RefreshAsync();
            return;
        }

        loadError = result.Error ?? L["ApiTokensRevokeFailed"];
    }

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public bool Read { get; set; } = true;
        public bool Write { get; set; } = true;
        public int RateLimitPerHour { get; set; } = 1000;
        public int BurstSize { get; set; } = 50;
    }
}
