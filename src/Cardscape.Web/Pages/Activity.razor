@page "/boards/{BoardId:guid}/activity"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Text.Json
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject IActivitiesApiClient Activities
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<PageTitle>Activity — Cardscape</PageTitle>

<PageHeader Title="Activity">
    <Actions>
        <RadzenButton Text="Back to board" Icon="arrow_back" ButtonStyle="ButtonStyle.Light"
                      Click="@(() => Nav.NavigateTo($"boards/{BoardId}"))" />
    </Actions>
</PageHeader>

@if (loading && items is null)
{
    <RadzenText Text="Loading activity…" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else if (items is null || items.Count == 0)
{
    <RadzenText Text="No activity recorded on this board yet." TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else
{
    <RadzenStack Gap="0.75rem">
        @foreach (ActivityDto a in items)
        {
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenBadge Text="@KindLabel(a.KindName)" BadgeStyle="@KindBadgeStyle(a.KindName)" />
                    <RadzenText Text="@a.KindName" TextStyle="TextStyle.Body1" TagName="TagName.Span" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                        · @a.OccurredAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                    </RadzenText>
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary rz-mt-1">
                    @if (a.CardId is Guid cardId)
                    {
                        <span>card: </span>
                        <RadzenLink Path="@($"cards/{cardId}")" Text="@cardId.ToString()[..8]" />
                    }
                    <span> · actor: @a.ActorId.ToString()[..8]</span>
                </RadzenText>
                @if (!string.IsNullOrEmpty(FormatPayload(a)))
                {
                    <RadzenText Text="@FormatPayload(a)" TextStyle="TextStyle.Body2" class="rz-mt-2" />
                }
            </RadzenCard>
        }
    </RadzenStack>

    @if (!string.IsNullOrEmpty(nextCursor))
    {
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" class="rz-mt-3">
            <RadzenButton Text="Load more" ButtonStyle="ButtonStyle.Light" Disabled="@loading"
                          Click="@LoadMoreAsync" IsBusy="@loading" />
        </RadzenStack>
    }
}

@if (error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" class="rz-mt-3">
        @error
    </RadzenAlert>
}

@code {
    [Parameter] public Guid BoardId { get; set; }

    private List<ActivityDto>? items;
    private string? nextCursor;
    private bool loading;
    private string? error;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        error = null;
        try
        {
            ApiResult<ActivityPageDto> result = await Activities.ListForBoardAsync(BoardId);
            if (result.IsSuccess && result.Value is not null)
            {
                items = result.Value.Items.ToList();
                nextCursor = result.Value.NextCursor;
            }
            else
            {
                error = result.Error;
                items = [];
                nextCursor = null;
            }
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (string.IsNullOrEmpty(nextCursor))
        {
            return;
        }

        loading = true;
        error = null;
        try
        {
            ApiResult<ActivityPageDto> result = await Activities.ListForBoardAsync(
                BoardId, cursor: nextCursor);
            if (result.IsSuccess && result.Value is not null)
            {
                items ??= [];
                items.AddRange(result.Value.Items);
                nextCursor = result.Value.NextCursor;
            }
            else
            {
                error = result.Error;
            }
        }
        finally
        {
            loading = false;
        }
    }

    private static string KindLabel(string kind) => kind switch
    {
        "BoardCreated" => "Board",
        "CardCreated" => "Card",
        "CardMoved" => "Move",
        "CardCompleted" => "Done",
        "CardReopened" => "Reopen",
        "CardRenamed" => "Rename",
        "CardArchived" => "Archive",
        "CardRestored" => "Restore",
        "CommentAdded" => "Comment",
        _ => kind
    };

    private static BadgeStyle KindBadgeStyle(string kind) => kind switch
    {
        "CardCreated" => BadgeStyle.Success,
        "CardMoved" => BadgeStyle.Info,
        "CardCompleted" => BadgeStyle.Success,
        "CardReopened" => BadgeStyle.Warning,
        "CardArchived" => BadgeStyle.Dark,
        "CardRestored" => BadgeStyle.Light,
        "CommentAdded" => BadgeStyle.Info,
        "BoardCreated" => BadgeStyle.Primary,
        _ => BadgeStyle.Light
    };

    private static string FormatPayload(ActivityDto a)
    {
        if (string.IsNullOrEmpty(a.PayloadJson) || a.PayloadJson == "{}")
        {
            return string.Empty;
        }

        try
        {
            using JsonDocument doc = JsonDocument.Parse(a.PayloadJson);
            if (doc.RootElement.ValueKind == JsonValueKind.Object)
            {
                List<string> parts = [];
                foreach (JsonProperty p in doc.RootElement.EnumerateObject())
                {
                    parts.Add($"{p.Name}: {p.Value}");
                }

                return string.Join(" · ", parts);
            }
        }
        catch
        {
            // fall through
        }

        return a.PayloadJson;
    }
}
