@page "/settings/oauth-apps"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject IOAuthAppsApiClient OAuthApps

<PageTitle>@L["OAuthAppsTitle"] @L["PageTitleSuffix"]</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <h1>@L["OAuthAppsTitle"]</h1>
        <p class="muted">@L["OAuthAppsBlurb"]</p>
    </div>

    <RadzenCard>
        <h3>@L["OAuthAppsProtocol"]</h3>
        <p class="muted">
            <code>POST /oauth/authorize</code> · <code>POST /oauth/token</code> ·
            <code>POST /oauth/revoke</code> · <code>GET /oauth/userinfo</code>
        </p>
        <p class="muted">@L["OAuthAppsScopes"]</p>
        <ul>
            <li><code>cards.read</code> · <code>cards.write</code></li>
            <li><code>boards.read</code> · <code>boards.write</code></li>
            <li><code>comments.write</code> · <code>webhooks.read</code> · <code>webhooks.write</code></li>
            <li><code>admin</code></li>
        </ul>
        <p class="muted">
            @L["OAuthAppsDocsHint"]
            <a href="docs/api/01-oauth-flow.md" target="_blank"><code>docs/api/01-oauth-flow.md</code></a>
        </p>
    </RadzenCard>

    <RadzenCard>
        <h3>@L["OAuthAppsRegister"]</h3>
        <p class="muted">@L["OAuthAppsRegisterBlurb"]</p>

        <RadzenTemplateForm TItem="RegisterFormModel" Data="@form" Submit="@OnSubmit">
            <div class="form-row">
                <RadzenLabel Text="@L["OAuthAppsNameLabel"]" Component="name" />
                <RadzenTextBox Name="name" @bind-Value="form.Name" Style="width:100%" />
            </div>
            <div class="form-row">
                <RadzenLabel Text="@L["OAuthAppsRedirectLabel"]" Component="redirect" />
                <RadzenTextBox Name="redirect" @bind-Value="form.RedirectUri"
                               Placeholder="https://example.com/callback" Style="width:100%" />
                <small class="muted">@L["OAuthAppsRedirectHint"]</small>
            </div>
            <div class="form-row">
                <RadzenLabel Text="@L["OAuthAppsScopesLabel"]" Component="scopes" />
                <RadzenTextBox Name="scopes" @bind-Value="form.Scopes"
                               Placeholder="cards.read boards.read" Style="width:100%" />
                <small class="muted">@L["OAuthAppsScopesHint"]</small>
            </div>
            <RadzenButton Text="@L["OAuthAppsRegisterButton"]" ButtonType="ButtonType.Submit"
                          ButtonStyle="ButtonStyle.Primary" Disabled="@busy" />
        </RadzenTemplateForm>

        @if (registration is not null)
        {
            <div class="one-time-secret">
                <h4>@L["OAuthAppsOneTimeTitle"]</h4>
                <p class="muted">@L["OAuthAppsOneTimeWarning"]</p>
                <dl>
                    <dt>@L["OAuthAppsClientId"]</dt>
                    <dd><code>@registration.ClientId</code></dd>
                    <dt>@L["OAuthAppsClientSecret"]</dt>
                    <dd><code>@registration.ClientSecret</code></dd>
                </dl>
                <RadzenButton Text="@L["OAuthAppsDismissButton"]" Click="@(() => registration = null)"
                              ButtonStyle="ButtonStyle.Light" />
            </div>
        }
    </RadzenCard>

    <RadzenCard>
        <h3>@L["OAuthAppsYourApps"]</h3>
        @if (loading)
        {
            <p>@L["CommonLoading"]</p>
        }
        else if (apps.Count == 0)
        {
            <p class="muted">@L["OAuthAppsNoneRegistered"]</p>
        }
        else
        {
            <table class="oauth-apps-table">
                <thead>
                    <tr>
                        <th>@L["OAuthAppsTableName"]</th>
                        <th>@L["OAuthAppsTableClientId"]</th>
                        <th>@L["OAuthAppsTableScopes"]</th>
                        <th>@L["OAuthAppsTableStatus"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (OAuthAppSummaryDto app in apps)
                    {
                        <tr>
                            <td>@app.Name</td>
                            <td><code>@app.ClientId</code></td>
                            <td>@string.Join(", ", app.AllowedScopes)</td>
                            <td>
                                @if (app.IsRevoked)
                                {
                                    <span class="status-pill revoked">@L["OAuthAppsStatusRevoked"]</span>
                                }
                                else
                                {
                                    <span class="status-pill active">@L["OAuthAppsStatusActive"]</span>
                                }
                            </td>
                            <td>
                                @if (!app.IsRevoked)
                                {
                                    <RadzenButton Text="@L["OAuthAppsRevokeButton"]"
                                                  Click="@(() => RevokeAsync(app.Id))"
                                                  ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </RadzenCard>
</div>

@code {
    private readonly RegisterFormModel form = new();
    private OAuthAppRegistrationDto? registration;
    private IReadOnlyList<OAuthAppSummaryDto> apps = [];
    private bool loading = true;
    private bool busy;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task OnSubmit()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            IReadOnlyCollection<string> scopes = form.Scopes
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .ToList();
            ApiResult<OAuthAppRegistrationDto> result = await OAuthApps.RegisterAsync(
                new RegisterOAuthAppRequest(
                    form.Name.Trim(),
                    scopes,
                    [form.RedirectUri.Trim()]));
            if (result.IsSuccess && result.Value is not null)
            {
                registration = result.Value;
                form.Reset();
                await ReloadAsync();
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RevokeAsync(Guid appId)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            await OAuthApps.RevokeAsync(appId);
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        loading = true;
        try
        {
            ApiResult<IReadOnlyList<OAuthAppSummaryDto>> result = await OAuthApps.ListAsync();
            apps = result.IsSuccess && result.Value is not null ? result.Value : [];
        }
        finally
        {
            loading = false;
        }
    }

    private sealed class RegisterFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string RedirectUri { get; set; } = string.Empty;
        public string Scopes { get; set; } = "cards.read boards.read";

        public void Reset()
        {
            Name = string.Empty;
            RedirectUri = string.Empty;
            Scopes = "cards.read boards.read";
        }
    }
}
