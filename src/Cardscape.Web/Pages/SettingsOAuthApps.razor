@page "/settings/oauth-apps"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject IOAuthAppsApiClient OAuthApps

<PageTitle>@L["OAuthAppsTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["OAuthAppsTitle"]" Subtitle="@L["OAuthAppsBlurb"]" />

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="@L["OAuthAppsProtocol"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
                <code>POST /oauth/authorize</code> · <code>POST /oauth/token</code> ·
                <code>POST /oauth/revoke</code> · <code>GET /oauth/userinfo</code>
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["OAuthAppsScopes"]</RadzenText>
            <ItemList>
                <li><code>cards.read</code> · <code>cards.write</code></li>
                <li><code>boards.read</code> · <code>boards.write</code></li>
                <li><code>comments.write</code> · <code>webhooks.read</code> · <code>webhooks.write</code></li>
                <li><code>admin</code></li>
            </ItemList>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
                @L["OAuthAppsDocsHint"]
                <RadzenLink Path="docs/api/01-oauth-flow.md" Target="_blank" Text="docs/api/01-oauth-flow.md" />
            </RadzenText>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="@L["OAuthAppsRegister"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["OAuthAppsRegisterBlurb"]</RadzenText>

            <RadzenTemplateForm TItem="RegisterFormModel" Data="@form" Submit="@OnSubmit">
                <LabeledField Text="@L["OAuthAppsNameLabel"]" Component="name">
                    <RadzenTextBox Name="name" @bind-Value="form.Name" Style="width:100%" />
                </LabeledField>
                <LabeledField Text="@L["OAuthAppsRedirectLabel"]" Component="redirect" Help="@L["OAuthAppsRedirectHint"]">
                    <RadzenTextBox Name="redirect" @bind-Value="form.RedirectUri"
                                   Placeholder="https://example.com/callback" Style="width:100%" />
                </LabeledField>
                <LabeledField Text="@L["OAuthAppsScopesLabel"]" Component="scopes" Help="@L["OAuthAppsScopesHint"]">
                    <RadzenTextBox Name="scopes" @bind-Value="form.Scopes"
                                   Placeholder="cards.read boards.read" Style="width:100%" />
                </LabeledField>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="@L["OAuthAppsRegisterButton"]" ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Primary" Disabled="@busy" />
                </RadzenStack>
            </RadzenTemplateForm>

            @if (registration is not null)
            {
                <RadzenCard Variant="Variant.Outlined" Class="rz-mt-3">
                    <RadzenStack Gap="0.5rem">
                        <RadzenText Text="@L["OAuthAppsOneTimeTitle"]" TextStyle="TextStyle.H5" TagName="TagName.H4" />
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["OAuthAppsOneTimeWarning"]</RadzenText>
                        <MetadataList Items="@OneTimeMetadataItems()" />
                        <RadzenButton Text="@L["OAuthAppsDismissButton"]" Click="@(() => registration = null)"
                                      ButtonStyle="ButtonStyle.Light" />
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="@L["OAuthAppsYourApps"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
            @if (loading)
            {
                <RadzenText Text="@L["CommonLoading"]" />
            }
            else if (apps.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["OAuthAppsNoneRegistered"]</RadzenText>
            }
            else
            {
                <RadzenDataGrid TItem="OAuthAppSummaryDto" Data="@apps" AllowSorting="true" AllowPaging="true" PageSize="20">
                    <Columns>
                        <RadzenDataGridColumn TItem="OAuthAppSummaryDto" Property="Name" Title="@L["OAuthAppsTableName"]" />
                        <RadzenDataGridColumn TItem="OAuthAppSummaryDto" Property="ClientId" Title="@L["OAuthAppsTableClientId"]">
                            <Template Context="app">
                                <code>@app.ClientId</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="OAuthAppSummaryDto" Property="AllowedScopes" Title="@L["OAuthAppsTableScopes"]">
                            <Template Context="app">
                                @string.Join(", ", app.AllowedScopes)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="OAuthAppSummaryDto" Property="IsRevoked" Title="@L["OAuthAppsTableStatus"]" Width="120px">
                            <Template Context="app">
                                @if (app.IsRevoked)
                                {
                                    <RadzenBadge Text="@L["OAuthAppsStatusRevoked"]" BadgeStyle="BadgeStyle.Danger" />
                                }
                                else
                                {
                                    <RadzenBadge Text="@L["OAuthAppsStatusActive"]" BadgeStyle="BadgeStyle.Success" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="OAuthAppSummaryDto" Title="" Sortable="false" Filterable="false" Width="120px">
                            <Template Context="app">
                                @if (!app.IsRevoked)
                                {
                                    <RadzenButton Text="@L["OAuthAppsRevokeButton"]"
                                                  Click="@(() => RevokeAsync(app.Id))"
                                                  ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    private readonly RegisterFormModel form = new();
    private OAuthAppRegistrationDto? registration;
    private IReadOnlyList<OAuthAppSummaryDto> apps = [];
    private bool loading = true;
    private bool busy;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task OnSubmit()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            IReadOnlyCollection<string> scopes = form.Scopes
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .ToList();
            ApiResult<OAuthAppRegistrationDto> result = await OAuthApps.RegisterAsync(
                new RegisterOAuthAppRequest(
                    form.Name.Trim(),
                    scopes,
                    [form.RedirectUri.Trim()]));
            if (result.IsSuccess && result.Value is not null)
            {
                registration = result.Value;
                form.Reset();
                await ReloadAsync();
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RevokeAsync(Guid appId)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            await OAuthApps.RevokeAsync(appId);
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        loading = true;
        try
        {
            ApiResult<IReadOnlyList<OAuthAppSummaryDto>> result = await OAuthApps.ListAsync();
            apps = result.IsSuccess && result.Value is not null ? result.Value : [];
        }
        finally
        {
            loading = false;
        }
    }

    private IReadOnlyList<MetadataListItem> OneTimeMetadataItems()
    {
        if (registration is null)
        {
            return [];
        }

        return new MetadataListItem[]
        {
            MetadataListItem.Text(L["OAuthAppsClientId"], registration.ClientId),
            MetadataListItem.Text(L["OAuthAppsClientSecret"], registration.ClientSecret),
        };
    }

    private sealed class RegisterFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string RedirectUri { get; set; } = string.Empty;
        public string Scopes { get; set; } = "cards.read boards.read";

        public void Reset()
        {
            Name = string.Empty;
            RedirectUri = string.Empty;
            Scopes = "cards.read boards.read";
        }
    }
}
