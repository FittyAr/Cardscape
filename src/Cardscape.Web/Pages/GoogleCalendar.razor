@page "/settings/integrations/google-calendar"
@* BUG-A8-011 — see test-results/beta/reports/A8-settings.md.
   The env file and external docs reference
   `/settings/google-calendar` but the canonical route was
   `/settings/integrations/google-calendar` (the same
   shape as `/settings/integrations/google-drive`). The
   second `@page` directive adds the shorter alias so a
   bookmarked link to either form still loads the page. *@
@page "/settings/google-calendar"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav
@inject IWorkspacesApiClient WorkspacesApi

<PageTitle>@L["GoogleCalendarTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem">
    <PageHeader Title="@L["GoogleCalendarTitle"]" Subtitle="@L["GoogleCalendarBlurb"]" />

    @if (connection is null)
    {
        <RadzenText Text="@L["ActionLoading"]" />
    }
    else if (connection.Id == Guid.Empty)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="@L["GoogleCalendarNotConnected"]" />
                @if (workspaces.Count == 0)
                {
                    <RadzenText Text="@L["GoogleCalendarPickWorkspace"]" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
                }
                else
                {
                    <RadzenFormField Text="@L["GoogleCalendarWorkspace"]" Component="gcal-workspace">
                        <RadzenDropDown Data="@workspaces"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        @bind-Value="selectedWorkspaceId"
                                        Name="gcal-workspace"
                                        AllowClear="true"
                                        Placeholder="@L["GoogleCalendarSelectWorkspace"]"
                                        Style="width: 100%; max-width: 360px;" />
                    </RadzenFormField>
                    <RadzenButton Text="@L["GoogleCalendarConnect"]"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@(selectedWorkspaceId is null)"
                                  Click="@Connect" />
                }
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="@($"{L["GoogleCalendarConnectedAs"]} {connection.GoogleEmail}")" TextStyle="TextStyle.H5" TagName="TagName.H2" />
                <RadzenText Text="@L["GoogleCalendarCalendarId"]" TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
                    <code>@connection.CalendarId</code>
                </RadzenText>
                @if (connection.LastSyncedAt is not null)
                {
                    <RadzenText Text="@($"{L["GoogleCalendarLastSync"]}: {connection.LastSyncedAt.Value.LocalDateTime:yyyy-MM-dd HH:mm}")"
                                TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
                }
                @if (connection.LastSyncError is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                        @connection.LastSyncError
                    </RadzenAlert>
                }
                <RadzenButton Text="@L["GoogleCalendarRevoke"]"
                              ButtonStyle="ButtonStyle.Danger"
                              Click="@Revoke" />
            </RadzenStack>
        </RadzenCard>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            @error
        </RadzenAlert>
    }
</RadzenStack>

@code {
    [Inject] private IGoogleCalendarApiClient Api { get; set; } = default!;

    private GoogleCalendarConnectionDto? connection;
    private IReadOnlyList<WorkspaceDto> workspaces = [];
    private Guid? selectedWorkspaceId;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync();
        connection = result.IsSuccess ? result.Value : Empty();

        var wsResult = await WorkspacesApi.ListAsync();
        workspaces = wsResult.IsSuccess && wsResult.Value is not null
            ? wsResult.Value
            : [];
    }

    private static GoogleCalendarConnectionDto Empty() => new(
        Guid.Empty, Guid.Empty, Guid.Empty, string.Empty, string.Empty,
        null, null, null, false);

    private void Connect()
    {
        if (selectedWorkspaceId is null)
        {
            error = L["GoogleCalendarSelectWorkspaceFirst"];
            return;
        }

        string url = Api.BuildOAuthStartUrl(selectedWorkspaceId.Value);
        Nav.NavigateTo(url, forceLoad: true);
    }

    private async Task Revoke()
    {
        error = null;
        var result = await Api.RevokeAsync();
        if (!result.IsSuccess)
        {
            error = result.Error;
            return;
        }
        connection = Empty();
    }
}
