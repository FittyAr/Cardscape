@page "/not-found"
@layout MainLayout
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 32rem;">
    <RadzenText Text="@L["NotFoundTitle"]" TextStyle="TextStyle.H4" TagName="TagName.H1" />
    <RadzenText Text="@L["NotFoundBlurb"]" TextStyle="TextStyle.Body1" />
    <RadzenLink Path="" Text="@L["NotFoundBackHome"]" />
</RadzenStack>
