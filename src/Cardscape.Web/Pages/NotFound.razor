@page "/not-found"
@* BETA-A10-002 — see test-results/beta/round-2/reports/A10-qa-cross.md.

   The previous version declared @layout MainLayout.
   MainLayout wraps its body in an <AuthorizeView>, so an
   unauthenticated user navigating to /not-found was
   redirected to /login instead of seeing the 404 page
   ("Back to home" link). The fix is to drop the @layout
   directive so NotFound renders with the framework's
   default layout (Router-provided), which is just a
   plain <Body/> with no auth check. The 404 page is the
   one place in the app where the user has no context to
   lose — they're lost already.
*@
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 32rem; padding: 2rem;">
    <RadzenText Text="@L["NotFoundTitle"]" TextStyle="TextStyle.H4" TagName="TagName.H1" />
    <RadzenText Text="@L["NotFoundBlurb"]" TextStyle="TextStyle.Body1" />
    <RadzenLink Path="" Text="@L["NotFoundBackHome"]" />
</RadzenStack>
