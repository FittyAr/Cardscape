@page "/planner"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits DueDatesPageBase

<PageTitle>@L["NavPlanner"] @L["PageTitleSuffix"]</PageTitle>

<PageHeader Title="@Month.Label" Subtitle="@L["PlannerSubtitle", Month.Label]">
    <Actions>
        <MonthNavigator Month="@Month" Disabled="@IsLoading" MonthChanged="@ShowMonthAsync" />
    </Actions>
</PageHeader>

@if (IsLoading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="@ProgressBarMode.Indeterminate" />
}
else if (Error is not null)
{
    <RadzenAlert AlertStyle="@AlertStyle.Danger" Variant="@Variant.Flat" AllowClose="false">@Error</RadzenAlert>
}
else if (swimlanes.Count == 0)
{
    <RadzenText Text="@L["PlannerEmpty"]" TextStyle="@TextStyle.Body2" class="rz-color-text-secondary" />
}
else
{
    <RadzenStack Gap="1rem">
        @foreach (Swimlane lane in swimlanes)
        {
            <RadzenCard Variant="@Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="@lane.ListName" TextStyle="@TextStyle.H6" TagName="@TagName.H3" />
                        <RadzenText Text="@lane.BoardName" TextStyle="@TextStyle.Caption"
                                    class="rz-color-text-secondary" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.25rem">
                        @foreach (CalendarEntryDto entry in lane.Entries)
                        {
                            <RadzenBadge BadgeStyle="@BadgeStyleFor(entry)"
                                         Text="@($"{entry.DueDate.LocalDateTime:d} · {entry.Title}")"
                                         title="@($"{entry.Title} — {entry.DueDate.LocalDateTime:g}")"
                                         IsClickable="true"
                                         Click="@(() => OpenCard(entry.CardId))" />
                        }
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
}

@code {
    private IReadOnlyList<Swimlane> swimlanes = [];

    private sealed record Swimlane(string BoardName, string ListName, IReadOnlyList<CalendarEntryDto> Entries);

    protected override void OnEntriesLoaded() =>
        swimlanes =
        [
            .. Entries
                .GroupBy(entry => entry.ListId)
                .Select(group => new Swimlane(
                    group.First().BoardName,
                    group.First().ListName,
                    [.. group.OrderBy(entry => entry.DueDate)]))
                .OrderBy(lane => lane.BoardName)
                .ThenBy(lane => lane.ListName),
        ];

    private static BadgeStyle BadgeStyleFor(CalendarEntryDto entry) => entry switch
    {
        { IsCompleted: true } => BadgeStyle.Success,
        { IsOverdue: true } => BadgeStyle.Danger,
        _ => BadgeStyle.Info,
    };
}
