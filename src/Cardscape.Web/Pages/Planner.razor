@page "/planner"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject ICardsApiClient Cards
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<PageTitle>Planner — Cardscape</PageTitle>

<PageHeader Title="@monthLabel"
            Subtitle="@($"Cards with a due date in {monthLabel}, grouped by list (one swimlane per list). Click a card to open it.")">
    <Actions>
        <RadzenButton Text="◀" ButtonStyle="ButtonStyle.Light" Click="@PrevMonth"
                      aria-label="Previous month" title="Previous month" />
        <RadzenButton Text="Today" ButtonStyle="ButtonStyle.Light" Click="@GoToCurrentMonth"
                      aria-label="Jump to current month" title="Jump to current month" />
        <RadzenButton Text="▶" ButtonStyle="ButtonStyle.Light" Click="@NextMonth"
                      aria-label="Next month" title="Next month" />
    </Actions>
</PageHeader>

@if (swimlanes.Count == 0)
{
    <RadzenText Text="No due dates in this range." TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else
{
    <RadzenStack Gap="1rem">
        @foreach (Swimlane lane in swimlanes)
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="@lane.Title" TextStyle="TextStyle.H6" TagName="TagName.H3" />
                        <RadzenText Text="@lane.BoardName" TextStyle="TextStyle.Caption"
                                    class="rz-color-text-secondary" />
                    </RadzenStack>
                    <RadzenStack Gap="0.25rem">
                        @foreach (CalendarEntryDto entry in lane.Entries)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                         Text="@entry.Title"
                                         title="@($"{entry.Title} — {entry.DueDate.LocalDateTime:yyyy-MM-dd}")"
                                         IsClickable="true"
                                         Click="@(() => Nav.NavigateTo($"cards/{entry.CardId}"))" />
                        }
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
}

@code {
    // BUG-A6-007 — see test-results/beta/reports/A6-views.md. The
    // swimlane header used to read "List 2a33ae28" (a truncated
    // GUID) because the API DTO didn't carry the list's human
    // name. CalendarEntryDto now exposes `ListName`; we use it
    // here, falling back to the truncated id only if the API
    // ever returns an empty string.
    private DateTimeOffset firstOfMonth = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, TimeSpan.Zero);
    private IReadOnlyList<CalendarEntryDto> entries = [];
    private List<Swimlane> swimlanes = [];
    private string monthLabel = string.Empty;

    private sealed record Swimlane(Guid ListId, string Title, string BoardName, List<CalendarEntryDto> Entries);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        DateTimeOffset from = firstOfMonth;
        DateTimeOffset to = firstOfMonth.AddMonths(1);

        ApiResult<IReadOnlyList<CalendarEntryDto>> result = await Cards.CalendarAsync(from, to, boardId: null);
        entries = result.IsSuccess && result.Value is not null
            ? result.Value
            : (IReadOnlyList<CalendarEntryDto>)Array.Empty<CalendarEntryDto>();

        monthLabel = firstOfMonth.ToString("MMMM yyyy");

        swimlanes = entries
            .GroupBy(e => e.ListId)
            .Select(g => new Swimlane(
                g.Key,
                string.IsNullOrWhiteSpace(g.First().ListName) ? $"List {g.Key.ToString()[..8]}" : g.First().ListName,
                g.First().BoardName,
                g.OrderBy(e => e.DueDate).ToList()))
            .OrderBy(s => s.BoardName)
            .ThenBy(s => s.Title)
            .ToList();
    }

    private async Task PrevMonth()
    {
        firstOfMonth = firstOfMonth.AddMonths(-1);
        await ReloadAsync();
    }

    private async Task NextMonth()
    {
        firstOfMonth = firstOfMonth.AddMonths(1);
        await ReloadAsync();
    }

    private async Task GoToCurrentMonth()
    {
        DateTime utcNow = DateTime.UtcNow;
        firstOfMonth = new DateTimeOffset(utcNow.Year, utcNow.Month, 1, 0, 0, 0, TimeSpan.Zero);
        await ReloadAsync();
    }
}
