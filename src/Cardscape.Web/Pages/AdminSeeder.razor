@page "/admin/seeder"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

@* The seeder moved into a tab of System settings; keep old links working. *@

<PageTitle>@L["NavSystemSettings"] @L["PageTitleSuffix"]</PageTitle>
<LoadingState Size="LoadingSize.Page" />

@code {
    protected override void OnInitialized() =>
        Nav.NavigateTo("admin/settings?tab=seeder", replace: true);
}
