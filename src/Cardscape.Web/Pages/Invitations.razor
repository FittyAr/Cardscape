@page "/invitations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IInvitationsApiClient InvitationsApi
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["InvitationsTitle"] @L["PageTitleSuffix"]</PageTitle>

<PageHeader Title="@L["InvitationsTitle"]"
            Subtitle="@L["InvitationsSubtitle"]" />

@if (invitations is null)
{
    <RadzenText Text="@L["InvitationsLoading"]" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else if (invitations.Count == 0)
{
    <RadzenText Text="@L["InvitationsEmpty"]" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else
{
    <RadzenStack Gap="0.75rem">
        @foreach (WorkspaceInvitationDto inv in invitations)
        {
            <RadzenCard>
                <RadzenText Text="@inv.WorkspaceName" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                    @L["InvitationsMetadata", RoleName(inv.Role), inv.InvitedBy == Guid.Empty ? L["InvitationsSystem"] : inv.InvitedBy.ToString(), inv.ExpiresAt.LocalDateTime.ToString("d")]
                </RadzenText>
            </RadzenCard>
        }
    </RadzenStack>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary rz-mt-3">
        @L["InvitationsAcceptHint"]
    </RadzenText>
}

@if (error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" class="rz-mt-3">
        @error
    </RadzenAlert>
}

@code {
    private IReadOnlyList<WorkspaceInvitationDto>? invitations;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        ApiResult<IReadOnlyList<WorkspaceInvitationDto>> result = await InvitationsApi.ListPendingAsync();
        invitations = result.IsSuccess ? result.Value : [];
        if (!result.IsSuccess)
        {
            error = result.Error;
        }
    }

    private string RoleName(WorkspaceRole role) => role switch
    {
        WorkspaceRole.Admin => L["WorkspaceRoleAdmin"],
        WorkspaceRole.Member => L["WorkspaceRoleMember"],
        WorkspaceRole.Observer => L["WorkspaceRoleObserver"],
        _ => L["CommonUnknown"]
    };
}
