@page "/invitations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IInvitationsApiClient InvitationsApi
@inject InstanceSettingsState Instance
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["InvitationsTitle"] @L["PageTitleSuffix"]</PageTitle>

<PageHeader Title="@L["InvitationsTitle"]"
            Subtitle="@L["InvitationsSubtitle"]" />

@if (loading)
{
    <LoadingState Size="LoadingSize.Page" />
}
else if (error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@error</RadzenAlert>
}
else if (invitations is { Count: 0 })
{
    <RadzenText Text="@L["InvitationsEmpty"]" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else if (invitations is not null)
{
    <RadzenStack Gap="0.75rem">
        @foreach (WorkspaceInvitationDto inv in invitations)
        {
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="@inv.WorkspaceName" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                            @L["InvitationsMetadata", RoleName(inv.Role), inv.InvitedBy == Guid.Empty ? L["InvitationsSystem"] : inv.InvitedByName ?? inv.InvitedBy.ToString(), inv.ExpiresAt.LocalDateTime.ToString("d")]
                        </RadzenText>
                    </RadzenStack>
                    @if (CanAcceptFromInbox)
                    {
                        <RadzenButton Text="@L["InvitationsAccept"]" Icon="check" ButtonStyle="ButtonStyle.Primary"
                                      IsBusy="@(acceptingId == inv.Id)" Disabled="@(acceptingId is not null)"
                                      aria-label="@L["InvitationsAcceptAria", inv.WorkspaceName]"
                                      Click="@(() => AcceptAsync(inv))" />
                    }
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
    @if (acceptError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" class="rz-mt-3">@acceptError</RadzenAlert>
    }
    @if (!CanAcceptFromInbox)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary rz-mt-3">
            @L["InvitationsAcceptHint"]
        </RadzenText>
    }
}

@code {
    private IReadOnlyList<WorkspaceInvitationDto>? invitations;
    private bool loading;
    private string? error;
    private string? acceptError;
    private Guid? acceptingId;

    // The server only accepts from the inbox (without the link's token)
    // while public registration is closed; see AcceptWorkspaceInvitationByIdCommand.
    private bool CanAcceptFromInbox => !Instance.Current.AllowPublicRegistration;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            await Instance.GetAsync();
            ApiResult<IReadOnlyList<WorkspaceInvitationDto>> result = await InvitationsApi.ListPendingAsync();
            if (result.HasValue)
            {
                invitations = result.Value;
                return;
            }

            invitations = null;
            error = result.Error ?? L["InvitationsLoadFailed"];
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AcceptAsync(WorkspaceInvitationDto invitation)
    {
        acceptingId = invitation.Id;
        acceptError = null;
        try
        {
            ApiResult<WorkspaceDto> result = await InvitationsApi.AcceptByIdAsync(invitation.Id);
            if (result.HasValue)
            {
                Nav.NavigateTo($"workspaces/{result.Value.Id}");
                return;
            }

            acceptError = result.Error ?? L["InvitationAcceptFailed"];
        }
        finally
        {
            acceptingId = null;
        }
    }

    private string RoleName(WorkspaceRole role) => L[role.LabelKey];
}
