@page "/oauth/callback"
@layout EmptyLayout
@using System.Web
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject TokenStore Tokens
@inject AuthStateProvider Auth
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AuthOauthTitle"] @L["PageTitleSuffix"]</PageTitle>

<div class="auth-shell">
    <div class="auth-card auth-card--status">
        <header class="auth-header">
            <h1 class="auth-title">@(error is null ? L["AuthOauthWorking"] : L["AuthOauthFailed"])</h1>
            <p class="auth-subtitle">@(error ?? L["AuthOauthHoldOn"].Value)</p>
        </header>
        @if (error is not null)
        {
            <a class="provider-button" href="login" style="justify-content: center;">
                <span>@L["AuthBackToSignIn"]</span>
            </a>
        }
        else
        {
            <div class="auth-spinner" aria-hidden="true"></div>
        }
    </div>
</div>

@code {
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            string currentUrl = await JS.InvokeAsync<string>("eval",
                "window.location.href");
            var uri = new Uri(currentUrl);
            string fragment = uri.Fragment.TrimStart('#');
            if (string.IsNullOrWhiteSpace(fragment))
            {
                error = L["AuthOauthMissingFragment"];
                StateHasChanged();
                return;
            }

            var query = HttpUtility.ParseQueryString(fragment);
            string? access = query["access_token"];
            string? refresh = query["refresh_token"];
            if (string.IsNullOrWhiteSpace(access) || string.IsNullOrWhiteSpace(refresh))
            {
                error = L["AuthOauthMissingToken"];
                StateHasChanged();
                return;
            }

            var userId = Guid.TryParse(query["user_id"], out var id) ? id : Guid.Empty;
            var user = new Shared.UserSummaryDto(
                Id: userId,
                Email: query["user_email"] ?? string.Empty,
                DisplayName: query["user_name"] ?? string.Empty);

            await Tokens.SetAsync(access, refresh, user);
            Auth.Notify();
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = string.Format(L["AuthOauthError"].Value, ex.Message);
            StateHasChanged();
        }
    }
}
