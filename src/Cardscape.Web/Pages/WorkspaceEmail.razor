@page "/workspaces/{WorkspaceId:guid}/integrations/email"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Microsoft.Extensions.Localization
@inject IEmailIntegrationApiClient EmailApi
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["EmailTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["EmailTitle"]" Subtitle="@L["EmailBlurb"]" />

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="@L["EmailWebhook"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["EmailWebhookBlurb"]</RadzenText>
            <RadzenText><code>@WebhookUrl</code></RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["EmailWebhookSecretHint"]</RadzenText>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="@L["EmailAddAddress"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
            <RadzenTemplateForm TItem="AddModel" Data="@addModel" Submit="@Add">
                <LabeledField Text="@L["EmailAddressLabel"]" Component="email-address">
                    <RadzenTextBox @bind-Value="addModel.EmailAddress" Name="email-address"
                                   Placeholder="board-123@cardscape.example.com" Style="width:100%" />
                </LabeledField>
                <LabeledField Text="@L["EmailLabelLabel"]" Component="email-label">
                    <RadzenTextBox @bind-Value="addModel.Label" Name="email-label" Style="width:100%" />
                </LabeledField>
                <LabeledField Text="@L["EmailTargetListId"]" Component="email-list">
                    <RadzenTextBox @bind-Value="addModel.TargetListIdText" Name="email-list" Style="width:100%" />
                </LabeledField>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="@L["EmailAddAddress"]" ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Primary" IsBusy="@busy" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenStack>
    </RadzenCard>

    <RadzenText Text="@L["EmailAddresses"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />

    @if (addresses is null)
    {
        <RadzenText Text="@L["ActionLoading"]" />
    }
    else if (addresses.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["EmailNoAddresses"]</RadzenText>
    }
    else
    {
        <RadzenDataGrid TItem="InboundEmailAddressDto" Data="@addresses" AllowSorting="true" AllowPaging="true" PageSize="20">
            <Columns>
                <RadzenDataGridColumn TItem="InboundEmailAddressDto" Property="EmailAddress" Title="@L["EmailAddressLabel"]" />
                <RadzenDataGridColumn TItem="InboundEmailAddressDto" Property="Label" Title="@L["EmailLabelLabel"]" />
                <RadzenDataGridColumn TItem="InboundEmailAddressDto" Property="TargetListId" Title="@L["EmailTargetListId"]" />
                <RadzenDataGridColumn TItem="InboundEmailAddressDto" Title="" Sortable="false" Filterable="false" Width="120px">
                    <Template Context="address">
                        <RadzenButton Text="@L["EmailRemove"]" ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      Click="@(() => Remove(address.Id))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }

    @if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            @error
        </RadzenAlert>
    }
</RadzenStack>

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private IReadOnlyList<InboundEmailAddressDto>? addresses;
    private string? error;
    private bool busy;
    private readonly AddModel addModel = new();

    private string WebhookUrl => $"{Nav.BaseUri}api/integrations/email/inbound?provider=sendgrid";

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        var result = await EmailApi.ListAddressesAsync(WorkspaceId);
        addresses = result.IsSuccess ? result.Value : [];
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(addModel.EmailAddress)
            || !Guid.TryParse(addModel.TargetListIdText, out Guid listId))
        {
            error = L["EmailAddMissing"];
            return;
        }

        busy = true;
        error = null;
        try
        {
            var result = await EmailApi.RegisterAddressAsync(
                WorkspaceId,
                addModel.EmailAddress.Trim(),
                listId,
                string.IsNullOrWhiteSpace(addModel.Label) ? addModel.EmailAddress.Trim() : addModel.Label.Trim());
            if (result.IsSuccess)
            {
                addModel.Reset();
                await Reload();
            }
            else
            {
                error = result.Error;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Remove(Guid addressId)
    {
        error = null;
        var result = await EmailApi.UnregisterAddressAsync(WorkspaceId, addressId);
        if (result.IsSuccess)
        {
            await Reload();
        }
        else
        {
            error = result.Error;
        }
    }

    private sealed class AddModel
    {
        public string EmailAddress { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string TargetListIdText { get; set; } = string.Empty;

        public void Reset()
        {
            EmailAddress = string.Empty;
            Label = string.Empty;
            TargetListIdText = string.Empty;
        }
    }
}
