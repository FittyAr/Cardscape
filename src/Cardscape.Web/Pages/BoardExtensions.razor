@page "/boards/{BoardId:guid}/extensions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Text.Json
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Microsoft.Extensions.Localization
@inject IBoardExtensionsApiClient ExtensionsClient
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ExtensionsTitle"] @L["PageTitleSuffix"]</PageTitle>

<PageHeader Title="@L["ExtensionsTitle"]" Subtitle="@L["ExtensionsBlurb"]" />

@if (rows is null)
{
    <LoadingState Size="LoadingSize.Page" />
}
else
{
    <RadzenStack Gap="1rem">
        @foreach (ExtensionOption option in allOptions)
        {
            BoardExtensionDto? match = rows.FirstOrDefault(r => r.Kind == option.Kind);
            bool isEnabled = match is { IsEnabled: true };
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="@L[option.NameKey]" TextStyle="TextStyle.Subtitle1"
                                    TagName="TagName.Span" />
                        <RadzenText Text="@L[option.DescriptionKey]" TextStyle="TextStyle.Body2"
                                    class="rz-color-text-secondary" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 Gap="0.5rem">
                        @if (isEnabled)
                        {
                            <RadzenButton Text="@L["ExtensionDisable"]" ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Click="@(() => DisableAsync(option.Kind))" />
                        }
                        else
                        {
                            <RadzenButton Text="@L["ExtensionEnable"]" ButtonStyle="ButtonStyle.Success"
                                          Size="ButtonSize.Small"
                                          Click="@(() => EnableAsync(option.Kind))" />
                        }
                    </RadzenStack>
                </RadzenStack>
                @* Card aging gets a mode selector once enabled, because the
                   effect (fade vs no-fade) is data-driven by the ConfigJson. *@
                @if (isEnabled && option.Kind == CardAgingKind)
                {
                    <RadzenSelectBar TValue="string"
                                     Value="@agingMode.ToString()"
                                     Change="@OnAgingModeChangedAsync"
                                     Size="ButtonSize.Small"
                                     Class="rz-mt-3">
                        <Items>
                            <RadzenSelectBarItem Text="@L["CardAgingModeDisabled"]" Value="@nameof(CardAgingMode.Disabled)" />
                            <RadzenSelectBarItem Text="@L["CardAgingModeByActivity"]" Value="@nameof(CardAgingMode.ByActivity)" />
                        </Items>
                    </RadzenSelectBar>
                }
            </RadzenCard>
        }
    </RadzenStack>

    @if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@error</RadzenAlert>
    }
}

@code {
    [Parameter] public Guid BoardId { get; set; }

    // Must match ExtensionKind.CardAging in
    // src/Cardscape.Domain/Boards/BoardExtension.cs.
    private const BoardExtensionKind CardAgingKind = BoardExtensionKind.CardAging;

    private IReadOnlyList<BoardExtensionDto>? rows;
    private string? error;

    private CardAgingMode agingMode = CardAgingMode.Disabled;

    private readonly List<ExtensionOption> allOptions = new()
    {
        new(BoardExtensionKind.CustomFields, "ExtensionCustomFieldsName", "ExtensionCustomFieldsDescription"),
        new(BoardExtensionKind.Voting, "ExtensionVotingName", "ExtensionVotingDescription"),
        new(BoardExtensionKind.CardRepeater, "ExtensionCardRepeaterName", "ExtensionCardRepeaterDescription"),
        new(CardAgingKind, "ExtensionCardAgingName", "ExtensionCardAgingDescription")
    };

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        ApiResult<IReadOnlyList<BoardExtensionDto>> result = await ExtensionsClient.ListAsync(BoardId);
        if (result.IsSuccess)
        {
            rows = result.Value;
            error = null;
            LoadAgingMode();
        }
        else
        {
            rows = [];
            error = result.Error;
        }
    }

    private void LoadAgingMode()
    {
        BoardExtensionDto? match = rows?.FirstOrDefault(r => r.Kind == CardAgingKind);
        agingMode = match is null
            ? CardAgingMode.Disabled
            : CardAgingMode.FromConfigJson(match.ConfigJson);
    }

    private async Task EnableAsync(BoardExtensionKind kind)
    {
        ApiResult<BoardExtensionDto> result = await ExtensionsClient.EnableAsync(
            BoardId, new EnableExtensionRequestDto(kind, ConfigJson: null));
        if (result.IsSuccess)
        {
            await ReloadAsync();
        }
        else
        {
            error = result.Error;
        }
    }

    private async Task DisableAsync(BoardExtensionKind kind)
    {
        ApiResult result = await ExtensionsClient.DisableAsync(BoardId, kind);
        if (result.IsSuccess)
        {
            await ReloadAsync();
        }
        else
        {
            error = result.Error;
        }
    }

    private async Task OnAgingModeChangedAsync(object value)
    {
        if (value is null
            || !Enum.TryParse<CardAgingMode>(value.ToString(), ignoreCase: false, out CardAgingMode parsed)
            || !Enum.IsDefined(parsed))
        {
            return;
        }

        agingMode = parsed;
        error = null;
        ApiResult<BoardExtensionDto> result = await ExtensionsClient.UpdateConfigAsync(
            BoardId, CardAgingKind, new UpdateExtensionConfigRequestDto(parsed.ToConfigJson()));
        if (result.IsSuccess)
        {
            // Keep the local mode in sync with what the server stored.
            await ReloadAsync();
        }
        else
        {
            error = result.Error;
        }
    }

    private sealed record ExtensionOption(BoardExtensionKind Kind, string NameKey, string DescriptionKey);
}
