@page "/calendar"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits DueDatesPageBase

<PageTitle>@L["NavCalendar"] @L["PageTitleSuffix"]</PageTitle>

<PageHeader Title="@Month.Label" Subtitle="@L["CalendarSubtitle", Month.Label]">
    <Actions>
        <MonthNavigator Month="@Month" Disabled="@IsLoading" MonthChanged="@ShowMonthAsync" />
    </Actions>
</PageHeader>

@if (IsLoading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="@ProgressBarMode.Indeterminate" />
}
else if (Error is not null)
{
    <RadzenAlert AlertStyle="@AlertStyle.Danger" Variant="@Variant.Flat" AllowClose="false">@Error</RadzenAlert>
}
else
{
    @* Re-keyed per month: RadzenScheduler has no two-way bindable date, so a
       new instance is the only way to keep its grid in step with the header. *@
    <RadzenScheduler @key="@Month"
                     TItem="CalendarEntryDto"
                     Data="@Entries"
                     StartProperty="@nameof(CalendarEntryDto.DayStart)"
                     EndProperty="@nameof(CalendarEntryDto.DayEnd)"
                     TextProperty="@nameof(CalendarEntryDto.Title)"
                     Date="@Month.FirstDay"
                     AppointmentRender="@OnAppointmentRender"
                     AppointmentSelect="@OnAppointmentSelect"
                     Style="height: 700px">
        <RadzenMonthView />
    </RadzenScheduler>
}

@code {
    private void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<CalendarEntryDto> args)
    {
        if (args.Data is { } entry)
        {
            OpenCard(entry.CardId);
        }
    }

    private static void OnAppointmentRender(SchedulerAppointmentRenderEventArgs<CalendarEntryDto> args)
    {
        string? state = args.Data switch
        {
            { IsCompleted: true } => "cs-appointment-completed",
            { IsOverdue: true } => "cs-appointment-overdue",
            _ => null,
        };
        if (state is not null)
        {
            args.Attributes["class"] = state;
        }
    }
}
