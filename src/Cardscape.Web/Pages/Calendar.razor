@page "/calendar"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject ICardsApiClient Cards
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<PageTitle>Calendar — Cardscape</PageTitle>

<PageHeader Title="@monthLabel"
            Subtitle="@($"Cards with a due date in {monthLabel}. Click a card to open it; click an empty day to add a new card (coming soon).")">
    <Actions>
        <RadzenButton Text="◀" ButtonStyle="ButtonStyle.Light" Click="@PrevMonth"
                      aria-label="@($"Previous month ({firstOfMonth.AddMonths(-1):MMMM yyyy})")" />
        <RadzenButton Text="Today" ButtonStyle="ButtonStyle.Light" Click="@GoToCurrentMonth"
                      aria-label="Jump to current month" />
        <RadzenButton Text="▶" ButtonStyle="ButtonStyle.Light" Click="@NextMonth"
                      aria-label="@($"Next month ({firstOfMonth.AddMonths(1):MMMM yyyy})")" />
    </Actions>
</PageHeader>

<RadzenScheduler TItem="CalendarSchedulerItem"
                 Data="@SchedulerItems"
                 StartProperty="Start"
                 EndProperty="End"
                 TextProperty="Title"
                 SelectedView="SchedulerView.Month"
                 CurrentDate="@schedulerCurrentDate"
                 CurrentDateChanged="@OnSchedulerDateChanged"
                 AppointmentSelect="@OnAppointmentSelect"
                 Style="height: 700px">
    <RadzenMonthView />
</RadzenScheduler>

@code {
    // BUG-A6-002 — see test-results/beta/reports/A6-views.md. The
    // page-level prev/next buttons (◀ / ▶ in the page header) and
    // the RadzenScheduler's own built-in nav (◀ / ▶ in the
    // scheduler toolbar) were stepping over each other: the
    // header updated but the scheduler kept showing the original
    // month, and vice-versa. The fix binds the scheduler's
    // CurrentDate to a DateTime that mirrors `firstOfMonth` and
    // listens to CurrentDateChanged so the two stay in sync
    // regardless of which control the user clicks.
    private DateTimeOffset firstOfMonth = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, TimeSpan.Zero);
    private IReadOnlyList<CalendarEntryDto> entries = [];
    private string monthLabel = string.Empty;

    // The RadzenScheduler takes a plain DateTime (not DateTimeOffset)
    // for CurrentDate; we project to / from UTC at the boundary so
    // the scheduler never sees a kind it can't handle.
    private DateTime schedulerCurrentDate => firstOfMonth.UtcDateTime.Date;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        DateTimeOffset from = firstOfMonth;
        DateTimeOffset to = firstOfMonth.AddMonths(1);

        ApiResult<IReadOnlyList<CalendarEntryDto>> result = await Cards.CalendarAsync(from, to, boardId: null);
        entries = result.IsSuccess && result.Value is not null
            ? result.Value
            : (IReadOnlyList<CalendarEntryDto>)Array.Empty<CalendarEntryDto>();

        monthLabel = firstOfMonth.ToString("MMMM yyyy");
    }

    private async Task PrevMonth()
    {
        firstOfMonth = firstOfMonth.AddMonths(-1);
        await ReloadAsync();
    }

    private async Task NextMonth()
    {
        firstOfMonth = firstOfMonth.AddMonths(1);
        await ReloadAsync();
    }

    private async Task GoToCurrentMonth()
    {
        DateTime utcNow = DateTime.UtcNow;
        firstOfMonth = new DateTimeOffset(utcNow.Year, utcNow.Month, 1, 0, 0, 0, TimeSpan.Zero);
        await ReloadAsync();
    }

    // BUG-A6-002 — sync the other direction. When the user clicks
    // the scheduler's own ◀ / ▶ / Today, the scheduler tells us the
    // new CurrentDate via this callback; we re-anchor firstOfMonth
    // to the first of that month and reload so the page header and
    // the data both follow.
    private async Task OnSchedulerDateChanged(DateTime newDate)
    {
        DateTime anchor = new DateTime(newDate.Year, newDate.Month, 1);
        DateTimeOffset proposed = new(anchor, TimeSpan.Zero);
        if (proposed == firstOfMonth)
        {
            return;
        }
        firstOfMonth = proposed;
        await ReloadAsync();
    }

    // RadzenScheduler's TItem contract requires Start/End/Text
    // properties. The API returns CalendarEntryDto with only
    // DueDate, so we project each entry to a thin wrapper that
    // exposes the start (start of the due day) and the end
    // (end of the same day) for the month view. The original
    // DTO is kept in `Source` so the AppointmentSelect handler
    // can navigate to the card without an extra round-trip.
    private IReadOnlyList<CalendarSchedulerItem> SchedulerItems => entries
        .Select(e => new CalendarSchedulerItem
        {
            Id = e.CardId,
            Title = e.Title,
            Start = e.DueDate.UtcDateTime.Date,
            End = e.DueDate.UtcDateTime.Date.AddDays(1).AddTicks(-1),
            Source = e
        })
        .ToList();

    private void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<CalendarSchedulerItem> args)
    {
        if (args.Data is not null)
        {
            Nav.NavigateTo($"cards/{args.Data.Source.CardId}");
        }
    }

    private sealed class CalendarSchedulerItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
        public CalendarEntryDto Source { get; set; } = default!;
    }
}
