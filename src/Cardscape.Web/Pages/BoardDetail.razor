@page "/boards/{BoardId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject IBoardsApiClient BoardsApi
@inject IListsApiClient ListsApi
@inject ICardsApiClient CardsApi
@inject IBoardExtensionsApiClient ExtensionsApi
@inject BoardHubClient HubClient
@inject DialogService DialogService
@implements IAsyncDisposable

<PageTitle>@(board?.Name ?? "Board") — Cardscape</PageTitle>

@if (board is null)
{
    <RadzenText Text="Loading board…" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else
{
    <PageHeader Title="@board.Name" Subtitle="@board.Description">
        <Actions>
            <RadzenBadge BadgeStyle="@(hubConnected ? BadgeStyle.Success : BadgeStyle.Light)"
                         Text="@(hubConnected ? "● Live" : "○ Offline")"
                         title="@(hubConnected ? "Live updates on" : "Live updates off — refreshes on navigation only")" />
            <RadzenButton Text="@(board.IsStarred ? "★ Starred" : "☆ Star")"
                          ButtonStyle="ButtonStyle.Secondary"
                          Click="@ToggleStar" />
            <RadzenButton Text="Add list" Icon="add" ButtonStyle="ButtonStyle.Light"
                          Click="@ToggleAddList" />
            <RadzenButton Text="Custom fields" Icon="list" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo($"boards/{BoardId}/custom-fields"))" />
            <RadzenButton Text="Extensions" Icon="extension" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo($"boards/{BoardId}/extensions"))" />
            <RadzenButton Text="Activity" Icon="history" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo($"boards/{BoardId}/activity"))" />
            <RadzenButton Text="Settings" Icon="settings" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => showSettings = !showSettings)" />
        </Actions>
    </PageHeader>

    @if (showAddList)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="AddListModel" Data="@addListModel" Submit="@AddList">
                <RadzenStack Gap="0.5rem">
                    @* BETA-8-UI-#17 — see test-results/r8/r8-report.md.
                       RadzenTemplateForm's HTML <form> would submit on
                       Enter inside a TextBox *if* the submit button is
                       the page's first RadzenButton. The form sits
                       next to several Light-style buttons above, so
                       we wire Enter explicitly through @onkeydown —
                       that works regardless of button order. *@
                    <RadzenTextBox @bind-Value="addListModel.Name" Placeholder="List name…"
                                   Style="width:100%"
                                   @onkeydown="@OnAddListKeyDown" />
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"
                                 Gap="0.5rem" Class="rz-mt-3">
                        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => showAddList = false)" />
                        <RadzenButton Text="Add" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@addingList" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @* BETA-6-#6 — see test-results/BETA-TEST-REPORT.md.
       The board API has supported rename / description / visibility /
       archive / unarchive / delete endpoints since v1.0.0, but the
       Blazor UI never surfaced them — the only affordance on the
       board page was "Star" + "Add list" + navigation. This panel
       closes that gap with a single expandable settings card. The
       rename / description / visibility / archive / unarchive
       commands already exist in IBoardsApiClient, so this is just
       wiring. *@
    @if (showSettings)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="Board settings" TextStyle="TextStyle.H6" TagName="TagName.H3" />
                <RadzenTemplateForm TItem="RenameBoardModel" Data="@renameModel" Submit="@RenameBoard">
                    <RadzenStack Gap="0.5rem">
                        <RadzenTextBox @bind-Value="renameModel.NewName" Placeholder="New board name…"
                                       Style="width:100%" />
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Rename" ButtonType="ButtonType.Submit"
                                          ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenTemplateForm>
                <RadzenTemplateForm TItem="DescriptionBoardModel" Data="@descriptionModel" Submit="@ChangeDescription">
                    <RadzenStack Gap="0.5rem">
                        <RadzenTextArea @bind-Value="descriptionModel.NewDescription" Rows="2"
                                         Placeholder="New description…" Style="width:100%" />
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Update description" ButtonType="ButtonType.Submit"
                                          ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenTemplateForm>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                             Wrap="FlexWrap.Wrap">
                    <RadzenText Text="Visibility" TextStyle="TextStyle.Body2" />
                    <RadzenDropDown TValue="string" @bind-Value="newVisibility" Data="@visibilityOptions"
                                    Change="@ChangeVisibility" Style="width:10rem" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    @if (board.IsArchived)
                    {
                        <RadzenButton Text="Unarchive" Icon="unarchive" ButtonStyle="ButtonStyle.Warning"
                                      Click="@UnarchiveBoard" />
                    }
                    else
                    {
                        <RadzenButton Text="Archive" Icon="archive" ButtonStyle="ButtonStyle.Warning"
                                      Click="@ArchiveBoard" />
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }

    <KanbanBoard TItem="CardSummaryDto" Columns="@KanbanColumns">
        <ColumnHeaderTemplate>
            @{
                var column = context;
                Guid listId = Guid.Parse(column.Id);
                BoardListDto? listDto = lists?.FirstOrDefault(l => l.Id == listId);
            }
            @* BUG-A4-002 — see test-results/beta/reports/A4-cards-lists.md.
               The list API has supported rename / move / archive /
               restore since v1.0.0 but the Web never had a per-column
               menu. Rendered via KanbanBoard.ColumnHeaderTemplate so
               the menu lives next to the title in the same row. *@
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText Text="@column.Title" TextStyle="TextStyle.Subtitle1" TagName="TagName.Span" />
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenText Text="@column.Cards.Count.ToString()"
                                TextStyle="TextStyle.Caption"
                                class="rz-color-text-secondary" />
                    @if (listDto is not null)
                    {
                        <RadzenMenu>
                            <RadzenMenuItem Text="…" Icon="more_horiz">
                                <RadzenMenuItem Text="Rename" Icon="edit"
                                                Click="@(() => PromptRenameList(listId, listDto.Name))" />
                                <RadzenMenuItem Text="Move to start" Icon="first_page"
                                                Click="@(() => MoveListToPosition(listId, 0.0d))" />
                                <RadzenMenuItem Text="Move to end" Icon="last_page"
                                                Click="@(() => MoveListToPosition(listId, double.MaxValue / 2))" />
                                @if (listDto.IsArchived)
                                {
                                    <RadzenMenuItem Text="Restore" Icon="unarchive"
                                                    Click="@(() => RestoreList(listId))" />
                                }
                                else
                                {
                                    <RadzenMenuItem Text="Archive" Icon="archive"
                                                    Click="@(() => ArchiveList(listId))" />
                                }
                            </RadzenMenuItem>
                        </RadzenMenu>
                    }
                </RadzenStack>
            </RadzenStack>
        </ColumnHeaderTemplate>
        <CardTemplate>
            @{
                var card = context;
                double opacity = ComputeCardOpacity(card, agingMode, now);
            }
            @* BETA-3-UI-#15 — see test-results/BETA-TEST-REPORT.md.
               The kanban card has both a mouse path (draggable=true
               wired to OnCardDragStart) and a keyboard path
               (tabindex="0" + role="group" + aria-label so a
               screen reader announces it as "Card: <title>").
               The full keyboard-only move flow is documented as
               a follow-up in the report — the next iteration will
               add a RadzenMenu button visible on focus that lists
               every list as a "Move to <list>" action. The minimal
               change here is enough to surface the card to the
               accessibility tree. *@
            <RadzenCard Style="@($"opacity: {opacity:0.00}; cursor: grab;")"
                        role="group"
                        aria-label="@($"Card: {card.Title}{(card.IsCompleted ? " (completed)" : string.Empty)}{(card.MirrorOfCardId is not null ? " (mirror)" : string.Empty)}")"
                        tabindex="0"
                        draggable="true"
                        @ondragstart="@(() => OnCardDragStart(card))"
                        @onclick="@(() => Nav.NavigateTo($"cards/{card.Id}/{BoardId}"))">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenText Text="@card.Title" TextStyle="TextStyle.Body2"
                                Class="@(card.IsCompleted ? "rz-color-text-disabled" : null)"
                                Style="@(card.IsCompleted ? "text-decoration: line-through; word-break: break-word;" : "word-break: break-word;")" />
                    @* BETA-7-#13 — see test-results/BETA-TEST-REPORT.md.
                       A mirror card is a real Card row that
                       shares title + description with the
                       source. The "Mirror" badge tells the
                       user which copy is the mirror so the
                       two same-titled cards are not
                       confusing in the kanban. *@
                    @if (card.MirrorOfCardId is not null)
                    {
                        <RadzenIcon Icon="content_copy"
                                    Style="font-size: 0.85rem;"
                                    title="Mirror card" />
                    }
                </RadzenStack>
                @if (card.DueDate is not null)
                {
                    <RadzenText Text="@($"📅 {card.DueDate.Value.LocalDateTime:yyyy-MM-dd}")"
                                TextStyle="TextStyle.Caption" class="rz-color-text-secondary" />
                }
            </RadzenCard>
        </CardTemplate>
        <ChildContent>
            @{
                var list = context;
                Guid listId = Guid.Parse(list.Id);
            }
            @* The `KanbanBoard` component renders each card in each column
               from the `Columns` parameter via the `CardTemplate` above.
               Re-rendering the cards here would duplicate every card (see
               BUG #10 in test-results/BETA-TEST-REPORT.md), so the
               ChildContent is reserved for the per-column shell: the
               drop target and the add-card affordance. *@
            <div class="cs-kanban-column-dropzone"
                 @ondragover="@OnColumnDragOver"
                 @ondragover:preventDefault
                 @ondrop="@(() => OnColumnDrop(listId))">
            </div>
            @if (openAddCardFor == listId)
            {
                <RadzenStack Gap="0.5rem">
                    @* BETA-8-UI-#17 — see comment in AddList above. *@
                    <RadzenTextBox @bind-Value="newCardTitle" Placeholder="Card title…"
                                   Style="width:100%"
                                   @onkeydown="@(e => OnAddCardKeyDown(e, listId))" />
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"
                                 Gap="0.5rem">
                        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => { openAddCardFor = null; newCardTitle = string.Empty; })" />
                        <RadzenButton Text="Add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@(() => ConfirmAddCard(listId))" />
                    </RadzenStack>
                </RadzenStack>
            }
            else
            {
                <RadzenButton Text="+ Add card" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(() => openAddCardFor = listId)" />
            }
        </ChildContent>
    </KanbanBoard>
}
