@page "/boards/{BoardId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IBoardsApiClient BoardsApi
@inject IListsApiClient ListsApi
@inject ICardsApiClient CardsApi
@inject IBoardExtensionsApiClient ExtensionsApi
@inject BoardHubClient HubClient
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<PageTitle>@(_board?.Name ?? L["GitHubBoard"]) @L["PageTitleSuffix"]</PageTitle>

@if (_board is null)
{
    <div class="cs-full-bleed">
        <KanbanBoard TItem="CardSummaryDto" Columns="null" />
    </div>
}
else
{
    @* Board background colour: the hex travels through a CSS custom
       property and the has-color class switches the tinted canvas on. *@
    <div class="cs-full-bleed cs-board-page @(_board.Color is null ? null : "has-color")" style="--cs-board-color: @_board.Color">
        <div class="cs-board-bar">
            <div class="cs-board-bar-main">
                <a class="cs-board-bar-crumb" href="@($"workspaces/{_board.WorkspaceId}")">
                    <RadzenIcon Icon="space_dashboard" />
                    <span>@(_workspace?.Name ?? L["WorkspaceBadge"])</span>
                </a>
                <div class="cs-board-bar-title-row">
                    @if (_renamingBoard)
                    {
                        <RadzenTextBox @ref="_boardRenameBox" @bind-Value="_renamingBoardName" Immediate="true" class="cs-board-bar-title-input"
                                       aria-label="@L["BoardNewName"]"
                                       @onkeydown="@OnBoardRenameKeyDownAsync" @onblur="@CommitBoardRenameAsync" />
                    }
                    else
                    {
                        <h1 class="cs-board-bar-title" tabindex="0" title="@L["BoardRenameHint"]"
                            @onclick="@StartRenamingBoard" @onkeydown="@OnBoardTitleKeyDown">@_board.Name</h1>
                    }
                    <RadzenButton Icon="@(_board.IsStarred ? "star" : "star_outline")"
                                  ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                  class="@(_board.IsStarred ? "cs-star is-starred" : "cs-star")"
                                  title="@(_board.IsStarred ? L["BoardsStarred"] : L["BoardStar"])"
                                  aria-label="@(_board.IsStarred ? L["BoardsStarred"] : L["BoardStar"])"
                                  aria-pressed="@(_board.IsStarred ? "true" : "false")"
                                  Click="@ToggleStarAsync" />
                    <span class="cs-board-chip">
                        <RadzenIcon Icon="@VisibilityIcon(_board.Visibility)" />
                        @VisibilityLabel(_board.Visibility)
                    </span>
                    <span class="cs-live @(_hubConnected ? "is-live" : null)" title="@(_hubConnected ? L["BoardLiveHint"] : L["BoardOfflineHint"])">
                        <span class="cs-live-dot" aria-hidden="true"></span>
                        @(_hubConnected ? L["BoardLiveShort"] : L["BoardOfflineShort"])
                    </span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_board.Description))
                {
                    <p class="cs-board-bar-description">@_board.Description</p>
                }
            </div>
            <div class="cs-board-bar-actions">
                <RadzenButton Text="@(IsFiltering ? L["BoardFilterActive", ActiveFilterCount] : L["BoardFilter"])" Icon="filter_list"
                              ButtonStyle="@(IsFiltering ? ButtonStyle.Primary : ButtonStyle.Base)"
                              Variant="@(IsFiltering ? Variant.Flat : Variant.Text)"
                              aria-expanded="@(_showFilters ? "true" : "false")"
                              Click="@(() => _showFilters = !_showFilters)" />
                <RadzenButton Text="@L["BoardActionDashboard"]" Icon="insights" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                              Click="@(() => Nav.NavigateTo($"boards/{BoardId}/dashboard"))" />
                <RadzenButton Text="@L["ActivityTitle"]" Icon="history" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                              Click="@(() => Nav.NavigateTo($"boards/{BoardId}/activity"))" />
                <RadzenMenu Responsive="false" class="cs-board-more">
                    <RadzenMenuItem Icon="more_horiz" title="@L["BoardMore"]">
                        <RadzenMenuItem Text="@(_showSnoozed ? L["BoardHideSnoozed"] : L["BoardShowSnoozed"])" Icon="snooze" Click="@ToggleSnoozedAsync" />
                        <RadzenMenuItem Text="@L["CustomFieldsTitle"]" Icon="tune" Path="@($"boards/{BoardId}/custom-fields")" />
                        <RadzenMenuItem Text="@L["ExtensionsTitle"]" Icon="extension" Path="@($"boards/{BoardId}/extensions")" />
                        <RadzenMenuItem Text="@L["BoardArchivedItems"]" Icon="inventory_2" Click="@ToggleArchivedAsync" />
                        <RadzenMenuItem Text="@L["BoardSettings"]" Icon="settings" Click="@ToggleSettings" />
                    </RadzenMenuItem>
                </RadzenMenu>
            </div>
        </div>

        @if (_board.IsArchived)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="cs-board-archived">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                    <span>@L["BoardArchivedBanner"]</span>
                    <RadzenButton Text="@L["BoardUnarchive"]" Icon="unarchive" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="@UnarchiveBoardAsync" />
                </RadzenStack>
            </RadzenAlert>
        }

        @if (_showFilters)
        {
            <RadzenCard class="cs-board-panel">
                <RadzenStack Gap="0.875rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText Text="@L["BoardFilter"]" TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-m-0" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                      aria-label="@L["ActionCancel"]" Click="@(() => _showFilters = false)" />
                    </RadzenStack>
                    <RadzenTextBox @bind-Value="_filterText" Immediate="true" Placeholder="@L["BoardFilterKeyword"]" Style="width:100%"
                                   aria-label="@L["BoardFilterKeyword"]" />
                    @if (_boardLabels.Count > 0)
                    {
                        <div class="cs-filter-group">
                            <h3 class="cs-filter-title">@L["CardLabels"]</h3>
                            <div class="cs-filter-chips">
                                @foreach (LabelDto label in _boardLabels)
                                {
                                    bool on = _filterLabels.Contains(label.Id);
                                    <span class="cs-filter-chip cs-filter-chip--label @(on ? "is-on" : null)" role="checkbox" tabindex="0"
                                          style="--cs-label-color: @label.Color"
                                          aria-checked="@(on ? "true" : "false")"
                                          @onclick="@(() => Toggle(_filterLabels, label.Id))"
                                          @onkeydown="@(e => { if (e.IsActivation) Toggle(_filterLabels, label.Id); })">@label.Name</span>
                                }
                            </div>
                        </div>
                    }
                    @if (BoardCardMembers.Count > 0)
                    {
                        <div class="cs-filter-group">
                            <h3 class="cs-filter-title">@L["MembersTitle"]</h3>
                            <div class="cs-filter-chips">
                                @foreach (CardSummaryMemberDto member in BoardCardMembers)
                                {
                                    bool on = _filterMembers.Contains(member.UserId);
                                    <span class="cs-filter-chip @(on ? "is-on" : null)" role="checkbox" tabindex="0"
                                          aria-checked="@(on ? "true" : "false")"
                                          @onclick="@(() => Toggle(_filterMembers, member.UserId))"
                                          @onkeydown="@(e => { if (e.IsActivation) Toggle(_filterMembers, member.UserId); })">
                                        <span class="cs-card-avatar" aria-hidden="true">@UserInitials.From(member.DisplayName)</span>
                                        @member.DisplayName
                                    </span>
                                }
                            </div>
                        </div>
                    }
                    <div class="cs-filter-group">
                        <h3 class="cs-filter-title">@L["CardDueDate"]</h3>
                        <div class="cs-filter-chips">
                            @foreach (DueFilter due in Enum.GetValues<DueFilter>())
                            {
                                bool on = _filterDue.Contains(due);
                                <span class="cs-filter-chip @(on ? "is-on" : null)" role="checkbox" tabindex="0"
                                      aria-checked="@(on ? "true" : "false")"
                                      @onclick="@(() => Toggle(_filterDue, due))"
                                      @onkeydown="@(e => { if (e.IsActivation) Toggle(_filterDue, due); })">@DueFilterLabel(due)</span>
                            }
                        </div>
                    </div>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <span class="cs-filter-count" role="status">@L["BoardFilterMatches", VisibleCardCount]</span>
                        <RadzenButton Text="@L["BoardFilterClear"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                      Disabled="@(!IsFiltering)" Click="@ClearFilters" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }

        @if (_showArchived)
        {
            <RadzenCard class="cs-board-panel">
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText Text="@L["BoardArchivedItems"]" TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-m-0" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                      aria-label="@L["ActionCancel"]" Click="@(() => _showArchived = false)" />
                    </RadzenStack>
                    @if (_archivedCards.Count == 0 && _archivedLists.Count == 0)
                    {
                        <span class="cs-muted">@L["BoardArchivedEmpty"]</span>
                    }
                    @if (_archivedLists.Count > 0)
                    {
                        <h3 class="cs-filter-title">@L["BoardArchivedLists"]</h3>
                        <ul class="cs-archived-list">
                            @foreach (BoardListDto list in _archivedLists)
                            {
                                <li class="cs-archived-item">
                                    <RadzenIcon Icon="view_column" />
                                    <span class="cs-archived-name">@list.Name</span>
                                    <RadzenButton Text="@L["ActionRestore"]" Icon="unarchive" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  Click="@(() => RestoreArchivedListAsync(list.Id))" />
                                </li>
                            }
                        </ul>
                    }
                    @if (_archivedCards.Count > 0)
                    {
                        <h3 class="cs-filter-title">@L["BoardArchivedCards"]</h3>
                        <ul class="cs-archived-list">
                            @foreach (CardSummaryDto card in _archivedCards)
                            {
                                <li class="cs-archived-item">
                                    <RadzenIcon Icon="article" />
                                    <span class="cs-archived-name">
                                        <RadzenLink Text="@card.Title" Path="@($"cards/{card.Id}/{BoardId}")" />
                                        <span class="cs-muted">@ArchivedCardListName(card)</span>
                                    </span>
                                    <RadzenButton Text="@L["ActionRestore"]" Icon="unarchive" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  Click="@(() => RestoreArchivedCardAsync(card.Id))" />
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  aria-label="@L["ActionDelete"]" title="@L["ActionDelete"]"
                                                  Click="@(() => DeleteArchivedCardAsync(card))" />
                                </li>
                            }
                        </ul>
                    }
                </RadzenStack>
            </RadzenCard>
        }

        @* BETA-6-#6 — board settings (rename / description / visibility /
           archive / unarchive). Opened from the "…" menu above. *@
        @if (_showSettings)
        {
            <RadzenCard class="cs-board-settings">
                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText Text="@L["BoardSettings"]" TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-m-0" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                      aria-label="@L["ActionCancel"]" Click="@(() => _showSettings = false)" />
                    </RadzenStack>
                    <RadzenTemplateForm TItem="RenameBoardModel" Data="@_renameModel" Submit="@RenameBoardAsync">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
                            <RadzenStack Gap="0.25rem" Style="flex: 1;">
                                <RadzenTextBox @bind-Value="_renameModel.NewName" Name="board-name" Placeholder="@L["BoardNewName"]" Style="width:100%" />
                                <RadzenRequiredValidator Component="board-name" Text="@L["ValidationRequired"]" />
                            </RadzenStack>
                            <RadzenButton Text="@L["CustomFieldsRename"]" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
                        </RadzenStack>
                    </RadzenTemplateForm>
                    <RadzenTemplateForm TItem="DescriptionBoardModel" Data="@_descriptionModel" Submit="@ChangeDescriptionAsync">
                        <RadzenStack Gap="0.5rem">
                            <RadzenTextArea @bind-Value="_descriptionModel.NewDescription" Rows="2" Placeholder="@L["BoardNewDescription"]" Style="width:100%" />
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                                <RadzenButton Text="@L["BoardUpdateDescription"]" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenTemplateForm>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenText Text="@L["BoardsVisibility"]" TextStyle="TextStyle.Body2" Class="rz-m-0" />
                            <RadzenDropDown TValue="string" @bind-Value="_newVisibility" Data="@VisibilityOptions"
                                            TextProperty="Label" ValueProperty="Value" Change="@ChangeVisibilityAsync" Style="width:10rem" />
                        </RadzenStack>
                        @if (_board.IsArchived)
                        {
                            <RadzenButton Text="@L["BoardUnarchive"]" Icon="unarchive" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Click="@UnarchiveBoardAsync" />
                        }
                        else
                        {
                            <RadzenButton Text="@L["ActionArchive"]" Icon="archive" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@ArchiveBoardAsync" />
                        }
                    </RadzenStack>
                    <RadzenStack Gap="0.5rem">
                        <RadzenText Text="@L["BoardColor"]" TextStyle="TextStyle.Body2" Class="rz-m-0" />
                        <div class="cs-swatches" role="radiogroup" aria-label="@L["BoardColor"]">
                            @foreach (CardPalette.Swatch swatch in CardPalette.All)
                            {
                                bool current = string.Equals(_board.Color, swatch.Hex, StringComparison.OrdinalIgnoreCase);
                                <span class="cs-swatch @(current ? "is-selected" : null)" role="radio" tabindex="0"
                                      style="--cs-swatch: @swatch.Hex" title="@swatch.Name"
                                      aria-checked="@(current ? "true" : "false")"
                                      @onclick="@(() => SetBoardColorAsync(swatch.Name))"
                                      @onkeydown="@(e => OnSwatchKeyAsync(e, () => SetBoardColorAsync(swatch.Name)))"></span>
                            }
                        </div>
                        @if (_board.Color is not null)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                                <RadzenButton Text="@L["BoardRemoveColor"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                              Click="@(() => SetBoardColorAsync(null))" />
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }

        <KanbanBoard TItem="CardSummaryDto" Columns="@KanbanColumns"
                     DropEnabled="true" OnColumnDrop="@OnKanbanDropAsync"
                     OnColumnTailDragEnter="@OnColumnTailDragEnter" OnDragEnd="@OnCardDragEnd"
                     DropTailColumnId="@DropTailColumnId">
            <ColumnHeaderTemplate>
                @{
                    var column = context;
                    Guid listId = Guid.Parse(column.Id);
                    BoardListDto? listDto = _lists?.FirstOrDefault(l => l.Id == listId);
                }
                @* BUG-A4-002 — per-list menu (rename / move / archive).
                   The title doubles as the drag handle for reordering lists
                   and turns into a text box on click (Trello-style). *@
                @if (listDto is not null && _renamingListId == listId)
                {
                    <RadzenTextBox @ref="_listRenameBox" @bind-Value="_renamingListName" Immediate="true" class="cs-column-title-input"
                                   aria-label="@L["BoardListName"]"
                                   @onkeydown="@OnListRenameKeyDownAsync" @onblur="@CommitListRenameAsync" />
                }
                else
                {
                    <h2 class="cs-column-title @(_draggingListId == listId ? "is-dragging" : null)" tabindex="0"
                        title="@L["BoardListDragHint"]"
                        draggable="true"
                        @ondragstart="@(() => OnListDragStart(listId))"
                        @onclick="@(() => { if (listDto is not null) StartRenamingList(listDto); })"
                        @onkeydown="@(e => { if (listDto is not null) OnListTitleKeyDown(e, listDto); })">@column.Title</h2>
                }
                <span class="cs-column-count">@column.Cards.Count</span>
                @if (listDto is not null)
                {
                    <RadzenMenu Responsive="false" class="cs-column-menu">
                        <RadzenMenuItem Icon="more_horiz" title="@L["BoardMore"]">
                            <RadzenMenuItem Text="@L["CustomFieldsRename"]" Icon="edit"
                                            Click="@(() => PromptRenameListAsync(listId, listDto.Name))" />
                            @if (!listDto.IsArchived)
                            {
                                <RadzenMenuItem Text="@L["ListCopy"]" Icon="content_copy"
                                                Click="@(() => PromptCopyListAsync(listId, listDto.Name))" />
                            }
                            <RadzenMenuItem Text="@L["BoardMoveListStart"]" Icon="first_page"
                                            Click="@(() => MoveListToPositionAsync(listId, 0.0d))" />
                            <RadzenMenuItem Text="@L["BoardMoveListEnd"]" Icon="last_page"
                                            Click="@(() => MoveListToPositionAsync(listId, double.MaxValue / 2))" />
                            @if (listDto.IsArchived)
                            {
                                <RadzenMenuItem Text="@L["ActionRestore"]" Icon="unarchive"
                                                Click="@(() => RestoreListAsync(listId))" />
                            }
                            else
                            {
                                <RadzenMenuItem Text="@L["ActionArchive"]" Icon="archive"
                                                Click="@(() => ArchiveListAsync(listId))" />
                            }
                        </RadzenMenuItem>
                    </RadzenMenu>
                }
            </ColumnHeaderTemplate>
            <CardTemplate>
                @{
                    var card = context;
                    double opacity = _agingMode.CardOpacity(card, _now);
                    DueState due = GetDueState(card, _now);
                }
                @* BETA-3-UI-#15 — draggable for mouse users; tabindex +
                   role + aria-label surface the card to keyboard and
                   screen-reader users, and Enter / Space open it. *@
                <div class="cs-card @(card.IsCompleted ? "is-completed" : null) @(_draggingCardId == card.Id ? "is-dragging" : null) @DropIndicatorClass(card)"
                     style="@(opacity < 1 ? $"opacity: {opacity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)};" : null)"
                     role="button"
                     aria-label="@L["BoardCardAria", card.Title, card.IsCompleted ? L["BoardCompletedSuffix"] : string.Empty, card.MirrorOfCardId is not null ? L["BoardMirrorSuffix"] : string.Empty]"
                     tabindex="0"
                     draggable="true"
                     @ondragstart="@(() => OnCardDragStart(card))"
                     @ondragenter="@(() => OnCardDragEnter(card))"
                     @onkeydown="@(e => OnCardKeyDown(e, card))"
                     @onclick="@(() => OpenCard(card))">
                    @if (card.CoverColor is not null)
                    {
                        <span class="cs-card-cover" style="--cs-cover-color: @card.CoverColor" aria-hidden="true"></span>
                    }
                    @if (card.Labels is { Count: > 0 } labels)
                    {
                        <span class="cs-card-labels @(_labelsExpanded ? "is-expanded" : null)" title="@L["BoardLabelsToggle"]"
                              @onclick="@ToggleLabelNames" @onclick:stopPropagation="true">
                            @foreach (CardSummaryLabelDto label in labels)
                            {
                                <span class="cs-card-label" style="--cs-label-color: @label.Color" title="@label.Name">@(_labelsExpanded ? label.Name : null)</span>
                            }
                        </span>
                    }
                    <span class="cs-card-title-row">
                        <span class="cs-card-check @(card.IsCompleted ? "is-done" : null)" role="checkbox" tabindex="0"
                              aria-checked="@(card.IsCompleted ? "true" : "false")"
                              aria-label="@(card.IsCompleted ? L["ActionReopen"] : L["CardComplete"])"
                              title="@(card.IsCompleted ? L["ActionReopen"] : L["CardComplete"])"
                              @onclick="@(() => ToggleCardCompleteAsync(card))" @onclick:stopPropagation="true"
                              @onkeydown="@(e => OnCompleteKeyDownAsync(e, card))" @onkeydown:stopPropagation="true">
                            <RadzenIcon Icon="@(card.IsCompleted ? "check_circle" : "radio_button_unchecked")" />
                        </span>
                        <span class="cs-card-title">@card.Title</span>
                    </span>
                    @{
                        bool hasMembers = card.Members is { Count: > 0 };
                        bool hasBadges = card.DueDate is not null || card.IsCompleted || card.MirrorOfCardId is not null
                                         || card.IsSnoozed || card.ChecklistTotal > 0 || card.CommentCount > 0
                                         || card.HasDescription || card.AttachmentCount > 0;
                    }
                    @if (hasBadges || hasMembers)
                    {
                        <span class="cs-card-footer">
                            <span class="cs-card-badges">
                                @if (card.DueDate is not null)
                                {
                                    <span class="cs-card-due cs-card-due--@due.ToString().ToLowerInvariant()" title="@($"{card.DueDate.Value.LocalDateTime:d} {card.DueDate.Value.LocalDateTime:t}")">
                                        <RadzenIcon Icon="@(card.IsCompleted ? "check_circle" : "schedule")" />
                                        @card.DueDate.Value.LocalDateTime.ToString("d MMM")
                                    </span>
                                }
                                else if (card.IsCompleted)
                                {
                                    <span class="cs-card-due cs-card-due--done"><RadzenIcon Icon="check_circle" /></span>
                                }
                                @if (card.HasDescription)
                                {
                                    <span class="cs-card-icon" title="@L["BoardCardHasDescription"]"><RadzenIcon Icon="notes" /></span>
                                }
                                @if (card.CommentCount > 0)
                                {
                                    <span class="cs-card-count" title="@L["BoardCardComments", card.CommentCount]">
                                        <RadzenIcon Icon="chat_bubble_outline" />
                                        @card.CommentCount
                                    </span>
                                }
                                @if (card.AttachmentCount > 0)
                                {
                                    <span class="cs-card-count" title="@L["BoardCardAttachments", card.AttachmentCount]">
                                        <RadzenIcon Icon="attach_file" />
                                        @card.AttachmentCount
                                    </span>
                                }
                                @if (card.ChecklistTotal > 0)
                                {
                                    <span class="cs-card-count @(card.ChecklistCompleted == card.ChecklistTotal ? "is-complete" : null)"
                                          title="@L["BoardCardChecklist", card.ChecklistCompleted, card.ChecklistTotal]">
                                        <RadzenIcon Icon="check_box" />
                                        @($"{card.ChecklistCompleted}/{card.ChecklistTotal}")
                                    </span>
                                }
                                @if (card.IsSnoozed)
                                {
                                    <span class="cs-card-icon" title="@(card.SnoozeUntil is null ? null : L["CardSnoozedUntil", card.SnoozeUntil.Value.LocalDateTime.ToString("g")].Value)"><RadzenIcon Icon="snooze" /></span>
                                }
                                @* BETA-7-#13 — mirror cards share title/description
                                   with their source; the icon tells the copies apart. *@
                                @if (card.MirrorOfCardId is not null)
                                {
                                    <span class="cs-card-icon" title="@L["BoardMirrorCard"]"><RadzenIcon Icon="content_copy" /></span>
                                }
                            </span>
                            @if (hasMembers)
                            {
                                <span class="cs-card-members">
                                    @foreach (CardSummaryMemberDto member in card.Members!)
                                    {
                                        <span class="cs-card-avatar" title="@member.DisplayName">@UserInitials.From(member.DisplayName)</span>
                                    }
                                </span>
                            }
                        </span>
                    }
                </div>
            </CardTemplate>
            <ChildContent>
                @{
                    Guid listId = Guid.Parse(context.Id);
                }
                @if (_openAddCardFor == listId)
                {
                    <div class="cs-composer">
                        @* BETA-8-UI-#17 — Enter submits, Escape closes. *@
                        <RadzenTextBox @ref="_cardComposerBox" @bind-Value="_newCardTitle" Immediate="true" Placeholder="@L["BoardCardTitle"]"
                                       Style="width:100%" class="cs-composer-input"
                                       @onkeydown="@(e => OnAddCardKeyDownAsync(e, listId))" />
                        <div class="cs-composer-actions">
                            <RadzenButton Text="@L["BoardAddCard"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                          Click="@(() => ConfirmAddCardAsync(listId))" />
                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                          aria-label="@L["ActionCancel"]" Click="@CloseCardComposer" />
                        </div>
                    </div>
                }
                else
                {
                    <RadzenButton Text="@L["BoardAddCard"]" Icon="add" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                  class="cs-add-card" Click="@(() => OpenCardComposer(listId))" />
                }
            </ChildContent>
            <TrailingContent>
                <div class="cs-add-list">
                    @if (_showAddList)
                    {
                        <RadzenTemplateForm TItem="AddListModel" Data="@_addListModel" Submit="@AddListAsync">
                            <div class="cs-composer">
                                @* BETA-8-UI-#17 — Enter submits explicitly. *@
                                <RadzenTextBox @ref="_listComposerBox" @bind-Value="_addListModel.Name" Immediate="true" Name="list-name" Placeholder="@L["BoardListName"]"
                                               Style="width:100%" class="cs-composer-input"
                                               @onkeydown="@OnAddListKeyDownAsync" />
                                <RadzenRequiredValidator Component="list-name" Text="@L["ValidationRequired"]" />
                                <div class="cs-composer-actions">
                                    <RadzenButton Text="@L["BoardAddList"]" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                                  Size="ButtonSize.Small" IsBusy="@_addingList" />
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  aria-label="@L["ActionCancel"]" Click="@(() => _showAddList = false)" />
                                </div>
                            </div>
                        </RadzenTemplateForm>
                    }
                    else
                    {
                        <RadzenButton Text="@L["BoardAddList"]" Icon="add" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                      class="cs-add-list-button" Click="@ToggleAddList" />
                    }
                </div>
            </TrailingContent>
        </KanbanBoard>
    </div>
}
