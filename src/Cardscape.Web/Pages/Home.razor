@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Microsoft.Extensions.Localization
@inject IWorkspacesApiClient Workspaces
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["HomeTitle"] @L["PageTitleSuffix"]</PageTitle>

<div class="home-shell">
    <h1>@L["HomeTitle"]</h1>
    <p>@L["AppTagline"]</p>

    <div class="home-grid">
        <RadzenCard>
            <h3>@L["HomeWorkspacesHeading"]</h3>
            <p>@L["HomeWorkspacesBlurb"]</p>
            <RadzenButton Text="@L["HomeOpenWorkspaces"]" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => Nav.NavigateTo("workspaces"))" />
        </RadzenCard>

        <RadzenCard>
            <h3>@L["HomeStarredHeading"]</h3>
            <p>@L["HomeStarredBlurb"]</p>
            <RadzenButton Text="@L["HomeSeeStarred"]" ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => Nav.NavigateTo("starred"))" />
        </RadzenCard>
    </div>
</div>
