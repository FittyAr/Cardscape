@page "/"
@using System.Security.Claims
@using Cardscape.Web.Resources
@using Cardscape.Web.Services.Api
@using Microsoft.Extensions.Localization
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@inject IWorkspacesApiClient WorkspacesApi
@inject IBoardsApiClient BoardsApi
@inject InstanceSettingsState Instance

<PageTitle>@L["HomeTitle"] @L["PageTitleSuffix"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cs-home">
            <PageHeader Title="@Greeting(context.User)" Subtitle="@(Instance.Current.WelcomeMessage ?? L["HomeLeadAuthorized"])" />

            @if (_loadError is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_loadError</RadzenAlert>
            }

            @* Starred boards — the Trello "pinned" row. *@
            <section class="cs-home-section">
                <h2 class="cs-section-title"><RadzenIcon Icon="star" />@L["HomeStarredHeading"]</h2>
                @if (_starredError is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_starredError</RadzenAlert>
                }
                else if (_starred is null)
                {
                    <div class="cs-board-grid">
                        @for (int i = 0; i < 3; i++)
                        {
                            <div class="cs-board-tile-skeleton"></div>
                        }
                    </div>
                }
                else if (_starred.Count == 0)
                {
                    <p class="cs-home-hint">@L["HomeStarredEmpty"]</p>
                }
                else
                {
                    <div class="cs-board-grid">
                        @foreach (BoardSummaryDto board in _starred)
                        {
                            <BoardTile BoardId="board.Id" Name="@board.Name" IsStarred="true" />
                        }
                    </div>
                }
            </section>

            @* One section per workspace with its boards. *@
            @if (_workspaces is not null)
            {
                @if (_workspaces.Count == 0)
                {
                    <div class="cs-empty">
                        <RadzenIcon Icon="space_dashboard" />
                        <span>@L["HomeWorkspacesEmpty"]</span>
                        <RadzenButton Text="@L["WorkspacesNew"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                                      Click="@(() => Nav.NavigateTo("workspaces"))" />
                    </div>
                }

                @foreach (WorkspaceDto workspace in _workspaces)
                {
                    _boardsByWorkspace.TryGetValue(workspace.Id, out IReadOnlyList<BoardSummaryDto>? boards);
                    _boardErrors.TryGetValue(workspace.Id, out string? boardsError);
                    <section class="cs-home-section">
                        <div class="cs-home-workspace-header">
                            <span class="cs-workspace-avatar" style="--cs-tile-color: @BoardTile.ColorFor(workspace.Id);" aria-hidden="true">@workspace.Name[..1].ToUpperInvariant()</span>
                            <div class="cs-home-workspace-text">
                                <h2 class="cs-home-workspace-name">@workspace.Name</h2>
                                <span class="cs-home-workspace-meta">@L["HomeWorkspaceMembers", workspace.MemberCount]</span>
                            </div>
                            <RadzenButton Text="@L["BoardsTitle"]" Icon="arrow_forward" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                          Click="@(() => Nav.NavigateTo($"workspaces/{workspace.Id}"))" />
                        </div>
                        @if (boardsError is not null)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@boardsError</RadzenAlert>
                        }
                        <div class="cs-board-grid">
                            @if (boards is null && boardsError is null)
                            {
                                <div class="cs-board-tile-skeleton"></div>
                            }
                            else if (boards is not null)
                            {
                                @foreach (BoardSummaryDto board in boards.Where(b => !b.IsArchived))
                                {
                                    <BoardTile BoardId="board.Id" Name="@board.Name" IsStarred="board.IsStarred" />
                                }
                            }
                            @if (!workspace.CallerIsGuest)
                            {
                                <a class="cs-board-tile cs-board-tile--new" href="@($"workspaces/{workspace.Id}?create=1")">
                                    <RadzenIcon Icon="add" />
                                    <span>@L["BoardsNew"]</span>
                                </a>
                            }
                        </div>
                    </section>
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="cs-landing">
            <div class="cs-landing-hero">
                <div class="cs-landing-copy">
                    <span class="cs-eyebrow">@L["HomeLandingEyebrow"]</span>
                    <h1 class="cs-landing-title">@L["AppName"]</h1>
                    <p class="cs-landing-lead">@L["AppTagline"]</p>
                    <div class="cs-landing-actions">
                        <RadzenButton Text="@L["AuthCreateAccount"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" Click="@(() => Nav.NavigateTo("register"))" />
                        <RadzenButton Text="@L["AuthSignIn"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Large" Click="@(() => Nav.NavigateTo("login"))" />
                    </div>
                </div>

                @* Decorative mini board. *@
                <div class="cs-landing-board" aria-hidden="true">
                    @foreach (int cards in new[] { 3, 2, 4 })
                    {
                        <div class="cs-landing-col">
                            <span class="cs-landing-col-title"></span>
                            @for (int i = 0; i < cards; i++)
                            {
                                <span class="cs-landing-card @(cards == 2 && i == 0 ? "is-accent" : null)"></span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="cs-landing-features">
                <div class="cs-landing-feature">
                    <RadzenIcon Icon="view_kanban" />
                    <h3>@L["HomePointBoardsTitle"]</h3>
                    <p>@L["HomePointBoardsBody"]</p>
                </div>
                <div class="cs-landing-feature">
                    <RadzenIcon Icon="dns" />
                    <h3>@L["HomePointSelfHostTitle"]</h3>
                    <p>@L["HomePointSelfHostBody"]</p>
                </div>
                <div class="cs-landing-feature">
                    <RadzenIcon Icon="smart_toy" />
                    <h3>@L["HomePointMcpTitle"]</h3>
                    <p>@L["HomePointMcpBody"]</p>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<BoardSummaryDto>? _starred;
    private IReadOnlyList<WorkspaceDto>? _workspaces;
    private readonly Dictionary<Guid, IReadOnlyList<BoardSummaryDto>> _boardsByWorkspace = new();
    private readonly Dictionary<Guid, string> _boardErrors = new();
    private string? _starredError;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await Instance.GetAsync();
        if (AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var starredTask = BoardsApi.ListStarredAsync();
        var workspacesTask = WorkspacesApi.ListAsync();
        await Task.WhenAll(starredTask, workspacesTask);

        // A failed request keeps its own error state; it is never
        // shown as an empty collection.
        ApiResult<IReadOnlyList<BoardSummaryDto>> starred = await starredTask;
        if (starred.IsSuccess)
        {
            _starred = starred.Value ?? [];
        }
        else
        {
            _starredError = starred.Error ?? L["BoardsLoadFailed"];
        }

        ApiResult<IReadOnlyList<WorkspaceDto>> workspaces = await workspacesTask;
        if (!workspaces.IsSuccess)
        {
            _loadError = workspaces.Error ?? L["BoardsLoadFailed"];
            return;
        }

        _workspaces = (workspaces.Value ?? []).Where(w => !w.IsArchived).ToList();
        StateHasChanged();

        // Board lists load per workspace in parallel; each section
        // fills in as soon as its own request returns.
        await Task.WhenAll(_workspaces.Select(async workspace =>
        {
            ApiResult<IReadOnlyList<BoardSummaryDto>> boards = await BoardsApi.ListForWorkspaceAsync(workspace.Id);
            if (boards.IsSuccess)
            {
                _boardsByWorkspace[workspace.Id] = boards.Value ?? [];
            }
            else
            {
                _boardErrors[workspace.Id] = boards.Error ?? L["BoardsLoadFailed"];
            }

            StateHasChanged();
        }));
    }

    private string Greeting(ClaimsPrincipal user)
    {
        string? name = user.FindFirst(ClaimTypes.GivenName)?.Value
            ?? user.Identity?.Name
            ?? user.FindFirst("name")?.Value;

        if (string.IsNullOrWhiteSpace(name))
        {
            return L["HomeTitle"];
        }

        return string.Format(L["HomeGreeting"].Value, name.Split(' ')[0]);
    }
}
