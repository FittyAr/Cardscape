@page "/"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Microsoft.Extensions.Localization
@inject IWorkspacesApiClient WorkspacesApi
@inject IBoardsApiClient BoardsApi
@inject INotificationsApiClient NotificationsApi
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["HomeTitle"] @L["PageTitleSuffix"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <RadzenStack Gap="1rem">
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12">
                    <RadzenText Text="@Greeting(context.User)" TextStyle="TextStyle.H3" TagName="TagName.H1" class="rz-m-0" />
                    <RadzenText Text="@L["HomeLeadAuthorized"]" TextStyle="TextStyle.Body1" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenCard Variant="Variant.Outlined">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Start">
                            <RadzenIcon Icon="grid_view" Class="rz-background-color-primary-light rz-color-on-primary-light rz-border-radius-2" Style="font-size: 32px; min-width: 64px; min-height: 64px" />
                            <RadzenStack Gap="0">
                                <RadzenText Text="@L["HomeWorkspacesHeading"]" TextStyle="TextStyle.Subtitle1" TagName="TagName.H4" />
                                <RadzenText Text="@L["HomeWorkspacesBlurb"]" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenCard Variant="Variant.Outlined">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Start">
                            <RadzenIcon Icon="star" Class="rz-background-color-warning-light rz-color-on-warning-light rz-border-radius-2" Style="font-size: 32px; min-width: 64px; min-height: 64px" />
                            <RadzenStack Gap="0">
                                <RadzenText Text="@L["HomeStarredHeading"]" TextStyle="TextStyle.Subtitle1" TagName="TagName.H4" />
                                <RadzenText Text="@L["HomeStarredBlurb"]" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </Authorized>
    <NotAuthorized>
        <RadzenStack Gap="2rem">
            <RadzenRow AlignItems="AlignItems.Center" Gap="2rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="1rem">
                        <RadzenText Text="@L["HomeLandingEyebrow"]" TextStyle="TextStyle.Overline" Style="color: var(--rz-primary); letter-spacing: 0.15em;" />
                        <RadzenText Text="@L["AppName"]" TextStyle="TextStyle.H1" TagName="TagName.H1" />
                        <RadzenText Text="@L["AppTagline"]" TextStyle="TextStyle.Body1" />
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Class="rz-mt-4">
                            <RadzenButton Text="@L["AuthSignIn"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" Click="@(() => Nav.NavigateTo("login"))" />
                            <RadzenButton Text="@L["AuthCreateAccount"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Large" Click="@(() => Nav.NavigateTo("register"))" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCard Variant="Variant.Filled" Class="rz-p-6" Style="min-height: 360px; background: linear-gradient(135deg, var(--rz-primary-dark) 0%, var(--rz-primary-darker) 100%);">
                        <RadzenStack Gap="1rem">
                            <RadzenRow Gap="0.5rem">
                                <RadzenColumn Size="4">
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="1" />
                                        <RadzenCard Style="min-height: 60px;" />
                                        <RadzenCard Style="min-height: 40px;" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="2" />
                                        <RadzenCard class="rz-background-color-primary-light" Style="min-height: 60px;" />
                                        <RadzenCard Style="min-height: 40px;" />
                                        <RadzenCard Style="min-height: 40px;" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="3" />
                                        <RadzenCard Style="min-height: 40px;" />
                                        <RadzenCard Style="min-height: 60px;" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenCard>
                        <RadzenStack Gap="0.5rem">
                            <RadzenIcon Icon="view_kanban" Style="font-size: 28px; color: var(--rz-primary);" />
                            <RadzenText Text="@L["HomePointBoardsTitle"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                            <RadzenText Text="@L["HomePointBoardsBody"]" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenCard>
                        <RadzenStack Gap="0.5rem">
                            <RadzenIcon Icon="lock" Style="font-size: 28px; color: var(--rz-primary);" />
                            <RadzenText Text="@L["HomePointSelfHostTitle"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                            <RadzenText Text="@L["HomePointSelfHostBody"]" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenCard>
                        <RadzenStack Gap="0.5rem">
                            <RadzenIcon Icon="android" Style="font-size: 28px; color: var(--rz-primary);" />
                            <RadzenText Text="@L["HomePointMcpTitle"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                            <RadzenText Text="@L["HomePointMcpBody"]" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<WorkspaceDto>? workspaces;
    private IReadOnlyList<BoardSummaryDto>? starred;
    private int unreadCount;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            Task<ApiResult<IReadOnlyList<WorkspaceDto>>> wsTask = WorkspacesApi.ListAsync();
            Task<ApiResult<IReadOnlyList<BoardSummaryDto>>> starredTask = BoardsApi.ListStarredAsync();
            Task<ApiResult<int>> unreadTask = NotificationsApi.GetUnreadCountAsync();

            await Task.WhenAll(wsTask, starredTask, unreadTask);

            ApiResult<IReadOnlyList<WorkspaceDto>> ws = await wsTask;
            ApiResult<IReadOnlyList<BoardSummaryDto>> st = await starredTask;
            ApiResult<int> unread = await unreadTask;

            if (ws.IsSuccess)
            {
                workspaces = ws.Value;
            }

            if (st.IsSuccess)
            {
                starred = st.Value;
            }

            if (unread.IsSuccess)
            {
                unreadCount = unread.Value;
            }
        }
        catch
        {
            // Non-fatal: render the home shell even if the data load fails.
        }
    }

    private string Greeting(ClaimsPrincipal user)
    {
        string? name = user.Identity?.Name
            ?? user.FindFirst(ClaimTypes.GivenName)?.Value
            ?? user.FindFirst("name")?.Value;

        if (string.IsNullOrWhiteSpace(name))
        {
            return L["HomeTitle"];
        }

        return string.Format(L["HomeGreeting"].Value, name);
    }
}
