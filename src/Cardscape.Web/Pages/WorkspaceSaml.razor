@page "/workspaces/{WorkspaceId:guid}/saml"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Cardscape.Web.Services.Api
@using Microsoft.Extensions.Localization
@inject ISamlApiClient SamlApi
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["SamlTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["SamlTitle"]" Subtitle="@L["SamlBlurb"]" />

    @if (connection is null)
    {
        <RadzenText Text="@L["ActionLoading"]" />
    }
    else if (connection.Id == Guid.Empty)
    {
        <RadzenCard>
            <RadzenStack Gap="0.5rem">
                <RadzenText Text="@L["SamlConfigure"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                <RadzenTemplateForm TItem="SamlModel" Data="@model" Submit="@Configure">
                    <LabeledField Text="@L["SamlSlug"]" Component="s-slug">
                        <RadzenTextBox @bind-Value="model.Slug" Name="s-slug" Style="width:100%" />
                    </LabeledField>
                    <LabeledField Text="@L["SamlDisplayName"]" Component="s-name">
                        <RadzenTextBox @bind-Value="model.DisplayName" Name="s-name" Style="width:100%" />
                    </LabeledField>
                    <LabeledField Text="@L["SamlIdpEntityId"]" Component="s-idp">
                        <RadzenTextBox @bind-Value="model.IdpEntityId" Name="s-idp" Style="width:100%" />
                    </LabeledField>
                    <LabeledField Text="@L["SamlIdpMetadataUrl"]" Component="s-meta">
                        <RadzenTextBox @bind-Value="model.IdpMetadataUrl" Name="s-meta" Style="width:100%" />
                    </LabeledField>
                    <LabeledField Text="@L["SamlSpEntityId"]" Component="s-sp">
                        <RadzenTextBox @bind-Value="model.SpEntityId" Name="s-sp" Style="width:100%" />
                    </LabeledField>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                        <RadzenButton Text="@L["SamlConfigure"]" ButtonType="ButtonType.Submit"
                                      ButtonStyle="ButtonStyle.Primary" IsBusy="@busy" />
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        <RadzenCard>
            <RadzenStack Gap="0.5rem">
                <RadzenText Text="@($"{L["SamlConnectedAs"]} {connection.DisplayName}")" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
                    @L["SamlSlug"]: <code>@connection.Slug</code>
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
                    @L["SamlIdpEntityId"]: <code>@connection.IdpEntityId</code>
                </RadzenText>
                @if (connection.IsActive)
                {
                    <RadzenBadge Text="@L["SamlActive"]" BadgeStyle="BadgeStyle.Success" />
                }
                else
                {
                    <RadzenBadge Text="@L["SamlInactive"]" BadgeStyle="BadgeStyle.Warning" />
                }
                <RadzenButton Text="@L["SamlDisable"]" ButtonStyle="ButtonStyle.Danger"
                              Click="@Disable" />
            </RadzenStack>
        </RadzenCard>
    }

    @if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            @error
        </RadzenAlert>
    }
</RadzenStack>

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    private SamlConnectionDto? connection;
    private string? error;
    private bool busy;
    private readonly SamlModel model = new()
    {
        SpEntityId = "https://cardscape.local/saml"
    };

    protected override async Task OnInitializedAsync()
    {
        var result = await SamlApi.GetAsync(WorkspaceId);
        connection = result.IsSuccess && result.Value is not null
            ? result.Value
            : Empty();
    }

    private static SamlConnectionDto Empty() => new(
        Guid.Empty, Guid.Empty, string.Empty, string.Empty, string.Empty, string.Empty,
        null, string.Empty, false, DateTimeOffset.UtcNow, null);

    private async Task Configure()
    {
        busy = true;
        error = null;
        try
        {
            var result = await SamlApi.ConfigureAsync(WorkspaceId, new SamlConfigDto(
                model.Slug, model.DisplayName, model.IdpEntityId, model.IdpMetadataUrl, model.SpEntityId));
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }
            connection = result.Value;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Disable()
    {
        var result = await SamlApi.DisableAsync(WorkspaceId);
        if (!result.IsSuccess)
        {
            error = result.Error;
            return;
        }
        connection = Empty();
    }

    private sealed class SamlModel
    {
        public string Slug { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string IdpEntityId { get; set; } = string.Empty;
        public string IdpMetadataUrl { get; set; } = string.Empty;
        public string SpEntityId { get; set; } = string.Empty;
    }
}
