@page "/forgot-password"
@layout EmptyLayout
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Web.Resources
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject IHttpClientFactory Http
@inject NavigationManager Nav

<PageTitle>@L["AuthForgotPassword"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Gap="0.25rem">
        <RadzenText Text="@L["AuthForgotPassword"]" TextStyle="TextStyle.H4" TagName="TagName.H1" />
        <RadzenText Text="@L["AuthForgotPasswordBlurb"]" TextStyle="TextStyle.Body2"
                    class="rz-color-text-secondary" />
    </RadzenStack>

    @if (string.IsNullOrEmpty(generatedToken))
    {
        <RadzenTemplateForm TItem="ForgotPasswordModel" Data="@model" Submit="@RequestResetAsync">
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@L["AuthEmail"]" Component="email">
                    <RadzenTextBox @bind-Value="model.Email" Name="email" Style="width:100%"
                                   autocomplete="email" Placeholder="you@company.com" />
                </RadzenFormField>

                @if (error is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
                        @error
                    </RadzenAlert>
                }

                <RadzenButton ButtonType="@ButtonType.Submit"
                              Text="@L["AuthForgotPasswordSubmit"]"
                              ButtonStyle="@ButtonStyle.Primary"
                              Size="@ButtonSize.Large"
                              IsBusy="@busy"
                              BusyText="@L["AuthSending"]"
                              Style="width:100%" />
            </RadzenStack>
        </RadzenTemplateForm>
    }
    else
    {
        @* BUG-A8-014 — the API returns the cleartext token in
           Development so the QA flow can run without an SMTP
           provider. In Production the email pipeline would
           deliver the link; this screen is only ever shown to
           the local dev. *@
        <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" AllowClose="false">
            @L["AuthForgotPasswordSuccess"]
        </RadzenAlert>
        <RadzenCard>
            <RadzenStack Gap="0.5rem">
                <RadzenText Text="@L["AuthForgotPasswordDevTokenLabel"]" TextStyle="TextStyle.Body2"
                            class="rz-color-text-secondary" />
                <RadzenText Text="@generatedToken" TextStyle="TextStyle.Body1"
                            Style="font-family: monospace; word-break: break-all;" />
                <RadzenButton Text="@L["AuthGoToReset"]" Icon="login" ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => Nav.NavigateTo($"reset-password?token={Uri.EscapeDataString(generatedToken)}"))" />
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center"
                 class="rz-mt-2">
        <RadzenText Text="@L["AuthRemembered"]" />
        <RadzenLink Path="login" Text="@L["AuthSignIn"]" />
    </RadzenStack>
</RadzenStack>

@code {
    private readonly ForgotPasswordModel model = new();
    private bool busy;
    private string? error;
    private string? generatedToken;

    private async Task RequestResetAsync()
    {
        if (string.IsNullOrWhiteSpace(model.Email))
        {
            error = L["AuthEmailRequired"];
            return;
        }

        busy = true;
        error = null;
        try
        {
            HttpClient client = Http.CreateClient("Cardscape.Api");
            HttpResponseMessage response = await client.PostAsJsonAsync(
                "api/auth/forgot-password",
                new { email = model.Email });

            if (response.IsSuccessStatusCode)
            {
                ForgotPasswordResponse? payload = await response.Content
                    .ReadFromJsonAsync<ForgotPasswordResponse>();
                if (payload is not null && !string.IsNullOrEmpty(payload.Token))
                {
                    generatedToken = payload.Token;
                }
                else
                {
                    // Production path: no token returned, just
                    // bounce to the "check your email" success
                    // state by leaving generatedToken null and
                    // showing the same alert.
                    generatedToken = string.Empty;
                }
            }
            else
            {
                error = await AuthService.ExtractErrorAsync(response, CancellationToken.None);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class ForgotPasswordModel
    {
        public string Email { get; set; } = string.Empty;
    }

    private sealed record ForgotPasswordResponse(string MaskedEmail, string? Token, long LifetimeSeconds);
}
