@page "/reset-password"
@layout EmptyLayout
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Web.Resources
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject IHttpClientFactory Http
@inject NavigationManager Nav

<PageTitle>@L["AuthResetPassword"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Gap="0.25rem">
        <RadzenText Text="@L["AuthResetPassword"]" TextStyle="TextStyle.H4" TagName="TagName.H1" />
        <RadzenText Text="@L["AuthResetPasswordBlurb"]" TextStyle="TextStyle.Body2"
                    class="rz-color-text-secondary" />
    </RadzenStack>

    @if (!completed)
    {
        <RadzenTemplateForm TItem="ResetPasswordModel" Data="@model" Submit="@SubmitAsync">
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@L["AuthResetToken"]" Component="token">
                    <RadzenTextBox @bind-Value="model.Token" Name="token" Style="width:100%" />
                </RadzenFormField>
                <RadzenFormField Text="@L["AuthNewPassword"]" Component="password">
                    <RadzenPassword @bind-Value="model.NewPassword" Name="password" Style="width:100%" />
                </RadzenFormField>
                <RadzenFormField Text="@L["AuthConfirmPassword"]" Component="confirmPassword">
                    <RadzenPassword @bind-Value="model.ConfirmPassword" Name="confirmPassword"
                                    Style="width:100%" />
                    @if (!string.IsNullOrEmpty(model.ConfirmPassword) && model.NewPassword != model.ConfirmPassword)
                    {
                        <RadzenText Text="@L["AuthPasswordsDoNotMatch"]" TextStyle="TextStyle.Caption"
                                    Style="color: var(--rz-danger);" />
                    }
                </RadzenFormField>

                @if (error is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
                        @error
                    </RadzenAlert>
                }

                <RadzenButton ButtonType="@ButtonType.Submit"
                              Text="@L["AuthResetPasswordSubmit"]"
                              ButtonStyle="@ButtonStyle.Primary"
                              Size="@ButtonSize.Large"
                              IsBusy="@busy"
                              BusyText="@L["AuthResetting"]"
                              Disabled="@(!CanSubmit())"
                              Style="width:100%" />
            </RadzenStack>
        </RadzenTemplateForm>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" AllowClose="false">
            @L["AuthResetPasswordSuccess"]
        </RadzenAlert>
        <RadzenButton Text="@L["AuthSignIn"]" Icon="login" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => Nav.NavigateTo("login"))" />
    }
</RadzenStack>

@code {
    [Parameter, SupplyParameterFromQuery] public string? Token { get; set; }

    private readonly ResetPasswordModel model = new();
    private bool busy;
    private string? error;
    private bool completed;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Token))
        {
            model.Token = Token;
        }
    }

    private bool CanSubmit() =>
        !string.IsNullOrWhiteSpace(model.Token) &&
        !string.IsNullOrWhiteSpace(model.NewPassword) &&
        model.NewPassword.Length >= 8 &&
        model.NewPassword == model.ConfirmPassword;

    private async Task SubmitAsync()
    {
        if (!CanSubmit())
        {
            error = L["AuthPasswordsDoNotMatch"];
            return;
        }

        busy = true;
        error = null;
        try
        {
            HttpClient client = Http.CreateClient("Cardscape.Api");
            HttpResponseMessage response = await client.PostAsJsonAsync(
                "api/auth/reset-password",
                new { token = model.Token, newPassword = model.NewPassword });

            if (response.IsSuccessStatusCode)
            {
                completed = true;
            }
            else
            {
                error = await AuthService.ExtractErrorAsync(response, CancellationToken.None);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class ResetPasswordModel
    {
        public string Token { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
