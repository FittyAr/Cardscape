@page "/workspaces/{WorkspaceId:guid}/integrations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["IntegrationsTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["IntegrationsTitle"]" Subtitle="@L["IntegrationsBlurb"]" />

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenText Text="Slack" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["SlackBlurb"]</RadzenText>
                    <RadzenButton Text="@L["ActionConfigure"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo($"/workspaces/{WorkspaceId}/integrations/slack"))" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenText Text="Google Drive" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["GoogleDriveBlurb"]</RadzenText>
                    <RadzenButton Text="@L["ActionConfigure"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo("/settings/integrations/google-drive"))" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenText Text="GitHub" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["GitHubBlurb"]</RadzenText>
                    <RadzenButton Text="@L["ActionConfigure"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo($"/workspaces/{WorkspaceId}/integrations/github"))" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenText Text="Email-to-board" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["EmailToBoardBlurb"]</RadzenText>
                    <RadzenButton Text="@L["ActionConfigure"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo($"/workspaces/{WorkspaceId}/integrations/email"))" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenText Text="Google Calendar" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["GoogleCalendarBlurb"]</RadzenText>
                    <RadzenButton Text="@L["ActionConfigure"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo("/settings/integrations/google-calendar"))" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenText Text="SCIM provisioning" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["ScimBlurb"]</RadzenText>
                    <RadzenButton Text="@L["ActionConfigure"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo($"/workspaces/{WorkspaceId}/scim"))" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenText Text="SAML SSO" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["SamlBlurb"]</RadzenText>
                    <RadzenButton Text="@L["ActionConfigure"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo($"/workspaces/{WorkspaceId}/saml"))" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter] public Guid WorkspaceId { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;
}
