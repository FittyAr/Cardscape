@page "/workspaces/{WorkspaceId:guid}/members"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject IWorkspacesApiClient WorkspacesApi
@inject IInvitationsApiClient InvitationsApi
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<PageTitle>Members — Cardscape</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <h1>Members</h1>
        @if (workspace is not null)
        {
            <small class="muted">@workspace.Name</small>
        }
        <div class="page-header-actions">
            <RadzenButton Text="Invite" Icon="person_add" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => showInvite = !showInvite)" />
        </div>
    </div>

    @if (showInvite)
    {
        <RadzenCard class="create-form">
            <RadzenTemplateForm TItem="InviteModel" Data="@inviteModel" Submit="@SendInvite">
                <RadzenLabel Text="Email" Component="invite-email" />
                <RadzenTextBox @bind-Value="inviteModel.Email" Name="invite-email" Style="width:100%" />

                <RadzenLabel Text="Role" Component="invite-role" Style="margin-top:.5rem;display:block" />
                <RadzenDropDown @bind-Value="inviteModel.Role" Data="@roles"
                                TextProperty="Label" ValueProperty="Value"
                                Name="invite-role" Style="width:100%" />

                @if (issuedToken is not null)
                {
                    <div class="issued-secret">
                        <h3>Invitation created</h3>
                        <p>
                            Send this link to <strong>@inviteModel.Email</strong>.
                            It will also appear in the API log.
                        </p>
                        <pre class="secret-box">@issuedToken</pre>
                        <RadzenButton Text="I've sent it" ButtonStyle="ButtonStyle.Primary"
                                      Click="@DismissIssuedToken" />
                    </div>
                }
                @if (error is not null)
                {
                    <div class="auth-error" role="alert">@error</div>
                }
                <div class="create-actions">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelInvite" />
                    <RadzenButton Text="Send" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@busy" />
                </div>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <h2>Current members</h2>
    @if (members is null)
    {
        <p>Loading…</p>
    }
    else if (members.Count == 0)
    {
        <p>No members yet — invite someone to get started.</p>
    }
    else
    {
        <div class="member-list">
            @foreach (WorkspaceMemberDto m in members)
            {
                <RadzenCard class="member-card">
                    <div class="member-row">
                        <div>
                            <strong>@m.DisplayName</strong>
                            <small> · @m.Email · @RoleName(m.Role)</small>
                        </div>
                    </div>
                </RadzenCard>
            }
        </div>
    }

    <h2>Pending invitations</h2>
    @if (invitations is null)
    {
        <p>Loading…</p>
    }
    else if (invitations.Count == 0)
    {
        <p>No pending invitations.</p>
    }
    else
    {
        <div class="invitation-list">
            @foreach (WorkspaceInvitationDto inv in invitations)
            {
                <RadzenCard class="invitation-card">
                    <div class="invitation-row">
                        <div class="invitation-meta">
                            <strong>@inv.Email</strong>
                            <small> · @RoleName(inv.Role) · expires @inv.ExpiresAt.LocalDateTime.ToString("yyyy-MM-dd")</small>
                        </div>
                        <RadzenButton Text="Revoke" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                      Click="@(() => RevokeAsync(inv))" />
                    </div>
                </RadzenCard>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    private WorkspaceDto? workspace;
    private IReadOnlyList<WorkspaceMemberDto>? members;
    private IReadOnlyList<WorkspaceInvitationDto>? invitations;
    private bool showInvite;
    private bool busy;
    private string? error;
    private string? issuedToken;
    private readonly InviteModel inviteModel = new();

    private readonly List<RoleOption> roles = new()
    {
        new(0, "Admin"),
        new(1, "Member"),
        new(2, "Observer")
    };

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var wsTask = WorkspacesApi.GetAsync(WorkspaceId);
        var membersTask = WorkspacesApi.ListMembersAsync(WorkspaceId);
        var invitationsTask = InvitationsApi.ListForWorkspaceAsync(WorkspaceId, includeTerminal: false);

        await Task.WhenAll(wsTask, membersTask, invitationsTask);

        workspace = (await wsTask).IsSuccess ? (await wsTask).Value : null;
        members = (await membersTask).IsSuccess ? (await membersTask).Value : [];
        invitations = (await invitationsTask).IsSuccess ? (await invitationsTask).Value : [];
    }

    private async Task SendInvite()
    {
        busy = true;
        error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(inviteModel.Email))
            {
                error = "Email is required.";
                return;
            }

            ApiResult<WorkspaceInvitationIssuanceDto> result = await InvitationsApi.IssueAsync(
                WorkspaceId, inviteModel.Email, inviteModel.Role, lifetime: null);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            issuedToken = result.Value!.CleartextToken;
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelInvite()
    {
        showInvite = false;
        error = null;
        issuedToken = null;
        inviteModel.Email = string.Empty;
    }

    private void DismissIssuedToken()
    {
        issuedToken = null;
        inviteModel.Email = string.Empty;
    }

    private async Task RevokeAsync(WorkspaceInvitationDto inv)
    {
        ApiResult result = await InvitationsApi.RevokeAsync(WorkspaceId, inv.Id);
        if (result.IsSuccess)
        {
            await ReloadAsync();
        }
        else
        {
            error = result.Error;
        }
    }

    private static string RoleName(int role) => role switch
    {
        0 => "Admin",
        1 => "Member",
        2 => "Observer",
        _ => "Unknown"
    };

    private sealed class InviteModel
    {
        public string Email { get; set; } = string.Empty;
        public int Role { get; set; } = 1; // Member by default
    }

    private sealed record RoleOption(int Value, string Label);
}
