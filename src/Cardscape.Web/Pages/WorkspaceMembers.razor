@page "/workspaces/{WorkspaceId:guid}/members"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IWorkspacesApiClient WorkspacesApi
@inject IInvitationsApiClient InvitationsApi
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["MembersTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["MembersTitle"]"
                Subtitle="@(workspace?.Name ?? string.Empty)"
                Actions="@(ShowInviteButton())" />

    @if (showInvite)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="InviteModel" Data="@inviteModel" Submit="@SendInviteAsync">
                <LabeledField Text="@L["MembersEmail"]" Component="invite-email">
                    <RadzenTextBox @bind-Value="inviteModel.Email" Name="invite-email" Style="width:100%" />
                </LabeledField>
                <RadzenRequiredValidator Component="invite-email" Text="@L["ValidationRequired"]" />
                <RadzenEmailValidator Component="invite-email" Text="@L["ValidationEmail"]" />

                <LabeledField Text="@L["MembersRole"]" Component="invite-role">
                    <RadzenDropDown @bind-Value="inviteModel.Role" Data="@Roles"
                                    TextProperty="Label" ValueProperty="Value"
                                    Name="invite-role" Style="width:100%" />
                </LabeledField>

                @if (issuedToken is not null)
                {
                    <RadzenCard Variant="Variant.Outlined" Class="rz-mt-3">
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H3" Text="@L["MembersInvitationCreated"]" />
                            <RadzenText Text="@L["MembersInvitationSendTo", inviteModel.Email]" TextStyle="TextStyle.Body2" />
                            <SecretBox Secret="@issuedToken" />
                            <RadzenButton Text="@L["MembersInvitationSent"]" ButtonStyle="ButtonStyle.Primary"
                                          Click="@DismissIssuedToken" />
                        </RadzenStack>
                    </RadzenCard>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="ButtonStyle.Light" Click="@CancelInvite" />
                    <RadzenButton Text="@L["MembersSend"]" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@busy" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@error</RadzenAlert>
    }

    @if (workspaceError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@workspaceError</RadzenAlert>
    }

    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Text="@L["MembersCurrent"]" />

    @if (membersError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@membersError</RadzenAlert>
    }
    else if (members is null)
    {
        <RadzenText Text="@L["ActionLoading"]" />
    }
    else if (members.Count == 0)
    {
        <RadzenText Text="@L["MembersEmpty"]" />
    }
    else
    {
        <RadzenDataGrid TItem="WorkspaceMemberDto" Data="@members" AllowSorting="true" AllowPaging="true" PageSize="20">
            <Columns>
                <RadzenDataGridColumn TItem="WorkspaceMemberDto" Property="DisplayName" Title="@L["MembersName"]" />
                <RadzenDataGridColumn TItem="WorkspaceMemberDto" Property="Email" Title="@L["MembersEmail"]" />
                <RadzenDataGridColumn TItem="WorkspaceMemberDto" Property="Role" Title="@L["MembersRole"]">
                    <Template Context="m">
                        @RoleName(m.Role)
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }

    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Text="@L["MembersPendingInvitations"]" />

    @if (invitationsError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@invitationsError</RadzenAlert>
    }
    else if (invitations is null)
    {
        <RadzenText Text="@L["ActionLoading"]" />
    }
    else if (invitations.Count == 0)
    {
        <RadzenText Text="@L["MembersNoInvitations"]" />
    }
    else
    {
        <RadzenDataGrid TItem="WorkspaceInvitationDto" Data="@invitations" AllowSorting="true" AllowPaging="true" PageSize="20">
            <Columns>
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Property="Email" Title="@L["MembersEmail"]" />
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Property="Role" Title="@L["MembersRole"]">
                    <Template Context="inv">
                        @RoleName(inv.Role)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Property="ExpiresAt" Title="@L["MembersExpires"]">
                    <Template Context="inv">
                        @inv.ExpiresAt.LocalDateTime.ToString("d")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Property="TokenPrefix" Title="@L["ScimPrefix"]" />
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Title="" Sortable="false" Filterable="false" Width="120px">
                    <Template Context="inv">
                        <RadzenButton Text="@L["ScimRevoke"]" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                      Click="@(() => RevokeAsync(inv))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    private WorkspaceDto? workspace;
    private IReadOnlyList<WorkspaceMemberDto>? members;
    private IReadOnlyList<WorkspaceInvitationDto>? invitations;
    private bool showInvite;
    private bool busy;
    private string? error;
    private string? workspaceError;
    private string? membersError;
    private string? invitationsError;
    private string? issuedToken;
    private readonly InviteModel inviteModel = new();

    private IReadOnlyList<RoleOption> Roles =>
    [
        new(WorkspaceRole.Admin, L["WorkspaceRoleAdmin"]),
        new(WorkspaceRole.Member, L["WorkspaceRoleMember"]),
        new(WorkspaceRole.Observer, L["WorkspaceRoleObserver"])
    ];

    private RenderFragment ShowInviteButton() => __builder =>
    {
        <RadzenButton Text="@L["MembersInvite"]" Icon="person_add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showInvite = !showInvite)" />
    };

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var wsTask = WorkspacesApi.GetAsync(WorkspaceId);
        var membersTask = WorkspacesApi.ListMembersAsync(WorkspaceId);
        var invitationsTask = InvitationsApi.ListForWorkspaceAsync(WorkspaceId, includeTerminal: false);

        await Task.WhenAll(wsTask, membersTask, invitationsTask);

        ApiResult<WorkspaceDto> workspaceResult = await wsTask;
        ApiResult<IReadOnlyList<WorkspaceMemberDto>> membersResult = await membersTask;
        ApiResult<IReadOnlyList<WorkspaceInvitationDto>> invitationsResult = await invitationsTask;

        workspace = workspaceResult.IsSuccess ? workspaceResult.Value : null;
        workspaceError = workspaceResult.IsSuccess
            ? null
            : workspaceResult.Error ?? L["WorkspaceMembersWorkspaceLoadFailed"];

        members = membersResult.IsSuccess ? membersResult.Value : null;
        membersError = membersResult.IsSuccess
            ? null
            : membersResult.Error ?? L["WorkspaceMembersLoadFailed"];

        invitations = invitationsResult.IsSuccess ? invitationsResult.Value : null;
        invitationsError = invitationsResult.IsSuccess
            ? null
            : invitationsResult.Error ?? L["WorkspaceInvitationsLoadFailed"];
    }

    private async Task SendInviteAsync()
    {
        busy = true;
        error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(inviteModel.Email))
            {
                error = L["ValidationRequired"];
                return;
            }

            ApiResult<WorkspaceInvitationIssuanceDto> result = await InvitationsApi.IssueAsync(
                WorkspaceId, inviteModel.Email, inviteModel.Role, lifetime: null);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            issuedToken = result.Value!.CleartextToken;
            await ReloadAsync();
            // The DataGrid is data-bound to `invitations`; an
            // in-place mutation through `await ReloadAsync()`
            // produces the same reference object, so the grid
            // skips its refresh. Force a re-render so the new
            // invitation row appears immediately (BUG #12).
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelInvite()
    {
        showInvite = false;
        error = null;
        issuedToken = null;
        inviteModel.Email = string.Empty;
    }

    private void DismissIssuedToken()
    {
        issuedToken = null;
        inviteModel.Email = string.Empty;
    }

    private async Task RevokeAsync(WorkspaceInvitationDto inv)
    {
        ApiResult result = await InvitationsApi.RevokeAsync(WorkspaceId, inv.Id);
        if (result.IsSuccess)
        {
            await ReloadAsync();
        }
        else
        {
            error = result.Error;
        }
    }

    private string RoleName(WorkspaceRole role) => role switch
    {
        WorkspaceRole.Admin => L["WorkspaceRoleAdmin"],
        WorkspaceRole.Member => L["WorkspaceRoleMember"],
        WorkspaceRole.Observer => L["WorkspaceRoleObserver"],
        _ => L["CommonUnknown"]
    };

    private sealed class InviteModel
    {
        public string Email { get; set; } = string.Empty;
        public WorkspaceRole Role { get; set; } = WorkspaceRole.Member;
    }

    private sealed record RoleOption(WorkspaceRole Value, string Label);
}
