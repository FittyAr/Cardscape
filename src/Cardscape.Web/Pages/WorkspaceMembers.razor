@page "/workspaces/{WorkspaceId:guid}/members"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject IWorkspacesApiClient WorkspacesApi
@inject IInvitationsApiClient InvitationsApi
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<PageTitle>Members — Cardscape</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="Members"
                Subtitle="@(workspace?.Name ?? string.Empty)"
                Actions="@(ShowInviteButton())" />

    @if (showInvite)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="InviteModel" Data="@inviteModel" Submit="@SendInvite">
                <LabeledField Text="Email" Component="invite-email">
                    <RadzenTextBox @bind-Value="inviteModel.Email" Name="invite-email" Style="width:100%" />
                </LabeledField>

                <LabeledField Text="Role" Component="invite-role">
                    <RadzenDropDown @bind-Value="inviteModel.Role" Data="@roles"
                                    TextProperty="Label" ValueProperty="Value"
                                    Name="invite-role" Style="width:100%" />
                </LabeledField>

                @if (issuedToken is not null)
                {
                    <RadzenCard Variant="Variant.Outlined" Class="rz-mt-3">
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H3" Text="Invitation created" />
                            <RadzenText TextStyle="TextStyle.Body2">
                                Send this link to <RadzenText Text="@inviteModel.Email" TextStyle="TextStyle.Body1" TagName="TagName.Span" />.
                                It will also appear in the API log.
                            </RadzenText>
                            <SecretBox Secret="@issuedToken" />
                            <RadzenButton Text="I've sent it" ButtonStyle="ButtonStyle.Primary"
                                          Click="@DismissIssuedToken" />
                        </RadzenStack>
                    </RadzenCard>
                }
                @if (error is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Class="rz-mt-2">
                        @error
                    </RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelInvite" />
                    <RadzenButton Text="Send" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@busy" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Text="Current members" />

    @if (members is null)
    {
        <RadzenText Text="Loading…" />
    }
    else if (members.Count == 0)
    {
        <RadzenText Text="No members yet — invite someone to get started." />
    }
    else
    {
        <RadzenDataGrid TItem="WorkspaceMemberDto" Data="@members" AllowSorting="true" AllowPaging="true" PageSize="20">
            <Columns>
                <RadzenDataGridColumn TItem="WorkspaceMemberDto" Property="DisplayName" Title="Name" />
                <RadzenDataGridColumn TItem="WorkspaceMemberDto" Property="Email" Title="Email" />
                <RadzenDataGridColumn TItem="WorkspaceMemberDto" Property="Role" Title="Role">
                    <Template Context="m">
                        @RoleName(m.Role)
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }

    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Text="Pending invitations" />

    @if (invitations is null)
    {
        <RadzenText Text="Loading…" />
    }
    else if (invitations.Count == 0)
    {
        <RadzenText Text="No pending invitations." />
    }
    else
    {
        <RadzenDataGrid TItem="WorkspaceInvitationDto" Data="@invitations" AllowSorting="true" AllowPaging="true" PageSize="20">
            <Columns>
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Property="Email" Title="Email" />
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Property="Role" Title="Role">
                    <Template Context="inv">
                        @RoleName(inv.Role)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Property="ExpiresAt" Title="Expires">
                    <Template Context="inv">
                        @inv.ExpiresAt.LocalDateTime.ToString("yyyy-MM-dd")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Property="TokenPrefix" Title="Prefix" />
                <RadzenDataGridColumn TItem="WorkspaceInvitationDto" Title="" Sortable="false" Filterable="false" Width="120px">
                    <Template Context="inv">
                        <RadzenButton Text="Revoke" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                      Click="@(() => RevokeAsync(inv))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    private WorkspaceDto? workspace;
    private IReadOnlyList<WorkspaceMemberDto>? members;
    private IReadOnlyList<WorkspaceInvitationDto>? invitations;
    private bool showInvite;
    private bool busy;
    private string? error;
    private string? issuedToken;
    private readonly InviteModel inviteModel = new();

    private readonly List<RoleOption> roles = new()
    {
        new(0, "Admin"),
        new(1, "Member"),
        new(2, "Observer")
    };

    private RenderFragment ShowInviteButton() => __builder =>
    {
        <RadzenButton Text="Invite" Icon="person_add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showInvite = !showInvite)" />
    };

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var wsTask = WorkspacesApi.GetAsync(WorkspaceId);
        var membersTask = WorkspacesApi.ListMembersAsync(WorkspaceId);
        var invitationsTask = InvitationsApi.ListForWorkspaceAsync(WorkspaceId, includeTerminal: false);

        await Task.WhenAll(wsTask, membersTask, invitationsTask);

        workspace = (await wsTask).IsSuccess ? (await wsTask).Value : null;
        members = (await membersTask).IsSuccess ? (await membersTask).Value : [];
        invitations = (await invitationsTask).IsSuccess ? (await invitationsTask).Value : [];
    }

    private async Task SendInvite()
    {
        busy = true;
        error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(inviteModel.Email))
            {
                error = "Email is required.";
                return;
            }

            ApiResult<WorkspaceInvitationIssuanceDto> result = await InvitationsApi.IssueAsync(
                WorkspaceId, inviteModel.Email, inviteModel.Role, lifetime: null);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            issuedToken = result.Value!.CleartextToken;
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelInvite()
    {
        showInvite = false;
        error = null;
        issuedToken = null;
        inviteModel.Email = string.Empty;
    }

    private void DismissIssuedToken()
    {
        issuedToken = null;
        inviteModel.Email = string.Empty;
    }

    private async Task RevokeAsync(WorkspaceInvitationDto inv)
    {
        ApiResult result = await InvitationsApi.RevokeAsync(WorkspaceId, inv.Id);
        if (result.IsSuccess)
        {
            await ReloadAsync();
        }
        else
        {
            error = result.Error;
        }
    }

    private static string RoleName(int role) => role switch
    {
        0 => "Admin",
        1 => "Member",
        2 => "Observer",
        _ => "Unknown"
    };

    private sealed class InviteModel
    {
        public string Email { get; set; } = string.Empty;
        public int Role { get; set; } = 1; // Member by default
    }

    private sealed record RoleOption(int Value, string Label);
}
