@page "/workspaces/{WorkspaceId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IBoardsApiClient BoardsApi
@inject IWorkspacesApiClient WorkspacesApi
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(workspace?.Name ?? L["BoardsTitle"]) @L["PageTitleSuffix"]</PageTitle>

<RadzenBreadCrumb Class="rz-mb-3">
    <RadzenBreadCrumbItem Path="/workspaces" Text="@L["NavWorkspaces"]" Icon="domain" />
    <RadzenBreadCrumbItem Text="@(workspace?.Name ?? L["WorkspaceBadge"])" />
</RadzenBreadCrumb>

<PageHeader Title="@(workspace?.Name ?? L["WorkspaceBadge"])"
            Subtitle="@(workspace is null ? null : L["HomeWorkspaceMembers", workspace.MemberCount].Value)">
    <Actions>
        <RadzenButton Text="@L["WorkspaceTabMembers"]" Icon="group" ButtonStyle="@ButtonStyle.Base" Variant="@Variant.Text"
                      Click="@(() => Nav.NavigateTo($"workspaces/{WorkspaceId}/members"))" />
        <RadzenButton Text="@L["WorkspaceTabIntegrations"]" Icon="hub" ButtonStyle="@ButtonStyle.Base" Variant="@Variant.Text"
                      Click="@(() => Nav.NavigateTo($"workspaces/{WorkspaceId}/integrations"))" />
        <RadzenButton Text="@L["WorkspaceTabImport"]" Icon="upload_file" ButtonStyle="@ButtonStyle.Base" Variant="@Variant.Text"
                      Click="@(() => Nav.NavigateTo($"workspaces/{WorkspaceId}/import"))" />
        <RadzenButton Text="@L["WorkspaceTabSecurity"]" Icon="shield" ButtonStyle="@ButtonStyle.Base" Variant="@Variant.Text"
                      Click="@(() => Nav.NavigateTo($"workspaces/{WorkspaceId}/security"))" />
        <RadzenButton Text="@L["BoardsNew"]" Icon="add" ButtonStyle="@ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    </Actions>
</PageHeader>

@if (showCreate)
{
    <RadzenCard Class="rz-mb-4" Style="max-width: 36rem;">
        <RadzenTemplateForm TItem="CreateModel" Data="@createModel" Submit="@CreateBoardAsync">
            <LabeledField Text="@L["WorkspacesName"]" Component="b-name">
                <RadzenTextBox @bind-Value="createModel.Name" Name="b-name" Style="width:100%" />
            </LabeledField>
            <RadzenRequiredValidator Component="b-name" Text="@L["ValidationRequired"]" />

            <LabeledField Text="@L["BoardsDescription"]" Component="b-desc">
                <RadzenTextArea @bind-Value="createModel.Description" Name="b-desc" Style="width:100%" Rows="2" />
            </LabeledField>

            <LabeledField Text="@L["BoardsVisibility"]" Component="b-vis">
                <RadzenDropDown @bind-Value="createModel.Visibility" Name="b-vis" Style="width:100%"
                                Data="@VisibilityOptions"
                                TextProperty="Label" ValueProperty="Value" />
            </LabeledField>

            <RadzenStack Orientation="@Orientation.Horizontal" JustifyContent="@JustifyContent.End" Gap="0.5rem" class="rz-mt-3">
                <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="@ButtonStyle.Light" Click="@(() => { showCreate = false; error = null; })" />
                <RadzenButton Text="@L["ActionCreate"]" ButtonType="@ButtonType.Submit" ButtonStyle="@ButtonStyle.Primary"
                              IsBusy="@busy" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}

@if (error is not null)
{
    <RadzenAlert AlertStyle="@AlertStyle.Danger" Variant="@Variant.Flat" AllowClose="false" Class="rz-mb-3">@error</RadzenAlert>
}

@if (boards is null)
{
    <div class="cs-board-grid">
        <div class="cs-board-tile-skeleton"></div>
        <div class="cs-board-tile-skeleton"></div>
        <div class="cs-board-tile-skeleton"></div>
    </div>
}
else
{
    IEnumerable<BoardSummaryDto> active = boards.Where(b => !b.IsArchived);
    IEnumerable<BoardSummaryDto> archived = boards.Where(b => b.IsArchived);

    <div class="cs-board-grid">
        @foreach (BoardSummaryDto b in active.OrderByDescending(b => b.IsStarred).ThenBy(b => b.Name))
        {
            <BoardTile BoardId="b.Id" Name="@b.Name" IsStarred="b.IsStarred" Meta="@TileMeta(b)" />
        }
        <RadzenButton Text="@L["BoardsNew"]" Icon="add" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                      class="cs-board-tile cs-board-tile--new" Click="@(() => showCreate = true)" />
    </div>

    @if (archived.Any())
    {
        <h2 class="cs-section-title rz-mt-8"><RadzenIcon Icon="inventory_2" />@L["ActionArchived"]</h2>
        <div class="cs-board-grid cs-board-grid--muted">
            @foreach (BoardSummaryDto b in archived)
            {
                <BoardTile BoardId="b.Id" Name="@b.Name" Meta="@TileMeta(b)" />
            }
        </div>
    }
}

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    /// <summary>`?create=1` (used by the "New board" tile on Home)
    /// opens the create form straight away.</summary>
    [SupplyParameterFromQuery(Name = "create")] public bool OpenCreate { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private WorkspaceDto? workspace;
    private IReadOnlyList<BoardSummaryDto>? boards;
    private bool showCreate;
    private bool busy;
    private string? error;
    private readonly CreateModel createModel = new() { Visibility = BoardVisibility.Private };
    private IReadOnlyList<VisibilityOption> VisibilityOptions =>
    [
        new(BoardVisibility.Private, L["BoardsVisibilityPrivate"]),
        new(BoardVisibility.Workspace, L["BoardsVisibilityWorkspace"]),
        new(BoardVisibility.Public, L["BoardsVisibilityPublic"])
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (OpenCreate)
        {
            showCreate = true;
        }

        var wsTask = WorkspacesApi.GetAsync(WorkspaceId);
        var boardsTask = BoardsApi.ListForWorkspaceAsync(WorkspaceId);

        await Task.WhenAll(wsTask, boardsTask);

        var wsResult = await wsTask;
        if (wsResult.IsSuccess)
        {
            workspace = wsResult.Value;
        }

        var result = await boardsTask;
        if (result.IsSuccess)
        {
            boards = result.Value;
            error = null;
        }
        else
        {
            error = result.Error ?? L["BoardsLoadFailed"];
        }
    }

    private async Task CreateBoardAsync()
    {
        busy = true;
        error = null;
        try
        {
            ApiResult<BoardDto> result = await BoardsApi.CreateAsync(
                WorkspaceId, createModel.Name, createModel.Description, createModel.Visibility);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            BoardDto dto = result.Value!;
            boards = [.. (boards ?? Array.Empty<BoardSummaryDto>()),
                new BoardSummaryDto(dto.Id, dto.Name, dto.Visibility, dto.IsArchived, dto.IsStarred, dto.CreatedAt)];

            createModel.Name = string.Empty;
            createModel.Description = string.Empty;
            showCreate = false;
        }
        finally
        {
            busy = false;
        }
    }

    private string TileMeta(BoardSummaryDto board) =>
        $"{VisibilityLabel(board.Visibility)} · {board.CreatedAt.LocalDateTime.ToString("d")}";

    private string VisibilityLabel(BoardVisibility visibility) => L[visibility.LabelKey];

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public BoardVisibility Visibility { get; set; }
    }

    private sealed record VisibilityOption(BoardVisibility Value, string Label);
}
