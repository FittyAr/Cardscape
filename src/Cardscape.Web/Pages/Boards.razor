@page "/workspaces/{WorkspaceId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject IBoardsApiClient BoardsApi

<PageTitle>Boards — Cardscape</PageTitle>

<PageHeader Title="Boards">
    <Actions>
        <RadzenButton Text="New board" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    </Actions>
</PageHeader>

@if (showCreate)
{
    <RadzenCard>
        <RadzenTemplateForm TItem="CreateModel" Data="@createModel" Submit="@CreateBoard">
            <LabeledField Text="Name" Component="b-name">
                <RadzenTextBox @bind-Value="createModel.Name" Name="b-name" Style="width:100%" />
            </LabeledField>

            <LabeledField Text="Description" Component="b-desc">
                <RadzenTextArea @bind-Value="createModel.Description" Name="b-desc" Style="width:100%" Rows="2" />
            </LabeledField>

            <LabeledField Text="Visibility" Component="b-vis">
                <RadzenDropDown @bind-Value="createModel.Visibility" Name="b-vis" Style="width:100%"
                                Data="@(new[] { new { Value = BoardVisibility.Private, Label = "Private" },
                                                new { Value = BoardVisibility.Workspace, Label = "Workspace" },
                                                new { Value = BoardVisibility.Public, Label = "Public" } })"
                                TextProperty="Label" ValueProperty="Value" />
            </LabeledField>

            @if (error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" class="rz-mt-3">
                    @error
                </RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-3">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => { showCreate = false; error = null; })" />
                <RadzenButton Text="Create" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@busy" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}

@if (boards is null)
{
    <RadzenText Text="Loading…" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else if (boards.Count == 0)
{
    <RadzenText Text="No boards in this workspace yet. Create your first one above." TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else
{
    <RadzenRow Gap="1rem">
        @foreach (BoardSummaryDto b in boards)
        {
            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                <RadzenCard @onclick="@(() => Nav.NavigateTo($"boards/{b.Id}"))">
                    <RadzenText Text="@b.Name" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                        created @b.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd")
                    </RadzenText>
                    @if (b.IsStarred)
                    {
                        <div class="rz-mt-2">
                            <RadzenBadge Text="★ Starred" BadgeStyle="BadgeStyle.Success" />
                        </div>
                    }
                    @if (b.IsArchived)
                    {
                        <div class="rz-mt-2">
                            <RadzenBadge Text="Archived" BadgeStyle="BadgeStyle.Warning" />
                        </div>
                    }
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>
}

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private IReadOnlyList<BoardSummaryDto>? boards;
    private bool showCreate;
    private bool busy;
    private string? error;
    private readonly CreateModel createModel = new() { Visibility = BoardVisibility.Private };

    protected override async Task OnParametersSetAsync()
    {
        ApiResult<IReadOnlyList<BoardSummaryDto>> result = await BoardsApi.ListForWorkspaceAsync(WorkspaceId);
        if (result.IsSuccess)
        {
            boards = result.Value;
            error = null;
        }
        else
        {
            error = result.Error;
        }
    }

    private async Task CreateBoard()
    {
        busy = true;
        error = null;
        try
        {
            ApiResult<BoardDto> result = await BoardsApi.CreateAsync(
                WorkspaceId, createModel.Name, createModel.Description, createModel.Visibility);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            BoardDto dto = result.Value!;
            boards = [.. (boards ?? Array.Empty<BoardSummaryDto>()),
                new BoardSummaryDto(dto.Id, dto.Name, dto.Visibility, dto.IsArchived, dto.IsStarred, dto.CreatedAt)];

            createModel.Name = string.Empty;
            createModel.Description = string.Empty;
            showCreate = false;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public BoardVisibility Visibility { get; set; }
    }
}
