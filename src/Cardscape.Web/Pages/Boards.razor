@page "/workspaces/{WorkspaceId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IBoardsApiClient BoardsApi
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["BoardsTitle"] @L["PageTitleSuffix"]</PageTitle>

<PageHeader Title="@L["BoardsTitle"]">
    <Actions>
        <RadzenButton Text="@L["BoardsNew"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    </Actions>
</PageHeader>

@if (showCreate)
{
    <RadzenCard>
        <RadzenTemplateForm TItem="CreateModel" Data="@createModel" Submit="@CreateBoardAsync">
            <LabeledField Text="@L["WorkspacesName"]" Component="b-name">
                <RadzenTextBox @bind-Value="createModel.Name" Name="b-name" Style="width:100%" />
            </LabeledField>
            <RadzenRequiredValidator Component="b-name" Text="@L["ValidationRequired"]" />

            <LabeledField Text="@L["BoardsDescription"]" Component="b-desc">
                <RadzenTextArea @bind-Value="createModel.Description" Name="b-desc" Style="width:100%" Rows="2" />
            </LabeledField>

            <LabeledField Text="@L["BoardsVisibility"]" Component="b-vis">
                <RadzenDropDown @bind-Value="createModel.Visibility" Name="b-vis" Style="width:100%"
                                Data="@VisibilityOptions"
                                TextProperty="Label" ValueProperty="Value" />
            </LabeledField>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-3">
                <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => { showCreate = false; error = null; })" />
                <RadzenButton Text="@L["ActionCreate"]" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@busy" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}

@if (error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Class="rz-mb-3">@error</RadzenAlert>
}

@if (boards is null)
{
    <RadzenText Text="@L["ActionLoading"]" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else if (boards.Count == 0)
{
    <RadzenText Text="@L["BoardsEmpty"]" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else
{
    <RadzenRow Gap="1rem">
        @foreach (BoardSummaryDto b in boards)
        {
            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                <RadzenCard>
                    <RadzenText Text="@b.Name" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                        @L["BoardsCreatedAt", b.CreatedAt.LocalDateTime.ToString("d")]
                    </RadzenText>
                    @if (b.IsStarred)
                    {
                        <div class="rz-mt-2">
                            <RadzenBadge Text="@L["BoardsStarred"]" BadgeStyle="BadgeStyle.Success" />
                        </div>
                    }
                    @if (b.IsArchived)
                    {
                        <div class="rz-mt-2">
                            <RadzenBadge Text="@L["ActionArchived"]" BadgeStyle="BadgeStyle.Warning" />
                        </div>
                    }
                    <RadzenButton Text="@L["BoardsOpen"]" Icon="open_in_new" ButtonStyle="ButtonStyle.Light"
                                  Class="rz-mt-3" Click="@(() => Nav.NavigateTo($"boards/{b.Id}"))" />
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>
}

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private IReadOnlyList<BoardSummaryDto>? boards;
    private bool showCreate;
    private bool busy;
    private string? error;
    private readonly CreateModel createModel = new() { Visibility = BoardVisibility.Private };
    private IReadOnlyList<VisibilityOption> VisibilityOptions =>
    [
        new(BoardVisibility.Private, L["BoardsVisibilityPrivate"]),
        new(BoardVisibility.Workspace, L["BoardsVisibilityWorkspace"]),
        new(BoardVisibility.Public, L["BoardsVisibilityPublic"])
    ];

    protected override async Task OnParametersSetAsync()
    {
        ApiResult<IReadOnlyList<BoardSummaryDto>> result = await BoardsApi.ListForWorkspaceAsync(WorkspaceId);
        if (result.IsSuccess)
        {
            boards = result.Value;
            error = null;
        }
        else
        {
            error = result.Error ?? L["BoardsLoadFailed"];
        }
    }

    private async Task CreateBoardAsync()
    {
        busy = true;
        error = null;
        try
        {
            ApiResult<BoardDto> result = await BoardsApi.CreateAsync(
                WorkspaceId, createModel.Name, createModel.Description, createModel.Visibility);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            BoardDto dto = result.Value!;
            boards = [.. (boards ?? Array.Empty<BoardSummaryDto>()),
                new BoardSummaryDto(dto.Id, dto.Name, dto.Visibility, dto.IsArchived, dto.IsStarred, dto.CreatedAt)];

            createModel.Name = string.Empty;
            createModel.Description = string.Empty;
            showCreate = false;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public BoardVisibility Visibility { get; set; }
    }

    private sealed record VisibilityOption(BoardVisibility Value, string Label);
}
