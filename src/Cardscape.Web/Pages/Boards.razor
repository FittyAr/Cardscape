@page "/workspaces/{WorkspaceId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject IBoardsApiClient BoardsApi

<PageTitle>Boards — Cardscape</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <h1>Boards</h1>
        <RadzenButton Text="New board" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    </div>

    @if (showCreate)
    {
        <RadzenCard class="create-form">
            <RadzenTemplateForm TItem="CreateModel" Data="@createModel" Submit="@CreateBoard">
                <RadzenLabel Text="Name" Component="b-name" />
                <RadzenTextBox @bind-Value="createModel.Name" Name="b-name" Style="width:100%" />

                <RadzenLabel Text="Description" Component="b-desc" Style="margin-top:1rem" />
                <RadzenTextArea @bind-Value="createModel.Description" Name="b-desc" Style="width:100%" Rows="2" />

                <RadzenLabel Text="Visibility" Component="b-vis" Style="margin-top:1rem" />
                <RadzenDropDown @bind-Value="createModel.Visibility" Name="b-vis" Style="width:100%"
                                Data="@(new[] { new { Value = 0, Label = "Private" },
                                                new { Value = 1, Label = "Workspace" },
                                                new { Value = 2, Label = "Public" } })"
                                TextProperty="Label" ValueProperty="Value" />

                @if (error is not null)
                {
                    <div class="auth-error" role="alert">@error</div>
                }
                <div class="create-actions">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => { showCreate = false; error = null; })" />
                    <RadzenButton Text="Create" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@busy" />
                </div>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @if (boards is null)
    {
        <p>Loading…</p>
    }
    else if (boards.Count == 0)
    {
        <p>No boards in this workspace yet. Create your first one above.</p>
    }
    else
    {
        <div class="board-grid">
            @foreach (BoardSummaryDto b in boards)
            {
                <RadzenCard class="board-card" @onclick="@(() => Nav.NavigateTo($"boards/{b.Id}"))">
                    <h3>@b.Name</h3>
                    <small>created @b.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd")</small>
                    @if (b.IsStarred)
                    {
                        <RadzenBadge Text="★ Starred" BadgeStyle="BadgeStyle.Success" Style="margin-top:.5rem" />
                    }
                    @if (b.IsArchived)
                    {
                        <RadzenBadge Text="Archived" BadgeStyle="BadgeStyle.Warning" Style="margin-top:.5rem; margin-left:.5rem" />
                    }
                </RadzenCard>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid WorkspaceId { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private IReadOnlyList<BoardSummaryDto>? boards;
    private bool showCreate;
    private bool busy;
    private string? error;
    private readonly CreateModel createModel = new() { Visibility = 0 };

    protected override async Task OnParametersSetAsync()
    {
        ApiResult<IReadOnlyList<BoardSummaryDto>> result = await BoardsApi.ListForWorkspaceAsync(WorkspaceId);
        if (result.IsSuccess)
        {
            boards = result.Value;
            error = null;
        }
        else
        {
            error = result.Error;
        }
    }

    private async Task CreateBoard()
    {
        busy = true;
        error = null;
        try
        {
            ApiResult<BoardDto> result = await BoardsApi.CreateAsync(
                WorkspaceId, createModel.Name, createModel.Description, createModel.Visibility);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            BoardDto dto = result.Value!;
            boards = [.. (boards ?? Array.Empty<BoardSummaryDto>()),
                new BoardSummaryDto(dto.Id, dto.Name, dto.Visibility, dto.IsArchived, dto.IsStarred, dto.CreatedAt)];

            createModel.Name = string.Empty;
            createModel.Description = string.Empty;
            showCreate = false;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int Visibility { get; set; }
    }
}
