@page "/invitations/accept"
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject IInvitationsApiClient InvitationsApi
@inject AuthenticationStateProvider AuthState
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

@* Anonymous on purpose: a signed-out invitee is sent to sign in
   (existing account) or to register with the token (new account),
   and comes back here or lands in the workspace afterwards. *@

<PageTitle>@L["InvitationAcceptTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 32rem;">
    <PageHeader Title="@L["InvitationAcceptTitle"]" />

    @if (string.IsNullOrWhiteSpace(Token))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            @L["InvitationMissingToken"]
        </RadzenAlert>
    }
    else if (busy)
    {
        <LoadingState Size="LoadingSize.Section" Text="@L["InvitationAccepting"]" />
    }
    else if (accepted is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="@accepted.Name" TextStyle="TextStyle.H5" TagName="TagName.H2" />
                <RadzenText Text="@L["InvitationAccepted", accepted.Name]" />
                <RadzenButton Text="@L["InvitationOpenWorkspace"]"
                              Icon="open_in_new"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => Nav.NavigateTo($"workspaces/{accepted.Id}"))" />
            </RadzenStack>
        </RadzenCard>
    }
    else if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span">@L["InvitationAcceptFailed"]</RadzenText>
            <RadzenText>@error</RadzenText>
        </RadzenAlert>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
            @L["InvitationAcceptFailedHint"]
        </RadzenText>
    }
</RadzenStack>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private WorkspaceDto? accepted;
    private string? error;
    private bool busy;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Token) || accepted is not null)
        {
            return;
        }

        busy = true;
        try
        {
            AuthenticationState state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated != true)
            {
                await RouteSignedOutInviteeAsync(Token);
                return;
            }

            ApiResult<WorkspaceDto> result = await InvitationsApi.AcceptAsync(Token);
            if (result.IsSuccess)
            {
                accepted = result.Value;
            }
            else
            {
                error = result.Error;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RouteSignedOutInviteeAsync(string token)
    {
        ApiResult<WorkspaceInvitationPreviewDto> preview = await InvitationsApi.PreviewAsync(token);
        if (!preview.HasValue)
        {
            error = preview.Error ?? L["InvitationAcceptFailed"];
            return;
        }

        string escaped = Uri.EscapeDataString(token);
        if (preview.Value.AccountExists)
        {
            string returnUrl = Uri.EscapeDataString($"invitations/accept?token={escaped}");
            Nav.NavigateTo($"login?returnUrl={returnUrl}");
        }
        else
        {
            Nav.NavigateTo($"register?invitation={escaped}");
        }
    }
}
