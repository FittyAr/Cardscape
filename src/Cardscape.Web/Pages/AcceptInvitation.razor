@page "/invitations/accept"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IInvitationsApiClient InvitationsApi
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["InvitationAcceptTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 32rem;">
    <PageHeader Title="@L["InvitationAcceptTitle"]" />

    @if (string.IsNullOrWhiteSpace(Token))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            @L["InvitationMissingToken"]
        </RadzenAlert>
    }
    else if (busy)
    {
        <RadzenText Text="@L["InvitationAccepting"]" />
    }
    else if (accepted is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="@accepted.Name" TextStyle="TextStyle.H5" TagName="TagName.H2" />
                <RadzenText Text="@L["InvitationAccepted", accepted.Name]" />
                <RadzenButton Text="@L["InvitationOpenWorkspace"]"
                              Icon="open_in_new"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => Nav.NavigateTo($"workspaces/{accepted.Id}"))" />
            </RadzenStack>
        </RadzenCard>
    }
    else if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span">@L["InvitationAcceptFailed"]</RadzenText>
            <RadzenText>@error</RadzenText>
        </RadzenAlert>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
            @L["InvitationAcceptFailedHint"]
        </RadzenText>
    }
</RadzenStack>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private WorkspaceDto? accepted;
    private string? error;
    private bool busy;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Token) || accepted is not null)
        {
            return;
        }

        busy = true;
        try
        {
            ApiResult<WorkspaceDto> result = await InvitationsApi.AcceptAsync(Token);
            if (result.IsSuccess)
            {
                accepted = result.Value;
            }
            else
            {
                error = result.Error;
            }
        }
        finally
        {
            busy = false;
        }
    }
}
