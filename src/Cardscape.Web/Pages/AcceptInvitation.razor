@page "/invitations/accept"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject IInvitationsApiClient InvitationsApi
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<PageTitle>Accept invitation — Cardscape</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 32rem;">
    <PageHeader Title="Accept invitation" />

    @if (string.IsNullOrWhiteSpace(Token))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            The invitation link is missing a <code>token</code> query
            parameter. Open the link the workspace owner sent you.
        </RadzenAlert>
    }
    else if (busy)
    {
        <RadzenText Text="Accepting…" />
    }
    else if (accepted is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="@accepted.Name" TextStyle="TextStyle.H5" TagName="TagName.H2" />
                <RadzenText Text="@($"You are now a member of {accepted.Name}.")" />
                <RadzenButton Text="Open workspace"
                              Icon="open_in_new"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => Nav.NavigateTo($"workspaces/{accepted.Id}"))" />
            </RadzenStack>
        </RadzenCard>
    }
    else if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span">Could not accept the invitation.</RadzenText>
            <RadzenText>@error</RadzenText>
        </RadzenAlert>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
            If the link came from someone other than your workspace
            owner, it may be addressed to a different email. Sign in
            with the email that received the invite, or ask the
            owner to resend.
        </RadzenText>
    }
</RadzenStack>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private WorkspaceDto? accepted;
    private string? error;
    private bool busy;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Token) || accepted is not null)
        {
            return;
        }

        busy = true;
        try
        {
            ApiResult<WorkspaceDto> result = await InvitationsApi.AcceptAsync(Token);
            if (result.IsSuccess)
            {
                accepted = result.Value;
            }
            else
            {
                error = result.Error;
            }
        }
        finally
        {
            busy = false;
        }
    }
}
