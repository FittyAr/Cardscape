@page "/settings/external-logins"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Cardscape.Web.Services.Api
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ExternalLoginsTitle"] @L["PageTitleSuffix"]</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <h1>@L["ExternalLoginsTitle"]</h1>
        <p class="muted">@L["ExternalLoginsBlurb"]</p>
    </div>

    <RadzenCard>
        <h3>@L["ExternalLoginsLinkAnother"]</h3>
        <p class="muted">@L["ExternalLoginsLinkAnotherBlurb"]</p>
        <div class="provider-buttons">
            <a class="provider-button provider-google" href="/api/auth/external/google/start?returnUrl=/settings/external-logins">
                <span class="provider-glyph">G</span>
                <span>@L["AuthSignInWithGoogle"]</span>
            </a>
            <a class="provider-button provider-microsoft" href="/api/auth/external/microsoft/start?returnUrl=/settings/external-logins">
                <span class="provider-glyph">M</span>
                <span>@L["AuthSignInWithMicrosoft"]</span>
            </a>
            <a class="provider-button provider-apple" href="/api/auth/external/apple/start?returnUrl=/settings/external-logins">
                <span class="provider-glyph">A</span>
                <span>@L["AuthSignInWithApple"]</span>
            </a>
        </div>
    </RadzenCard>
</div>
