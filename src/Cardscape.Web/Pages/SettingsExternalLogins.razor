@page "/settings/external-logins"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Web.Resources
@using Cardscape.Web.Services.Api
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject Cardscape.Web.Services.InstanceSettingsState Instance

<PageTitle>@L["ExternalLoginsTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["ExternalLoginsTitle"]" Subtitle="@L["ExternalLoginsBlurb"]" />

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="@L["ExternalLoginsLinkAnother"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">@L["ExternalLoginsLinkAnotherBlurb"]</RadzenText>
            @if (_instance is not null)
            {
                <ExternalSignInButtons Settings="@_instance" ReturnUrl="/settings/external-logins" Size="ButtonSize.Medium">
                    <EmptyContent>
                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false">@L["ExternalLoginsNoneAvailable"]</RadzenAlert>
                    </EmptyContent>
                </ExternalSignInButtons>
            }
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    private Cardscape.Contracts.Settings.PublicInstanceSettings? _instance;

    protected override async Task OnInitializedAsync() => _instance = await Instance.GetAsync();
}
