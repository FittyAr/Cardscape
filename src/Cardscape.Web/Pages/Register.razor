@page "/register"
@layout EmptyLayout
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject AuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AuthCreateAccount"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Gap="0.25rem">
        <RadzenText Text="@L["AuthCreateAccountTitle"]" TextStyle="TextStyle.H4" TagName="TagName.H1" />
        <RadzenText Text="@L["AuthCreateAccountSubtitle"]" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
    </RadzenStack>

    <RadzenTemplateForm TItem="RegisterModel" Data="@model" Submit="@HandleSubmit">
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="@L["AuthDisplayName"]" Component="displayName">
                <RadzenTextBox @bind-Value="model.DisplayName" Name="displayName" Style="width:100%"
                               autocomplete="name" Placeholder="@L["AuthDisplayNamePlaceholder"]" />
            </RadzenFormField>

            <RadzenFormField Text="@L["AuthEmail"]" Component="email">
                <RadzenTextBox @bind-Value="model.Email" Name="email" Style="width:100%"
                               autocomplete="email" Placeholder="you@company.com" />
            </RadzenFormField>

            <RadzenFormField Text="@L["AuthPassword"]" Component="password">
                <RadzenPassword @bind-Value="model.Password" Name="password" Style="width:100%"
                                autocomplete="new-password" />
                <RadzenText Text="@L["AuthPasswordHint"]" TextStyle="TextStyle.Caption" class="rz-color-text-secondary" />
            </RadzenFormField>

            @* BUG-A8-012 — see test-results/beta/reports/A8-settings.md.
               The form previously only collected the password
               once, so a typo at signup time would silently
               ship an unrecoverable password to the API. The
               confirm field is matched against the password
               client-side before the request goes out; the
               server already enforces its own length and
               dictionary checks on the single value, this is
               a UX safety net only. *@
            <RadzenFormField Text="@L["AuthConfirmPassword"]" Component="confirmPassword">
                <RadzenPassword @bind-Value="model.ConfirmPassword" Name="confirmPassword" Style="width:100%"
                                autocomplete="new-password" />
                @if (!string.IsNullOrEmpty(model.ConfirmPassword) && model.Password != model.ConfirmPassword)
                {
                    <RadzenText Text="@L["AuthPasswordsDoNotMatch"]" TextStyle="TextStyle.Caption"
                                Style="color: var(--rz-danger);" />
                }
            </RadzenFormField>

            @if (error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
                    @error
                </RadzenAlert>
            }

            <RadzenButton ButtonType="@ButtonType.Submit"
                          Text="@L["AuthCreateAccount"]"
                          ButtonStyle="@ButtonStyle.Primary"
                          Size="@ButtonSize.Large"
                          IsBusy="@busy"
                          BusyText="@L["AuthCreating"]"
                          Disabled="@(!CanSubmit())"
                          Style="width:100%" />
        </RadzenStack>
    </RadzenTemplateForm>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center" class="rz-mt-2">
        <RadzenText Text="@L["AuthAlreadyAccount"]" />
        <RadzenLink Path="login" Text="@L["AuthSignIn"]" />
    </RadzenStack>
</RadzenStack>

@code {
    private readonly RegisterModel model = new();
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task HandleSubmit()
    {
        if (!CanSubmit())
        {
            // BUG-A8-012 — belt-and-braces: if the disabled
            // state somehow fails to fire, refuse the request.
            error = L["AuthPasswordsDoNotMatch"];
            return;
        }

        busy = true;
        error = null;
        try
        {
            ApiResult<UserSummaryDto> result = await Auth.RegisterAsync(
                model.Email, model.DisplayName, model.Password);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            Nav.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            busy = false;
        }
    }

    private bool CanSubmit() =>
        !string.IsNullOrWhiteSpace(model.Email) &&
        !string.IsNullOrWhiteSpace(model.DisplayName) &&
        !string.IsNullOrWhiteSpace(model.Password) &&
        model.Password.Length >= 8 &&
        model.Password == model.ConfirmPassword;

    private sealed class RegisterModel
    {
        public string Email { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
