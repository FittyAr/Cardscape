    private async Task ConfirmResetAsync()
    {
        bool? confirmed = await Dialogs.Confirm(
            "¿Estás seguro de que deseas restablecer todos los parámetros del sistema a los valores de fábrica?",
            "Restablecer Configuración",
            new ConfirmOptions { OkButtonText = "Sí, Restablecer", CancelButtonText = "Cancelar" });

        if (confirmed == true)
        {
            try
            {
                ApiResult<SystemSettingsDto> result = await SettingsApi.ResetSettingsAsync();
                if (result.IsSuccess && result.Value is not null)
                {
                    ApplyDto(result.Value);
                    Notify.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Valores de Fábrica Restaurados",
                        Detail = "La configuración ha sido restablecida a sus parámetros predeterminados.",
                        Duration = 4000
                    });
                }
            }
            catch (Exception ex)
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Restablecer",
                    Detail = ex.Message,
                    Duration = 5000
                });
            }
        }
    }

    private async Task TestAiConnectionAsync()
    {
        _testingAi = true;
        try
        {
            ApiResult<TestAiResponseDto> result = await SettingsApi.TestAiAsync();
            if (result.IsSuccess && result.Value is not null)
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = result.Value.Success ? NotificationSeverity.Success : NotificationSeverity.Warning,
                    Summary = result.Value.Success ? "Conexión IA Exitosa" : "Fallo de Conexión IA",
                    Detail = result.Value.Message,
                    Duration = 5000
                });
            }
            else
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Probar IA",
                    Detail = result.Error ?? "No se pudo comunicar con el servidor.",
                    Duration = 5000
                });
            }
        }
        finally
        {
            _testingAi = false;
        }
    }

    private async Task TestEmailConnectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_testEmailTarget))
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Correo Requerido",
                Detail = "Por favor ingresa un correo de destino para la prueba.",
                Duration = 3000
            });
            return;
        }

        _testingEmail = true;
        try
        {
            ApiResult<TestEmailResponseDto> result = await SettingsApi.TestEmailAsync(new TestEmailRequestDto(_testEmailTarget.Trim()));
            if (result.IsSuccess && result.Value is not null)
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = result.Value.Success ? NotificationSeverity.Success : NotificationSeverity.Warning,
                    Summary = result.Value.Success ? "Prueba SMTP Correcta" : "Fallo SMTP",
                    Detail = result.Value.Message,
                    Duration = 5000
                });
            }
            else
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Probar SMTP",
                    Detail = result.Error ?? "No se pudo comunicar con el servidor.",
                    Duration = 5000
                });
            }
        }
        finally
        {
            _testingEmail = false;
        }
    }

    private async Task ExportJsonAsync()
    {
        if (_settings is null) return;
        string json = JsonSerializer.Serialize(_settings, new JsonSerializerOptions { WriteIndented = true });
        string bytesBase64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
        string url = $"data:application/json;base64,{bytesBase64}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
