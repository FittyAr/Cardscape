@page "/admin/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using System.Text.Json
@using Cardscape.Web.Resources
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Microsoft.Extensions.Localization
@inject AdminSettingsApiClient SettingsApi
@inject NotificationService Notify
@inject DialogService Dialogs
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>Configuración Integral del Sistema @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1.5rem" Class="rz-mx-auto" Style="max-width: 85rem;">
    <PageHeader Title="Panel de Configuración del Sistema"
                Subtitle="Administración centralizada y parametrización de todos los subsistemas, políticas, integraciones y recursos de Cardscape." />

    @if (_loading)
    {
        <RadzenCard>
            <RadzenStack AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.Center" Class="rz-p-6">
                <RadzenProgressBarCircular ShowValue="false" Mode="@ProgressBarMode.Indeterminate" Size="@ProgressBarCircularSize.Medium" />
                <RadzenText Text="Cargando configuración integral..." TextStyle="@TextStyle.Body2" Class="rz-color-text-secondary rz-mt-2" />
            </RadzenStack>
        </RadzenCard>
    }
    else if (_settings is not null)
    {
        <RadzenTabs RenderMode="@TabRenderMode.Client">
            <Tabs>
                @* 1. General & Marca *@
                <RadzenTabsItem Text="General" Icon="tune">
                    <RadzenCard Class="rz-p-4">
                        <RadzenStack Gap="1.25rem">
                            <RadzenText Text="Identidad y Acceso de la Plataforma" TextStyle="@TextStyle.H6" />

                            <RadzenFormField Text="Título de la Instancia" Component="instanceTitle">
                                <RadzenTextBox @bind-Value="_model.InstanceTitle" Name="instanceTitle" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenText Text="Nombre público de la organización visible en cabeceras, correos y páginas."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />

                            <RadzenFormField Text="Mensaje de Bienvenida" Component="welcomeMsg">
                                <RadzenTextBox @bind-Value="_model.WelcomeMessage" Name="welcomeMsg" Style="width:100%" />
                            </RadzenFormField>

                            <RadzenFormField Text="Correo de Soporte y Contacto" Component="supportEmail">
                                <RadzenTextBox @bind-Value="_model.SupportEmail" Name="supportEmail" Style="width:100%" />
                            </RadzenFormField>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Idioma Predeterminado" Component="defaultLang" Style="width:100%">
                                        <RadzenDropDown @bind-Value="_model.DefaultLanguage" Data="@_languages"
                                                        TextProperty="Name" ValueProperty="Code" Name="defaultLang" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Tema Visual Predeterminado" Component="defaultTheme" Style="width:100%">
                                        <RadzenDropDown @bind-Value="_model.DefaultTheme" Data="@_themes" Name="defaultTheme" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween" Class="rz-pt-2">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Permitir Registro Público de Usuarios" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Si está deshabilitado, los usuarios sólo podrán acceder si han sido invitados expresamente."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.AllowPublicRegistration" />
                            </RadzenStack>

                            <RadzenText Text="Experiencia de Usuario Predeterminada" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Atajos de Teclado Globales" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Habilita atajos de teclado rápidos (por ejemplo, '/' para buscar, 'c' para nueva tarjeta, 'esc' para cerrar)."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.EnableKeyboardShortcuts" />
                            </RadzenStack>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Modo Compacto / Denso por Defecto" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Reduce el espaciado y márgenes para optimizar la visualización de tableros con muchas tarjetas."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.EnableDenseModeByDefault" />
                            </RadzenStack>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Mostrar Portadas de Tarjeta en Tableros" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Renderiza miniaturas e imágenes de portada en las tarjetas dentro del flujo Kanban."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.ShowCardCoverImagesByDefault" />
                            </RadzenStack>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Alertas Sonoras de Notificación" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Reproduce un suave sonido de alerta al recibir notificaciones o asignaciones en vivo."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.EnableSoundNotifications" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenTabsItem>

                @* 2. Seguridad & Acceso *@
                <RadzenTabsItem Text="Seguridad" Icon="security">
                    <RadzenCard Class="rz-p-4">
                        <RadzenStack Gap="1.25rem">
                            <RadzenText Text="Políticas de Autenticación, Credenciales y Sesión" TextStyle="@TextStyle.H6" />

                            <RadzenFormField Text="Duración del Token de Sesión JWT (Minutos)" Component="jwtExpiry">
                                <RadzenNumeric @bind-Value="_model.JwtAccessTokenMinutes" Name="jwtExpiry" Min="5" Max="43200" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenText Text="Tiempo tras el cual el token expira (por defecto 1440 min = 24 horas; rango 5 a 43200 min)."
                                        TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Confiar en Claim JWT de Administrador (Alto Rendimiento)" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Si está activo, verifica los permisos de administrador leyendo el token JWT sin consultar la base de datos en cada petición. Si está inactivo, consulta la BD en cada llamada para revocación instantánea."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.CacheAdminClaim" />
                            </RadzenStack>

                            <RadzenFormField Text="Longitud Mínima de Contraseña" Component="pwdMinLen">
                                <RadzenNumeric @bind-Value="_model.PasswordMinLength" Name="pwdMinLen" Min="6" Max="32" Style="width:100%" />
                            </RadzenFormField>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenText Text="Exigir al menos un Dígito Numérico en Contraseñas" TextStyle="@TextStyle.Subtitle2" />
                                <RadzenSwitch @bind-Value="_model.PasswordRequireDigit" />
                            </RadzenStack>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenText Text="Exigir Caracteres Especiales / No Alfanuméricos" TextStyle="@TextStyle.Subtitle2" />
                                <RadzenSwitch @bind-Value="_model.PasswordRequireNonAlphanumeric" />
                            </RadzenStack>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Exigir 2FA (TOTP) Obligatorio para Administradores" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Fuerza a todos los administradores a habilitar autenticación de dos factores para acceder a funciones administrativas."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.RequireTwoFactorForAdmins" />
                            </RadzenStack>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Nombre del Emisor TOTP (App de Autenticación)" Component="totpIssuer" Style="width:100%">
                                        <RadzenTextBox @bind-Value="_model.TotpIssuerName" Name="totpIssuer" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Tolerancia de Reloj TOTP (Pasos de 30s)" Component="totpSkew" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.TotpStepTolerance" Name="totpSkew" Min="0" Max="3" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenFormField Text="Validez de Enlaces de Restablecimiento de Contraseña (Minutos)" Component="pwdResetExp">
                                <RadzenNumeric @bind-Value="_model.PasswordResetTokenLifetimeMinutes" Name="pwdResetExp" Min="5" Max="1440" Style="width:100%" />
                            </RadzenFormField>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Límite de Intentos Fallidos de Inicio de Sesión" Component="maxFailed" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.MaxFailedLoginAttempts" Name="maxFailed" Min="3" Max="20" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Duración del Bloqueo Temporal (Minutos)" Component="lockDuration" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.LockoutDurationMinutes" Name="lockDuration" Min="1" Max="1440" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Sesión Activa Única por Usuario" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Cierra automáticamente cualquier sesión anterior en otros dispositivos al iniciar una nueva."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.SingleActiveSessionPerUser" />
                            </RadzenStack>

                            <RadzenText Text="Tokens Personales de API (PAT)" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Máx. Tokens API por Usuario" Component="maxTokens" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.MaxApiTokensPerUser" Name="maxTokens" Min="1" Max="100" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Duración Predeterminada (Días)" Component="tokenDefExp" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.DefaultApiTokenExpiryDays" Name="tokenDefExp" Min="1" Max="365" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Expiración Máxima Permitida (Días)" Component="tokenMaxExp" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.MaxApiTokenExpiryDays" Name="tokenMaxExp" Min="1" Max="1825" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenText Text="Red y Encabezados de Seguridad" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                            <RadzenFormField Text="Orígenes Permitidos CORS (separados por coma, o '*')" Component="corsOrigins">
                                <RadzenTextBox @bind-Value="_model.CorsAllowedOrigins" Name="corsOrigins" Style="width:100%" />
                            </RadzenFormField>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Forzar HTTPS y HSTS" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Redirige tráfico HTTP no seguro a HTTPS y envía encabezados Strict-Transport-Security."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.EnforceHttps" />
                            </RadzenStack>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Activar Encabezados de Protección (CSP, X-Frame, X-Content-Type)" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Protege contra clickjacking, MIME sniffing y ataques XSS inyectando cabeceras seguras."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.EnableSecurityHeaders" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenTabsItem>

                @* 3. SSO Empresarial & Provisionamiento *@
                <RadzenTabsItem Text="Empresa / SSO" Icon="corporate_fare">
                    <RadzenCard Class="rz-p-4">
                        <RadzenStack Gap="1.25rem">
                            <RadzenText Text="Autenticación Corporativa SAML 2.0, SCIM y Aplicaciones OAuth" TextStyle="@TextStyle.H6" />

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Habilitar Single Sign-On (SAML 2.0)" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Permite a los usuarios autenticarse a través de un Proveedor de Identidad empresarial (Okta, Entra ID, etc.)."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.SamlSsoEnabled" />
                            </RadzenStack>

                            @if (_model.SamlSsoEnabled)
                            {
                                <RadzenFormField Text="Forzar SAML para Dominio de Correo (opcional, ej. miempresa.com)" Component="samlDomain">
                                    <RadzenTextBox @bind-Value="_model.SamlEnforceForDomain" Name="samlDomain" Style="width:100%" />
                                </RadzenFormField>
                            }

                            <RadzenText Text="Provisionamiento de Usuarios (SCIM 2.0)" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Habilitar Provisionamiento SCIM 2.0" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Permite sincronizar usuarios y grupos automáticamente desde directorios corporativos externos."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.ScimProvisioningEnabled" />
                            </RadzenStack>

                            @if (_model.ScimProvisioningEnabled)
                            {
                                <RadzenFormField Text="Expiración de Tokens SCIM (Días)" Component="scimExp">
                                    <RadzenNumeric @bind-Value="_model.ScimTokenExpirationDays" Name="scimExp" Min="1" Max="365" Style="width:100%" />
                                </RadzenFormField>
                            }

                            <RadzenText Text="Ecosistema de Aplicaciones OAuth 2.0" TextStyle="@TextStyle.Subtitle1" Class="rz-mt-3" />

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Permitir Registro de Aplicaciones OAuth 2.0" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Habilita a los desarrolladores registrar aplicaciones clientes de terceros conectadas a la API."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.OAuthAppsEnabled" />
                            </RadzenStack>

                            @if (_model.OAuthAppsEnabled)
                            {
                                <RadzenFormField Text="Máximo de Aplicaciones OAuth por Usuario" Component="maxOAuth">
                                    <RadzenNumeric @bind-Value="_model.MaxOAuthAppsPerUser" Name="maxOAuth" Min="1" Max="50" Style="width:100%" />
                                </RadzenFormField>
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenTabsItem>

                @* 4. OAuth Social / Proveedores Externos *@
                <RadzenTabsItem Text="OAuth Externo" Icon="badge">
                    <RadzenCard Class="rz-p-4">
                        <RadzenStack Gap="1.25rem">
                            <RadzenText Text="Inicio de Sesión con Proveedores Externos (Google, GitHub, Microsoft)" TextStyle="@TextStyle.H6" />

                            @* Google OAuth *@
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Habilitar Autenticación con Google" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Permite iniciar sesión con cuentas Google Workspace y Gmail."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.EnableGoogleAuth" />
                            </RadzenStack>

                            @if (_model.EnableGoogleAuth)
                            {
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="6">
                                        <RadzenFormField Text="Google Client ID" Component="googleClientId" Style="width:100%">
                                            <RadzenTextBox @bind-Value="_model.GoogleClientId" Name="googleClientId" Style="width:100%" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenFormField Text="Google Client Secret" Component="googleClientSecret" Style="width:100%">
                                            <RadzenPassword @bind-Value="_model.GoogleClientSecret" Name="googleClientSecret" Placeholder="******" Style="width:100%" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                            }

                            @* GitHub OAuth *@
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween" Class="rz-pt-2">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Habilitar Autenticación con GitHub" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Permite a los usuarios acceder con su perfil de GitHub."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.EnableGitHubAuth" />
                            </RadzenStack>

                            @if (_model.EnableGitHubAuth)
                            {
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="6">
                                        <RadzenFormField Text="GitHub Client ID" Component="gitHubClientId" Style="width:100%">
                                            <RadzenTextBox @bind-Value="_model.GitHubClientId" Name="gitHubClientId" Style="width:100%" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenFormField Text="GitHub Client Secret" Component="gitHubClientSecret" Style="width:100%">
                                            <RadzenPassword @bind-Value="_model.GitHubClientSecret" Name="gitHubClientSecret" Placeholder="******" Style="width:100%" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                            }

                            @* Microsoft OAuth *@
                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween" Class="rz-pt-2">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Habilitar Autenticación con Microsoft (Azure AD / Entra ID)" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Permite acceder mediante cuentas profesionales o personales de Microsoft."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.EnableMicrosoftAuth" />
                            </RadzenStack>

                            @if (_model.EnableMicrosoftAuth)
                            {
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="6">
                                        <RadzenFormField Text="Microsoft Client ID" Component="msClientId" Style="width:100%">
                                            <RadzenTextBox @bind-Value="_model.MicrosoftClientId" Name="msClientId" Style="width:100%" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenFormField Text="Microsoft Client Secret" Component="msClientSecret" Style="width:100%">
                                            <RadzenPassword @bind-Value="_model.MicrosoftClientSecret" Name="msClientSecret" Placeholder="******" Style="width:100%" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenTabsItem>

                @* 5. Espacios y Tableros *@
                <RadzenTabsItem Text="Espacios y Tableros" Icon="groups">
                    <RadzenCard Class="rz-p-4">
                        <RadzenStack Gap="1.25rem">
                            <RadzenText Text="Límites de Creación y Jerarquías de Trabajo" TextStyle="@TextStyle.H6" />

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Espacios Máx. por Usuario (0 = Ilimitado)" Component="maxWorkspaces" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.MaxWorkspacesPerUser" Name="maxWorkspaces" Min="0" Max="1000" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Tableros Máx. por Espacio (0 = Ilimitado)" Component="maxBoards" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.MaxBoardsPerWorkspace" Name="maxBoards" Min="0" Max="1000" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Miembros Máx. por Espacio (0 = Ilimitado)" Component="maxMembers" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.MaxMembersPerWorkspace" Name="maxMembers" Min="0" Max="1000" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Rol Predeterminado de Nuevos Miembros" Component="defaultRole" Style="width:100%">
                                        <RadzenDropDown @bind-Value="_model.DefaultWorkspaceRole" Data="@_workspaceRoles" Name="defaultRole" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Validez de Enlaces de Invitación (Días)" Component="invExp" Style="width:100%">
                                        <RadzenNumeric @bind-Value="_model.InvitationExpirationDays" Name="invExp" Min="1" Max="90" Style="width:100%" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText Text="Permitir Tableros con Visibilidad Pública" TextStyle="@TextStyle.Subtitle2" />
                                    <RadzenText Text="Permite compartir tableros de sólo lectura con usuarios sin cuenta registrada."
                                                TextStyle="@TextStyle.Caption" Class="rz-color-text-secondary" />
                                </RadzenStack>
                                <RadzenSwitch @bind-Value="_model.AllowPublicBoards" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenTabsItem>

                @* 6. Tarjetas y Listas *@
                <RadzenTabsItem Text="Tarjetas y Listas" Icon="view_kanban">
