    private SystemSettingsDto? _settings;
    private readonly SettingsFormModel _model = new();
    private bool _loading = true;
    private bool _saving;
    private bool _testingAi;
    private bool _testingEmail;
    private string _testEmailTarget = "admin@cardscape.local";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            ApiResult<SystemSettingsDto> result = await SettingsApi.GetSettingsAsync();
            if (result.IsSuccess && result.Value is not null)
            {
                ApplyDto(result.Value);
            }
            else
            {
                _error = result.Error ?? "No se pudo cargar la configuración del sistema.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyDto(SystemSettingsDto dto)
    {
        _settings = dto;

        _model.InstanceTitle = dto.InstanceTitle;
        _model.SupportEmail = dto.SupportEmail;
        _model.DefaultLanguage = dto.DefaultLanguage;
        _model.DefaultTheme = dto.DefaultTheme;
        _model.AllowPublicRegistration = dto.AllowPublicRegistration;

        _model.JwtAccessTokenMinutes = dto.JwtAccessTokenMinutes;
        _model.PasswordMinLength = dto.PasswordMinLength;
        _model.PasswordRequireDigit = dto.PasswordRequireDigit;
        _model.PasswordRequireNonAlphanumeric = dto.PasswordRequireNonAlphanumeric;
        _model.RequireTwoFactorForAdmins = dto.RequireTwoFactorForAdmins;
        _model.MaxFailedLoginAttempts = dto.MaxFailedLoginAttempts;

        _model.MaxAttachmentSizeMb = dto.MaxAttachmentSizeMb;
        _model.AllowedAttachmentExtensions = dto.AllowedAttachmentExtensions;

        _model.AiEnabled = dto.AiEnabled;
        _model.AiProvider = dto.AiProvider;
        _model.AiEndpoint = dto.AiEndpoint;
        _model.AiModel = dto.AiModel;
        _model.AiApiKey = null;
        _model.AiTimeoutSeconds = dto.AiTimeoutSeconds;

        _model.EmailNotificationsEnabled = dto.EmailNotificationsEnabled;
        _model.SmtpHost = dto.SmtpHost;
        _model.SmtpPort = dto.SmtpPort;
        _model.SmtpUsername = dto.SmtpUsername;
        _model.SmtpPassword = null;
        _model.SmtpEnableSsl = dto.SmtpEnableSsl;
        _model.SenderEmail = dto.SenderEmail;
        _model.SenderName = dto.SenderName;

        _model.WebhooksEnabled = dto.WebhooksEnabled;
        _model.MaxWebhookRetries = dto.MaxWebhookRetries;
        _model.WebhookTimeoutSeconds = dto.WebhookTimeoutSeconds;
        _model.SlackIntegrationEnabled = dto.SlackIntegrationEnabled;
        _model.GitHubIntegrationEnabled = dto.GitHubIntegrationEnabled;
        _model.GoogleCalendarIntegrationEnabled = dto.GoogleCalendarIntegrationEnabled;

        _model.RateLimitingEnabled = dto.RateLimitingEnabled;
        _model.DefaultRequestsPerHour = dto.DefaultRequestsPerHour;
        _model.RateLimiterBackend = dto.RateLimiterBackend;

        _model.RetentionSweeperEnabled = dto.RetentionSweeperEnabled;
        _model.SweepIntervalHours = dto.SweepIntervalHours;
        _model.UserGracePeriodDays = dto.UserGracePeriodDays;
        _model.ActivityRetentionDays = dto.ActivityRetentionDays;
        _model.AuditRetentionDays = dto.AuditRetentionDays;

        _model.DataResidencyEnabled = dto.DataResidencyEnabled;
        _model.SeederEnabled = dto.SeederEnabled;
    }

    private async Task SaveSettingsAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var req = new UpdateSystemSettingsRequestDto(
                InstanceTitle: _model.InstanceTitle,
                SupportEmail: _model.SupportEmail,
                DefaultLanguage: _model.DefaultLanguage,
                DefaultTheme: _model.DefaultTheme,
                AllowPublicRegistration: _model.AllowPublicRegistration,

                JwtAccessTokenMinutes: _model.JwtAccessTokenMinutes,
                PasswordMinLength: _model.PasswordMinLength,
                PasswordRequireDigit: _model.PasswordRequireDigit,
                PasswordRequireNonAlphanumeric: _model.PasswordRequireNonAlphanumeric,
                RequireTwoFactorForAdmins: _model.RequireTwoFactorForAdmins,
                MaxFailedLoginAttempts: _model.MaxFailedLoginAttempts,

                MaxAttachmentSizeMb: _model.MaxAttachmentSizeMb,
                AllowedAttachmentExtensions: _model.AllowedAttachmentExtensions,

                AiEnabled: _model.AiEnabled,
                AiProvider: _model.AiProvider,
                AiEndpoint: _model.AiEndpoint,
                AiModel: _model.AiModel,
                AiApiKey: _model.AiApiKey,
                AiTimeoutSeconds: _model.AiTimeoutSeconds,

                EmailNotificationsEnabled: _model.EmailNotificationsEnabled,
                SmtpHost: _model.SmtpHost,
                SmtpPort: _model.SmtpPort,
                SmtpUsername: _model.SmtpUsername,
                SmtpPassword: _model.SmtpPassword,
                SmtpEnableSsl: _model.SmtpEnableSsl,
                SenderEmail: _model.SenderEmail,
                SenderName: _model.SenderName,

                WebhooksEnabled: _model.WebhooksEnabled,
                MaxWebhookRetries: _model.MaxWebhookRetries,
                WebhookTimeoutSeconds: _model.WebhookTimeoutSeconds,
                SlackIntegrationEnabled: _model.SlackIntegrationEnabled,
                GitHubIntegrationEnabled: _model.GitHubIntegrationEnabled,
                GoogleCalendarIntegrationEnabled: _model.GoogleCalendarIntegrationEnabled,

                RateLimitingEnabled: _model.RateLimitingEnabled,
                DefaultRequestsPerHour: _model.DefaultRequestsPerHour,
                RateLimiterBackend: _model.RateLimiterBackend,

                RetentionSweeperEnabled: _model.RetentionSweeperEnabled,
                SweepIntervalHours: _model.SweepIntervalHours,
                UserGracePeriodDays: _model.UserGracePeriodDays,
                ActivityRetentionDays: _model.ActivityRetentionDays,
                AuditRetentionDays: _model.AuditRetentionDays,

                DataResidencyEnabled: _model.DataResidencyEnabled,
                SeederEnabled: _model.SeederEnabled
            );

            ApiResult<SystemSettingsDto> result = await SettingsApi.UpdateSettingsAsync(req);
            if (result.IsSuccess && result.Value is not null)
            {
                ApplyDto(result.Value);
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Configuración Guardada",
                    Detail = "Todos los parámetros del sistema han sido actualizados con éxito.",
                    Duration = 4000
                });
            }
            else
            {
                _error = result.Error ?? "Error al actualizar la configuración.";
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Guardar",
                    Detail = _error,
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmResetAsync()
    {
        bool? confirmed = await Dialogs.Confirm(
            "¿Estás seguro de que deseas restablecer todos los parámetros del sistema a los valores de fábrica?",
            "Restablecer Configuración",
            new ConfirmOptions { OkButtonText = "Sí, Restablecer", CancelButtonText = "Cancelar" });

        if (confirmed == true)
        {
            try
            {
                ApiResult<SystemSettingsDto> result = await SettingsApi.ResetSettingsAsync();
                if (result.IsSuccess && result.Value is not null)
                {
                    ApplyDto(result.Value);
                    Notify.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Valores de Fábrica Restaurados",
                        Detail = "La configuración ha sido restablecida a sus parámetros predeterminados.",
                        Duration = 4000
                    });
                }
            }
            catch (Exception ex)
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Restablecer",
                    Detail = ex.Message,
                    Duration = 5000
                });
            }
        }
    }

    private async Task TestAiConnectionAsync()
    {
        _testingAi = true;
        try
        {
            ApiResult<TestAiResponseDto> result = await SettingsApi.TestAiAsync();
            if (result.IsSuccess && result.Value is not null)
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = result.Value.Success ? NotificationSeverity.Success : NotificationSeverity.Warning,
                    Summary = result.Value.Success ? "Conexión IA Exitosa" : "Fallo de Conexión IA",
                    Detail = result.Value.Message,
                    Duration = 5000
                });
            }
            else
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Probar IA",
                    Detail = result.Error ?? "No se pudo comunicar con el servidor.",
                    Duration = 5000
                });
            }
        }
        finally
        {
            _testingAi = false;
        }
    }

    private async Task TestEmailConnectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_testEmailTarget))
        {
            Notify.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Correo Requerido",
                Detail = "Por favor ingresa un correo de destino para la prueba.",
                Duration = 3000
            });
            return;
        }

        _testingEmail = true;
        try
        {
            ApiResult<TestEmailResponseDto> result = await SettingsApi.TestEmailAsync(new TestEmailRequestDto(_testEmailTarget.Trim()));
            if (result.IsSuccess && result.Value is not null)
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = result.Value.Success ? NotificationSeverity.Success : NotificationSeverity.Warning,
                    Summary = result.Value.Success ? "Prueba SMTP Correcta" : "Fallo SMTP",
                    Detail = result.Value.Message,
                    Duration = 5000
                });
            }
            else
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Probar SMTP",
                    Detail = result.Error ?? "No se pudo comunicar con el servidor.",
                    Duration = 5000
                });
            }
        }
        finally
        {
            _testingEmail = false;
        }
    }

    private async Task ExportJsonAsync()
    {
        if (_settings is null) return;
        string json = JsonSerializer.Serialize(_settings, new JsonSerializerOptions { WriteIndented = true });
        string bytesBase64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
        string url = $"data:application/json;base64,{bytesBase64}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
