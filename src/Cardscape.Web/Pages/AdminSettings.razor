@page "/admin/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@using Cardscape.Contracts.Settings
@using Cardscape.Web.Components.Seeder
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject AdminSettingsEditor Editor
@inject NotificationService Notify
@inject DialogService Dialogs
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<PageTitle>@L["NavSystemSettings"] @L["PageTitleSuffix"]</PageTitle>

<PageHeader Title="@L["NavSystemSettings"]" Subtitle="@L["SettingsSubtitle"]" />

@if (_loadError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_loadError</RadzenAlert>
}
else if (Editor.Draft is not { } draft)
{
    <LoadingState Size="LoadingSize.Page" />
}
else
{
    <RadzenTemplateForm TItem="SystemSettings" Data="@draft" Submit="@SaveAsync">
        <FormChangeListener Changed="@StateHasChanged" />
        <RadzenStack Gap="1rem">
            <RadzenTabs RenderMode="TabRenderMode.Client" @bind-SelectedIndex="_selectedTab">
                <Tabs>
                    <RadzenTabsItem Text="@L["SettingsTabGeneral"]" Icon="tune">
                        <GeneralSettingsPanel Model="@draft.General" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@L["SettingsTabAccess"]" Icon="login">
                        <AccessSettingsPanel Model="@draft.Access" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@L["SettingsTabNotices"]" Icon="campaign">
                        <NoticeSettingsPanel Model="@draft.Notices" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@L["SettingsTabLimits"]" Icon="speed">
                        <LimitSettingsPanel Model="@draft.Limits" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@L["SettingsTabAi"]" Icon="auto_awesome">
                        <AiSettingsPanel Model="@draft.Ai" HasUnsavedChanges="@Editor.HasChanges" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@L["SettingsTabEmail"]" Icon="mail">
                        <EmailSettingsPanel Model="@draft.Email" InstanceTitle="@draft.General.InstanceTitle"
                                            HasUnsavedChanges="@Editor.HasChanges" />
                    </RadzenTabsItem>
                    @* Only while the seeder is enabled on the server (the saved
                       value, not the draft): its endpoints answer 404 otherwise.
                       The on/off switch itself lives in the System tab. *@
                    @if (Editor.SeederEnabled)
                    {
                        <RadzenTabsItem Text="@L["SettingsTabSeeder"]" Icon="database">
                            <SeederSettingsPanel Model="@draft.Seeder" ShowEnableSwitch="false" />
                            <SeederConsole />
                        </RadzenTabsItem>
                    }
                    <RadzenTabsItem Text="@L["SettingsTabSystem"]" Icon="monitor_heart">
                        <RadzenStack Gap="1rem">
                            <SeederSettingsPanel Model="@draft.Seeder" ShowWipeDefault="false" />
                            <SystemInfoPanel />
                        </RadzenStack>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>

            <RadzenCard Variant="Variant.Outlined" class="cs-settings-actions rz-p-3">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"
                             AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                    <RadzenText Text="@(Editor.HasChanges ? L["SettingsUnsavedChanges"] : L["SettingsAllSaved"])"
                                TextStyle="TextStyle.Caption" class="rz-color-text-secondary rz-m-0 rz-me-auto" />
                    <RadzenButton Text="@L["SettingsResetDefaults"]" Icon="restart_alt" ButtonStyle="ButtonStyle.Danger"
                                  Variant="Variant.Text" Click="@ResetAsync" Disabled="@_busy" />
                    <RadzenButton Text="@L["SettingsDiscard"]" Icon="undo" ButtonStyle="ButtonStyle.Light"
                                  Click="@Editor.Discard" Disabled="@(_busy || !Editor.HasChanges)" />
                    <RadzenButton ButtonType="ButtonType.Submit" Text="@L["SettingsSave"]" Icon="save"
                                  ButtonStyle="ButtonStyle.Primary" IsBusy="@_busy" Disabled="@(!Editor.HasChanges)" />
                </RadzenStack>
            </RadzenCard>
        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    // Tab order, used to open a tab from ?tab=… (old /admin/seeder links).
    private const int SeederTabIndex = 6;

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private string? _loadError;
    private bool _busy;
    private int _selectedTab;

    protected override async Task OnInitializedAsync()
    {
        _loadError = await Editor.LoadAsync();
        if (string.Equals(Tab, "seeder", StringComparison.OrdinalIgnoreCase) && Editor.SeederEnabled)
        {
            _selectedTab = SeederTabIndex;
        }
    }

    private Task SaveAsync() => RunAsync(Editor.SaveAsync, L["SettingsSaved"]);

    private async Task ResetAsync()
    {
        bool? confirmed = await Dialogs.Confirm(
            L["SettingsResetConfirm"], L["SettingsResetDefaults"],
            new ConfirmOptions { OkButtonText = L["SettingsResetDefaults"], CancelButtonText = L["CommonCancel"] });
        if (confirmed == true)
        {
            await RunAsync(Editor.ResetToDefaultsAsync, L["SettingsResetDone"]);
        }
    }

    private async Task RunAsync(Func<Task<string?>> operation, string successMessage)
    {
        _busy = true;
        string? error = await operation();
        _busy = false;
        if (error is null)
        {
            Notify.Notify(NotificationSeverity.Success, successMessage);
        }
        else
        {
            Notify.Notify(NotificationSeverity.Error, L["SettingsSaveFailed"], error, duration: 8000);
        }
    }
}
