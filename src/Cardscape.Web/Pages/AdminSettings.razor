                AutoPurgeOrphanAttachments: _model.AutoPurgeOrphanAttachments,
                DataResidencyEnabled: _model.DataResidencyEnabled,
                DeploymentRegion: _model.DeploymentRegion,
                EnforceDataResidency: _model.EnforceDataResidency,
                SoftDeleteRetentionDays: _model.SoftDeleteRetentionDays,
                PermanentDeleteRequiresAdmin: _model.PermanentDeleteRequiresAdmin,
                CustomPrivacyPolicyUrl: _model.CustomPrivacyPolicyUrl ?? string.Empty,
                CustomTermsOfServiceUrl: _model.CustomTermsOfServiceUrl ?? string.Empty,
                DisplayCookieBanner: _model.DisplayCookieBanner,
                RequireLegalNoticeAcceptance: _model.RequireLegalNoticeAcceptance,

                // 30. Automated Backups
                AutoBackupEnabled: _model.AutoBackupEnabled,
                BackupIntervalHours: _model.BackupIntervalHours,
                BackupRetentionDays: _model.BackupRetentionDays,

                // 31. Seeder & Dev
                SeederEnabled: _model.SeederEnabled,
                AllowSeederExecution: _model.AllowSeederExecution,
                SeederWipeBeforeSeed: _model.SeederWipeBeforeSeed
            );

            ApiResult<SystemSettingsDto> result = await SettingsApi.UpdateSettingsAsync(req);
            if (result.IsSuccess && result.Value is not null)
            {
                ApplyDto(result.Value);
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Configuración Actualizada",
                    Detail = "Todos los parámetros del sistema han sido guardados con éxito.",
                    Duration = 4000
                });
            }
            else
            {
                _error = result.Error ?? "Error al actualizar la configuración.";
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Guardar",
                    Detail = _error,
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmResetAsync()
    {
        bool? confirmed = await Dialogs.Confirm(
            "¿Estás seguro de que deseas restablecer todos los parámetros del sistema a los valores de fábrica?",
            "Restablecer Configuración",
            new ConfirmOptions { OkButtonText = "Sí, Restablecer", CancelButtonText = "Cancelar" });

        if (confirmed == true)
        {
            try
            {
                ApiResult<SystemSettingsDto> result = await SettingsApi.ResetSettingsAsync();
                if (result.IsSuccess && result.Value is not null)
                {
                    ApplyDto(result.Value);
                    Notify.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Valores de Fábrica Restaurados",
                        Detail = "La configuración ha sido restablecida a sus parámetros predeterminados.",
                        Duration = 4000
                    });
                }
            }
            catch (Exception ex)
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Restablecer",
                    Detail = ex.Message,
                    Duration = 5000
                });
            }
        }
    }

    private async Task TestAiConnectionAsync()
    {
        _testingAi = true;
        try
        {
            ApiResult<TestAiResponseDto> result = await SettingsApi.TestAiAsync();
            if (result.IsSuccess && result.Value is not null)
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = result.Value.Success ? NotificationSeverity.Success : NotificationSeverity.Warning,
                    Summary = result.Value.Success ? "Conexión IA Exitosa" : "Fallo de Conexión IA",
                    Detail = result.Value.Message,
                    Duration = 5000
                });
            }
            else
            {
                Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Probar IA",
                    Detail = result.Error ?? "No se pudo comunicar con el servidor.",
                    Duration = 5000
                });
            }
        }
        finally
