@page "/boards/{BoardId:guid}/custom-fields"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Text.Json
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject ICustomFieldsApiClient CustomFieldsClient
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["CustomFieldsTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["CustomFieldsTitle"]"
                Actions="@(NewFieldButton())" />

    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
        @L["CustomFieldsBlurb"]
    </RadzenText>

    @if (rows is null)
    {
        <RadzenText Text="@L["CommonLoading"]" />
    }
    else if (rows.Count == 0 && !showCreate)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
            @L["CustomFieldsEmpty"]
        </RadzenText>
    }
    else if (rows.Count > 0)
    {
        <RadzenStack Gap="0.5rem">
            @foreach (CustomFieldDefinitionDto field in rows)
            {
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0.25rem">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                <RadzenText Text="@field.Name" TextStyle="TextStyle.Body1" TagName="TagName.Span" />
                                <RadzenBadge Text="@KindLabel(field.Kind)" BadgeStyle="BadgeStyle.Info" />
                            </RadzenStack>
                            @if (field.Kind == CustomFieldKind.Dropdown)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                                    @L["CustomFieldsOptions", string.Join(", ", ParseOptions(field.OptionsJson))]
                                </RadzenText>
                            }
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                            @if (renamingId == field.Id)
                            {
                                <RadzenTextBox @bind-Value="renameValue" Style="width:200px" />
                                <RadzenButton Text="@L["ActionSave"]" ButtonStyle="ButtonStyle.Success"
                                              Size="ButtonSize.Small" Click="@(() => SaveRenameAsync(field))" />
                                <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small" Click="@CancelRename" />
                            }
                            else
                            {
                                <RadzenButton Text="@L["CustomFieldsRename"]" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small" Click="@(() => StartRename(field))" />
                                <RadzenButton Text="@L["ActionDelete"]" ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small" Click="@(() => DeleteAsync(field))" />
                            }
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    }

    @if (showCreate)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="CreateModel" Data="@createModel" Submit="@CreateAsync">
              <RadzenStack Gap="0.5rem">
                <RadzenText Text="@L["CustomFieldsNew"]" TextStyle="TextStyle.H5" TagName="TagName.H3" />
                <LabeledField Text="@L["CustomFieldsName"]" Component="cf-name">
                    <RadzenTextBox @bind-Value="createModel.Name" Name="cf-name" Placeholder="@L["CustomFieldsNamePlaceholder"]" Style="width:100%" />
                </LabeledField>
                <RadzenRequiredValidator Component="cf-name" Text="@L["ValidationRequired"]" />
                <LabeledField Text="@L["CustomFieldsKind"]" Component="cf-kind">
                    <RadzenDropDown @bind-Value="createModel.KindValue" Data="@AllKinds"
                                    TextProperty="Label" ValueProperty="Value" Name="cf-kind" Style="width:100%" />
                </LabeledField>
                @if (createModel.KindValue == CustomFieldKind.Dropdown)
                {
                    <LabeledField Text="@L["CustomFieldsDropdownOptions"]" Component="cf-options">
                        <RadzenTextBox @bind-Value="createModel.OptionsRaw"
                                       Name="cf-options" Placeholder="@L["CustomFieldsOptionsPlaceholder"]" Style="width:100%" />
                    </LabeledField>
                    <RadzenRequiredValidator Component="cf-options" Text="@L["CustomFieldsOptionsRequired"]" />
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="ButtonStyle.Light" Click="@CancelCreate" />
                    <RadzenButton Text="@L["ActionCreate"]" ButtonStyle="ButtonStyle.Primary"
                                  ButtonType="ButtonType.Submit" IsBusy="@creating" />
                </RadzenStack>
              </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            @error
        </RadzenAlert>
    }
</RadzenStack>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private IReadOnlyList<CustomFieldDefinitionDto>? rows;
    private string? error;
    private bool showCreate;
    private bool creating;
    private CreateModel createModel = new();
    private Guid? renamingId;
    private string renameValue = string.Empty;

    private IReadOnlyList<KindOption> AllKinds =>
    [
        new(CustomFieldKind.Text, L["CustomFieldText"]),
        new(CustomFieldKind.Number, L["CustomFieldNumber"]),
        new(CustomFieldKind.Date, L["CustomFieldDate"]),
        new(CustomFieldKind.Dropdown, L["CustomFieldDropdown"]),
        new(CustomFieldKind.Checkbox, L["CustomFieldCheckbox"])
    ];

    private RenderFragment NewFieldButton() => __builder =>
    {
        <RadzenButton Text="@L["CustomFieldsNewAction"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@ShowCreateForm" />
    };

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        ApiResult<IReadOnlyList<CustomFieldDefinitionDto>> result =
            await CustomFieldsClient.ListForBoardAsync(BoardId);
        if (result.IsSuccess)
        {
            rows = result.Value;
            error = null;
        }
        else
        {
            rows = [];
            error = result.Error;
        }
    }

    private void ShowCreateForm()
    {
        createModel = new CreateModel();
        showCreate = true;
        error = null;
    }

    private void CancelCreate()
    {
        showCreate = false;
        createModel = new CreateModel();
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(createModel.Name))
        {
            error = L["ValidationRequired"];
            return;
        }

        IReadOnlyList<string>? options = null;
        if (createModel.KindValue == CustomFieldKind.Dropdown)
        {
            options = (createModel.OptionsRaw ?? string.Empty)
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (options.Count == 0)
            {
                error = L["CustomFieldsOptionsRequired"];
                return;
            }
        }

        creating = true;
        try
        {
            ApiResult<CustomFieldDefinitionDto> result = await CustomFieldsClient.CreateAsync(
                BoardId,
                new CreateCustomFieldRequestDto(
                    createModel.Name.Trim(),
                    createModel.KindValue,
                    options,
                    rows?.Count ?? 0));
            if (result.IsSuccess)
            {
                showCreate = false;
                createModel = new CreateModel();
                await ReloadAsync();
            }
            else
            {
                error = result.Error;
            }
        }
        finally
        {
            creating = false;
        }
    }

    private void StartRename(CustomFieldDefinitionDto field)
    {
        renamingId = field.Id;
        renameValue = field.Name;
        error = null;
    }

    private void CancelRename()
    {
        renamingId = null;
        renameValue = string.Empty;
    }

    private async Task SaveRenameAsync(CustomFieldDefinitionDto field)
    {
        if (string.IsNullOrWhiteSpace(renameValue) || renameValue == field.Name)
        {
            CancelRename();
            return;
        }

        ApiResult<CustomFieldDefinitionDto> result = await CustomFieldsClient.RenameAsync(
            BoardId, field.Id, new RenameCustomFieldRequestDto(renameValue.Trim()));
        if (result.IsSuccess)
        {
            CancelRename();
            await ReloadAsync();
        }
        else
        {
            error = result.Error;
        }
    }

    private async Task DeleteAsync(CustomFieldDefinitionDto field)
    {
        bool? ok = await DialogService.Confirm(
            L["CustomFieldsDeleteConfirm", field.Name],
            L["CustomFieldsDeleteTitle"], new ConfirmOptions { OkButtonText = L["ActionDelete"], CancelButtonText = L["ActionCancel"] });
        if (ok != true)
        {
            return;
        }

        ApiResult result = await CustomFieldsClient.DeleteAsync(BoardId, field.Id);
        if (result.IsSuccess)
        {
            await ReloadAsync();
        }
        else
        {
            error = result.Error;
        }
    }

    private string KindLabel(CustomFieldKind kind) =>
        AllKinds.FirstOrDefault(k => k.Value == kind)?.Label ?? L["CustomFieldUnknown", (int)kind];

    private static IEnumerable<string> ParseOptions(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return [];
        }

        try
        {
            return JsonSerializer.Deserialize<string[]>(json) ?? [];
        }
        catch
        {
            return [];
        }
    }

    private sealed record KindOption(CustomFieldKind Value, string Label);

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public CustomFieldKind KindValue { get; set; } = CustomFieldKind.Text;
        public string OptionsRaw { get; set; } = string.Empty;
    }
}
