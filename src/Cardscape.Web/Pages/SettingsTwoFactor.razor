@page "/settings/two-factor"
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Radzen
@inject IHttpClientFactory HttpFactory
@inject TokenStore Tokens
@inject AuthStateProvider Auth
@inject NavigationManager Nav
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["SettingsTwoFactor"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Class="rz-mx-auto" Style="max-width: 48rem;" Gap="1rem">
    <RadzenText Text="@L["SettingsTwoFactor"]" TextStyle="TextStyle.H4" TagName="TagName.H1" />

    @if (loading)
    {
        <RadzenText Text="@L["ActionLoading"]" TextStyle="TextStyle.Body1" />
    }
    else if (status is null || !status.IsEnrolled)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="@L["SettingsTwoFactorProtectTitle"]" TextStyle="TextStyle.H5" TagName="TagName.H2" />
                <RadzenText Text="@L["SettingsTwoFactorProtectBlurb"]" />
                <RadzenButton Text="@L["SettingsTwoFactorEnrol"]"
                              Click="@OnEnroll"
                              ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenCard>

        @if (enrollment is not null)
        {
            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenText Text="@L["SettingsTwoFactorScanTitle"]"
                                TextStyle="TextStyle.H6" TagName="TagName.H3" />
                    <RadzenText>
                        <RadzenLink Path="@enrollment.QrCodeUrl" Target="_blank" Text="@L["SettingsTwoFactorOpenUri"]" />
                        @L["SettingsTwoFactorOrCopy"]
                    </RadzenText>
                    <SecretBox Secret="@enrollment.Secret" AriaLabel="@L["SettingsTwoFactorSecretAria"]" />

                    <RadzenText Text="@L["SettingsTwoFactorRecoveryTitle"]"
                                TextStyle="TextStyle.H6" TagName="TagName.H3" Class="rz-mt-4" />
                    <RadzenText>
                        @L["SettingsTwoFactorRecoveryBlurb"]
                    </RadzenText>
                    <ItemList>
                        @foreach (var recoveryCode in enrollment.RecoveryCodes)
                        {
                            <li><SecretBox Secret="@recoveryCode" AriaLabel="@L["SettingsTwoFactorRecoveryAria"]" /></li>
                        }
                    </ItemList>
                </RadzenStack>
            </RadzenCard>
        }
    }
    else
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText Text="@L["SettingsTwoFactorOn"]" TextStyle="TextStyle.H5" TagName="TagName.H2" />
                <RadzenText Text="@string.Format(L["SettingsTwoFactorEnrolledAt"].Value, status.EnrolledAt?.ToString("u"))" />
                <RadzenText Text="@string.Format(L["SettingsTwoFactorRecoveryCodesRemaining"].Value, status.RemainingRecoveryCodes)" />
                <RadzenButton Text="@L["SettingsTwoFactorDisable"]"
                              Click="@OnDisable"
                              ButtonStyle="ButtonStyle.Danger" />
            </RadzenStack>
        </RadzenCard>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">
            @message
        </RadzenAlert>
    }
</RadzenStack>

@code {
    private TotpStatusDto? status;
    private TotpEnrollmentDto? enrollment;
    private bool loading = true;
    private string? message;

    protected override async Task OnInitializedAsync() => await LoadStatusAsync();

    private async Task LoadStatusAsync()
    {
        loading = true;
        message = null;
        try
        {
            var http = await AuthedClientAsync();
            status = await http.GetFromJsonAsync<TotpStatusDto>("api/auth/2fa/status");
        }
        catch (Exception ex)
        {
            message = string.Format(L["SettingsTwoFactorLoadError"].Value, ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnEnroll()
    {
        message = null;
        try
        {
            var http = await AuthedClientAsync();
            var response = await http.PostAsync("api/auth/2fa/enroll", content: null);
            if (!response.IsSuccessStatusCode)
            {
                message = string.Format(L["SettingsTwoFactorEnrolError"].Value, response.StatusCode);
                return;
            }
            enrollment = await response.Content.ReadFromJsonAsync<TotpEnrollmentDto>();
        }
        catch (Exception ex)
        {
            message = string.Format(L["SettingsTwoFactorEnrolError"].Value, ex.Message);
        }
    }

    private async Task OnDisable()
    {
        message = null;
        try
        {
            // Open a RadzenDialog instead of the browser-native
            // `window.prompt(...)` (which is not accessible, not
            // styleable, and breaks the Blazor layout).
            var result = await DialogService.OpenAsync<ConfirmCodeDialog>(
                L["SettingsTwoFactorConfirmTitle"],
                new Dictionary<string, object?>
                {
                    ["Label"] = L["SettingsTwoFactorCurrentCode"],
                    ["Message"] = L["SettingsTwoFactorConfirmBlurb"]
                },
                new DialogOptions
                {
                    Width = "420px",
                    CloseDialogOnOverlayClick = false,
                    ShowClose = true
                });

            if (result is not string code || string.IsNullOrWhiteSpace(code))
            {
                return;
            }

            var http = await AuthedClientAsync();
            var response = await http.PostAsJsonAsync("api/auth/2fa/disable", new { code });
            if (!response.IsSuccessStatusCode)
            {
                message = L["SettingsTwoFactorDisableInvalidCode"];
                return;
            }
            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            message = string.Format(L["SettingsTwoFactorDisableError"].Value, ex.Message);
        }
    }

    // BETA-2-UI-#5 — see test-results/ui/beta-test-r2-ui.md.
    //
    // The previous version used `@inject HttpClient Http`
    // (the framework-provided client with no BaseAddress) and
    // called `http.GetAsync("api/auth/2fa/status")` on a
    // relative URL — that throws
    // `net_http_client_invalid_requesturi` because there's
    // no base URL. The right pattern (used by every other
    // page in the app) is to ask the IHttpClientFactory for
    // the "Cardscape.Api" client, which has its BaseAddress
    // configured in Program.cs. The auth token is attached
    // per-request so we don't mutate the shared client's
    // DefaultRequestHeaders across calls.
    private async Task<HttpClient> AuthedClientAsync()
    {
        var http = HttpFactory.CreateClient("Cardscape.Api");
        var token = await Tokens.GetAccessTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
        return http;
    }

    private sealed record TotpStatusDto(bool IsEnrolled, DateTimeOffset? EnrolledAt, int RemainingRecoveryCodes);
    private sealed record TotpEnrollmentDto(Guid CredentialId, string Secret, string QrCodeUrl, string[] RecoveryCodes);
}
