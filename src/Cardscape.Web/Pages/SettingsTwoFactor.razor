@page "/settings/two-factor"
@using Cardscape.Web.Services
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject TokenStore Tokens
@inject AuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Two-factor authentication — Cardscape</PageTitle>

<div class="page-shell">
    <h1>Two-factor authentication</h1>

    @if (loading)
    {
        <p>Loading…</p>
    }
    else if (status is null || !status.IsEnrolled)
    {
        <RadzenCard>
            <h2>Protect your account with 2FA</h2>
            <p>
                Scan a QR code with your authenticator app
                (Authy, 1Password, Google Authenticator, …)
                and confirm a code to enable two-factor
                authentication.
            </p>
            <RadzenButton Text="Enrol" Click="@OnEnroll"
                          ButtonStyle="ButtonStyle.Primary" />
        </RadzenCard>

        @if (enrollment is not null)
        {
            <RadzenCard Style="margin-top:1rem">
                <h3>1. Scan this QR code with your authenticator</h3>
                <p>
                    <a href="@enrollment.QrCodeUrl" target="_blank"
                       rel="noopener">Open the otpauth:// URI</a>
                    or copy the secret below and enter it manually:
                </p>
                <code>@enrollment.Secret</code>

                <h3 style="margin-top:1.5rem">2. Save your recovery codes</h3>
                <p>
                    Each code can be used <strong>once</strong> if you lose
                    access to your authenticator. They are not shown again.
                </p>
                <ul>
                    @foreach (var recoveryCode in enrollment.RecoveryCodes)
                    {
                        <li><code>@recoveryCode</code></li>
                    }
                </ul>
            </RadzenCard>
        }
    }
    else
    {
        <RadzenCard>
            <h2>2FA is on</h2>
            <p>Enrolled @status.EnrolledAt?.ToString("u").</p>
            <p>@status.RemainingRecoveryCodes recovery codes remaining.</p>
            <RadzenButton Text="Disable 2FA" Click="@OnDisable"
                          ButtonStyle="ButtonStyle.Danger" />
        </RadzenCard>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="auth-error" role="alert" style="margin-top:1rem">@message</div>
    }
</div>

@code {
    private TotpStatusDto? status;
    private TotpEnrollmentDto? enrollment;
    private bool loading = true;
    private string? message;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadStatusAsync();
    }

    private async Task LoadStatusAsync()
    {
        loading = true;
        message = null;
        try
        {
            var http = await AuthedClientAsync();
            status = await http.GetFromJsonAsync<TotpStatusDto>("api/auth/2fa/status");
        }
        catch (Exception ex)
        {
            message = $"Could not load 2FA status: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnEnroll()
    {
        message = null;
        try
        {
            var http = await AuthedClientAsync();
            var response = await http.PostAsync("api/auth/2fa/enroll", content: null);
            if (!response.IsSuccessStatusCode)
            {
                message = $"Enrolment failed: {response.StatusCode}";
                return;
            }
            enrollment = await response.Content.ReadFromJsonAsync<TotpEnrollmentDto>();
        }
        catch (Exception ex)
        {
            message = $"Enrolment failed: {ex.Message}";
        }
    }

    private async Task OnDisable()
    {
        message = null;
        try
        {
            var http = await AuthedClientAsync();
            var code = await JS.InvokeAsync<string>("prompt", "Enter your current 2FA code to disable 2FA:");
            if (string.IsNullOrWhiteSpace(code)) return;
            var response = await http.PostAsJsonAsync("api/auth/2fa/disable", new { code });
            if (!response.IsSuccessStatusCode)
            {
                message = "Could not disable 2FA: invalid code.";
                return;
            }
            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            message = $"Could not disable 2FA: {ex.Message}";
        }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task<HttpClient> AuthedClientAsync()
    {
        var http = Http;
        var token = await Tokens.GetAccessTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
        return http;
    }

    private sealed record TotpStatusDto(bool IsEnrolled, DateTimeOffset? EnrolledAt, int RemainingRecoveryCodes);
    private sealed record TotpEnrollmentDto(Guid CredentialId, string Secret, string QrCodeUrl, string[] RecoveryCodes);
}
