@page "/settings/appearance"
@inherits Cardscape.Web.Shared.CultureReactiveComponentBase
@implements IDisposable
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Theming
@using Microsoft.Extensions.Localization
@inject UserPreferencesService UserPreferences
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["SettingsAppearanceTitle"] — Cardscape</PageTitle>

<div class="cs-appearance">
    <PageHeader Title="@L["SettingsAppearanceTitle"]" Subtitle="@L["SettingsAppearanceLead"]" />

    @* Mode: Light / Dark / follow the OS. *@
    <section class="cs-appearance-section">
        <h2 class="cs-section-title">@L["AppearanceMode"]</h2>
        <RadzenSelectBar TValue="string"
                         Value="@UserPreferences.CurrentMode"
                         Change="@OnModeChangedAsync"
                         Size="ButtonSize.Medium"
                         aria-label="@L["AppearanceMode"]">
            <Items>
                <RadzenSelectBarItem Text="@L["AppearanceModeLight"]" Value="@("Light")" Icon="light_mode" />
                <RadzenSelectBarItem Text="@L["AppearanceModeDark"]" Value="@("Dark")" Icon="dark_mode" />
                <RadzenSelectBarItem Text="@L["AppearanceSystem"]" Value="@("System")" Icon="contrast" />
            </Items>
        </RadzenSelectBar>
    </section>

    @*
      Theme families. Each family has a light and a dark
      member in ThemeCatalog; the mode above decides which
      one renders. The previews are drawn from each theme's
      own primary / surface colours (copied from the Radzen
      CSS files and css/themes/), so they show what the theme
      looks like rather than the currently active one.
    *@
    <section class="cs-appearance-section">
        <h2 class="cs-section-title">@L["AppearanceTheme"]</h2>
        <div class="cs-theme-grid" role="radiogroup" aria-label="@L["AppearanceTheme"]">
            @foreach (ThemeFamily family in Families)
            {
                bool selected = family.Contains(UserPreferences.CurrentThemeName);
                ThemeSwatch swatch = ShowDark ? family.DarkSwatch : family.LightSwatch;
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                              class="@(selected ? "cs-theme-option is-selected" : "cs-theme-option")"
                              role="radio"
                              aria-checked="@(selected ? "true" : "false")"
                              aria-label="@family.Label"
                              Click="@(() => OnFamilySelectedAsync(family))">
                    <span class="cs-theme-preview" style="--p: @swatch.Primary; --bg: @swatch.Body; --sf: @swatch.Surface; --tx: @swatch.Text;">
                        <span class="cs-theme-preview-bar"></span>
                        <span class="cs-theme-preview-cols">
                            <span class="cs-theme-preview-col"><i></i><i class="is-accent"></i></span>
                            <span class="cs-theme-preview-col"><i></i></span>
                            <span class="cs-theme-preview-col"><i></i><i></i></span>
                        </span>
                    </span>
                    <span class="cs-theme-option-label">
                        @family.Label
                        @if (selected)
                        {
                            <RadzenIcon Icon="check_circle" class="cs-theme-option-check" />
                        }
                    </span>
                </RadzenButton>
            }
        </div>
    </section>

    <section class="cs-appearance-section">
        <h2 class="cs-section-title">@L["SettingsAppearanceLivePreview"]</h2>
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="Primary" ButtonStyle="ButtonStyle.Primary" />
                    <RadzenButton Text="Secondary" ButtonStyle="ButtonStyle.Secondary" />
                    <RadzenButton Text="Base" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
                    <RadzenButton Text="Danger" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" />
                </RadzenStack>
                <RadzenTextBox Placeholder="Sample input" Style="max-width: 20rem;" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="Primary" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Success" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Warning" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Danger" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </section>
</div>

@code {
    private sealed record ThemeSwatch(string Primary, string Body, string Surface, string Text);

    private sealed record ThemeFamily(string Label, string LightName, string DarkName, ThemeSwatch LightSwatch, ThemeSwatch DarkSwatch)
    {
        public bool Contains(string? themeName) => themeName == LightName || themeName == DarkName;
    }

    private static readonly IReadOnlyList<ThemeFamily> Families = new[]
    {
        new ThemeFamily("Cardscape", CardscapeThemes.ClassicName, CardscapeThemes.ClassicDarkName,
            new("#0f766e", "#f6f8fa", "#ffffff", "#1f2328"), new("#2dd4bf", "#0d1117", "#161b22", "#e6edf3")),
        new ThemeFamily("Default", "default", "dark",
            new("#ff6d41", "#f6f7fa", "#ffffff", "#28363c"), new("#ff6d41", "#28363c", "#38474e", "#f6f7fa")),
        new ThemeFamily("Humanistic", "humanistic", "humanistic-dark",
            new("#d64d42", "#f4f5f9", "#ffffff", "#2b3a50"), new("#d64d42", "#2b3a50", "#30445f", "#f4f5f9")),
        new ThemeFamily("Material", "material", "material-dark",
            new("#4340d2", "#f5f5f5", "#ffffff", "#212121"), new("#bb86fc", "#121212", "#1e1e1e", "#f5f5f5")),
        new ThemeFamily("Software", "software", "software-dark",
            new("#598087", "#f6f7fa", "#ffffff", "#28363c"), new("#598087", "#28363c", "#3a474d", "#f6f7fa")),
        new ThemeFamily("Standard", "standard", "standard-dark",
            new("#1151f3", "#f4f4f4", "#ffffff", "#262526"), new("#3871ff", "#19191a", "#242527", "#f4f4f4")),
    };

    /// <summary>True when the previews should show the dark member of each family.</summary>
    private bool ShowDark => UserPreferences.CurrentMode switch
    {
        "Dark" => true,
        "Light" => false,
        _ => UserPreferences.SystemPrefersDark,
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UserPreferences.Changed += OnPreferencesChangedAsync;
    }

    public new void Dispose()
    {
        UserPreferences.Changed -= OnPreferencesChangedAsync;
        base.Dispose();
    }

    private Task OnPreferencesChangedAsync() => InvokeAsync(StateHasChanged);

    private Task OnFamilySelectedAsync(ThemeFamily family) =>
        UserPreferences.SetAsync(PickMember(family, UserPreferences.CurrentMode), UserPreferences.CurrentMode);

    private Task OnModeChangedAsync(string mode)
    {
        ThemeFamily family = Families.FirstOrDefault(f => f.Contains(UserPreferences.CurrentThemeName)) ?? Families[0];
        return UserPreferences.SetAsync(PickMember(family, mode), mode);
    }

    // The stored theme is the member matching the explicit mode;
    // for System the light member is stored and the service
    // swaps in the dark sibling while the OS is dark.
    private static string PickMember(ThemeFamily family, string mode) =>
        mode == "Dark" ? family.DarkName : family.LightName;
}
