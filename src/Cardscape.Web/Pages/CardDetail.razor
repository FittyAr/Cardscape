@page "/cards/{CardId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Text.Json
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject ICardsApiClient Cards
@inject ICommentsApiClient Comments
@inject ICustomFieldsApiClient CustomFields
@inject IActivitiesApiClient Activities
@inject IVotingApiClient Votes
@inject IChecklistsApiClient Checklists
@inject IRecurrenceApiClient Recurrence
@inject IAiApiClient Ai
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(card?.Title ?? "Card") — Cardscape</PageTitle>

<div class="card-detail-shell">
    @if (card is null)
    {
        <p>Loading card…</p>
    }
    else
    {
        <RadzenCard>
            <div class="card-detail-header">
                <h1>@card.Title</h1>
                <div class="card-detail-actions">
                    @if (card.IsCompleted)
                    {
                        <RadzenButton Text="Reopen" ButtonStyle="ButtonStyle.Light" Click="@Reopen" />
                    }
                    else
                    {
                        <RadzenButton Text="Complete" ButtonStyle="ButtonStyle.Success" Click="@Complete" />
                    }
                    <RadzenButton Text="@(card.IsArchived ? "Restore" : "Archive")"
                                  ButtonStyle="ButtonStyle.Warning" Click="@ToggleArchive" />
                    <RadzenButton Text="@(voteState is { CurrentUserHasVoted: true } ? "♥ " : "♡ ")"
                                  ButtonStyle="@(voteState is { CurrentUserHasVoted: true } ? ButtonStyle.Danger : ButtonStyle.Light)"
                                  Click="@ToggleVoteAsync"
                                  Disabled="@togglingVote"
                                  IsBusy="@togglingVote"
                                  title="Vote on this card" />
                    <small class="vote-count">@voteState?.VoteCount ?? 0</small>
                </div>
            </div>

            <dl class="card-meta">
                <dt>Due date</dt>
                <dd>
                    @if (card.DueDate is null)
                    {
                        <span>none</span>
                    }
                    else
                    {
                        @card.DueDate.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                    }
                </dd>
                <dt>Members</dt>
                <dd>@card.MemberCount</dd>
                <dt>Labels</dt>
                <dd>@card.LabelCount</dd>
            </dl>

            <h3>Description</h3>
            <p class="card-description">@(string.IsNullOrWhiteSpace(card.Description) ? "(no description)" : card.Description)</p>
            <div class="ai-actions">
                <RadzenButton Text="@($"✨ {L["AiGenerateDescription"]}")" Icon="auto_awesome"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@GenerateDescriptionAsync" Disabled="@aiBusy" IsBusy="@aiBusy" />
                @if (aiGeneratedDescription is not null)
                {
                    <span class="ai-preview">
                        <em>@aiGeneratedDescription</em>
                    </span>
                }
            </div>

            @if (fieldValues is not null && fieldValues.Count > 0)
            {
                <h3>Custom fields</h3>
                <dl class="card-meta">
                    @foreach (CustomFieldValueDto v in fieldValues)
                    {
                        <dt>@FieldKindLabel(v.Kind)</dt>
                        <dd>@FormatFieldValue(v)</dd>
                    }
                </dl>
            }

            <h3>Comments</h3>
            @if (comments is null)
            {
                <p>Loading comments…</p>
            }
            else
            {
                <div class="ai-actions" style="margin-bottom:.5rem">
                    <RadzenButton Text="@($"✨ {L["AiSummarizeComments"]}")" Icon="auto_awesome"
                                  ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@SummarizeCommentsAsync" Disabled="@aiBusy" IsBusy="@aiBusy" />
                </div>
                @if (aiSummary is not null)
                {
                    <RadzenCard class="ai-summary">
                        <strong>@L["AiSummaryTitle"]</strong>
                        <p>@aiSummary</p>
                    </RadzenCard>
                }
                @foreach (CommentDto c in comments)
                {
                    <RadzenCard class="comment-card">
                        <small>@c.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm") · @c.AuthorId</small>
                        <p>@c.Body</p>
                    </RadzenCard>
                }
            }

            <RadzenTemplateForm TItem="AddCommentModel" Data="@addCommentModel" Submit="@AddComment">
                <RadzenTextArea @bind-Value="addCommentModel.Body" Rows="2" Placeholder="Write a comment…"
                                Style="width:100%; margin-top:.5rem" />
                <RadzenButton Text="Comment" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@addingComment" Style="margin-top:.5rem" />
            </RadzenTemplateForm>

            <h3>Recurrence</h3>
            @if (recurrence is { IsActive: true })
            {
                <p>Repeats every <strong>@recurrence.IntervalDays</strong> day(s).
                   Next: @recurrence.NextOccurrenceAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                   <RadzenButton Text="Stop" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                 Click="@ClearRecurrenceAsync" /></p>
            }
            else
            {
                <div class="recurrence-create">
                    <RadzenNumeric @bind-Value="recurrenceIntervalDays" Min="1" Max="365"
                                   ShowUpDown="true" Style="width:6rem; margin-right:.5rem" />
                    <span>day(s)</span>
                    <RadzenButton Text="Set recurrence" ButtonStyle="ButtonStyle.Secondary"
                                  Click="@SaveRecurrenceAsync" Style="margin-left:.5rem" />
                </div>
            }

            <h3>Checklists</h3>
            @if (checklists is null)
            {
                <p>Loading checklists…</p>
            }
            else
            {
                @foreach (ChecklistDto cl in checklists)
                {
                    <RadzenCard class="checklist-card">
                        <div class="checklist-header">
                            <strong>@cl.Title</strong>
                            <RadzenProgressBar Value="@cl.CompletedCount" Max="@Math.Max(1, cl.TotalCount)"
                                                ShowValue="true" Style="flex:1; margin: 0 .5rem;" />
                            <small>@cl.CompletedCount / @cl.TotalCount</small>
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          Click="@(() => DeleteChecklistAsync(cl.Id))" />
                        </div>
                        @foreach (ChecklistItemDto item in cl.Items)
                        {
                            <div class="checklist-item">
                                <RadzenCheckBox Value="@item.IsCompleted"
                                                Change="@(async (bool _) => await ToggleItemAsync(cl.Id, item.Id))" />
                                <span class="@(item.IsCompleted ? "checklist-item-done" : "")">@item.Text</span>
                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => DeleteItemAsync(cl.Id, item.Id))" />
                            </div>
                        }
                        <div class="checklist-add-item">
                            <RadzenTextBox @bind-Value="newChecklistItemText" Placeholder="Add an item…"
                                           Style="flex:1; margin-right:.5rem" />
                            <RadzenButton Text="Add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                          Click="@(() => AddItemAsync(cl.Id))" />
                        </div>
                    </RadzenCard>
                }
                <div class="checklist-create">
                    <RadzenTextBox @bind-Value="newChecklistTitle" Placeholder="New checklist title…"
                                   Style="flex:1; margin-right:.5rem" />
                    <RadzenButton Text="Create checklist" Icon="add" ButtonStyle="ButtonStyle.Secondary"
                                  Click="@CreateChecklistAsync" />
                </div>
            }

            <h3>Activity</h3>
            @if (recentActivity is null)
            {
                <p>Loading activity…</p>
            }
            else if (recentActivity.Count == 0)
            {
                <p>No activity recorded for this card yet.</p>
            }
            else
            {
                <ul class="card-activity-list">
                    @foreach (ActivityDto a in recentActivity)
                    {
                        <li>
                            <strong>@a.KindName</strong>
                            <small> · @a.OccurredAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</small>
                            <span> · @FormatActivityPayload(a)</span>
                        </li>
                    }
                </ul>
            }
        </RadzenCard>
    }
</div>

@code {
    [Parameter] public Guid CardId { get; set; }

    private CardDto? card;
    private IReadOnlyList<CommentDto>? comments;
    private IReadOnlyList<CustomFieldValueDto>? fieldValues;
    private IReadOnlyList<ActivityDto>? recentActivity;
    private CardVoteStateDto? voteState;
    private IReadOnlyList<ChecklistDto>? checklists;
    private string newChecklistTitle = string.Empty;
    private string newChecklistItemText = string.Empty;
    private CardRecurrenceDto? recurrence;
    private int recurrenceIntervalDays = 7;
    private bool addingComment;
    private bool togglingVote;
    private bool aiBusy;
    private string? aiGeneratedDescription;
    private string? aiSummary;
    private readonly AddCommentModel addCommentModel = new();

    private async Task GenerateDescriptionAsync()
    {
        if (aiBusy)
        {
            return;
        }

        aiBusy = true;
        try
        {
            ApiResult<AiGeneratedTextDto> result = await Ai.GenerateDescriptionAsync(CardId);
            aiGeneratedDescription = result.IsSuccess && result.Value is not null
                ? result.Value.Text
                : null;
        }
        finally
        {
            aiBusy = false;
        }
    }

    private async Task SummarizeCommentsAsync()
    {
        if (aiBusy || comments is null || comments.Count == 0)
        {
            return;
        }

        aiBusy = true;
        try
        {
            IReadOnlyList<Guid> commentIds = comments.Select(c => c.Id).ToList();
            ApiResult<AiGeneratedTextDto> result = await Ai.SummarizeCommentsAsync(commentIds);
            aiSummary = result.IsSuccess && result.Value is not null
                ? result.Value.Text
                : null;
        }
        finally
        {
            aiBusy = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        ApiResult<CardDto> cardResult = await Cards.GetAsync(CardId);
        card = cardResult.IsSuccess ? cardResult.Value : null;

        ApiResult<IReadOnlyList<CommentDto>> commentsResult = await Comments.ListForCardAsync(CardId);
        comments = commentsResult.IsSuccess ? commentsResult.Value : [];

        ApiResult<IReadOnlyList<CustomFieldValueDto>> valuesResult =
            await CustomFields.ListValuesForCardAsync(CardId);
        fieldValues = valuesResult.IsSuccess ? valuesResult.Value : [];

        ApiResult<ActivityPageDto> activityResult =
            await Activities.ListForCardAsync(CardId, cursor: null, limit: 20);
        recentActivity = activityResult.IsSuccess ? activityResult.Value?.Items : [];

        ApiResult<CardVoteStateDto> voteResult = await Votes.GetStateAsync(CardId);
        voteState = voteResult.IsSuccess ? voteResult.Value : null;

        ApiResult<IReadOnlyList<ChecklistDto>> checklistsResult = await Checklists.ListForCardAsync(CardId);
        checklists = checklistsResult.IsSuccess ? checklistsResult.Value : [];

        ApiResult<CardRecurrenceDto?> recurrenceResult = await Recurrence.GetAsync(CardId);
        recurrence = recurrenceResult.IsSuccess ? recurrenceResult.Value : null;
    }

    private async Task SaveRecurrenceAsync()
    {
        if (recurrenceIntervalDays < 1) return;
        DateTimeOffset firstOccurrence = DateTimeOffset.UtcNow.AddDays(recurrenceIntervalDays);
        ApiResult<CardRecurrenceDto> result = await Recurrence.SetAsync(
            CardId, recurrenceIntervalDays, firstOccurrence);
        if (result.IsSuccess) recurrence = result.Value;
    }

    private async Task ClearRecurrenceAsync()
    {
        ApiResult result = await Recurrence.DeleteAsync(CardId);
        if (result.IsSuccess) recurrence = null;
    }

    private async Task CreateChecklistAsync()
    {
        if (string.IsNullOrWhiteSpace(newChecklistTitle)) return;
        ApiResult<ChecklistDto> result = await Checklists.CreateAsync(CardId, newChecklistTitle);
        if (result.IsSuccess && checklists is not null)
        {
            checklists = [.. checklists, result.Value!];
            newChecklistTitle = string.Empty;
        }
    }

    private async Task AddItemAsync(Guid checklistId)
    {
        if (string.IsNullOrWhiteSpace(newChecklistItemText)) return;
        ApiResult<ChecklistDto> result = await Checklists.AddItemAsync(checklistId, newChecklistItemText);
        if (result.IsSuccess) await ReplaceChecklistAsync(result.Value!);
        newChecklistItemText = string.Empty;
    }

    private async Task ToggleItemAsync(Guid checklistId, Guid itemId)
    {
        ApiResult<ChecklistDto> result = await Checklists.ToggleItemAsync(checklistId, itemId);
        if (result.IsSuccess) await ReplaceChecklistAsync(result.Value!);
    }

    private async Task DeleteItemAsync(Guid checklistId, Guid itemId)
    {
        ApiResult<ChecklistDto> result = await Checklists.DeleteItemAsync(checklistId, itemId);
        if (result.IsSuccess) await ReplaceChecklistAsync(result.Value!);
    }

    private async Task DeleteChecklistAsync(Guid checklistId)
    {
        ApiResult result = await Checklists.DeleteAsync(checklistId);
        if (result.IsSuccess && checklists is not null)
        {
            checklists = checklists.Where(c => c.Id != checklistId).ToList();
        }
    }

    private async Task ReplaceChecklistAsync(ChecklistDto updated)
    {
        if (checklists is null) return;
        checklists = checklists
            .Select(c => c.Id == updated.Id ? updated : c)
            .ToList();
        await Task.CompletedTask;
    }

    private async Task ToggleVoteAsync()
    {
        if (togglingVote) return;
        togglingVote = true;
        try
        {
            ApiResult<CardVoteStateDto> result = await Votes.ToggleAsync(CardId);
            if (result.IsSuccess)
            {
                voteState = result.Value;
            }
        }
        finally
        {
            togglingVote = false;
        }
    }

    private async Task Complete()
    {
        if (card is null) return;
        ApiResult<CardDto> result = await Cards.CompleteAsync(CardId);
        if (result.IsSuccess) card = result.Value;
    }

    private async Task Reopen()
    {
        if (card is null) return;
        ApiResult<CardDto> result = await Cards.ReopenAsync(CardId);
        if (result.IsSuccess) card = result.Value;
    }

    private async Task ToggleArchive()
    {
        if (card is null) return;
        ApiResult<CardDto> result = card.IsArchived
            ? await Cards.RestoreAsync(CardId)
            : await Cards.ArchiveAsync(CardId);
        if (result.IsSuccess) card = result.Value;
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(addCommentModel.Body)) return;
        addingComment = true;
        try
        {
            ApiResult<CommentDto> result = await Comments.AddAsync(CardId, addCommentModel.Body);
            if (result.IsSuccess)
            {
                comments = [.. (comments ?? Array.Empty<CommentDto>()), result.Value!];
                addCommentModel.Body = string.Empty;
            }
        }
        finally
        {
            addingComment = false;
        }
    }

    private sealed class AddCommentModel
    {
        public string Body { get; set; } = string.Empty;
    }

    private static string FieldKindLabel(int kind) => kind switch
    {
        0 => "Text",
        1 => "Number",
        2 => "Date",
        3 => "Dropdown",
        4 => "Checkbox",
        _ => $"Kind {kind}",
    };

    private static string FormatFieldValue(CustomFieldValueDto value)
    {
        // Values are stored as JSON strings; strip outer quotes for display.
        string raw = value.ValueJson?.Trim('"') ?? string.Empty;
        if (string.IsNullOrEmpty(raw))
        {
            return "(empty)";
        }

        return value.Kind switch
        {
            4 => raw.Equals("true", StringComparison.OrdinalIgnoreCase) ? "☑ Yes" : "☐ No",
            2 => raw, // ISO date; render as-is
            _ => raw,
        };
    }

    private static string FormatActivityPayload(ActivityDto a)
    {
        if (string.IsNullOrEmpty(a.PayloadJson) || a.PayloadJson == "{}")
        {
            return string.Empty;
        }

        try
        {
            using JsonDocument doc = JsonDocument.Parse(a.PayloadJson);
            if (doc.RootElement.ValueKind == JsonValueKind.Object)
            {
                List<string> parts = [];
                foreach (JsonProperty p in doc.RootElement.EnumerateObject())
                {
                    parts.Add($"{p.Name}: {p.Value}");
                }

                return string.Join(" · ", parts);
            }
        }
        catch
        {
            // fall through
        }

        return a.PayloadJson;
    }
}
