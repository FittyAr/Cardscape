@page "/cards/{CardId:guid}"
@page "/cards/{CardId:guid}/{BoardId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Text.Json
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@using Radzen
@inject ICardsApiClient Cards
@inject ICommentsApiClient Comments
@inject ICustomFieldsApiClient CustomFields
@inject IActivitiesApiClient Activities
@inject IVotingApiClient Votes
@inject IChecklistsApiClient Checklists
@inject IRecurrenceApiClient Recurrence
@inject IAiApiClient Ai
@inject IStringLocalizer<SharedResource> L
@inject DialogService DialogService
@inject NotificationService Notify
@inject NavigationManager Nav

<PageTitle>@(card?.Title ?? "Card") — Cardscape</PageTitle>

@if (notFound)
{
    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="@L["CardNotFoundTitle"]" TextStyle="TextStyle.H4" TagName="TagName.H2" />
            <RadzenText Text="@L["CardNotFoundBody"]" TextStyle="TextStyle.Body1" class="rz-color-text-secondary" />
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="@L["CardNotFoundBack"]" Icon="arrow_back" ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => Nav.NavigateTo("workspaces"))" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
}
else if (card is null)
{
    <RadzenText Text="Loading card…" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
}
else
{
    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenStack Gap="0.5rem">
                @if (editingTitle)
                {
                    <RadzenTextBox @bind-Value="editingTitleValue"
                                   Style="font-size: 1.5rem; font-weight: 600; width: 100%"
                                   autofocus
                                   @onkeydown="@HandleTitleKeyDown"
                                   @onblur="@SaveTitleAsync" />
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenText Text="@card.Title" TextStyle="TextStyle.H5" TagName="TagName.H1" />
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                      Click="@StartEditingTitle" title="@L["CardEditTitle"]" />
                    </RadzenStack>
                }
                @* P3.2 / G6b ” "Snoozed" badge. Rendered below the
                   title only when the card carries an active snooze
                   (Until > now). The unsnooze affordance is a small
                   link so the user can flip the toggle in one click. *@
                @if (card.IsSnoozed && card.SnoozeUntil is { } snoozeUntil)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning"
                                     Text="@($"Snoozed until {snoozeUntil.LocalDateTime:yyyy-MM-dd HH:mm}")" />
                        <RadzenButton Text="Unsnooze" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.ExtraSmall" Click="@UnsnoozeAsync" />
                    </RadzenStack>
                }
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                             Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="Back to board" Icon="arrow_back"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => Nav.NavigateTo(BackToBoardHref))" />
                    @if (card.IsCompleted)
                    {
                        <RadzenButton Text="Reopen" ButtonStyle="ButtonStyle.Light" Click="@Reopen" />
                    }
                    else
                    {
                        <RadzenButton Text="Complete" ButtonStyle="ButtonStyle.Success" Click="@Complete" />
                    }
                    <RadzenButton Text="@(card.IsArchived ? "Restore" : "Archive")"
                                  ButtonStyle="ButtonStyle.Warning" Click="@ToggleArchive" />
                    <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                  Click="@DeleteCard" />
                    @* P3.3 / G6c ” "Mirror to..." entry. Opens a RadzenDialog
                       with a board picker + a list picker. On confirm the
                       dialog returns the target list id and the parent
                       calls ICardsApiClient.MirrorToAsync. *@
                    <RadzenButton Text="@L["MirrorToButton"]"
                                  Icon="content_copy"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@OpenMirrorDialogAsync"
                                  Disabled="@mirroring"
                                  IsBusy="@mirroring"
                                  title="@L["MirrorToTitle"]" />
                    <RadzenButton Text="@(voteState is { CurrentUserHasVoted: true } ? " " : " ")"
                                  ButtonStyle="@(voteState is { CurrentUserHasVoted: true } ? ButtonStyle.Danger : ButtonStyle.Light)"
                                  Click="@ToggleVoteAsync"
                                  Disabled="@togglingVote"
                                  IsBusy="@togglingVote"
                                  title="Vote on this card" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Light"
                                 Text="@($"Votes: {voteState?.VoteCount ?? 0}")" />
                </RadzenStack>
            </RadzenStack>

            <MetadataList Items="@CardMetaItems" />

            @* P3.2 / G6b ” snooze section. Hidden when the card is
               already snoozed because the badge in the header
               already surfaces the controls (and double-bookkeeping
               would let the user stash the card twice). The
               datetime picker defaults to "tomorrow 9am" so the
               common case is one click. *@
            @if (!card.IsSnoozed)
            {
                <RadzenCard Variant="Variant.Flat">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenText Text="Snooze" TextStyle="TextStyle.H6" TagName="TagName.H3" />
                        <RadzenDatePicker @bind-Value="snoozeUntilLocal"
                                          ShowTime="true"
                                          DateFormat="yyyy-MM-dd HH:mm" />
                        <RadzenButton Text="Snooze until…"
                                      Icon="schedule"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@SnoozeAsync"
                                      Disabled="@snoozing"
                                      IsBusy="@snoozing" />
                    </RadzenStack>
                </RadzenCard>
            }

            @if (aiSuggestedOwners is { Count: > 0 })
            {
                <RadzenCard>
                    <RadzenStack Gap="0.5rem">
                        <RadzenText Text="@L["AiSuggestOwners"]" TextStyle="TextStyle.Subtitle1"
                                    TagName="TagName.Span" />
                        <RadzenStack Gap="0.25rem">
                            @foreach (AiOwnerSuggestionDto suggestion in aiSuggestedOwners)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                             Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenText Text="@suggestion.DisplayName" TextStyle="TextStyle.Body1"
                                                TagName="TagName.Span" />
                                    <RadzenText Text="@($"” {suggestion.Reason}")" TextStyle="TextStyle.Body2"
                                                class="rz-color-text-secondary" />
                                    <RadzenButton Text="Add" Size="ButtonSize.ExtraSmall"
                                                  ButtonStyle="ButtonStyle.Success"
                                                  Click="@(() => AssignSuggestedOwnerAsync(suggestion))"
                                                  Disabled="@aiBusy" />
                                </RadzenStack>
                            }
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            }

            <RadzenStack Gap="0.5rem">
                <RadzenText Text="Description" TextStyle="TextStyle.H6" TagName="TagName.H3" />
                @* BETA-8-UI-#15 - see test-results/r8/r8-report.md.
                   Manual description editor. The endpoint
                   (POST /api/cards/{id}/description) and
                   ChangeDescriptionAsync have been in the API
                   client since v1.0.0; this just wires the
                   editor so the field isn't read-only without
                   an AI round-trip. *@
                @if (editingDescription)
                {
                    <RadzenTextArea @bind-Value="editingDescriptionValue" Rows="4"
                                    Style="width:100%" Placeholder="@L["DescriptionEmpty"]" />
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Text="@L["DescriptionSave"]" Icon="check"
                                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@SaveDescriptionAsync" IsBusy="@savingDescription" />
                        <RadzenButton Text="@L["DescriptionCancel"]" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Click="@(() => editingDescription = false)" />
                    </RadzenStack>
                }
                else
                {
                    <RadzenText Text="@(string.IsNullOrWhiteSpace(card.Description) ? L["DescriptionEmpty"] : card.Description)"
                                TextStyle="TextStyle.Body1" Style="white-space: pre-wrap" />
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                                 Wrap="FlexWrap.Wrap">
                        <RadzenButton Text="@L["DescriptionEdit"]" Icon="edit"
                                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@StartEditingDescription" />
                        <RadzenButton Text="@($" {L["AiGenerateDescription"]}")" Icon="auto_awesome"
                                  ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@GenerateDescriptionAsync" Disabled="@aiBusy" IsBusy="@aiBusy" />
                    @if (aiGeneratedDescription is not null)
                    {
                        <RadzenText Text="@aiGeneratedDescription" TextStyle="TextStyle.Body2"
                                    TagName="TagName.Span" class="rz-color-text-secondary" />
                    }
                    </RadzenStack>
                }
            </RadzenStack>

            @if (fieldValues is not null && fieldValues.Count > 0)
            {
                <RadzenStack Gap="0.5rem">
                    <RadzenText Text="Custom fields" TextStyle="TextStyle.H6" TagName="TagName.H3" />
                    <MetadataList Items="@CustomFieldItems" />
                </RadzenStack>
            }

            <RadzenStack Gap="0.5rem">
                <RadzenText Text="Comments" TextStyle="TextStyle.H6" TagName="TagName.H3" />
                @if (comments is null)
                {
                    <RadzenText Text="Loading comments…" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Text="@($" {L["AiSummarizeComments"]}")" Icon="auto_awesome"
                                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@SummarizeCommentsAsync" Disabled="@aiBusy" IsBusy="@aiBusy" />
                    </RadzenStack>
                    @if (aiSummary is not null)
                    {
                        <RadzenCard>
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="@L["AiSummaryTitle"]" TextStyle="TextStyle.Subtitle1"
                                            TagName="TagName.Span" />
                                <RadzenText Text="@aiSummary" TextStyle="TextStyle.Body2" />
                            </RadzenStack>
                        </RadzenCard>
                    }
                    @foreach (CommentDto c in comments)
                    {
                        // BETA-8-UI-#12 — see test-results/r8/r8-report.md.
                        // The backend now populates AuthorDisplayName
                        // for both the list and the add/edit handlers.
                        // We fall back to the GUID when the user was
                        // deleted (or for any row that pre-dates the
                        // DTO change) so the line never goes blank.
                        string authorLabel = !string.IsNullOrEmpty(c.AuthorDisplayName)
                            ? c.AuthorDisplayName
                            : c.AuthorId.ToString();
                        <RadzenCard Variant="Variant.Flat">
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="@($"{c.CreatedAt.LocalDateTime:yyyy-MM-dd HH:mm} · {authorLabel}")"
                                            TextStyle="TextStyle.Caption" class="rz-color-text-secondary" />
                                <RadzenText Text="@c.Body" TextStyle="TextStyle.Body2" />
                            </RadzenStack>
                        </RadzenCard>
                    }
                }

                <RadzenTemplateForm TItem="AddCommentModel" Data="@addCommentModel" Submit="@AddComment">
                    <RadzenStack Gap="0.5rem" Class="rz-mt-2">
                        <RadzenTextArea @bind-Value="addCommentModel.Body" Rows="2" Placeholder="Write a comment…"
                                        Style="width:100%" />
                        <RadzenButton Text="Comment" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                      IsBusy="@addingComment" />
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenStack>

            <RadzenStack Gap="0.5rem">
                <RadzenText Text="Recurrence" TextStyle="TextStyle.H6" TagName="TagName.H3" />
                @if (recurrence is { IsActive: true })
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                                 Wrap="FlexWrap.Wrap">
                        <RadzenText Text="@($"Repeats every {recurrence.IntervalDays} day(s). Next: {recurrence.NextOccurrenceAt.LocalDateTime:yyyy-MM-dd HH:mm}")"
                                    TextStyle="TextStyle.Body2" />
                        <RadzenButton Text="Stop" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                      Click="@ClearRecurrenceAsync" />
                    </RadzenStack>
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenNumeric @bind-Value="recurrenceIntervalDays" Min="1" Max="365"
                                       ShowUpDown="true" Style="width:6rem" />
                        <RadzenText Text="day(s)" TextStyle="TextStyle.Body2" />
                        <RadzenButton Text="Set recurrence" ButtonStyle="ButtonStyle.Secondary"
                                      Click="@SaveRecurrenceAsync" />
                    </RadzenStack>
                }
            </RadzenStack>

            <RadzenStack Gap="0.5rem">
                <RadzenText Text="Checklists" TextStyle="TextStyle.H6" TagName="TagName.H3" />
                @if (checklists is null)
                {
                    <RadzenText Text="Loading checklists…" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
                }
                else
                {
                    @foreach (ChecklistDto cl in checklists)
                    {
                        <RadzenCard Variant="Variant.Flat">
                            <RadzenStack Gap="0.5rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                             Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenText Text="@cl.Title" TextStyle="TextStyle.Subtitle1"
                                                TagName="TagName.Span" />
                                    @* BETA-8-UI-#16 — see test-results/r8/r8-report.md.
                                       The previous incarnation passed `Value=1, Max=3`
                                       directly to RadzenProgressBar, which renders
                                       `Value` as a 0–100 percent against `Max`
                                       (so 1 of 3 displayed as `1%`). Computing the
                                       percent ourselves and pinning `Max=100` makes
                                       the bar match the human-readable `X / Y`
                                       label next to it. *@
                                    <RadzenProgressBar Value="@ChecklistProgressPercent(cl)"
                                                       Max="100"
                                                       ShowValue="true" Style="flex: 1" />
                                    <RadzenText Text="@($"{cl.CompletedCount} / {cl.TotalCount}")"
                                                TextStyle="TextStyle.Caption" class="rz-color-text-secondary" />
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                  Click="@(() => DeleteChecklistAsync(cl.Id))" />
                                </RadzenStack>
                                @foreach (ChecklistItemDto item in cl.Items)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                                 Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                        <RadzenCheckBox Value="@item.IsCompleted"
                                                        Change="@(async (bool _) => await ToggleItemAsync(cl.Id, item.Id))" />
                                        <RadzenText Text="@item.Text" TextStyle="TextStyle.Body2"
                                                    Class="@(item.IsCompleted ? "rz-color-text-disabled" : null)"
                                                    Style="@(item.IsCompleted ? "text-decoration: line-through;" : null)" />
                                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                                      Click="@(() => DeleteItemAsync(cl.Id, item.Id))" />
                                    </RadzenStack>
                                }
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                             Gap="0.5rem">
                                    <RadzenTextBox @bind-Value="newChecklistItemText" Placeholder="Add an item…"
                                                   Style="flex:1"
                                                   @onkeydown="@(e => OnAddItemKeyDown(e, cl.Id))" />
                                    <RadzenButton Text="Add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                  Click="@(() => AddItemAsync(cl.Id))" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                    }
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                                 Wrap="FlexWrap.Wrap">
                        <RadzenTextBox @bind-Value="newChecklistTitle" Placeholder="New checklist title…"
                                       Style="flex:1"
                                       @onkeydown="@OnCreateChecklistKeyDown" />
                        <RadzenButton Text="Create checklist" Icon="add" ButtonStyle="ButtonStyle.Secondary"
                                      Click="@CreateChecklistAsync" />
                        <RadzenButton Text="@($" {L["AiGenerateChecklist"]}")" Icon="auto_awesome"
                                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@MakeChecklistAsync" Disabled="@aiBusy" IsBusy="@aiBusy" />
                    </RadzenStack>
                }
            </RadzenStack>

            <RadzenStack Gap="0.5rem">
                <RadzenText Text="Activity" TextStyle="TextStyle.H6" TagName="TagName.H3" />
                @if (recentActivity is null)
                {
                    <RadzenText Text="Loading activity…" TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
                }
                else if (recentActivity.Count == 0)
                {
                    <RadzenText Text="No activity recorded for this card yet." TextStyle="TextStyle.Body2" class="rz-color-text-secondary" />
                }
                else
                {
                    <RadzenStack Gap="0.25rem">
                        @foreach (ActivityDto a in recentActivity)
                        {
                            // BETA-8-UI-#13 — see test-results/r8/r8-report.md.
                            // The backend now joins the actor's
                            // display name; if it's missing (deleted
                            // user, very old row) we fall back to the
                            // GUID so the line is never empty.
                            string actorLabel = !string.IsNullOrEmpty(a.ActorDisplayName)
                                ? a.ActorDisplayName
                                : a.ActorId.ToString();
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                         Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                <RadzenText Text="@a.KindName" TextStyle="TextStyle.Body2"
                                            TagName="TagName.Span" />
                                <RadzenText Text="@actorLabel" TextStyle="TextStyle.Body2"
                                            TagName="TagName.Span" class="rz-color-text-secondary" />
                                <RadzenText Text="@($"· {a.OccurredAt.LocalDateTime:yyyy-MM-dd HH:mm}")"
                                            TextStyle="TextStyle.Caption" class="rz-color-text-secondary" />
                                <RadzenText Text="@($"· {FormatActivityPayload(a)}")" TextStyle="TextStyle.Body2"
                                            class="rz-color-text-secondary" />
                            </RadzenStack>
                        }
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter] public Guid CardId { get; set; }

    // BETA-A2-005: the second `@page` template
    // `/cards/{CardId:guid}/{BoardId:guid}` is used by BoardDetail.razor
    // to scope the deep link to the originating board. The parameter
    // is read by `BackToBoardHref` so the trimmer keeps the setter;
    // see BUG-A4-001 — without a reader the IL trimmer silently
    // drops the property from the CardDetail type metadata and Blazor's
    // router then throws "does not have a property matching the name
    // 'BoardId'" the moment a deep link is opened. The getter is the
    // back link the user actually clicks.
    [Parameter] public Guid BoardId { get; set; }

    // BUG-A4-001 — keeps the BoardId property alive through trimming
    // and provides the back-to-board link the deep-link template exists
    // for. Returns the workspaces index when the user opened the card
    // via /cards/{id} (no BoardId in the URL) so the link is always
    // safe to render.
    private string BackToBoardHref =>
        BoardId == Guid.Empty ? "workspaces" : $"boards/{BoardId}";

    private CardDto? card;
    private bool notFound;
    private bool editingTitle;
    private string editingTitleValue = string.Empty;
    private CancellationTokenSource? titleCts;
    private IReadOnlyList<CommentDto>? comments;
    private IReadOnlyList<CustomFieldValueDto>? fieldValues;
    private IReadOnlyList<ActivityDto>? recentActivity;
    private CardVoteStateDto? voteState;
    private IReadOnlyList<ChecklistDto>? checklists;
    private string newChecklistTitle = string.Empty;
    private string newChecklistItemText = string.Empty;
    private CardRecurrenceDto? recurrence;
    private int recurrenceIntervalDays = 7;
    private bool addingComment;
    private bool togglingVote;
    private bool aiBusy;
    private bool snoozing;
    private string? aiGeneratedDescription;
    private string? aiSummary;
    private IReadOnlyList<AiOwnerSuggestionDto>? aiSuggestedOwners;
    private readonly AddCommentModel addCommentModel = new();

    // P3.2 / G6b ” default the snooze picker to "tomorrow 9am"
    // so the common case is one click. The backend rejects
    // values that are not strictly in the future, so the date
    // is computed off the local clock each time the user opens
    // the page (kept in @code so the same default persists
    // across re-renders within the same session). Named
    // `snoozeUntilLocal` to avoid clashing with the
    // `CardDto.SnoozeUntil` property in the markup.
    private DateTimeOffset snoozeUntilLocal = DateTimeOffset.Now.AddDays(1)
        .Date.AddHours(9);

    // P3.4 / MetadataList adapters ” translate the card projection
    // into the IReadOnlyList<MetadataListItem> shape that the
    // <MetadataList> shared component expects. The Members row
    // needs a custom RenderFragment because the AI "Suggest owners"
    // button lives next to the count; the other rows are plain text.
    private IReadOnlyList<MetadataListItem> CardMetaItems => card is null
        ? Array.Empty<MetadataListItem>()
        : new MetadataListItem[]
        {
            MetadataListItem.Text("Due date",
                card.DueDate is null
                    ? "none"
                    : card.DueDate.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")),
            new("Members", MakeMembersValueFragment(card)),
            MetadataListItem.Text("Labels", card.LabelCount.ToString())
        };

    private IReadOnlyList<MetadataListItem> CustomFieldItems => fieldValues is null
        ? Array.Empty<MetadataListItem>()
        : fieldValues
            .Select(v => MetadataListItem.Text(FieldKindLabel(v.Kind), FormatFieldValue(v)))
            .ToList();

    private RenderFragment MakeMembersValueFragment(CardDto cardRef) => __builder =>
    {
        __builder.OpenElement(0, "span");
        __builder.AddContent(1, cardRef.MemberCount.ToString());
        __builder.AddContent(2, " ");
        __builder.OpenComponent<Radzen.Blazor.RadzenButton>(3);
        __builder.AddAttribute(4, "Text", $" {L["AiSuggestOwners"]}");
        __builder.AddAttribute(5, "Icon", "auto_awesome");
        __builder.AddAttribute(6, "ButtonStyle", ButtonStyle.Light);
        __builder.AddAttribute(7, "Size", ButtonSize.ExtraSmall);
        __builder.AddAttribute(8, "Click",
            EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                this, SuggestOwnersAsync));
        __builder.AddAttribute(9, "Disabled", aiBusy);
        __builder.AddAttribute(10, "IsBusy", aiBusy);
        __builder.AddAttribute(11, "Style", "margin-left:.5rem");
        __builder.CloseComponent();
        __builder.CloseElement();
    };

    private async Task GenerateDescriptionAsync()
    {
        if (aiBusy)
        {
            return;
        }

        aiBusy = true;
        try
        {
            ApiResult<AiGeneratedTextDto> result = await Ai.GenerateDescriptionAsync(CardId);
            aiGeneratedDescription = result.IsSuccess && result.Value is not null
                ? result.Value.Text
                : null;
        }
        finally
        {
            aiBusy = false;
        }
    }

    private async Task SummarizeCommentsAsync()
    {
        if (aiBusy || comments is null || comments.Count == 0)
        {
            return;
        }

        aiBusy = true;
        try
        {
            IReadOnlyList<Guid> commentIds = comments.Select(c => c.Id).ToList();
            ApiResult<AiGeneratedTextDto> result = await Ai.SummarizeCommentsAsync(commentIds);
            aiSummary = result.IsSuccess && result.Value is not null
                ? result.Value.Text
                : null;
        }
        finally
        {
            aiBusy = false;
        }
    }

    private async Task MakeChecklistAsync()
    {
        if (aiBusy)
        {
            return;
        }

        aiBusy = true;
        try
        {
            ApiResult<AiGeneratedChecklistDto> result = await Ai.GenerateChecklistAsync(CardId);
            if (!result.IsSuccess || result.Value is null || result.Value.Items.Count == 0)
            {
                return;
            }

            ApiResult<ChecklistDto> created = await Checklists.CreateAsync(CardId, "AI suggestions");
            if (!created.IsSuccess || created.Value is null)
            {
                return;
            }

            Guid newChecklistId = created.Value.Id;
            foreach (string item in result.Value.Items)
            {
                // BETA-8-API-#3 — return type is now ChecklistItemDto
                // (we still discard the result here, the next line
                // reloads the checklists to render the final shape).
                await Checklists.AddItemAsync(newChecklistId, item);
            }

            await ReloadChecklistsAsync();
        }
        finally
        {
            aiBusy = false;
        }
    }

    private async Task SuggestOwnersAsync()
    {
        if (aiBusy)
        {
            return;
        }

        aiBusy = true;
        try
        {
            ApiResult<AiOwnerSuggestionsDto> result = await Ai.SuggestOwnersAsync(CardId);
            aiSuggestedOwners = result.IsSuccess && result.Value is not null
                ? result.Value.Suggestions
                : null;
        }
        finally
        {
            aiBusy = false;
        }
    }

    private async Task AssignSuggestedOwnerAsync(AiOwnerSuggestionDto suggestion)
    {
        if (aiBusy || card is null)
        {
            return;
        }

        aiBusy = true;
        try
        {
            ApiResult<CardDto> result = await Cards.AssignAsync(CardId, suggestion.UserId);
            if (result.IsSuccess && result.Value is not null)
            {
                card = result.Value;
            }

            if (aiSuggestedOwners is not null)
            {
                aiSuggestedOwners = aiSuggestedOwners
                    .Where(s => s.UserId != suggestion.UserId)
                    .ToList();
            }
        }
        finally
        {
            aiBusy = false;
        }
    }

    private async Task ReloadChecklistsAsync()
    {
        ApiResult<IReadOnlyList<ChecklistDto>> checklistsResult =
            await Checklists.ListForCardAsync(CardId);
        checklists = checklistsResult.IsSuccess ? checklistsResult.Value : [];
        await Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        ApiResult<CardDto> cardResult = await Cards.GetAsync(CardId);
        if (cardResult.IsSuccess)
        {
            card = cardResult.Value;
            notFound = false;
        }
        else
        {
            // Treat both 404 (not found) and 403 (not a member) as
            // "not found" for the page — we do not want to leak the
            // difference to a deep-linked user who has no business
            // knowing the card exists. BETA-8-UI-#5.
            card = null;
            notFound = true;
        }

        ApiResult<IReadOnlyList<CommentDto>> commentsResult = await Comments.ListForCardAsync(CardId);
        comments = commentsResult.IsSuccess ? commentsResult.Value : [];

        ApiResult<IReadOnlyList<CustomFieldValueDto>> valuesResult =
            await CustomFields.ListValuesForCardAsync(CardId);
        fieldValues = valuesResult.IsSuccess ? valuesResult.Value : [];

        ApiResult<ActivityPageDto> activityResult =
            await Activities.ListForCardAsync(CardId, cursor: null, limit: 20);
        recentActivity = activityResult.IsSuccess ? activityResult.Value?.Items : [];

        ApiResult<CardVoteStateDto> voteResult = await Votes.GetStateAsync(CardId);
        voteState = voteResult.IsSuccess ? voteResult.Value : null;

        ApiResult<IReadOnlyList<ChecklistDto>> checklistsResult = await Checklists.ListForCardAsync(CardId);
        checklists = checklistsResult.IsSuccess ? checklistsResult.Value : [];

        ApiResult<CardRecurrenceDto?> recurrenceResult = await Recurrence.GetAsync(CardId);
        recurrence = recurrenceResult.IsSuccess ? recurrenceResult.Value : null;
    }

    private void StartEditingTitle()
    {
        if (card is null)
        {
            return;
        }
        editingTitleValue = card.Title;
        editingTitle = true;
    }

    // BETA-8-UI-#15 - manual description editor. The state lives
    // on the page so a Cancel does not lose the original value
    // until the user clicks Edit again.
    private bool editingDescription;
    private string editingDescriptionValue = string.Empty;
    private bool savingDescription;

    private void StartEditingDescription()
    {
        if (card is null)
        {
            return;
        }
        editingDescriptionValue = card.Description ?? string.Empty;
        editingDescription = true;
    }

    private async Task SaveDescriptionAsync()
    {
        if (!editingDescription || card is null || savingDescription)
        {
            return;
        }
        savingDescription = true;
        try
        {
            ApiResult<CardDto> result = await Cards.ChangeDescriptionAsync(
                CardId, editingDescriptionValue);
            if (result.IsSuccess && result.Value is not null)
            {
                card = result.Value;
            }
            editingDescription = false;
        }
        finally
        {
            savingDescription = false;
        }
    }

    private async Task HandleTitleKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            await SaveTitleAsync();
        }
        else if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            editingTitle = false;
        }
    }

    private async Task SaveTitleAsync()
    {
        if (!editingTitle || card is null)
        {
            return;
        }
        string newTitle = (editingTitleValue ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(newTitle) || newTitle == card.Title)
        {
            editingTitle = false;
            return;
        }
        titleCts?.Cancel();
        titleCts = new CancellationTokenSource();
        ApiResult<CardDto> result = await Cards.RenameAsync(CardId, newTitle, titleCts.Token);
        if (result.IsSuccess && result.Value is not null)
        {
            card = result.Value;
        }
        editingTitle = false;
    }

    private async Task SaveRecurrenceAsync()
    {
        if (recurrenceIntervalDays < 1) return;
        DateTimeOffset firstOccurrence = DateTimeOffset.UtcNow.AddDays(recurrenceIntervalDays);
        ApiResult<CardRecurrenceDto> result = await Recurrence.SetAsync(
            CardId, recurrenceIntervalDays, firstOccurrence);
        if (result.IsSuccess) recurrence = result.Value;
    }

    private async Task ClearRecurrenceAsync()
    {
        ApiResult result = await Recurrence.DeleteAsync(CardId);
        if (result.IsSuccess) recurrence = null;
    }

    // BETA-8-UI-#17 — see test-results/r8/r8-report.md.
    // Wire Enter on the inline TextBoxes to the same handlers
    // the buttons use, so the user can submit the form without
    // leaving the keyboard.
    private async Task OnCreateChecklistKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Enter", StringComparison.Ordinal))
        {
            await CreateChecklistAsync();
        }
    }

    private async Task OnAddItemKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, Guid checklistId)
    {
        if (string.Equals(e.Key, "Enter", StringComparison.Ordinal))
        {
            await AddItemAsync(checklistId);
        }
