@page "/cards/{CardId:guid}"
@page "/cards/{CardId:guid}/{BoardId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@using Radzen
@inject ICardsApiClient Cards
@inject ICommentsApiClient Comments
@inject ICustomFieldsApiClient CustomFields
@inject IActivitiesApiClient Activities
@inject IVotingApiClient Votes
@inject IChecklistsApiClient Checklists
@inject IRecurrenceApiClient Recurrence
@inject IAiApiClient Ai
@inject InstanceSettingsState Instance
@inject IAttachmentsApiClient Attachments
@inject IStringLocalizer<SharedResource> L
@inject DialogService DialogService
@inject NotificationService Notify
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(_card?.Title ?? L["ActivityKindCard"]) @L["PageTitleSuffix"]</PageTitle>

@if (_notFound)
{
    <div class="cs-empty">
        <RadzenIcon Icon="search_off" />
        <RadzenText Text="@L["CardNotFoundTitle"]" TextStyle="TextStyle.H5" TagName="TagName.H2" Class="rz-m-0" />
        <span>@L["CardNotFoundBody"]</span>
        <RadzenButton Text="@L["CardNotFoundBack"]" Icon="arrow_back" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => Nav.NavigateTo("workspaces"))" />
    </div>
}
else if (_card is null)
{
    <div class="cs-card-detail" aria-busy="true">
        <div class="cs-card-detail-skeleton"></div>
    </div>
}
else
{
    <div class="cs-card-detail">
        @if (CoverColor is not null)
        {
            <div class="cs-card-detail-cover" style="--cs-cover-color: @CoverColor" aria-hidden="true"></div>
        }
        <RadzenButton Text="@L["ActivityBackToBoard"]" Icon="arrow_back" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                      Size="ButtonSize.Small" class="cs-card-detail-back" Click="@GoBackToBoard" />

        @* Mutation failures surface above the editable title so they
           are visible whichever control triggered them. *@
        @if (_commandError is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_commandError</RadzenAlert>
        }

        @* ── Title + status ───────────────────────────────── *@
        <header class="cs-card-detail-header">
            <RadzenIcon Icon="@(_card.IsCompleted ? "check_circle" : "radio_button_unchecked")"
                        class="@(_card.IsCompleted ? "cs-card-detail-status is-done" : "cs-card-detail-status")" />
            <div class="cs-card-detail-heading">
                @if (_editingTitle)
                {
                    <RadzenTextBox @ref="_titleBox" @bind-Value="_editingTitleValue"
                                   class="cs-card-detail-title-input"
                                   @onkeydown="@HandleTitleKeyDownAsync"
                                   @onblur="@SaveTitleAsync" />
                }
                else
                {
                    <h1 class="cs-card-detail-title" title="@L["CardEditTitle"]" tabindex="0"
                        @onclick="@StartEditingTitle"
                        @onkeydown="@(e => { if (e.IsEnter) StartEditingTitle(); })">@_card.Title</h1>
                }
                <div class="cs-card-detail-chips">
                    @if (_card.IsCompleted)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" Text="@L["CardCompletedBadge"]" />
                    }
                    @if (_card.IsArchived)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" Text="@L["CardArchivedBadge"]" />
                    }
                    @* P3.2 / G6b — snoozed badge + one-click unsnooze. *@
                    @if (_card.IsSnoozed && _card.SnoozeUntil is { } snoozeUntil)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter"
                                     Text="@L["CardSnoozedUntil", snoozeUntil.LocalDateTime.ToString("g")]" />
                        <RadzenButton Text="@L["CardUnsnooze"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                      Size="ButtonSize.ExtraSmall" Click="@UnsnoozeAsync" />
                    }
                </div>
                @if (!string.IsNullOrEmpty(_listName))
                {
                    <p class="cs-card-detail-inlist">@L["CardInList", _listName]</p>
                }
                @* Trello-style badges row: members, labels and due date,
                   each opening the matching side-panel picker. *@
                <div class="cs-card-detail-meta">
                    @if (CardMembers.Count > 0)
                    {
                        <div class="cs-meta-group">
                            <h2 class="cs-aside-title">@L["MembersTitle"]</h2>
                            <div class="cs-meta-row">
                                @foreach (WorkspaceMemberDto member in CardMembers)
                                {
                                    <span class="cs-avatar cs-avatar--sm" title="@member.DisplayName">@UserInitials.From(member.DisplayName)</span>
                                }
                                <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                                              class="cs-meta-add" aria-label="@L["MembersTitle"]" Click="@(() => TogglePanel(CardPanel.Members))" />
                            </div>
                        </div>
                    }
                    @if (CardLabels.Count > 0)
                    {
                        <div class="cs-meta-group">
                            <h2 class="cs-aside-title">@L["CardLabels"]</h2>
                            <div class="cs-meta-row">
                                @foreach (LabelDto label in CardLabels)
                                {
                                    <span class="cs-label-chip" style="--cs-label-color: @label.Color">@label.Name</span>
                                }
                                <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                                              class="cs-meta-add" aria-label="@L["CardLabels"]" Click="@(() => TogglePanel(CardPanel.Labels))" />
                            </div>
                        </div>
                    }
                    @if (_card.DueDate is { } dueDate)
                    {
                        <div class="cs-meta-group">
                            <h2 class="cs-aside-title">@L["CardDueDate"]</h2>
                            <div class="cs-meta-row">
                                <RadzenCheckBox TValue="bool" Value="@_card.IsCompleted" Change="@(async (bool _) => await ToggleCompleteFromDueAsync())"
                                                aria-label="@L["CardComplete"]" />
                                <RadzenButton Text="@FormatDue(dueDate)" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Size="ButtonSize.Small"
                                              class="@($"cs-due-chip {DueStateClass()}")" Click="@(() => TogglePanel(CardPanel.Dates))" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>

        @if (_voteError is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_voteError</RadzenAlert>
        }

        <div class="cs-card-detail-grid">
            @* ── Main column ─────────────────────────────── *@
            <div class="cs-card-detail-main">
                @if (_aiSuggestedOwners is { Count: > 0 })
                {
                    <section class="cs-card-section">
                        <h2 class="cs-card-section-title"><RadzenIcon Icon="auto_awesome" />@L["AiSuggestOwners"]</h2>
                        @foreach (AiOwnerSuggestionDto suggestion in _aiSuggestedOwners)
                        {
                            <div class="cs-row">
                                <strong>@suggestion.DisplayName</strong>
                                <span class="cs-muted">— @suggestion.Reason</span>
                                <RadzenButton Text="@L["BoardAddItem"]" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                                              Click="@(() => AssignSuggestedOwnerAsync(suggestion))"
                                              Disabled="@_aiBusy" />
                            </div>
                        }
                    </section>
                }

                <section class="cs-card-section">
                    <h2 class="cs-card-section-title"><RadzenIcon Icon="notes" />@L["CardDescription"]</h2>
                    @* BETA-8-UI-#15 — manual description editor.
                       BUG-A4-005 — wrapped in a RadzenTemplateForm with an
                       explicit Submit so the latest text is committed
                       before the handler runs. *@
                    @if (_editingDescription)
                    {
                        <RadzenTemplateForm TItem="string" Data="@_editingDescriptionValue" Submit="@SaveDescriptionAsync">
                            <RadzenTextArea @bind-Value="_editingDescriptionValue" Name="description-editor"
                                            Rows="5" Style="width:100%" Placeholder="@L["DescriptionEmpty"]" />
                            <div class="cs-row rz-mt-2">
                                <RadzenButton Text="@L["DescriptionSave"]" Icon="check"
                                              ButtonType="ButtonType.Submit"
                                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                              IsBusy="@_savingDescription" />
                                <RadzenButton Text="@L["DescriptionCancel"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                              Size="ButtonSize.Small"
                                              Click="@(() => _editingDescription = false)" />
                            </div>
                        </RadzenTemplateForm>
                    }
                    else
                    {
                        <div class="cs-card-description @(string.IsNullOrWhiteSpace(_card.Description) ? "is-empty" : null)"
                             role="button" tabindex="0" title="@L["DescriptionEdit"]"
                             @onclick="@StartEditingDescription"
                             @onkeydown="@(e => { if (e.IsEnter) StartEditingDescription(); })">
                            @(string.IsNullOrWhiteSpace(_card.Description) ? L["DescriptionEmpty"] : _card.Description)
                        </div>
                        <div class="cs-row">
                            <RadzenButton Text="@L["AiGenerateDescription"]" Icon="auto_awesome" Visible="@AiEnabled"
                                          ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                          Click="@GenerateDescriptionAsync" Disabled="@_aiBusy" IsBusy="@_aiBusy" />
                        </div>
                        @if (_aiGeneratedDescription is not null)
                        {
                            <p class="cs-muted">@_aiGeneratedDescription</p>
                        }
                    }
                </section>

                <section class="cs-card-section">
                    <h2 class="cs-card-section-title"><RadzenIcon Icon="checklist" />@L["CardChecklists"]</h2>
                    @if (_checklistsError is not null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_checklistsError</RadzenAlert>
                    }
                    else if (_checklists is null)
                    {
                        <span class="cs-muted">@L["CardLoadingChecklists"]</span>
                    }
                    else
                    {
                        @foreach (ChecklistDto cl in _checklists)
                        {
                            <div class="cs-checklist">
                                <div class="cs-checklist-header">
                                    <strong class="cs-checklist-title">@cl.Title</strong>
                                    <span class="cs-muted tabular-nums">@($"{cl.CompletedCount}/{cl.TotalCount}")</span>
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                                  Click="@(() => DeleteChecklistAsync(cl.Id))"
                                                  title="@L["ChecklistDelete"]" aria-label="@L["ChecklistDelete"]" />
                                </div>
                                @* BETA-8-UI-#16 — percent computed here, Max pinned to 100. *@
                                <RadzenProgressBar Value="@ChecklistProgressPercent(cl)" Max="100" ShowValue="false"
                                                   ProgressBarStyle="@(cl.TotalCount > 0 && cl.CompletedCount == cl.TotalCount ? ProgressBarStyle.Success : ProgressBarStyle.Primary)"
                                                   class="cs-checklist-progress" />
                                @foreach (ChecklistItemDto item in cl.Items)
                                {
                                    <div class="cs-checklist-item @(item.IsCompleted ? "is-done" : null)">
                                        <RadzenCheckBox Value="@item.IsCompleted"
                                                        Change="@(async (bool _) => await ToggleItemAsync(cl.Id, item.Id))" />
                                        <span class="cs-checklist-item-text">@item.Text</span>
                                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                                      Click="@(() => DeleteItemAsync(cl.Id, item.Id))"
                                                      aria-label="@L["ChecklistItemDelete"]" class="cs-checklist-item-delete" />
                                    </div>
                                }
                                <div class="cs-row">
                                    <RadzenTextBox @bind-Value="_newChecklistItemText" Immediate="true" Placeholder="@L["CardChecklistItem"]"
                                                   Style="flex:1"
                                                   @onkeydown="@(e => OnAddItemKeyDownAsync(e, cl.Id))" />
                                    <RadzenButton Text="@L["BoardAddItem"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                                  Click="@(() => AddItemAsync(cl.Id))" />
                                </div>
                            </div>
                        }
                        <div class="cs-row">
                            <RadzenTextBox @bind-Value="_newChecklistTitle" Immediate="true" Placeholder="@L["CardChecklistTitle"]"
                                           Style="flex:1"
                                           @onkeydown="@OnCreateChecklistKeyDownAsync" />
                            <RadzenButton Text="@L["CardCreateChecklist"]" Icon="add" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                          Click="@CreateChecklistAsync" />
                            <RadzenButton Text="@L["AiGenerateChecklist"]" Icon="auto_awesome" Visible="@AiEnabled"
                                          ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                          Click="@MakeChecklistAsync" Disabled="@_aiBusy" IsBusy="@_aiBusy" />
                        </div>
                    }
                </section>

                @* BUG-A5-002 — direct file upload / list / download / delete. *@
                <section class="cs-card-section">
                    <h2 class="cs-card-section-title"><RadzenIcon Icon="attach_file" />@L["CardAttachments"]</h2>
                    <div class="cs-row">
                        <RadzenUpload Change="@OnAttachmentSelectedAsync" Accept="*/*" Auto="false" Multiple="false"
                                      Disabled="@_uploadingAttachment" ChooseText="@L["CardChooseAttachment"]" />
                        @if (_uploadingAttachment)
                        {
                            <RadzenProgressBarCircular ProgressBarType="ProgressBarType.Indeterminate"
                                                       Size="ProgressBarCircularSize.Small" />
                        }
                    </div>
                    @if (_attachmentsError is not null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_attachmentsError</RadzenAlert>
                    }
                    else if (_attachments is null)
                    {
                        <span class="cs-muted">@L["ActionLoading"]</span>
                    }
                    else if (_attachments.Count == 0)
                    {
                        <span class="cs-muted">@L["CardNoAttachments"]</span>
                    }
                    else
                    {
                        <ul class="cs-attachment-list">
                            @foreach (AttachmentDto attachment in _attachments)
                            {
                                <li class="cs-attachment">
                                    <span class="cs-attachment-icon"><RadzenIcon Icon="description" /></span>
                                    <span class="cs-attachment-name">@attachment.FileName</span>
                                    <span class="cs-muted tabular-nums">@FormatSize(attachment.SizeBytes)</span>
                                    <RadzenButton Icon="download" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                  Size="ButtonSize.ExtraSmall" title="@L["CardDownload"]" aria-label="@L["CardDownload"]"
                                                  Click="@(() => DownloadAttachmentAsync(attachment))" />
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                  Size="ButtonSize.ExtraSmall" title="@L["ActionDelete"]" aria-label="@L["ActionDelete"]"
                                                  Click="@(() => DeleteAttachmentAsync(attachment))" />
                                </li>
                            }
                        </ul>
                    }
                </section>

                @if (_fieldValuesError is not null)
                {
                    <section class="cs-card-section">
                        <h2 class="cs-card-section-title"><RadzenIcon Icon="tune" />@L["CustomFieldsTitle"]</h2>
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_fieldValuesError</RadzenAlert>
                    </section>
                }
                else if (_fieldValues is not null && _fieldValues.Count > 0)
                {
                    <section class="cs-card-section">
                        <h2 class="cs-card-section-title"><RadzenIcon Icon="tune" />@L["CustomFieldsTitle"]</h2>
                        <MetadataList Items="@CustomFieldItems" />
                    </section>
                }

                <section class="cs-card-section">
                    <div class="cs-card-section-title-row">
                        <h2 class="cs-card-section-title"><RadzenIcon Icon="forum" />@L["CardComments"]</h2>
                        @if (_comments is { Count: > 0 })
                        {
                            <RadzenButton Text="@L["AiSummarizeComments"]" Icon="auto_awesome" Visible="@AiEnabled"
                                          ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                          Click="@SummarizeCommentsAsync" Disabled="@_aiBusy" IsBusy="@_aiBusy" />
                        }
                    </div>

                    <RadzenTemplateForm TItem="AddCommentModel" Data="@_addCommentModel" Submit="@AddCommentAsync">
                        <div class="cs-comment-composer">
                            <RadzenTextArea @bind-Value="_addCommentModel.Body" Name="comment-body" Rows="2" Placeholder="@L["CardWriteComment"]"
                                            Style="width:100%" />
                            <RadzenRequiredValidator Component="comment-body" Text="@L["ValidationRequired"]" />
                            <div class="cs-row">
                                <RadzenButton Text="@L["CardSendComment"]" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small" IsBusy="@_addingComment" />
                            </div>
                        </div>
                    </RadzenTemplateForm>

                    @if (_commentsError is not null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_commentsError</RadzenAlert>
                    }
                    else if (_comments is null)
                    {
                        <span class="cs-muted">@L["CardLoadingComments"]</span>
                    }
                    else
                    {
                        @if (_aiSummary is not null)
                        {
                            <div class="cs-ai-summary">
                                <strong>@L["AiSummaryTitle"]</strong>
                                <p>@_aiSummary</p>
                            </div>
                        }
                        <ol class="cs-comment-list">
                            @foreach (CommentDto c in _comments)
                            {
                                // BETA-8-UI-#12 — fall back to the GUID when the
                                // author's display name is missing.
                                string authorLabel = !string.IsNullOrEmpty(c.AuthorDisplayName)
                                    ? c.AuthorDisplayName
                                    : c.AuthorId.ToString();
                                <li class="cs-comment">
                                    <span class="cs-avatar cs-avatar--sm" aria-hidden="true">@UserInitials.From(authorLabel)</span>
                                    <div class="cs-comment-body">
                                        <div class="cs-comment-meta">
                                            <strong>@authorLabel</strong>
                                            <span class="cs-muted">@($"{c.CreatedAt.LocalDateTime:g}")</span>
                                            @if (c.UpdatedAt is not null)
                                            {
                                                <span class="cs-muted">@L["CommentEdited"]</span>
                                            }
                                        </div>
                                        @if (_editingCommentId == c.Id)
                                        {
                                            <RadzenTextArea @bind-Value="_editingCommentBody" Rows="2" Style="width:100%"
                                                            aria-label="@L["CommentEdit"]" />
                                            <div class="cs-row rz-mt-1">
                                                <RadzenButton Text="@L["DescriptionSave"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                              Click="@(() => SaveCommentAsync(c.Id))" />
                                                <RadzenButton Text="@L["DescriptionCancel"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                              Size="ButtonSize.Small" Click="@CancelEditingComment" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="cs-comment-text">@c.Body</div>
                                            @if (IsOwnComment(c))
                                            {
                                                <div class="cs-comment-actions">
                                                    <RadzenButton Text="@L["CommentEdit"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                                  Size="ButtonSize.ExtraSmall" Click="@(() => StartEditingComment(c))" />
                                                    <RadzenButton Text="@L["ActionDelete"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                                  Size="ButtonSize.ExtraSmall" Click="@(() => DeleteCommentAsync(c.Id))" />
                                                </div>
                                            }
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                </section>

                <section class="cs-card-section">
                    <h2 class="cs-card-section-title"><RadzenIcon Icon="history" />@L["ActivityTitle"]</h2>
                    @if (_activityError is not null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_activityError</RadzenAlert>
                    }
                    else if (_recentActivity is null)
                    {
                        <span class="cs-muted">@L["ActivityLoading"]</span>
                    }
                    else if (_recentActivity.Count == 0)
                    {
                        <span class="cs-muted">@L["CardActivityEmpty"]</span>
                    }
                    else
                    {
                        <ol class="cs-activity-list">
                            @foreach (ActivityDto a in _recentActivity)
                            {
                                // BETA-8-UI-#13 — fall back to the GUID when the
                                // actor's display name is missing.
                                string actorLabel = !string.IsNullOrEmpty(a.ActorDisplayName)
                                    ? a.ActorDisplayName
                                    : a.ActorId.ToString();
                                string payload = FormatActivityPayload(a);
                                <li class="cs-activity">
                                    <strong>@actorLabel</strong>
                                    <span>@ActivityKindLabel(a.Kind)</span>
                                    @if (!string.IsNullOrWhiteSpace(payload))
                                    {
                                        <span class="cs-muted">· @payload</span>
                                    }
                                    <span class="cs-muted cs-activity-time">@($"{a.OccurredAt.LocalDateTime:g}")</span>
                                </li>
                            }
                        </ol>
                    }
                </section>
            </div>

            @* ── Side panel ──────────────────────────────── *@
            <aside class="cs-card-detail-aside">
                <section class="cs-aside-group">
                    <h2 class="cs-aside-title">@L["CardAddToCard"]</h2>
                    @if (_currentUserId is { } me && !HasMember(me))
                    {
                        <RadzenButton Text="@L["CardJoin"]" Icon="person_add" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                      class="cs-aside-button" Click="@JoinCardAsync" />
                    }
                    <RadzenButton Text="@L["MembersTitle"]" Icon="person_outline" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                  class="@PanelButtonClass(CardPanel.Members)" Click="@(() => TogglePanel(CardPanel.Members))" />
                    @if (_openPanel == CardPanel.Members)
                    {
                        <div class="cs-panel">
                            @foreach (WorkspaceMemberDto member in _workspaceMembers)
                            {
                                bool assigned = HasMember(member.UserId);
                                <div class="cs-panel-option @(assigned ? "is-selected" : null)" role="button" tabindex="0"
                                     aria-pressed="@(assigned ? "true" : "false")"
                                     @onclick="@(() => ToggleMemberAsync(member.UserId))"
                                     @onkeydown="@(e => OnOptionKeyAsync(e, () => ToggleMemberAsync(member.UserId)))">
                                    <span class="cs-avatar cs-avatar--sm" aria-hidden="true">@UserInitials.From(member.DisplayName)</span>
                                    <span class="cs-panel-option-text">@member.DisplayName</span>
                                    @if (assigned)
                                    {
                                        <RadzenIcon Icon="check" />
                                    }
                                </div>
                            }
                            <RadzenButton Text="@L["AiSuggestOwners"]" Icon="auto_awesome" Visible="@AiEnabled" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                          Size="ButtonSize.Small" Click="@SuggestOwnersAsync" Disabled="@_aiBusy" IsBusy="@_aiBusy" />
                        </div>
                    }
                    <RadzenButton Text="@L["CardLabels"]" Icon="label" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                  class="@PanelButtonClass(CardPanel.Labels)" Click="@(() => TogglePanel(CardPanel.Labels))" />
                    @if (_openPanel == CardPanel.Labels)
                    {
                        <div class="cs-panel">
                            @foreach (LabelDto label in _boardLabels)
                            {
                                bool attached = HasLabel(label.Id);
                                <div class="cs-panel-label-row">
                                    <div class="cs-panel-label @(attached ? "is-selected" : null)" role="button" tabindex="0"
                                         style="--cs-label-color: @label.Color"
                                         aria-pressed="@(attached ? "true" : "false")"
                                         @onclick="@(() => ToggleLabelAsync(label.Id))"
                                         @onkeydown="@(e => OnOptionKeyAsync(e, () => ToggleLabelAsync(label.Id)))">
                                        <span>@label.Name</span>
                                        @if (attached)
                                        {
                                            <RadzenIcon Icon="check" />
                                        }
                                    </div>
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                                  aria-label="@L["CardLabelDelete"]" title="@L["CardLabelDelete"]"
                                                  Click="@(() => DeleteLabelAsync(label))" />
                                </div>
                            }
                            <div class="cs-panel-divider"></div>
                            <RadzenTextBox @bind-Value="_newLabelName" Immediate="true" Placeholder="@L["CardLabelName"]" Style="width:100%"
                                           aria-label="@L["CardLabelName"]"
                                           @onkeydown="@(e => OnOptionKeyAsync(e, CreateLabelAsync, enterOnly: true))" />
                            <div class="cs-swatches" role="radiogroup" aria-label="@L["CardLabelColor"]">
                                @foreach (CardPalette.Swatch swatch in CardPalette.All)
                                {
                                    <span class="cs-swatch @(_newLabelColor == swatch.Hex ? "is-selected" : null)" role="radio" tabindex="0"
                                          style="--cs-swatch: @swatch.Hex" title="@swatch.Name"
                                          aria-checked="@(_newLabelColor == swatch.Hex ? "true" : "false")"
                                          @onclick="@(() => _newLabelColor = swatch.Hex)"
                                          @onkeydown="@(e => OnOptionKeyAsync(e, () => { _newLabelColor = swatch.Hex; return Task.CompletedTask; }))"></span>
                                }
                            </div>
                            <RadzenButton Text="@L["CardLabelCreate"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                          Click="@CreateLabelAsync" Disabled="@string.IsNullOrWhiteSpace(_newLabelName)" />
                        </div>
                    }
                    <RadzenButton Text="@L["CardDates"]" Icon="schedule" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                  class="@PanelButtonClass(CardPanel.Dates)" Click="@(() => TogglePanel(CardPanel.Dates))" />
                    @if (_openPanel == CardPanel.Dates)
                    {
                        <div class="cs-panel">
                            <RadzenDatePicker TValue="DateTime?" @bind-Value="_dueDateLocal" ShowTime="true"
                                              DateFormat="@CardDateTimeFormat" Style="width:100%" aria-label="@L["CardDueDate"]" />
                            <div class="cs-row">
                                <RadzenButton Text="@L["DescriptionSave"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                              Click="@SaveDueDateAsync" />
                                @if (_card.DueDate is not null)
                                {
                                    <RadzenButton Text="@L["CardRemoveDate"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  Click="@ClearDueDateAsync" />
                                }
                            </div>
                        </div>
                    }
                    <RadzenButton Text="@L["CardCover"]" Icon="palette" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                  class="@PanelButtonClass(CardPanel.Cover)" Click="@(() => TogglePanel(CardPanel.Cover))" />
                    @if (_openPanel == CardPanel.Cover)
                    {
                        <div class="cs-panel">
                            <div class="cs-swatches cs-swatches--cover" role="radiogroup" aria-label="@L["CardCover"]">
                                @foreach (CardPalette.Swatch swatch in CardPalette.All)
                                {
                                    bool current = string.Equals(CoverColor, swatch.Hex, StringComparison.OrdinalIgnoreCase);
                                    <span class="cs-swatch @(current ? "is-selected" : null)" role="radio" tabindex="0"
                                          style="--cs-swatch: @swatch.Hex" title="@swatch.Name"
                                          aria-checked="@(current ? "true" : "false")"
                                          @onclick="@(() => SetCoverAsync(swatch.Name))"
                                          @onkeydown="@(e => OnOptionKeyAsync(e, () => SetCoverAsync(swatch.Name)))"></span>
                                }
                            </div>
                            @if (CoverColor is not null)
                            {
                                <RadzenButton Text="@L["CardRemoveCover"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                              Click="@(() => SetCoverAsync(null))" />
                            }
                        </div>
                    }
                </section>

                <section class="cs-aside-group">
                    <h2 class="cs-aside-title">@L["CardActions"]</h2>
                    <RadzenButton Text="@L["CardMove"]" Icon="arrow_forward" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                  class="@PanelButtonClass(CardPanel.Move)" Click="@(() => TogglePanel(CardPanel.Move))" />
                    @if (_openPanel == CardPanel.Move)
                    {
                        <div class="cs-panel">
                            <RadzenDropDown TValue="Guid?" @bind-Value="_moveTargetListId" Data="@_boardLists"
                                            TextProperty="Name" ValueProperty="Id" Style="width:100%" aria-label="@L["CardMoveList"]" />
                            <div class="cs-row">
                                <RadzenCheckBox TValue="bool" @bind-Value="_moveToTop" Name="move-top" />
                                <RadzenLabel Text="@L["CardMoveTop"]" Component="move-top" />
                            </div>
                            <RadzenButton Text="@L["CardMove"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                          Click="@MoveCardAsync" Disabled="@(_moveTargetListId is null)" />
                        </div>
                    }
                    <RadzenButton Text="@L["CardCopy"]" Icon="file_copy" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                  class="@PanelButtonClass(CardPanel.Copy)" Click="@(() => TogglePanel(CardPanel.Copy))" />
                    @if (_openPanel == CardPanel.Copy)
                    {
                        <div class="cs-panel">
                            <RadzenTextBox @bind-Value="_copyTitle" Immediate="true" Style="width:100%" aria-label="@L["CardCopyTitle"]"
                                           Placeholder="@L["CardCopyTitle"]" />
                            <span class="cs-muted">@L["CardCopyKeeps"]</span>
                            <RadzenDropDown TValue="Guid?" @bind-Value="_copyTargetListId" Data="@_boardLists"
                                            TextProperty="Name" ValueProperty="Id" Style="width:100%" aria-label="@L["CardMoveList"]" />
                            <div class="cs-row">
                                <RadzenCheckBox TValue="bool" @bind-Value="_copyToTop" Name="copy-top" />
                                <RadzenLabel Text="@L["CardMoveTop"]" Component="copy-top" />
                            </div>
                            <RadzenButton Text="@L["CardCopyCreate"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                          Click="@CopyCardAsync" IsBusy="@_copying"
                                          Disabled="@(_copying || _copyTargetListId is null || string.IsNullOrWhiteSpace(_copyTitle))" />
                        </div>
                    }
                    @if (_card.IsCompleted)
                    {
                        <RadzenButton Text="@L["ActionReopen"]" Icon="replay" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@ReopenAsync" class="cs-aside-button" />
                    }
                    else
                    {
                        <RadzenButton Text="@L["CardComplete"]" Icon="check" ButtonStyle="ButtonStyle.Primary" Click="@CompleteAsync" class="cs-aside-button" />
                    }
                    <RadzenButton Text="@L["CardVotes", _voteState?.VoteCount ?? 0]"
                                  Icon="@(_voteState is { CurrentUserHasVoted: true } ? "thumb_up" : "thumb_up_off_alt")"
                                  ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                  class="@(_voteState is { CurrentUserHasVoted: true } ? "cs-aside-button is-active" : "cs-aside-button")"
                                  Click="@ToggleVoteAsync"
                                  Disabled="@_togglingVote"
                                  IsBusy="@_togglingVote"
                                  title="@L["CardVote"]"
                                  aria-pressed="@(_voteState is { CurrentUserHasVoted: true } ? "true" : "false")" />
                    @* P3.3 / G6c — "Mirror to…" opens the board + list picker dialog. *@
                    <RadzenButton Text="@L["MirrorToButton"]" Icon="content_copy"
                                  ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" class="cs-aside-button"
                                  Click="@OpenMirrorDialogAsync"
                                  Disabled="@_mirroring" IsBusy="@_mirroring"
                                  title="@L["MirrorToTitle"]" />
                </section>

                @* P3.2 / G6b — snooze. Hidden while snoozed: the badge in
                   the header carries the unsnooze control. *@
                @if (!_card.IsSnoozed)
                {
                    <section class="cs-aside-group">
                        <h2 class="cs-aside-title">@L["CardSnooze"]</h2>
                        <RadzenDatePicker @bind-Value="_snoozeUntilLocal" ShowTime="true"
                                          DateFormat="@CardDateTimeFormat" Style="width: 100%;" />
                        <RadzenButton Text="@L["CardSnoozeUntil"]" Icon="snooze"
                                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" class="cs-aside-button"
                                      Click="@SnoozeAsync" Disabled="@_snoozing" IsBusy="@_snoozing" />
                    </section>
                }

                <section class="cs-aside-group">
                    <h2 class="cs-aside-title">@L["CardRecurrence"]</h2>
                    @if (_recurrenceError is not null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_recurrenceError</RadzenAlert>
                    }
                    else if (_recurrence is { IsActive: true })
                    {
                        <span class="cs-aside-text">@L["CardRecurrenceSummary", _recurrence.IntervalDays, _recurrence.NextOccurrenceAt.LocalDateTime.ToString("g")]</span>
                        <RadzenButton Text="@L["CardRecurrenceStop"]" Icon="event_busy" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                      class="cs-aside-button" Click="@ClearRecurrenceAsync" />
                    }
                    else
                    {
                        <div class="cs-row">
                            <RadzenNumeric @bind-Value="_recurrenceIntervalDays" Min="1" Max="365" ShowUpDown="true" Style="width:5.5rem" />
                            <span class="cs-muted">@L["CardDays"]</span>
                        </div>
                        <RadzenButton Text="@L["CardSetRecurrence"]" Icon="event_repeat" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                      class="cs-aside-button" Click="@SaveRecurrenceAsync" />
                    }
                </section>

                <section class="cs-aside-group">
                    <h2 class="cs-aside-title">@L["CardDetails"]</h2>
                    <MetadataList Items="@CardMetaItems" />
                </section>

                <section class="cs-aside-group">
                    <RadzenButton Text="@(_card.IsArchived ? L["ActionRestore"] : L["ActionArchive"])"
                                  Icon="@(_card.IsArchived ? "unarchive" : "archive")"
                                  ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" class="cs-aside-button"
                                  Click="@ToggleArchiveAsync" />
                    <RadzenButton Text="@L["ActionDelete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                  class="cs-aside-button" Click="@DeleteCardAsync" />
                </section>
            </aside>
        </div>
    </div>
}
