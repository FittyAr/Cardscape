@page "/cards/{CardId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Text.Json
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject ICardsApiClient Cards
@inject ICommentsApiClient Comments
@inject ICustomFieldsApiClient CustomFields
@inject IActivitiesApiClient Activities
@inject IVotingApiClient Votes

<PageTitle>@(card?.Title ?? "Card") — Cardscape</PageTitle>

<div class="card-detail-shell">
    @if (card is null)
    {
        <p>Loading card…</p>
    }
    else
    {
        <RadzenCard>
            <div class="card-detail-header">
                <h1>@card.Title</h1>
                <div class="card-detail-actions">
                    @if (card.IsCompleted)
                    {
                        <RadzenButton Text="Reopen" ButtonStyle="ButtonStyle.Light" Click="@Reopen" />
                    }
                    else
                    {
                        <RadzenButton Text="Complete" ButtonStyle="ButtonStyle.Success" Click="@Complete" />
                    }
                    <RadzenButton Text="@(card.IsArchived ? "Restore" : "Archive")"
                                  ButtonStyle="ButtonStyle.Warning" Click="@ToggleArchive" />
                    <RadzenButton Text="@(voteState is { CurrentUserHasVoted: true } ? "♥ " : "♡ ")"
                                  ButtonStyle="@(voteState is { CurrentUserHasVoted: true } ? ButtonStyle.Danger : ButtonStyle.Light)"
                                  Click="@ToggleVoteAsync"
                                  Disabled="@togglingVote"
                                  IsBusy="@togglingVote"
                                  title="Vote on this card" />
                    <small class="vote-count">@voteState?.VoteCount ?? 0</small>
                </div>
            </div>

            <dl class="card-meta">
                <dt>Due date</dt>
                <dd>
                    @if (card.DueDate is null)
                    {
                        <span>none</span>
                    }
                    else
                    {
                        @card.DueDate.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                    }
                </dd>
                <dt>Members</dt>
                <dd>@card.MemberCount</dd>
                <dt>Labels</dt>
                <dd>@card.LabelCount</dd>
            </dl>

            <h3>Description</h3>
            <p class="card-description">@(string.IsNullOrWhiteSpace(card.Description) ? "(no description)" : card.Description)</p>

            @if (fieldValues is not null && fieldValues.Count > 0)
            {
                <h3>Custom fields</h3>
                <dl class="card-meta">
                    @foreach (CustomFieldValueDto v in fieldValues)
                    {
                        <dt>@FieldKindLabel(v.Kind)</dt>
                        <dd>@FormatFieldValue(v)</dd>
                    }
                </dl>
            }

            <h3>Comments</h3>
            @if (comments is null)
            {
                <p>Loading comments…</p>
            }
            else
            {
                @foreach (CommentDto c in comments)
                {
                    <RadzenCard class="comment-card">
                        <small>@c.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm") · @c.AuthorId</small>
                        <p>@c.Body</p>
                    </RadzenCard>
                }
            }

            <RadzenTemplateForm TItem="AddCommentModel" Data="@addCommentModel" Submit="@AddComment">
                <RadzenTextArea @bind-Value="addCommentModel.Body" Rows="2" Placeholder="Write a comment…"
                                Style="width:100%; margin-top:.5rem" />
                <RadzenButton Text="Comment" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@addingComment" Style="margin-top:.5rem" />
            </RadzenTemplateForm>

            <h3>Activity</h3>
            @if (recentActivity is null)
            {
                <p>Loading activity…</p>
            }
            else if (recentActivity.Count == 0)
            {
                <p>No activity recorded for this card yet.</p>
            }
            else
            {
                <ul class="card-activity-list">
                    @foreach (ActivityDto a in recentActivity)
                    {
                        <li>
                            <strong>@a.KindName</strong>
                            <small> · @a.OccurredAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</small>
                            <span> · @FormatActivityPayload(a)</span>
                        </li>
                    }
                </ul>
            }
        </RadzenCard>
    }
</div>

@code {
    [Parameter] public Guid CardId { get; set; }

    private CardDto? card;
    private IReadOnlyList<CommentDto>? comments;
    private IReadOnlyList<CustomFieldValueDto>? fieldValues;
    private IReadOnlyList<ActivityDto>? recentActivity;
    private CardVoteStateDto? voteState;
    private bool addingComment;
    private bool togglingVote;
    private readonly AddCommentModel addCommentModel = new();

    protected override async Task OnParametersSetAsync()
    {
        ApiResult<CardDto> cardResult = await Cards.GetAsync(CardId);
        card = cardResult.IsSuccess ? cardResult.Value : null;

        ApiResult<IReadOnlyList<CommentDto>> commentsResult = await Comments.ListForCardAsync(CardId);
        comments = commentsResult.IsSuccess ? commentsResult.Value : [];

        ApiResult<IReadOnlyList<CustomFieldValueDto>> valuesResult =
            await CustomFields.ListValuesForCardAsync(CardId);
        fieldValues = valuesResult.IsSuccess ? valuesResult.Value : [];

        ApiResult<ActivityPageDto> activityResult =
            await Activities.ListForCardAsync(CardId, cursor: null, limit: 20);
        recentActivity = activityResult.IsSuccess ? activityResult.Value?.Items : [];

        ApiResult<CardVoteStateDto> voteResult = await Votes.GetStateAsync(CardId);
        voteState = voteResult.IsSuccess ? voteResult.Value : null;
    }

    private async Task ToggleVoteAsync()
    {
        if (togglingVote) return;
        togglingVote = true;
        try
        {
            ApiResult<CardVoteStateDto> result = await Votes.ToggleAsync(CardId);
            if (result.IsSuccess)
            {
                voteState = result.Value;
            }
        }
        finally
        {
            togglingVote = false;
        }
    }

    private async Task Complete()
    {
        if (card is null) return;
        ApiResult<CardDto> result = await Cards.CompleteAsync(CardId);
        if (result.IsSuccess) card = result.Value;
    }

    private async Task Reopen()
    {
        if (card is null) return;
        ApiResult<CardDto> result = await Cards.ReopenAsync(CardId);
        if (result.IsSuccess) card = result.Value;
    }

    private async Task ToggleArchive()
    {
        if (card is null) return;
        ApiResult<CardDto> result = card.IsArchived
            ? await Cards.RestoreAsync(CardId)
            : await Cards.ArchiveAsync(CardId);
        if (result.IsSuccess) card = result.Value;
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(addCommentModel.Body)) return;
        addingComment = true;
        try
        {
            ApiResult<CommentDto> result = await Comments.AddAsync(CardId, addCommentModel.Body);
            if (result.IsSuccess)
            {
                comments = [.. (comments ?? Array.Empty<CommentDto>()), result.Value!];
                addCommentModel.Body = string.Empty;
            }
        }
        finally
        {
            addingComment = false;
        }
    }

    private sealed class AddCommentModel
    {
        public string Body { get; set; } = string.Empty;
    }

    private static string FieldKindLabel(int kind) => kind switch
    {
        0 => "Text",
        1 => "Number",
        2 => "Date",
        3 => "Dropdown",
        4 => "Checkbox",
        _ => $"Kind {kind}",
    };

    private static string FormatFieldValue(CustomFieldValueDto value)
    {
        // Values are stored as JSON strings; strip outer quotes for display.
        string raw = value.ValueJson?.Trim('"') ?? string.Empty;
        if (string.IsNullOrEmpty(raw))
        {
            return "(empty)";
        }

        return value.Kind switch
        {
            4 => raw.Equals("true", StringComparison.OrdinalIgnoreCase) ? "☑ Yes" : "☐ No",
            2 => raw, // ISO date; render as-is
            _ => raw,
        };
    }

    private static string FormatActivityPayload(ActivityDto a)
    {
        if (string.IsNullOrEmpty(a.PayloadJson) || a.PayloadJson == "{}")
        {
            return string.Empty;
        }

        try
        {
            using JsonDocument doc = JsonDocument.Parse(a.PayloadJson);
            if (doc.RootElement.ValueKind == JsonValueKind.Object)
            {
                List<string> parts = [];
                foreach (JsonProperty p in doc.RootElement.EnumerateObject())
                {
                    parts.Add($"{p.Name}: {p.Value}");
                }

                return string.Join(" · ", parts);
            }
        }
        catch
        {
            // fall through
        }

        return a.PayloadJson;
    }
}
