@page "/boards/{BoardId:guid}/automation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject IAutomationApiClient AutomationClient

<PageTitle>Automation — Cardscape</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="Automation"
                Actions="@(NewRuleButton())" />

    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
        Rules run server-side the moment a matching card event fires.
        They're best-effort: a failed rule never blocks the user that
        caused the event.
    </RadzenText>

    @if (showCreate)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="NewRuleModel" Data="@newRule" Submit="@CreateRule">
                <LabeledField Text="Name" Component="rule-name">
                    <RadzenTextBox @bind-Value="newRule.Name" Name="rule-name" Style="width:100%" />
                </LabeledField>

                <LabeledField Text="When…" Component="rule-trigger">
                    <RadzenDropDown @bind-Value="newRule.Trigger" Data="@triggerOptions"
                                    TextProperty="Label" ValueProperty="Value"
                                    Name="rule-trigger" Style="width:100%" Change="@OnTriggerChanged" />
                </LabeledField>

                @if (newRule.Trigger == AutomationTrigger.CardCreatedInList)
                {
                    <LabeledField Text="In list (id)" Component="rule-trigger-list">
                        <RadzenTextBox @bind-Value="newRule.TriggerListIdText" Name="rule-trigger-list"
                                       Style="width:100%" />
                    </LabeledField>
                }

                <LabeledField Text="Then…" Component="rule-action">
                    <RadzenDropDown @bind-Value="newRule.Action" Data="@actionOptions"
                                    TextProperty="Label" ValueProperty="Value"
                                    Name="rule-action" Style="width:100%" />
                </LabeledField>

                <LabeledField Text="Argument (list id / user id / ISO date)" Component="rule-arg">
                    <RadzenTextBox @bind-Value="newRule.ActionArgument" Name="rule-arg"
                                   Style="width:100%" />
                </LabeledField>

                @if (error is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Class="rz-mt-2">
                        @error
                    </RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelCreate" />
                    <RadzenButton Text="Create" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@busy" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @if (rules is null)
    {
        <RadzenText Text="Loading…" />
    }
    else if (rules.Count == 0)
    {
        <RadzenText Text="No automation rules yet. Create one above to get started." />
    }
    else
    {
        <RadzenStack Gap="0.5rem">
            @foreach (BoardAutomationRuleDto rule in rules)
            {
                <RadzenCard Variant="@(rule.IsEnabled ? Variant.Filled : Variant.Outlined)">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="@rule.Name" TextStyle="TextStyle.Body1" TagName="TagName.Span" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                                When: <em>@TriggerName(rule.Trigger)</em>
                                @if (rule.Trigger == AutomationTrigger.CardCreatedInList)
                                {
                                    <text> (list @rule.TriggerListId)</text>
                                }
                                · Do: <em>@ActionName(rule.Action)</em>
                                @if (!string.IsNullOrEmpty(rule.ActionArgument))
                                {
                                    <text> → @rule.ActionArgument</text>
                                }
                            </RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                            @if (rule.IsEnabled)
                            {
                                <RadzenButton Text="Disable" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="@(() => DisableAsync(rule))" />
                            }
                            else
                            {
                                <RadzenButton Text="Enable" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                              Click="@(() => EnableAsync(rule))" />
                            }
                            <RadzenButton Text="Delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          Click="@(() => DeleteAsync(rule))" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    }
</RadzenStack>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private IReadOnlyList<BoardAutomationRuleDto>? rules;
    private bool showCreate;
    private bool busy;
    private string? error;
    private readonly NewRuleModel newRule = new();

    private readonly List<TriggerOption> triggerOptions = new()
    {
        new(AutomationTrigger.CardMoved, "Card moved to any list"),
        new(AutomationTrigger.CardCompleted, "Card completed"),
        new(AutomationTrigger.CardReopened, "Card reopened"),
        new(AutomationTrigger.CardCreatedInList, "Card created in a specific list")
    };

    private readonly List<ActionOption> actionOptions = new()
    {
        new(AutomationAction.MoveCardToList, "Move card to list (arg = list id)"),
        new(AutomationAction.AssignUser, "Assign user (arg = user id)"),
        new(AutomationAction.SetDueDate, "Set due date (arg = ISO date)"),
        new(AutomationAction.MarkComplete, "Mark complete")
    };

    private RenderFragment NewRuleButton() => __builder =>
    {
        <RadzenButton Text="New rule" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    };

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        ApiResult<IReadOnlyList<BoardAutomationRuleDto>> result = await AutomationClient.ListRulesAsync(BoardId);
        rules = result.IsSuccess ? result.Value : [];
        if (!result.IsSuccess)
        {
            error = result.Error;
        }
    }

    private void OnTriggerChanged()
    {
        if (newRule.Trigger != AutomationTrigger.CardCreatedInList)
        {
            newRule.TriggerListIdText = string.Empty;
        }
    }

    private async Task CreateRule()
    {
        busy = true;
        error = null;
        try
        {
            Guid? triggerListId = null;
            if (newRule.Trigger == AutomationTrigger.CardCreatedInList && Guid.TryParse(newRule.TriggerListIdText, out var tlid))
            {
                triggerListId = tlid;
            }

            var body = new CreateRuleRequestDto(
                newRule.Name,
                newRule.Trigger,
                triggerListId,
                newRule.Action,
                string.IsNullOrWhiteSpace(newRule.ActionArgument) ? null : newRule.ActionArgument,
                Position: 0);

            ApiResult<BoardAutomationRuleDto> result = await AutomationClient.CreateRuleAsync(BoardId, body);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            showCreate = false;
            newRule.Name = string.Empty;
            newRule.ActionArgument = string.Empty;
            newRule.TriggerListIdText = string.Empty;
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelCreate()
    {
        showCreate = false;
        error = null;
    }

    private async Task EnableAsync(BoardAutomationRuleDto rule)
    {
        ApiResult r = await AutomationClient.EnableRuleAsync(BoardId, rule.Id);
        if (r.IsSuccess) await ReloadAsync();
    }

    private async Task DisableAsync(BoardAutomationRuleDto rule)
    {
        ApiResult r = await AutomationClient.DisableRuleAsync(BoardId, rule.Id);
        if (r.IsSuccess) await ReloadAsync();
    }

    private async Task DeleteAsync(BoardAutomationRuleDto rule)
    {
        ApiResult r = await AutomationClient.DeleteRuleAsync(BoardId, rule.Id);
        if (r.IsSuccess) await ReloadAsync();
    }

    private static string TriggerName(AutomationTrigger t) => t switch
    {
        AutomationTrigger.CardMoved => "card moved",
        AutomationTrigger.CardCompleted => "card completed",
        AutomationTrigger.CardReopened => "card reopened",
        AutomationTrigger.CardCreatedInList => "card created in list",
        _ => "unknown"
    };

    private static string ActionName(AutomationAction a) => a switch
    {
        AutomationAction.MoveCardToList => "move card to list",
        AutomationAction.AssignUser => "assign user",
        AutomationAction.SetDueDate => "set due date",
        AutomationAction.MarkComplete => "mark complete",
        _ => "unknown"
    };

    private sealed class NewRuleModel
    {
        public string Name { get; set; } = string.Empty;
        public AutomationTrigger Trigger { get; set; } = AutomationTrigger.CardCompleted;
        public string TriggerListIdText { get; set; } = string.Empty;
        public AutomationAction Action { get; set; } = AutomationAction.MarkComplete;
        public string ActionArgument { get; set; } = string.Empty;
    }

    private sealed record TriggerOption(AutomationTrigger Value, string Label);
    private sealed record ActionOption(AutomationAction Value, string Label);
}
