@page "/boards/{BoardId:guid}/automation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Cardscape.Web.Resources
@using Microsoft.Extensions.Localization
@inject IAutomationApiClient AutomationClient
@inject IBoardsApiClient BoardsApi
@inject IListsApiClient ListsApi
@inject IWorkspacesApiClient WorkspacesApi
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AutomationTitle"] @L["PageTitleSuffix"]</PageTitle>

<RadzenStack Gap="1rem" Class="rz-mx-auto" Style="max-width: 80rem;">
    <PageHeader Title="@L["AutomationTitle"]"
                Actions="@(NewRuleButton())" />

    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-text-secondary">
        @L["AutomationBlurb"]
    </RadzenText>

    @if (showCreate)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="NewRuleModel" Data="@newRule" Submit="@CreateRuleAsync">
                <LabeledField Text="@L["AutomationName"]" Component="rule-name">
                    <RadzenTextBox @bind-Value="newRule.Name" Name="rule-name" Style="width:100%" />
                </LabeledField>
                <RadzenRequiredValidator Component="rule-name" Text="@L["ValidationRequired"]" />

                <LabeledField Text="@L["AutomationWhen"]" Component="rule-trigger">
                    <RadzenDropDown @bind-Value="newRule.Trigger" Data="@TriggerOptions"
                                    TextProperty="Label" ValueProperty="Value"
                                    Name="rule-trigger" Style="width:100%" Change="@OnTriggerChanged" />
                </LabeledField>

                @if (newRule.Trigger == AutomationTrigger.CardCreatedInList)
                {
                    <LabeledField Text="@L["AutomationTriggerList"]" Component="rule-trigger-list">
                        <RadzenDropDown @bind-Value="newRule.TriggerListId" Data="@lists"
                                        TextProperty="Name" ValueProperty="Id" Name="rule-trigger-list"
                                        Placeholder="@L["AutomationPickList"]" Style="width:100%" />
                    </LabeledField>
                }

                <LabeledField Text="@L["AutomationThen"]" Component="rule-action">
                    <RadzenDropDown @bind-Value="newRule.Action" Data="@ActionOptions"
                                    TextProperty="Label" ValueProperty="Value"
                                    Name="rule-action" Style="width:100%" />
                </LabeledField>

                @switch (newRule.Action)
                {
                    case AutomationAction.MoveCardToList:
                        <LabeledField Text="@L["AutomationTargetList"]" Component="rule-arg-list">
                            <RadzenDropDown @bind-Value="newRule.TargetListId" Data="@lists"
                                            TextProperty="Name" ValueProperty="Id" Name="rule-arg-list"
                                            Placeholder="@L["AutomationPickList"]" Style="width:100%" />
                        </LabeledField>
                        break;
                    case AutomationAction.AssignUser:
                        <LabeledField Text="@L["AutomationTargetMember"]" Component="rule-arg-member">
                            <RadzenDropDown @bind-Value="newRule.TargetUserId" Data="@members"
                                            TextProperty="DisplayName" ValueProperty="UserId" Name="rule-arg-member"
                                            Placeholder="@L["AutomationPickMember"]" AllowFiltering="true" Style="width:100%" />
                        </LabeledField>
                        break;
                    case AutomationAction.SetDueDate:
                        <LabeledField Text="@L["AutomationTargetDue"]" Component="rule-arg-due">
                            <RadzenDatePicker @bind-Value="newRule.DueDate" Name="rule-arg-due" ShowTime="true"
                                              DateFormat="g" Style="width:100%" />
                        </LabeledField>
                        break;
                }

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="ButtonStyle.Light" Click="@CancelCreate" />
                    <RadzenButton Text="@L["ActionCreate"]" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@busy" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@error</RadzenAlert>
    }

    @if (loading)
    {
        <LoadingState Size="LoadingSize.Section" />
    }
    else if (loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@loadError</RadzenAlert>
    }
    else if (rules is { Count: 0 })
    {
        <RadzenText Text="@L["AutomationEmpty"]" />
    }
    else if (rules is not null)
    {
        <RadzenStack Gap="0.5rem">
            @foreach (BoardAutomationRuleDto rule in rules)
            {
                <RadzenCard Variant="@(rule.IsEnabled ? Variant.Filled : Variant.Outlined)">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText Text="@rule.Name" TextStyle="TextStyle.Body1" TagName="TagName.Span" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-text-secondary">
                                @L["AutomationWhen"] <em>@TriggerName(rule.Trigger)</em>
                                @if (rule.Trigger == AutomationTrigger.CardCreatedInList)
                                {
                                    <text> (@L["AutomationList"] @ListName(rule.TriggerListId))</text>
                                }
                                · @L["AutomationDo"] <em>@ActionName(rule.Action)</em>
                                @if (!string.IsNullOrEmpty(rule.ActionArgument))
                                {
                                    <text> → @ArgumentLabel(rule)</text>
                                }
                            </RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                            @if (rule.IsEnabled)
                            {
                                <RadzenButton Text="@L["AutomationDisable"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="@(() => DisableAsync(rule))" />
                            }
                            else
                            {
                                <RadzenButton Text="@L["AutomationEnable"]" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                              Click="@(() => EnableAsync(rule))" />
                            }
                            <RadzenButton Text="@L["ActionDelete"]" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          Click="@(() => DeleteAsync(rule))" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    }
</RadzenStack>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private IReadOnlyList<BoardAutomationRuleDto>? rules;
    private bool showCreate;
    private bool busy;
    private bool loading;
    private string? error;
    private string? loadError;
    private readonly NewRuleModel newRule = new();
    private IReadOnlyList<BoardListDto> lists = [];
    private IReadOnlyList<WorkspaceMemberDto> members = [];

    private IReadOnlyList<TriggerOption> TriggerOptions =>
    [
        new(AutomationTrigger.CardMoved, L["AutomationTriggerMoved"]),
        new(AutomationTrigger.CardCompleted, L["AutomationTriggerCompleted"]),
        new(AutomationTrigger.CardReopened, L["AutomationTriggerReopened"]),
        new(AutomationTrigger.CardCreatedInList, L["AutomationTriggerCreatedInList"])
    ];

    private IReadOnlyList<ActionOption> ActionOptions =>
    [
        new(AutomationAction.MoveCardToList, L["AutomationActionMove"]),
        new(AutomationAction.AssignUser, L["AutomationActionAssign"]),
        new(AutomationAction.SetDueDate, L["AutomationActionDue"]),
        new(AutomationAction.MarkComplete, L["AutomationActionComplete"])
    ];

    private RenderFragment NewRuleButton() => __builder =>
    {
        <RadzenButton Text="@L["AutomationNew"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    };

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        loadError = null;
        try
        {
            Task<ApiResult<IReadOnlyList<BoardAutomationRuleDto>>> rulesTask = AutomationClient.ListRulesAsync(BoardId);
            await LoadReferenceDataAsync();
            ApiResult<IReadOnlyList<BoardAutomationRuleDto>> result = await rulesTask;
            if (result.HasValue)
            {
                rules = result.Value;
                return;
            }

            rules = null;
            loadError = result.Error ?? L["AutomationLoadFailed"];
        }
        finally
        {
            loading = false;
        }
    }

    // Lists and workspace members turn the ids stored on a rule (trigger
    // list, target list, assignee) into names, and feed the pickers.
    private async Task LoadReferenceDataAsync()
    {
        if (lists.Count > 0)
        {
            return;
        }

        Task<ApiResult<IReadOnlyList<BoardListDto>>> listsTask = ListsApi.ListForBoardAsync(BoardId);
        ApiResult<BoardDto> board = await BoardsApi.GetAsync(BoardId);
        if (board.HasValue)
        {
            ApiResult<IReadOnlyList<WorkspaceMemberDto>> memberResult = await WorkspacesApi.ListMembersAsync(board.Value.WorkspaceId);
            members = memberResult.HasValue
                ? memberResult.Value.OrderBy(m => m.DisplayName, StringComparer.CurrentCultureIgnoreCase).ToList()
                : [];
        }

        ApiResult<IReadOnlyList<BoardListDto>> listResult = await listsTask;
        lists = listResult.HasValue ? listResult.Value.OrderBy(l => l.Position).ToList() : [];
    }

    private string ListName(Guid? listId) =>
        lists.FirstOrDefault(l => l.Id == listId)?.Name ?? L["AutomationUnknownList"];

    private string ArgumentLabel(BoardAutomationRuleDto rule) => rule.Action switch
    {
        AutomationAction.MoveCardToList when Guid.TryParse(rule.ActionArgument, out Guid listId) => ListName(listId),
        AutomationAction.AssignUser when Guid.TryParse(rule.ActionArgument, out Guid userId) =>
            members.FirstOrDefault(m => m.UserId == userId)?.DisplayName ?? L["AutomationUnknownMember"],
        AutomationAction.SetDueDate when DateTimeOffset.TryParse(
            rule.ActionArgument, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out DateTimeOffset due) => due.LocalDateTime.ToString("g"),
        _ => rule.ActionArgument ?? string.Empty
    };

    private string? NewRuleArgument() => newRule.Action switch
    {
        AutomationAction.MoveCardToList => newRule.TargetListId?.ToString(),
        AutomationAction.AssignUser => newRule.TargetUserId?.ToString(),
        AutomationAction.SetDueDate => newRule.DueDate is { } due
            ? new DateTimeOffset(due).ToString("o", System.Globalization.CultureInfo.InvariantCulture)
            : null,
        _ => null
    };

    private void OnTriggerChanged()
    {
        if (newRule.Trigger != AutomationTrigger.CardCreatedInList)
        {
            newRule.TriggerListId = null;
        }
    }

    private async Task CreateRuleAsync()
    {
        busy = true;
        error = null;
        try
        {
            Guid? triggerListId = newRule.Trigger == AutomationTrigger.CardCreatedInList ? newRule.TriggerListId : null;
            string? argument = NewRuleArgument();
            if ((newRule.Trigger == AutomationTrigger.CardCreatedInList && triggerListId is null)
                || (newRule.Action != AutomationAction.MarkComplete && argument is null))
            {
                error = L["AutomationIncomplete"];
                return;
            }

            var body = new CreateRuleRequestDto(
                newRule.Name,
                newRule.Trigger,
                triggerListId,
                newRule.Action,
                argument,
                Position: 0);

            ApiResult<BoardAutomationRuleDto> result = await AutomationClient.CreateRuleAsync(BoardId, body);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            showCreate = false;
            newRule.Name = string.Empty;
            newRule.TriggerListId = null;
            newRule.TargetListId = null;
            newRule.TargetUserId = null;
            newRule.DueDate = null;
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelCreate()
    {
        showCreate = false;
        error = null;
    }

    private async Task EnableAsync(BoardAutomationRuleDto rule)
    {
        ApiResult r = await AutomationClient.EnableRuleAsync(BoardId, rule.Id);
        if (r.IsSuccess) await ReloadAsync();
        else error = r.Error;
    }

    private async Task DisableAsync(BoardAutomationRuleDto rule)
    {
        ApiResult r = await AutomationClient.DisableRuleAsync(BoardId, rule.Id);
        if (r.IsSuccess) await ReloadAsync();
        else error = r.Error;
    }

    private async Task DeleteAsync(BoardAutomationRuleDto rule)
    {
        ApiResult r = await AutomationClient.DeleteRuleAsync(BoardId, rule.Id);
        if (r.IsSuccess) await ReloadAsync();
        else error = r.Error;
    }

    private string TriggerName(AutomationTrigger t) => t switch
    {
        AutomationTrigger.CardMoved => L["AutomationTriggerMoved"],
        AutomationTrigger.CardCompleted => L["AutomationTriggerCompleted"],
        AutomationTrigger.CardReopened => L["AutomationTriggerReopened"],
        AutomationTrigger.CardCreatedInList => L["AutomationTriggerCreatedInList"],
        _ => L["CommonUnknown"]
    };

    private string ActionName(AutomationAction a) => a switch
    {
        AutomationAction.MoveCardToList => L["AutomationActionMove"],
        AutomationAction.AssignUser => L["AutomationActionAssign"],
        AutomationAction.SetDueDate => L["AutomationActionDue"],
        AutomationAction.MarkComplete => L["AutomationActionComplete"],
        _ => L["CommonUnknown"]
    };

    private sealed class NewRuleModel
    {
        public string Name { get; set; } = string.Empty;
        public AutomationTrigger Trigger { get; set; } = AutomationTrigger.CardCompleted;
        public Guid? TriggerListId { get; set; }
        public AutomationAction Action { get; set; } = AutomationAction.MarkComplete;
        public Guid? TargetListId { get; set; }
        public Guid? TargetUserId { get; set; }
        public DateTime? DueDate { get; set; }
    }

    private sealed record TriggerOption(AutomationTrigger Value, string Label);
    private sealed record ActionOption(AutomationAction Value, string Label);
}
