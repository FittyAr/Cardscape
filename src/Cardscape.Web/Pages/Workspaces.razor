@page "/workspaces"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@inject IWorkspacesApiClient WorkspacesApi

<PageTitle>Workspaces — Cardscape</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <h1>Workspaces</h1>
        <RadzenButton Text="New workspace" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    </div>

    @if (showCreate)
    {
        <RadzenCard class="create-form">
            <RadzenTemplateForm TItem="CreateModel" Data="@createModel" Submit="@CreateWorkspace">
                <RadzenLabel Text="Name" Component="ws-name" />
                <RadzenTextBox @bind-Value="createModel.Name" Name="ws-name" Style="width:100%" />
                @if (error is not null)
                {
                    <div class="auth-error" role="alert">@error</div>
                }
                <div class="create-actions">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => { showCreate = false; error = null; })" />
                    <RadzenButton Text="Create" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@busy" />
                </div>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    @if (workspaces is null)
    {
        <p>Loading…</p>
    }
    else if (workspaces.Count == 0)
    {
        <p>You have no workspaces yet. Create your first one above.</p>
    }
    else
    {
        <div class="workspace-grid">
            @foreach (WorkspaceDto ws in workspaces)
            {
                <RadzenCard class="workspace-card" @onclick="@(() => Nav.NavigateTo($"workspaces/{ws.Id}"))">
                    <h3>@ws.Name</h3>
                    <small>@ws.MemberCount members · created @ws.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd")</small>
                    @if (ws.IsArchived)
                    {
                        <RadzenBadge Text="Archived" BadgeStyle="BadgeStyle.Warning" Style="margin-top:.5rem" />
                    }
                </RadzenCard>
            }
        </div>
    }
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private IReadOnlyList<WorkspaceDto>? workspaces;
    private bool showCreate;
    private bool busy;
    private string? error;
    private readonly CreateModel createModel = new();

    protected override async Task OnInitializedAsync()
    {
        ApiResult<IReadOnlyList<WorkspaceDto>> result = await WorkspacesApi.ListAsync();
        workspaces = result.IsSuccess ? result.Value : [];
        if (!result.IsSuccess)
        {
            error = result.Error;
        }
    }

    private async Task CreateWorkspace()
    {
        busy = true;
        error = null;
        try
        {
            ApiResult<WorkspaceDto> result = await WorkspacesApi.CreateAsync(createModel.Name);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            workspaces = [.. (workspaces ?? Array.Empty<WorkspaceDto>()), result.Value!];
            createModel.Name = string.Empty;
            showCreate = false;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
    }
}
