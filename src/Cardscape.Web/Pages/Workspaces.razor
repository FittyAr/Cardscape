@page "/workspaces"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Cardscape.Web.Resources
@using Cardscape.Web.Services
@using Cardscape.Web.Services.Api
@using Cardscape.Web.Shared
@using Microsoft.Extensions.Localization
@inject IWorkspacesApiClient WorkspacesApi
@inject IStringLocalizer<SharedResource> L
@inject IConfiguration Config

<PageTitle>@L["WorkspacesTitle"] @L["PageTitleSuffix"]</PageTitle>

<PageHeader Title="@L["WorkspacesTitle"]">
    <Actions>
        <RadzenButton Text="@L["WorkspacesNew"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => showCreate = !showCreate)" />
    </Actions>
</PageHeader>

@if (showCreate)
{
    <RadzenCard class="rz-mb-6" Style="max-width: 36rem;">
        <RadzenTemplateForm TItem="CreateModel" Data="@createModel" Submit="@CreateWorkspaceAsync">
            <LabeledField Text="@L["WorkspacesName"]" Component="ws-name">
                <RadzenTextBox @bind-Value="createModel.Name" Name="ws-name" Style="width:100%" />
            </LabeledField>
            <RadzenRequiredValidator Component="ws-name" Text="@L["ValidationRequired"]" />

            @* Data residency is an opt-in feature. The dropdown only
               appears when `Features:DataResidencyEnabled` is true in
               wwwroot/appsettings.json; otherwise the workspace is
               created with `Region.Unspecified` and the deployment's
               configured region (see `Cardscape:Deployment:Region`)
               becomes the implicit choice. The server-side domain,
               migration, and `RegionGuardEndpointFilter` remain
               available; flipping the flag back on restores the UI
               without any other change. *@
            @if (dataResidencyEnabled)
            {
                <LabeledField Text="@L["WorkspacesRegion"]" Component="ws-region">
                    <RadzenDropDown @bind-Value="createModel.Region" Data="@availableRegions"
                                    TextProperty="Label" ValueProperty="Value" Name="ws-region"
                                    Placeholder="@L["WorkspacesRegionPlaceholder"]" Style="width:100%" />
                </LabeledField>
            }

            @if (error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" class="rz-mt-3">
                    @error
                </RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-3">
                <RadzenButton Text="@L["ActionCancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => { showCreate = false; error = null; })" />
                <RadzenButton Text="@L["ActionCreate"]" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@busy" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}

@if (loadError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@loadError</RadzenAlert>
}
else if (workspaces is null)
{
    <LoadingState Size="LoadingSize.Page" />
}
else if (workspaces.Count == 0)
{
    <div class="cs-empty">
        <RadzenIcon Icon="space_dashboard" />
        <span>@L["WorkspacesEmpty"]</span>
        <RadzenButton Text="@L["WorkspacesNew"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@(() => showCreate = true)" />
    </div>
}
else
{
    <div class="cs-workspace-grid">
        @foreach (WorkspaceDto ws in workspaces)
        {
            <a class="cs-workspace-card @(ws.IsArchived ? "is-archived" : null)" href="@($"workspaces/{ws.Id}")">
                <span class="cs-workspace-card-avatar" style="--cs-tile-color: @BoardTile.ColorFor(ws.Id);" aria-hidden="true">@ws.Name[..1].ToUpperInvariant()</span>
                <span class="cs-workspace-card-text">
                    <span class="cs-workspace-card-name">@ws.Name</span>
                    <span class="cs-workspace-card-meta">
                        @L["HomeWorkspaceMembers", ws.MemberCount] · @ws.CreatedAt.LocalDateTime.ToString("d")
                    </span>
                    @if ((dataResidencyEnabled && ws.Region != Region.Unspecified) || ws.IsArchived || ws.CallerIsGuest)
                    {
                        <span class="cs-row rz-mt-1">
                            @if (ws.CallerIsGuest)
                            {
                                <RadzenBadge Text="@L["WorkspaceRoleGuest"]" BadgeStyle="BadgeStyle.Secondary" title="@L["WorkspaceGuestHint"]" />
                            }
                            @if (dataResidencyEnabled && ws.Region != Region.Unspecified)
                            {
                                <RadzenBadge Text="@RegionLabel(ws.Region)" BadgeStyle="BadgeStyle.Info" />
                            }
                            @if (ws.IsArchived)
                            {
                                <RadzenBadge Text="@L["ActionArchived"]" BadgeStyle="BadgeStyle.Warning" />
                            }
                        </span>
                    }
                </span>
                <RadzenIcon Icon="chevron_right" class="cs-workspace-card-chevron" />
            </a>
        }
    </div>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private IReadOnlyList<WorkspaceDto>? workspaces;
    private bool showCreate;
    private bool busy;
    private string? error;
    private string? loadError;
    private readonly CreateModel createModel = new();

    // Read once on first render. The flag is a deployment-time
    // choice, not a per-user toggle, so re-evaluating it on every
    // render would only add noise. Toggling the value in
    // appsettings.json requires a WASM host restart to take effect
    // (consistent with every other IConfiguration-driven knob in
    // the Web host). Instance-injected, so it cannot be read in a
    // field initializer — see OnInitializedAsync below.
    private bool dataResidencyEnabled;

    private sealed record RegionOption(Region Value, string Label);

    private IReadOnlyList<RegionOption> availableRegions = new[]
    {
        new RegionOption(Region.Unspecified, "Unspecified (auto)"),
        new RegionOption(Region.Europe, "Europe"),
        new RegionOption(Region.NorthAmerica, "North America"),
        new RegionOption(Region.AsiaPacific, "Asia Pacific"),
        new RegionOption(Region.SouthAmerica, "South America"),
    };

    protected override async Task OnInitializedAsync()
    {
        dataResidencyEnabled = Config.GetValue<bool>(
            "Features:DataResidencyEnabled", false);

        ApiResult<IReadOnlyList<WorkspaceDto>> result = await WorkspacesApi.ListAsync();
        if (result.HasValue)
        {
            workspaces = result.Value;
            return;
        }

        workspaces = null;
        loadError = result.Error ?? L["WorkspacesLoadFailed"];
    }

    private async Task CreateWorkspaceAsync()
    {
        busy = true;
        error = null;
        try
        {
            Region? region = createModel.Region == Region.Unspecified ? null : createModel.Region;
            ApiResult<WorkspaceDto> result = await WorkspacesApi.CreateAsync(createModel.Name, region);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            workspaces = [.. (workspaces ?? Array.Empty<WorkspaceDto>()), result.Value!];
            createModel.Name = string.Empty;
            createModel.Region = Region.Unspecified;
            showCreate = false;
        }
        finally
        {
            busy = false;
        }
    }

    private string RegionLabel(Region region) => region switch
    {
        Region.Europe => "Europe",
        Region.NorthAmerica => "North America",
        Region.AsiaPacific => "Asia Pacific",
        Region.SouthAmerica => "South America",
        _ => "Unspecified"
    };

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public Region Region { get; set; } = Region.Unspecified;
    }
}
