{
  "name": "Cardscape",
  "image": "mcr.microsoft.com/dotnet/sdk:11.0.100-preview.6-noble",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/git:1": {
      "configureDefaultBranchAsMain": false
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/joshspicer/devcontainer-features/sqlite:0": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.sdk.version": "11.0.100-preview.6",
        "csharp.format.enable": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-dotnettools.csharp",
        "[markdown]": {
          "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
          "editor.formatOnSave": true
        },
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.blazorwasm-companion",
        "DavidAnson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-spanish",
        "tamasfe.even-better-toml",
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "exiasr.hadolint"
      ]
    }
  },
  "forwardPorts": [
    5000,
    5001,
    4317,
    4318
  ],
  "portsAttributes": {
    "5000": {
      "label": "Cardscape.Api (HTTP)",
      "onAutoForward": "notify"
    },
    "5001": {
      "label": "Cardscape.Web (HTTPS dev)",
      "onAutoForward": "notify"
    },
    "4317": {
      "label": "OTel collector (gRPC)",
      "onAutoForward": "silent"
    },
    "4318": {
      "label": "OTel collector (HTTP)",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": {
    "server": "dotnet tool restore",
    "db": "echo 'Cardscape uses SQLite by default; no DB to start. The integration tests use an in-memory SQLite.'"
  },
  "postStartCommand": {
    "hooks": [
      "dotnet build --verbosity quiet --nologo"
    ]
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerUser": "vscode",
  "mounts": [
    "source=cardscape-bashhistory,target=/home/vscode/.bash_history,type=volume",
    "source=cardscape-zshhistory,target=/home/vscode/.zsh_history,type=volume"
  ]
}
