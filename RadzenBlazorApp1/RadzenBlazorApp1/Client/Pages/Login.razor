@layout LoginLayout
@page "/login"

<PageTitle>Login</PageTitle>
<RadzenText Text="Login" TextStyle="Radzen.Blazor.TextStyle.H4" TagName="Radzen.Blazor.TagName.H2" class="rz-mb-4 rz-mb-md-8" />
<RadzenRow>
    <RadzenColumn SizeMD="12">
        <RadzenTemplateForm Action="@($"account/login?redirectUrl={redirectUrl}")" Data="@("login")"
            Method="post">
            <RadzenAlert Shade="Radzen.Shade.Lighter" Variant="Radzen.Variant.Flat" Size="Radzen.AlertSize.Small" AlertStyle="Radzen.AlertStyle.Danger" Visible="@errorVisible">@error</RadzenAlert>
            <RadzenAlert Shade="Radzen.Shade.Lighter" Variant="Radzen.Variant.Flat" Size="Radzen.AlertSize.Small" AlertStyle="Radzen.AlertStyle.Info" Visible="@infoVisible">@info</RadzenAlert>
            <RadzenLogin ShowLoginButton=false AllowResetPassword="false" AllowRegister="false" FormFieldVariant="Radzen.Variant.Text" Style="--rz-gap: 1rem;"
            />
            <RadzenSplitButton Click="@SplitButton0Click" Text="Login" ButtonStyle="ButtonStyle.Primary" style="float: right;">
                 <ChildContent>
                    <RadzenSplitButtonItem Text="Sales Manager" Value="1" />
                    <RadzenSplitButtonItem Text="Sales Representative" Value="2" />
                </ChildContent>
            </RadzenSplitButton>
        </RadzenTemplateForm>
    </RadzenColumn>
</RadzenRow>
