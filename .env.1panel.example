# ============================================================================
# Cardscape - Plantilla de Entorno (.env) para 1Panel / Home Server
# ============================================================================
# Copie este archivo a '.env' antes de iniciar la pila con Docker Compose:
#   cp .env.1panel.example .env
# Luego ajuste las contraseñas, claves y puertos según su entorno.
# NUNCA suba el archivo '.env' real al repositorio git.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL
# ----------------------------------------------------------------------------
# Nombre de la base de datos para Cardscape
POSTGRES_DB=cardscape

# Usuario de PostgreSQL
POSTGRES_USER=cardscape

# CONTRASEÑA OBLIGATORIA: Cambie por una contraseña robusta antes de desplegar
POSTGRES_PASSWORD=CambiarEstaClaveSegura2026!

# Puerto expuesto en el host para conexiones locales de administración (opcional)
POSTGRES_PORT=5434

# ----------------------------------------------------------------------------
# 2. Cardscape API & Web (.NET 10 Blazor WASM)
# ----------------------------------------------------------------------------
# Puerto local en el host donde escuchará la API para el Reverse Proxy OpenResty
CARDSCAPE_PORT=7420

# CLAVE SECRETA JWT OBLIGATORIA: Clave simétrica de al menos 32-48 bytes para firmar tokens.
# Puede generarse en Linux con: openssl rand -base64 48
CARDS_CAPE_JWT_KEY=CambiarPorClaveSecretaGeneradaConOpensslRandBase64_48BytesMinimo!

# Emisor y audiencia para los tokens JWT
JWT_ISSUER=Cardscape
JWT_AUDIENCE=Cardscape

# ----------------------------------------------------------------------------
# 3. Integración con 1Panel y Red
# ----------------------------------------------------------------------------
# Red externa creada automáticamente por 1Panel para OpenResty y DNS
PANEL_NETWORK=1panel-network
