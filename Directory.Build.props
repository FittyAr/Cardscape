<Project>

  <!-- Common MSBuild properties applied to every project in the solution. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- Target framework pinned across the whole solution. -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- C# language & nullability. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Roslyn analyzers. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- OSS metadata. -->
    <Company>Cardscape</Company>
    <Product>Cardscape</Product>
    <Authors>Cardscape Contributors</Authors>
    <Copyright>Copyright (c) $([System.DateTime]::UtcNow.Year) Cardscape. Licensed under RPL-1.5.</Copyright>
    <RepositoryUrl>https://github.com/FittyAr/Cardscape</RepositoryUrl>
    <PackageLicenseExpression>RPL-1.5</PackageLicenseExpression>
    <!-- Keep in sync with the newest vX.Y.Z git tag (the CI release job runs scripts/site-data.py in check mode). -->
    <Version>1.1.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
