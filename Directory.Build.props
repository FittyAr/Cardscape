<Project>

  <!-- Common MSBuild properties applied to every project in the solution. -->
  <PropertyGroup>
    <!-- Target framework pinned across the whole solution. -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- C# language & nullability. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CA2007;CA1014;CS1591;CA1062;CA1056;CA1812;CA1848;CA1822;CA1000;CA1051;CA1716;CA1819;CA2227;CA1031;CA1305;CA1034;CA1054;CA1308;CA1721;CA1304;CA1311;CA1052;CA1724;CA1303;CA1310;CA1727;CA1725;IDE1006;NU1608;NU1107</NoWarn>

    <!-- Roslyn analyzers. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- XML doc files for every project. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- OSS metadata. -->
    <Company>Cardscape</Company>
    <Product>Cardscape</Product>
    <Authors>Cardscape Contributors</Authors>
    <Copyright>Copyright (c) $([System.DateTime]::UtcNow.Year) Cardscape. Licensed under RPL-1.5.</Copyright>
    <RepositoryUrl>https://github.com/cardscape/cardscape</RepositoryUrl>
    <PackageLicenseExpression>RPL-1.5</PackageLicenseExpression>
    <Version>0.1.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
