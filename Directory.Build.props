<Project>

  <!-- Common MSBuild properties applied to every project in the solution. -->
  <PropertyGroup>
    <!-- Target framework pinned across the whole solution. -->
    <TargetFramework>net11.0</TargetFramework>

    <!-- C# language & nullability. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CA2007;CA1014;CS1591;CA1062;CA1056;CA1812;CA1848;CA1822;IDE0055;IDE0290;IDE0032;IDE0046;IDE0078;IDE0028;IDE0161;IDE0200;IDE0300;IDE0305;IDE0306;CA1000;CA1051;CA1716;CA1819;CA2227;CA1031;CA1305;CA1034;CA1054;CA1308;CA1721;CA1822;CA1304;CA1311;CA2000;CA1052;CA1724;CA1063;CA1816;CA2208;CA2249;CA2234;CA1052;CA1724;CA1303;CA1304;CA1305;CA1310;CA1834;CA1308;CA1303;CA1304;CA1310;CA1834;CA1854;CA1862;CA1862;CA1860;CA1303;CA1304;CA1305;CA1308;CA1310;CA1311;CA1727;CA1822;CA1845;CA1846;CA1847;CA1862;CA1868;CA1861;CA2017;CA2018;CA2019;CA2020;CA2200;CA2201;CA2208;CA2211;CA2213;CA2215;CA2219;CA2225;CA2227;CA2234;CA2245;CA2247;CA2249;CA2254;CA2255;CA2256;CA2257;CA2258;CA2259;CA2260;CA2261;CA2262;CA2263;CA2264;CA2265;CA1873;CA1725;IDE0005;IDE0044;IDE0051;IDE0058;IDE0060;IDE0290;IDE1006</NoWarn>

    <!-- Roslyn analyzers. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- XML doc files for every project. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- OSS metadata. -->
    <Company>Cardscape</Company>
    <Product>Cardscape</Product>
    <Authors>Cardscape Contributors</Authors>
    <Copyright>Copyright (c) $([System.DateTime]::UtcNow.Year) Cardscape. Licensed under RPL-1.5.</Copyright>
    <RepositoryUrl>https://github.com/cardscape/cardscape</RepositoryUrl>
    <PackageLicenseExpression>RPL-1.5</PackageLicenseExpression>
    <Version>0.1.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
